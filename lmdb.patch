+++ b/cmake/modules/FindLMDB.cmake
@@ -0,0 +1,50 @@
+# Find LMDB or download it using FetchContent
+#  LMDB_FOUND - system has LMDB lib
+#  LMDB_INCLUDE_DIR - the LMDB include directory
+#  LMDB_LIBRARIES - Libraries needed to use LMDB
+
+# Copyright 2023, RocksDB developers
+
+include(FetchContent)
+
+set(LMDB_REPOSITORY "https://github.com/LMDB/lmdb.git" CACHE STRING "LMDB repository URL")
+set(LMDB_TAG "LMDB_0.9.31" CACHE STRING "LMDB git tag to use")
+
+message(STATUS "Downloading LMDB from ${LMDB_REPOSITORY}, tag ${LMDB_TAG}")
+
+FetchContent_Declare(
+  lmdb
+  URL https://github.com/LMDB/lmdb/archive/refs/tags/LMDB_0.9.31.zip
+  URL_HASH SHA1=ec1948aab5fd14f34ff142f876d5921dc95c83cc
+  DOWNLOAD_EXTRACT_TIMESTAMP 1
+)
+
+FetchContent_GetProperties(lmdb)
+if(NOT lmdb_POPULATED)
+  FetchContent_Populate(lmdb)
+  
+  # LMDB's source code is in the 'libraries/liblmdb' directory
+  set(LMDB_SOURCE_DIR "${lmdb_SOURCE_DIR}/libraries/liblmdb")
+  
+  # Set include directory
+  set(LMDB_INCLUDE_DIR "${LMDB_SOURCE_DIR}")
+  
+  # Build LMDB - only include mdb.c and midl.c, not test files
+  set(LMDB_SOURCES "${LMDB_SOURCE_DIR}/mdb.c" "${LMDB_SOURCE_DIR}/midl.c")
+  add_library(lmdb STATIC ${LMDB_SOURCES})
+  target_include_directories(lmdb INTERFACE ${LMDB_SOURCE_DIR})
+  set_target_properties(lmdb PROPERTIES POSITION_INDEPENDENT_CODE ON)
+  
+  # Set the library
+  set(LMDB_LIBRARIES lmdb)
+  
+  # Export version information
+  set(LMDB_VERSION "0.9.31")  # Use the version from the tag
+endif()
+
+# Set LMDB_INCLUDE_DIRS for backward compatibility
+set(LMDB_INCLUDE_DIRS ${LMDB_INCLUDE_DIR})
+
+set(LMDB_FOUND TRUE)
+message(STATUS "Using FetchContent LMDB (include: ${LMDB_INCLUDE_DIR}, library: ${LMDB_LIBRARIES})")
+mark_as_advanced(LMDB_INCLUDE_DIR LMDB_LIBRARIES LMDB_INCLUDE_DIRS)
