+#include <rocksdb/c.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// Configuration - must match the writer
+const char *DB_PATH = "/tmp/rocksdb_blob_example";
+
+// Helper function to check RocksDB errors
+void check_rocksdb_error(char *errptr, const char *message) {
+  if (errptr != NULL) {
+    fprintf(stderr, "Error: %s: %s\n", message, errptr);
+    free(errptr);
+    exit(1);
+  }
+}
+
+int main(int argc, char *argv[]) {
+  rocksdb_t *db;
+  rocksdb_options_t *options;
+  rocksdb_readoptions_t *read_options;
+  char *err = NULL;
+  char key_buffer[64];
+  
+  int start_key = 0;
+  int num_keys = 10;
+  
+  // Parse command line arguments if provided
+  if (argc > 1) start_key = atoi(argv[1]);
+  if (argc > 2) num_keys = atoi(argv[2]);
+  
+  printf("Reading from RocksDB at %s\n", DB_PATH);
+  printf("Starting at key %d, reading %d keys\n", start_key, num_keys);
+
+  // Create options
+  options = rocksdb_options_create();
+  read_options = rocksdb_readoptions_create();
+  
+  // Open the database
+  db = rocksdb_open(options, DB_PATH, &err);
+  check_rocksdb_error(err, "DB Open failed");
+  
+  // Read and print keys
+  for (int i = start_key; i < start_key + num_keys; i++) {
+    size_t val_len;
+    
+    // Format key the same way as in the writer
+    snprintf(key_buffer, sizeof(key_buffer), "key%08d", i);
+    
+    // Read the value
+    char *value = rocksdb_get(db, read_options, key_buffer, strlen(key_buffer), &val_len, &err);
+    check_rocksdb_error(err, "Read failed");
+    
+    if (value != NULL) {
+      printf("Key: %s, Value size: %zu bytes\n", key_buffer, val_len);
+      
+      // Print first few bytes as hex
+      printf("Value preview (first 16 bytes): ");
+      for (size_t j = 0; j < val_len && j < 16; j++) {
+        printf("%02x ", (unsigned char)value[j]);
+      }
+      printf("\n");
+      
+      // Free the value returned by RocksDB
+      free(value);
+    } else {
+      printf("Key %s not found\n", key_buffer);
+    }
+  }
+  
+  // Cleanup
+  rocksdb_readoptions_destroy(read_options);
+  rocksdb_options_destroy(options);
+  rocksdb_close(db);
+  
+  printf("Done.\n");
+  return 0;
+} 
