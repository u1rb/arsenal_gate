index 0000000..812610c
--- /dev/null
+++ b/main.cpp
@@ -0,0 +1,158 @@
+#include <rocksdb/c.h>
+#include <stddef.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h> // For seeding random
+
+// --- Configuration ---
+const char *DB_PATH = "/tmp/rocksdb_blob_example";
+const int NUM_KEYS_TO_WRITE = 4 * 1000 * 1000; // Number of blob entries to write
+// const size_t BLOB_SIZE = 128 * 1024; // 128 KB blobs
+const size_t BLOB_SIZE = 1 * 1024; // 1 KB blobs
+const int BATCH_SIZE = 8192 * 4;   // Write in batches of 100
+const int DISABLE_WAL = 1; // 1 to disable WAL (faster, less safe), 0 to enable
+const size_t MIN_BLOB_SIZE = 16 * 1024; // Values >= 16KB go to blob files
+// --- End Configuration ---
+
+// Helper function to check RocksDB errors
+void check_rocksdb_error(char *errptr, const char *message) {
+  if (errptr != NULL) {
+    fprintf(stderr, "Error: %s: %s\n", message, errptr);
+    free(errptr); // Important: Free the error message memory
+    exit(1);
+  }
+}
+
+int main() {
+  rocksdb_t *db;
+  rocksdb_options_t *options;
+  rocksdb_writeoptions_t *write_options;
+  char *err = NULL;
+  char key_buffer[64];
+  char *value_buffer = NULL;
+
+  printf("Starting RocksDB Blob Write Example...\n");
+  printf("Database path: %s\n", DB_PATH);
+  printf("Writing %d keys with blob size %zu bytes.\n", NUM_KEYS_TO_WRITE,
+         BLOB_SIZE);
+  printf("Batch size: %d\n", BATCH_SIZE);
+  printf("Min blob size for BlobDB: %zu bytes\n", MIN_BLOB_SIZE);
+  printf("Write Ahead Log (WAL): %s\n",
+         DISABLE_WAL ? "DISABLED (Max Speed / Less Safe!)" : "ENABLED (Safer)");
+
+  // --- Prepare RocksDB Options ---
+  options = rocksdb_options_create();
+  // Increase parallelism (adjust based on your CPU cores)
+  rocksdb_options_increase_parallelism(options, 4);
+  // Optimize level 0 file num compaction trigger (can help with write stalls)
+  rocksdb_options_optimize_level_style_compaction(
+      options, 512 * 1024 * 1024); // 512MB memory budget
+  // Create DB if it doesn't exist
+  rocksdb_options_set_create_if_missing(options, 1);
+
+  // Tune memtable/write buffer size (larger buffer can absorb write bursts)
+  rocksdb_options_set_write_buffer_size(options,
+                                        128 * 1024 * 1024); // 128MB memtable
+  rocksdb_options_set_max_write_buffer_number(
+      options, 4); // Allow more memtables in memory
+
+  // Disable compression for potential raw speed gain (if CPU bound or data
+  // incompressible)
+  rocksdb_options_set_compression(options, rocksdb_no_compression);
+
+  // --- Enable and Configure BlobDB ---
+  rocksdb_options_set_enable_blob_files(options, 1);
+  rocksdb_options_set_min_blob_size(options, MIN_BLOB_SIZE);
+  // Optional: Set blob file size, compression for blobs, enable GC etc.
+  // rocksdb_options_set_blob_file_size(options, 256 * 1024 * 1024); // 256MB
+  // blob files rocksdb_options_set_blob_compression_type(options,
+  // rocksdb_lz4_compression);
+  // rocksdb_options_set_enable_blob_garbage_collection(options, 1);
+
+  // --- Prepare Write Options ---
+  write_options = rocksdb_writeoptions_create();
+  if (DISABLE_WAL) {
+    // Disabling WAL significantly increases write speed but risks data loss on
+    // crash
+    rocksdb_writeoptions_disable_WAL(write_options, 1);
+    // Optional: Sync writes aren't needed if WAL is off
+    // rocksdb_writeoptions_set_sync(write_options, 0);
+  } else {
+    // Optional: If WAL is enabled, you might consider disabling sync for speed,
+    // but this still risks losing data in the OS buffer cache on power loss.
+    // rocksdb_writeoptions_set_sync(write_options, 0);
+  }
+
+  // --- Open DB ---
+  printf("Opening database...\n");
+  db = rocksdb_open(options, DB_PATH, &err);
+  check_rocksdb_error(err, "DB Open failed");
+  err = NULL; // Reset error pointer
+
+  // --- Allocate reusable buffer for blob data ---
+  value_buffer = (char *)malloc(BLOB_SIZE);
+  if (!value_buffer) {
+    fprintf(stderr, "Failed to allocate memory for value buffer\n");
+    exit(1);
+  }
+  // Fill with some arbitrary data (e.g., pseudo-random bytes)
+  srand(time(NULL));
+  for (size_t i = 0; i < BLOB_SIZE; ++i) {
+    value_buffer[i] = rand() % 256;
+  }
+
+  // --- Write Data in Batches ---
+  printf("Writing data...\n");
+  rocksdb_writebatch_t *batch = NULL;
+  for (size_t i = 0; i < NUM_KEYS_TO_WRITE; ++i) {
+    // Create a new batch every BATCH_SIZE iterations
+    if (i % BATCH_SIZE == 0) {
+      // Write the previous batch if it exists
+      if (batch != NULL) {
+        rocksdb_write(db, write_options, batch, &err);
+        check_rocksdb_error(err, "Write batch failed");
+        err = NULL;
+        rocksdb_writebatch_destroy(batch); // Destroy the old batch
+      }
+      // Create a new batch
+      batch = rocksdb_writebatch_create();
+      if (i + BATCH_SIZE > NUM_KEYS_TO_WRITE) {
+        printf("Writing final batch (%ld keys)...\n", NUM_KEYS_TO_WRITE - i);
+      } else {
+        printf("Writing batch starting at key %ld...\n", i);
+      }
+    }
+
+    // Generate key, i is uint64_t
+    snprintf(key_buffer, sizeof(key_buffer), "key%08ld", i);
+
+    // Add Put operation to the current batch
+    // Using value_buffer directly. For varying data, fill it here.
+    if (1) {
+      rocksdb_writebatch_put(batch, key_buffer, sizeof(size_t), value_buffer,
+                             BLOB_SIZE);
+    }
+  }
+
+  // Write the last remaining batch
+  if (batch != NULL) {
+    rocksdb_write(db, write_options, batch, &err);
+    check_rocksdb_error(err, "Final write batch failed");
+    err = NULL;
+    rocksdb_writebatch_destroy(batch);
+    batch = NULL;
+  }
+
+  printf("Finished writing data.\n");
+
+  // --- Cleanup ---
+  printf("Cleaning up resources...\n");
+  free(value_buffer);
+  rocksdb_writeoptions_destroy(write_options);
+  rocksdb_options_destroy(options);
+  rocksdb_close(db);
+
+  printf("Done.\n");
+  return 0;
+}
