+++ b/CMakeLists.txt
@@ -0,0 +1,78 @@
+cmake_minimum_required(VERSION 3.10)
+project(rocksdb_blob_example C CXX)
+
+set(CMAKE_C_STANDARD 11)
+set(CMAKE_C_STANDARD_REQUIRED True)
+
+# Add option to force compile RocksDB from source
+option(FORCE_COMPILE_ROCKSDB "Force compilation of RocksDB from source" OFF)
+
+# First try to find system-installed RocksDB if not forcing compilation
+if(NOT FORCE_COMPILE_ROCKSDB)
+    find_package(RocksDB QUIET)
+else()
+    set(RocksDB_FOUND FALSE)
+    message(STATUS "Forcing compilation of RocksDB from source as requested")
+endif()
+
+if(NOT RocksDB_FOUND)
+    message(STATUS "System RocksDB not found, downloading and building from source")
+    # Set RocksDB options before including it
+    set(WITH_GFLAGS OFF CACHE BOOL "build with gflags")
+    set(WITH_TESTS OFF CACHE BOOL "build with tests")
+    set(WITH_TOOLS OFF CACHE BOOL "build with tools")
+    set(WITH_SNAPPY ON CACHE BOOL "build with snappy")
+
+    include(FetchContent)
+    FetchContent_Declare(
+        rocksdb
+        URL https://github.com/facebook/rocksdb/archive/refs/tags/v10.0.1.zip
+        URL_HASH SHA1=59334fa9c4194149b18b5eb6faba37fb04d431e8
+        DOWNLOAD_EXTRACT_TIMESTAMP TRUE
+        CMAKE_ARGS 
+            -DCMAKE_BUILD_TYPE=Release
+    )
+
+    FetchContent_MakeAvailable(rocksdb)
+    # Don't use find_package after FetchContent_MakeAvailable
+    # The target 'rocksdb' is already available
+    
+    # Set variable to indicate we're using built rocksdb
+    set(USING_BUILT_ROCKSDB TRUE)
+else()
+    message(STATUS "Using system-installed RocksDB")
+    set(USING_BUILT_ROCKSDB FALSE)
+endif()
+
+# Try to find system-installed LMDB
+find_package(LMDB REQUIRED)
+if(LMDB_FOUND)
+    message(STATUS "Found LMDB: ${LMDB_LIBRARIES}")
+else()
+    message(FATAL_ERROR "LMDB library not found. Please install lmdb-dev (or equivalent).")
+endif()
+
+# Add the executables
+add_executable(rocksdb_writer main.cpp)
+add_executable(rocksdb_reader reader.cpp)
+add_executable(lmdb_writer lmdb_writer.cpp)
+
+# Link against the RocksDB library and include directories
+if(USING_BUILT_ROCKSDB)
+    target_link_libraries(rocksdb_writer PRIVATE rocksdb)
+    target_link_libraries(rocksdb_reader PRIVATE rocksdb)
+else()
+    target_link_libraries(rocksdb_writer PRIVATE RocksDB::rocksdb)
+    target_link_libraries(rocksdb_reader PRIVATE RocksDB::rocksdb)
+endif()
+
+# Link LMDB executable
+target_link_libraries(lmdb_writer PRIVATE ${LMDB_LIBRARIES})
+
+add_executable(file_stream_writer file_stream_writer.cpp)
+
+# Optional: Add compiler flags if needed, e.g., for optimization
+# target_compile_options(rocksdb_writer PRIVATE -O3)
+# target_compile_options(rocksdb_reader PRIVATE -O3)
+
+message(STATUS "RocksDB configuration complete")
