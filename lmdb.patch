diff --git a/lmdb_writer.cpp b/lmdb_writer.cpp
new file mode 100644
index 0000000..167d628
--- /dev/null
+++ b/lmdb_writer.cpp
@@ -0,0 +1,200 @@
+#include <lmdb.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h> // For mkdir
+#include <sys/time.h> // For timing
+#include <time.h>     // For seeding random
+
+// --- Configuration ---
+const int NUM_KEYS_TO_WRITE =
+    2 * 1000 * 1000;               // Number of blob entries to write
+const size_t BLOB_SIZE = 1 * 1024; // 1 KB blobs
+const int BATCH_SIZE = 2048 * 16;  // Write in batches
+// LMDB specific: Define max DB size (adjust as needed)
+// Rough estimate: NUM_KEYS * (Avg Key Size + BLOB_SIZE) + overhead
+// 10000 * (12 + 1024) = ~10MB. Let's use 100MB to be safe.
+const size_t MAP_SIZE = 10ULL * 1024 * 1024 * 1024; // 2 GiB
+// LMDB Flags for performance (trade-off safety)
+// MDB_NOSYNC: Don't fsync after commit - faster, less durable
+// MDB_MAPASYNC: Use asynchronous msync - faster, less durable
+// MDB_WRITEMAP: Use writeable memory map - faster
+// MDB_NOMETASYNC: Don't fsync metadata - faster, less durable
+const unsigned int ENV_FLAGS =
+    MDB_NOSYNC | MDB_MAPASYNC | MDB_NOMETASYNC | MDB_WRITEMAP;
+
+// --- End Configuration ---
+
+// Helper function to check LMDB errors
+void check_lmdb_error(int rc, const char *message) {
+  if (rc != MDB_SUCCESS) {
+    fprintf(stderr, "Error: %s: %s ", message, mdb_strerror(rc));
+    exit(1);
+  }
+}
+
+int main(int argc, char **argv) {
+
+  const char *DB_PATH_DEFAULT = "build/lmdb_blob_example";
+  char DB_PATH[1024];
+  if (argc > 1) {
+    strncpy(DB_PATH, argv[1], sizeof(DB_PATH));
+  } else {
+    strncpy(DB_PATH, DB_PATH_DEFAULT, sizeof(DB_PATH));
+  }
+
+  MDB_env *env;
+  MDB_dbi dbi;
+  MDB_txn *txn;
+  MDB_val key_val, data_val;
+  int rc;
+  char key_buffer[64];
+  char *value_buffer = NULL;
+  struct timeval start_time, end_time;
+  double elapsed;
+
+  printf("Starting LMDB Write Example...  ");
+  printf("Database path: %s ", DB_PATH);
+  printf("Writing %d keys with blob size %zu bytes.  ", NUM_KEYS_TO_WRITE,
+         BLOB_SIZE);
+  printf("Batch size: %d ", BATCH_SIZE);
+  printf("LMDB Map Size: %zu bytes ", MAP_SIZE);
+  printf("LMDB Env Flags: 0x%X (MDB_WRITEMAP | MDB_NOSYNC | MDB_MAPASYNC | "
+         "MDB_NOMETASYNC) ",
+         ENV_FLAGS);
+
+  // --- Create DB Directory if it doesn't exist ---
+  // LMDB doesn't create the directory automatically
+  struct stat st = {0};
+  if (stat(DB_PATH, &st) == -1) {
+    if (mkdir(DB_PATH, 0700) != 0) {
+      perror("Failed to create database directory");
+      exit(1);
+    }
+    printf("Created database directory: %s ", DB_PATH);
+  }
+
+  // --- Prepare LMDB Environment ---
+  rc = mdb_env_create(&env);
+  check_lmdb_error(rc, "mdb_env_create failed");
+
+  // Set the max database size
+  rc = mdb_env_set_mapsize(env, MAP_SIZE);
+  check_lmdb_error(rc, "mdb_env_set_mapsize failed");
+
+  // Set max databases (only need 1 here)
+  rc = mdb_env_set_maxdbs(env, 1);
+  check_lmdb_error(rc, "mdb_env_set_maxdbs failed");
+
+  // --- Open LMDB Environment ---
+  printf("Opening LMDB environment...  ");
+  // Flags: MDB_WRITEMAP for potential speedup, MDB_NOSYNC/MAPASYNC for less
+  // durability/more speed
+  rc = mdb_env_open(env, DB_PATH, ENV_FLAGS, 0664);
+  check_lmdb_error(rc, "mdb_env_open failed");
+
+  // --- Allocate reusable buffer for blob data ---
+  value_buffer = (char *)malloc(BLOB_SIZE);
+  if (!value_buffer) {
+    fprintf(stderr, "Failed to allocate memory for value buffer ");
+    exit(1);
+  }
+  // Fill with some arbitrary data (e.g., pseudo-random bytes)
+  srand(time(NULL));
+  for (size_t i = 0; i < BLOB_SIZE; ++i) {
+    value_buffer[i] = rand() % 256;
+  }
+
+  // --- Write Data in Batches using Transactions ---
+  printf("Writing data...  ");
+  int keys_in_batch = 0;
+  txn = NULL; // Initialize transaction pointer
+
+  gettimeofday(&start_time, NULL);
+
+  for (size_t i = 0; i < NUM_KEYS_TO_WRITE; ++i) {
+    // Start a new transaction every BATCH_SIZE iterations or on the first key
+    if (keys_in_batch == 0) {
+      if (txn != NULL) { // Commit previous transaction if it exists
+        rc = mdb_txn_commit(txn);
+        check_lmdb_error(rc, "mdb_txn_commit failed");
+        txn = NULL; // Reset transaction pointer
+        // printf("Committed batch.  \n");
+      }
+      // Begin a new write transaction
+      rc = mdb_txn_begin(env, NULL, 0, &txn); // Use 0 flags for write txn
+      check_lmdb_error(rc, "mdb_txn_begin failed");
+
+      // Open the database (DBI) within the transaction.
+      // Needs to be done once per transaction usually, but safe to do
+      // repeatedly. Use MDB_CREATE to create the DB if it doesn't exist.
+      rc = mdb_dbi_open(txn, NULL, MDB_CREATE, &dbi); // NULL for main DB
+      check_lmdb_error(rc, "mdb_dbi_open failed");
+
+      if (i + BATCH_SIZE > NUM_KEYS_TO_WRITE) {
+        // printf("Writing final batch (%ld keys)...  \n", NUM_KEYS_TO_WRITE -
+        // i);
+      } else {
+        // printf("Starting batch at key %ld...  \n", i);
+      }
+    }
+
+    // Generate key
+
+    snprintf(key_buffer, sizeof(key_buffer), "key%08ld", i);
+    key_val.mv_size = strlen(key_buffer);
+
+    key_val.mv_data = key_buffer;
+
+    // Set data value (using the pre-filled buffer)
+    data_val.mv_size = BLOB_SIZE;
+    data_val.mv_data = value_buffer;
+
+    // Add Put operation to the current transaction
+    // Use MDB_APPEND flag because keys are sorted lexicographically.
+    // This significantly speeds up insertions.
+    rc = mdb_put(txn, dbi, &key_val, &data_val, MDB_APPEND);
+
+    // Handle specific errors like MDB_MAP_FULL if necessary
+    if (rc == MDB_MAP_FULL) {
+      fprintf(stderr, "Error: LMDB Map Full. Increase MAP_SIZE.  ");
+      mdb_txn_abort(txn); // Abort the current transaction
+      exit(1);
+    }
+    check_lmdb_error(rc, "mdb_put failed");
+
+    keys_in_batch++;
+
+    // Commit batch if BATCH_SIZE is reached
+    if (keys_in_batch >= BATCH_SIZE) {
+      keys_in_batch = 0; // Reset counter for next batch trigger
+      // The commit will happen at the start of the next loop iteration
+    }
+  }
+
+  // Commit the last remaining transaction
+  if (txn != NULL) {
+    rc = mdb_txn_commit(txn);
+    check_lmdb_error(rc, "Final mdb_txn_commit failed");
+    txn = NULL;
+    // printf("Committed final batch.  ");
+  }
+
+  gettimeofday(&end_time, NULL);
+  elapsed = (end_time.tv_sec - start_time.tv_sec) +
+            (end_time.tv_usec - start_time.tv_usec) / 1000000.0;
+
+  printf("Finished writing data in %.2f seconds\n", elapsed);
+  printf("Write throughput: %.2f MB/s\n",
+         (NUM_KEYS_TO_WRITE * (BLOB_SIZE + 16)) / (elapsed * 1024 * 1024));
+
+  // --- Cleanup ---
+  printf("Cleaning up resources...  ");
+  free(value_buffer);
+  // DBI handle is closed automatically when transaction commits/aborts or env
+  // closes No need to explicitly call mdb_dbi_close unless using MDB_NOMETASYNC
+  mdb_env_close(env);
+
+  printf("Done.  ");
+  return 0;
+}
