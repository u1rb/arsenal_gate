new file mode 100644
index 0000000..cfe1d98
--- /dev/null
+++ b/file_stream_writer.cpp
@@ -0,0 +1,148 @@
+#include <fcntl.h> // For open, O_* constants
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h> // For mkdir
+#include <sys/time.h> // For timing
+#include <time.h>     // For seeding random
+#include <unistd.h>   // For write, close
+
+// --- Configuration ---
+const char *FILE_PATH = "build/file_blob_example.dat";
+const int NUM_KEYS_TO_WRITE =
+    2 * 1000 * 1000;                        // Number of blob entries to write
+const size_t BLOB_SIZE = 1 * 1024;          // 1 KB blobs
+const int BATCH_SIZE = 2048 * 16;           // Write in batches
+const size_t BUFFER_SIZE = 8 * 1024 * 1024; // 8 MB write buffer
+
+// --- End Configuration ---
+
+// Helper function to check errors
+void check_error(int rc, const char *message) {
+  if (rc < 0) {
+    perror(message);
+    exit(1);
+  }
+}
+
+int main() {
+  int fd;
+  int rc;
+  char key_buffer[64];
+  char *value_buffer = NULL;
+  char *write_buffer = NULL;
+  size_t write_buffer_pos = 0;
+  struct timeval start_time, end_time;
+  double elapsed;
+
+  printf("Starting File Stream Write Example...\n");
+  printf("Output file: %s\n", FILE_PATH);
+  printf("Writing %d keys with blob size %zu bytes.\n", NUM_KEYS_TO_WRITE,
+         BLOB_SIZE);
+  printf("Batch size: %d\n", BATCH_SIZE);
+  printf("Buffer size: %zu bytes\n", BUFFER_SIZE);
+
+  // --- Create directory if it doesn't exist ---
+  struct stat st = {0};
+  const char *dir_path = "build";
+  if (stat(dir_path, &st) == -1) {
+    if (mkdir(dir_path, 0700) != 0) {
+      perror("Failed to create directory");
+      exit(1);
+    }
+    printf("Created directory: %s\n", dir_path);
+  }
+
+  // --- Open output file ---
+  printf("Opening output file...\n");
+  fd = open(FILE_PATH, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+  if (fd < 0) {
+    perror("Failed to open output file");
+    exit(1);
+  }
+
+  // --- Allocate buffers ---
+  value_buffer = (char *)malloc(BLOB_SIZE);
+  if (!value_buffer) {
+    fprintf(stderr, "Failed to allocate memory for value buffer\n");
+    exit(1);
+  }
+
+  write_buffer = (char *)malloc(BUFFER_SIZE);
+  if (!write_buffer) {
+    fprintf(stderr, "Failed to allocate memory for write buffer\n");
+    free(value_buffer);
+    exit(1);
+  }
+
+  // Fill value buffer with some arbitrary data (e.g., pseudo-random bytes)
+  srand(time(NULL));
+  for (size_t i = 0; i < BLOB_SIZE; ++i) {
+    value_buffer[i] = rand() % 256;
+  }
+
+  // --- Write Data ---
+  printf("Writing data...\n");
+  gettimeofday(&start_time, NULL);
+
+  for (size_t i = 0; i < NUM_KEYS_TO_WRITE; ++i) {
+    // Generate key
+    snprintf(key_buffer, sizeof(key_buffer), "key%08ld", i);
+    size_t key_size = strlen(key_buffer);
+
+    // Check if buffer needs to be flushed
+    if (write_buffer_pos + sizeof(key_size) + key_size + sizeof(BLOB_SIZE) +
+            BLOB_SIZE >
+        BUFFER_SIZE) {
+      rc = write(fd, write_buffer, write_buffer_pos);
+      check_error(rc, "write failed");
+      write_buffer_pos = 0;
+
+      if (i % BATCH_SIZE == 0) {
+        printf("Wrote %ld keys...\n", i);
+      }
+    }
+
+    // Write key size
+    memcpy(write_buffer + write_buffer_pos, &key_size, sizeof(key_size));
+    write_buffer_pos += sizeof(key_size);
+
+    // Write key data
+    memcpy(write_buffer + write_buffer_pos, key_buffer, key_size);
+    write_buffer_pos += key_size;
+
+    // Write blob size
+    memcpy(write_buffer + write_buffer_pos, &BLOB_SIZE, sizeof(BLOB_SIZE));
+    write_buffer_pos += sizeof(BLOB_SIZE);
+
+    // Write blob data
+    memcpy(write_buffer + write_buffer_pos, value_buffer, BLOB_SIZE);
+    write_buffer_pos += BLOB_SIZE;
+  }
+
+  // Flush any remaining data
+  if (write_buffer_pos > 0) {
+    rc = write(fd, write_buffer, write_buffer_pos);
+    check_error(rc, "final write failed");
+  }
+
+  // Sync data to disk
+  fsync(fd);
+
+  gettimeofday(&end_time, NULL);
+  elapsed = (end_time.tv_sec - start_time.tv_sec) +
+            (end_time.tv_usec - start_time.tv_usec) / 1000000.0;
+
+  printf("Finished writing data in %.2f seconds\n", elapsed);
+  printf("Write throughput: %.2f MB/s\n",
+         (NUM_KEYS_TO_WRITE * (BLOB_SIZE + 16)) / (elapsed * 1024 * 1024));
+
+  // --- Cleanup ---
+  printf("Cleaning up resources...\n");
+  free(value_buffer);
+  free(write_buffer);
+  close(fd);
+
+  printf("Done.\n");
+  return 0;
+}
