+++ b/main.cpp
@@ -0,0 +1,79 @@
+#include <cstddef>
+#include <cstdint>
+#include <duckdb.h>
+#include <stdio.h>
+#include <string>
+
+int run_query(duckdb_connection conn, const char *query) {
+  duckdb_result result;
+  if (duckdb_query(conn, query, &result) == DuckDBError) {
+    printf("Query 1 error\n");
+    return -1;
+  }
+
+  idx_t duckdb_result_chunk_cnt = duckdb_result_chunk_count(result);
+  printf("result chunk cnt: %ld\n", duckdb_result_chunk_cnt);
+
+  idx_t total_rows = 0;
+  uint64_t largest_nic_time = 0;
+
+  for (idx_t chunk_idx = 0; chunk_idx < duckdb_result_chunk_cnt; chunk_idx++) {
+    duckdb_data_chunk data_chunk = duckdb_result_get_chunk(result, chunk_idx);
+    idx_t data_chunk_size = duckdb_data_chunk_get_size(data_chunk);
+    idx_t column_cnt = duckdb_data_chunk_get_column_count(data_chunk);
+
+    total_rows += data_chunk_size;
+
+    uint64_t *data_vector =
+        (uint64_t *)duckdb_data_chunk_get_vector(data_chunk, 2);
+
+    for (idx_t row_i = 0; row_i < data_chunk_size; row_i += 1) {
+      uint64_t nic_timestamp = data_vector[row_i];
+      if (nic_timestamp > largest_nic_time) {
+        largest_nic_time = nic_timestamp;
+      }
+    }
+
+    // printf("Result chunk idx: %ld, len: %ld, col cnt: %ld\n", chunk_idx,
+    // data_chunk_size, column_cnt);
+  }
+  printf("Total Rows: %ld\n", total_rows);
+  return 0;
+}
+
+int main() {
+
+  // Connect to duckdb
+
+  duckdb_database db;
+  duckdb_connection conn;
+  duckdb_result result;
+
+  duckdb_config config;
+  duckdb_create_config(&config);
+
+  duckdb_set_config(config, "memory_limit", "1GB");
+
+  const char *duckdb_path = "local_data/a.duckdb";
+
+  if (duckdb_open(duckdb_path, &db) == DuckDBError) {
+    printf("Open error: \n");
+    return -1;
+  }
+  if (duckdb_connect(db, &conn) == DuckDBError) {
+    printf("Conenct error\n");
+    return -1;
+  }
+
+  // std::string query = "SELECT * FROM './local_data/*.parquet' LIMIT 10";
+  std::string query = "SELECT * FROM './local_data/*.parquet'";
+  run_query(conn, query.c_str());
+
+  query = "SELECT * FROM './local_data/*.parquet' WHERE ticker != '831'";
+  run_query(conn, query.c_str());
+
+  // Query on all parquet files
+
+  // Test latency on iterations
+  return 0;
+}
