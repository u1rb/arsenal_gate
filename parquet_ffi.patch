+use arrow::array::ffi_stream::FFI_ArrowArrayStream;
+use parquet::arrow::arrow_reader::ParquetRecordBatchReaderBuilder;
+use parquet::errors::Result;
+use std::fs::File;
+use std::os::raw::c_int;
+
+pub fn do_read(path: &str) -> Result<()> {
+    let file = File::open(path).unwrap();
+
+    // Create a sync parquet reader with batch_size.
+    // batch_size is the number of rows to read up to buffer once from pages, defaults to 1024
+    let parquet_reader = ParquetRecordBatchReaderBuilder::try_new(file)?
+        .with_batch_size(1024 * 8)
+        .build()?;
+
+    let mut rows = 0;
+    let mut batch_count = 0;
+    for batch in parquet_reader {
+        match batch {
+            Ok(batch) => {
+                // batches.push(batch);
+                rows += batch.num_rows();
+                batch_count += 1;
+            }
+            _ => {}
+        }
+    }
+
+    println!("batches: {:?}", batch_count);
+    println!("rows: {:?}", rows);
+    Ok(())
+}
+
+/// Creates a reader for a parquet file and returns a FFI_ArrowArrayStream
+/// that can be consumed by C programs.
+pub fn export_parquet_to_ffi(path: &str) -> Result<FFI_ArrowArrayStream> {
+    let file = File::open(path)?;
+
+    // Create a parquet reader
+    let reader = ParquetRecordBatchReaderBuilder::try_new(file)?
+        .with_batch_size(1024 * 8)
+        .build()?;
+
+    // Box the reader so it can be moved into the FFI_ArrowArrayStream
+    let reader_box = Box::new(reader);
+
+    // Create the FFI_ArrowArrayStream from the reader
+    Ok(FFI_ArrowArrayStream::new(reader_box))
+}
+
+/// Creates a new empty FFI_ArrowArrayStream for receiving data from C
+pub fn create_empty_stream() -> FFI_ArrowArrayStream {
+    FFI_ArrowArrayStream::empty()
+}
+
+/// Export the FFI_ArrowArrayStream into a raw pointer for C consumption
+///
+/// # Safety
+///
+/// The caller must ensure the stream is properly released
+#[no_mangle]
+pub unsafe extern "C" fn export_parquet_file_to_stream(
+    path: *const std::os::raw::c_char,
+    out_stream: *mut FFI_ArrowArrayStream,
+) -> c_int {
+    use std::ffi::CStr;
+
+    if path.is_null() || out_stream.is_null() {
+        return -1;
+    }
+
+    let c_path = CStr::from_ptr(path);
+    let path_str = match c_path.to_str() {
+        Ok(s) => s,
+        Err(_) => return -1,
+    };
+
+    match export_parquet_to_ffi(path_str) {
+        Ok(stream) => {
+            std::ptr::write(out_stream, stream);
+            0
+        }
+        Err(_) => -1,
+    }
+}
