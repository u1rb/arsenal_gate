+/// Start a new row group (flush previous row group if any)
+#[no_mangle]
+pub extern "C" fn parquet_writer_start_row_group(handle: *mut ParquetWriterHandle) -> ParquetError {
+    // Get writer
+    let writer = match get_writer_mut(handle) {
+        Ok(w) => w,
+        Err(e) => return e,
+    };
+
+    // If there's data in the current arrays, write it as a record batch
+    let mut arrays: Vec<ArrayRef> = Vec::with_capacity(writer.current_arrays.len());
+
+    for builder in &mut writer.current_arrays {
+        // Finish array and convert to ArrayRef
+        arrays.push(builder.finish());
+    }
+
+    // If we have arrays, write them
+    if !arrays.is_empty() {
+        // Create a record batch from the arrays
+        let batch = match RecordBatch::try_new(writer.schema.clone(), arrays) {
+            Ok(b) => b,
+            Err(_) => return ParquetError::ParquetGeneralError,
+        };
+
+        // Write the batch
+        if let Some(parquet_writer) = &mut writer.writer {
+            if let Err(_) = parquet_writer.write(&batch) {
+                return ParquetError::ParquetFileWriteError;
+            }
+        }
+    }
+
+    ParquetError::ParquetOk
+}
