+// Helper to create validity bitmap from boolean flags
+uint8_t *create_validity_buffer(const bool *null_flags, int64_t num_rows,
+                                int64_t *out_null_count) {
+  if (!null_flags) { // Column is not nullable
+    *out_null_count = 0;
+    int64_t valid_bytes = (num_rows + 7) / 8;
+    uint8_t *validity = (uint8_t *)calloc(valid_bytes, 1);
+    if (validity) {
+      memset(validity, 0xFF, valid_bytes); // All valid
+    }
+    return validity;
+  }
+
+  *out_null_count = 0;
+  int64_t valid_bytes = (num_rows + 7) / 8;
+  uint8_t *validity = (uint8_t *)calloc(valid_bytes, 1);
+  if (!validity) {
+    return NULL; // Allocation failed
+  }
+
+  for (int64_t i = 0; i < num_rows; i++) {
+    if (!null_flags[i]) {
+      // Set bit for non-null values
+      int byte_idx = i / 8;
+      int bit_idx = i % 8;
+      validity[byte_idx] |= (1 << bit_idx);
+    } else {
+      (*out_null_count)++;
+    }
+  }
+  return validity;
+}
