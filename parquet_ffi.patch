+        row_writer_free(writer);
+        return NULL;
+      }
+      // For string/binary, element_size from get_type_size_from_format will be
+      // the size of the offset/struct
+      if (format[0] == 'u' || format[0] == 'U')
+        element_size = sizeof(int32_t); // Offset for strings
+      else if (format[0] == 'z' || format[0] == 'Z')
+        element_size = sizeof(BinaryOffsetSize); // Offset/Size for binary
+      else { // Should not happen based on above check
+        fprintf(stderr, "Internal error: Unhandled variable type format %s\n",
+                format);
