+/// Close the writer and finalize the Parquet file
+#[no_mangle]
+pub extern "C" fn parquet_writer_close(handle: *mut ParquetWriterHandle) -> ParquetError {
+    // Get writer
+    let writer = match get_writer_mut(handle) {
+        Ok(w) => w,
+        Err(e) => return e,
+    };
+
+    info!("Closing Parquet writer");
+
+    // Flush any buffered rows
+    if writer.buffered_rows > 0 {
+        debug!("Flushing {} buffered rows before closing", writer.buffered_rows);
+        let result = parquet_writer_flush_buffer(handle);
+        if result != ParquetError::ParquetOk {
+            error!("Failed to flush buffer during close: error code {:?}", result);
+            return result;
+        }
+    }
+
+    // Take the writer out of the handle
+    if let Some(parquet_writer) = writer.writer.take() {
+        // Close the writer
+        if let Err(e) = parquet_writer.close() {
+            error!("Error closing writer: {}", e);
+            return ParquetError::ParquetFileCloseError;
+        }
+    }
+
+    // Free the handle memory
+    unsafe {
+        let _ = Box::from_raw(handle as *mut ParquetWriter);
+    }
+
+    info!("Parquet writer closed successfully");
+    ParquetError::ParquetOk
+}
