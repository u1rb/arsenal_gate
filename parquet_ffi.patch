+ *
+ * @param stream The Arrow array stream containing data to write
+ * @param path Path to the output Parquet file
+ * @return 0 on success, non-zero on error
+ */
+int write_parquet_from_ffi_stream(struct ArrowArrayStream *stream,
+                                  const char *path);
