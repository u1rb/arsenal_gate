+use std::os::raw::c_char;
+
+/// FFI Error codes
+#[repr(C)]
+#[derive(Debug, PartialEq, Eq, Clone, Copy)]
+pub enum ParquetError {
+    ParquetOk = 0,
+    ParquetFileOpenError = 1,
+    ParquetFileWriteError = 2,
+    ParquetFileReadError = 3,
+    ParquetFileCloseError = 4,
+    ParquetInvalidHandle = 5,
+    ParquetInvalidPath = 6,
+    ParquetInvalidData = 7,
+    ParquetInvalidSchema = 8,
+    ParquetMemoryError = 9,
+    ParquetGeneralError = 10,
+}
+
+/// FFI Log levels
+#[repr(C)]
+#[derive(Debug, PartialEq, Eq, Clone, Copy)]
+pub enum ParquetLogLevel {
+    ParquetLogOff = 0,
+    ParquetLogError = 1,
+    ParquetLogWarn = 2,
+    ParquetLogInfo = 3,
+    ParquetLogDebug = 4,
+    ParquetLogTrace = 5,
+}
+
+/// FFI Data types
+#[repr(C)]
+#[derive(Debug, PartialEq, Eq, Clone, Copy)]
+pub enum ParquetDataType {
+    ParquetBoolean = 0,
+    ParquetInt8 = 1,
+    ParquetInt16 = 2,
+    ParquetInt32 = 3,
+    ParquetInt64 = 4,
+    ParquetUint8 = 5,
+    ParquetUint16 = 6,
+    ParquetUint32 = 7,
+    ParquetUint64 = 8,
+    ParquetFloat = 9,
+    ParquetDouble = 10,
+    ParquetString = 11,
+    ParquetBinary = 12,
+    ParquetDate32 = 13,
+    ParquetTimestampMs = 14,
+    ParquetTimestampUs = 15,
+    ParquetTimestampNs = 16,
+}
+
+/// FFI Compression types
+#[repr(C)]
+#[derive(Debug, PartialEq, Eq, Clone, Copy)]
+pub enum ParquetCompression {
+    ParquetCompressionUncompressed = 0,
+    ParquetCompressionSnappy = 1,
+    ParquetCompressionGzip = 2,
+    ParquetCompressionLzo = 3,
+    ParquetCompressionBrotli = 4,
+    ParquetCompressionZstd = 5,
+}
+
+/// FFI Encoding types
+#[repr(C)]
+#[derive(Debug, PartialEq, Eq, Clone, Copy)]
+pub enum ParquetEncoding {
+    ParquetEncodingPlain = 0,
+    ParquetEncodingDictionary = 1,
+    ParquetEncodingRle = 2,
+    ParquetEncodingBitPacked = 3,
+    ParquetEncodingDeltaBinaryPacked = 4,
+    ParquetEncodingDeltaLengthByteArray = 5,
+    ParquetEncodingDeltaByteArray = 6,
+}
+
+/// FFI Column definition
+#[repr(C)]
+pub struct ParquetColumnDef {
+    pub name: *const c_char,
+    pub data_type: ParquetDataType,
+    pub nullable: bool,
+    pub encoding: ParquetEncoding,
+}
+
+/// FFI Opaque writer handle
+#[repr(C)]
+pub struct ParquetWriterHandle {
+    _private: [u8; 0],
+}
+
+/// FFI Opaque reader handle
+#[repr(C)]
+pub struct ParquetReaderHandle {
+    _private: [u8; 0],
+}
+
+/// FFI Row batch structure
+#[repr(C)]
+pub struct ParquetRowBatch {
+    pub num_rows: u64,
+    pub num_columns: u64,
+    pub column_data: *mut *mut std::ffi::c_void,
+    pub column_lengths: *mut u64,
+    pub null_maps: *mut u8,
+}
+
+/// FFI Writer options
+#[repr(C)]
+#[derive(Debug, Clone, Copy)]
+pub struct ParquetWriterOptions {
+    pub row_group_size: u32,
+    pub compression: ParquetCompression,
+    pub enable_dictionary: bool,
+    pub enable_statistics: bool,
+    pub enable_bloom_filter: bool,
+    pub row_buffer_size: u32,
+}
+
+/// FFI Reader options
+#[repr(C)]
+#[derive(Debug, Clone, Copy)]
+pub struct ParquetReaderOptions {
+    pub batch_size: u32,
+    pub use_threads: bool,
+    pub enable_buffering: bool,
+} 
