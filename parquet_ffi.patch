+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+// clang-format off
+#include <parquet_stream.h>
+// clang-format on
+
+// Helper function to print schema information
+void print_schema(struct ArrowSchema *schema, int indent) {
+  char indent_str[64] = {0};
+  for (int i = 0; i < indent; i++) {
+    indent_str[i] = ' ';
+  }
+
+  printf("%sField: %s, Type: %s, Nullable: %s\n", indent_str,
+         schema->name ? schema->name : "(unnamed)",
+         schema->format ? schema->format : "(unknown)",
+         (schema->flags & 1) ? "false" : "true");
+
+  for (int64_t i = 0; i < schema->n_children; i++) {
+    print_schema(schema->children[i], indent + 2);
+  }
+}
+
+// Helper function to print primitive array values without brackets for single
+// values
+void print_array_value_simple(struct ArrowArray *array,
+                              struct ArrowSchema *schema) {
+  // This function is like print_array_values but without the brackets and
+  // limited to one value
+  if (strcmp(schema->format, "i") == 0) {
+    // Int32 array
+    const int32_t *values = (const int32_t *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%d", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "c") == 0) {
+    // Int8 array
+    const int8_t *values = (const int8_t *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%d", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "C") == 0) {
+    // UInt8 array
+    const uint8_t *values = (const uint8_t *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%u", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "s") == 0) {
+    // Int16 array
+    const int16_t *values = (const int16_t *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%d", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "S") == 0) {
+    // UInt16 array
+    const uint16_t *values = (const uint16_t *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%u", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "I") == 0) {
+    // UInt32 array
+    const uint32_t *values = (const uint32_t *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%u", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "l") == 0) {
+    // Int64 array
+    const int64_t *values = (const int64_t *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%ld", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "L") == 0) {
+    // UInt64 array
+    const uint64_t *values = (const uint64_t *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%lu", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "f") == 0) {
+    // Float32 array
+    const float *values = (const float *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%g", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "g") == 0) {
+    // Float64 array
+    const double *values = (const double *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%g", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "u") == 0) {
+    // String array
+    const int32_t *offsets = (const int32_t *)array->buffers[1];
+    const uint8_t *data = (const uint8_t *)array->buffers[2];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      int32_t offset = offsets[array->offset];
+      int32_t length = offsets[array->offset + 1] - offset;
+      printf("\"");
+      for (int32_t j = 0; j < length; j++) {
+        printf("%c", data[offset + j]);
+      }
+      printf("\"");
+    }
+  } else if (strcmp(schema->format, "z") == 0) {
+    // Binary array
+    const int32_t *offsets = (const int32_t *)array->buffers[1];
+    const uint8_t *data = (const uint8_t *)array->buffers[2];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      int32_t offset = offsets[array->offset];
+      int32_t length = offsets[array->offset + 1] - offset;
+      printf("0x");
+      // Print as hex, limit to max 16 bytes for display
+      int32_t display_length = length < 8 ? length : 8;
+      for (int32_t j = 0; j < display_length; j++) {
+        printf("%02x", data[offset + j]);
+      }
+      if (length > 8) {
+        printf("...");
+      }
+    }
+  } else if (strcmp(schema->format, "b") == 0) {
+    // Boolean array
+    const uint8_t *data = (const uint8_t *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      // For booleans, the values are bit-packed too
+      printf("%s", (data[array->offset / 8] & (1 << (array->offset % 8)))
+                       ? "true"
+                       : "false");
+    }
+  } else {
+    printf("?:%s", schema->format);
+  }
+}
+
+// Helper function to print a value with limited width
+void print_value_cell(struct ArrowArray *array, struct ArrowSchema *schema,
+                      int64_t row_idx, int width) {
+  char buffer[512] = {0};
+
+  // Save original values
+  int64_t orig_length = array->length;
+  int64_t orig_offset = array->offset;
+
+  // Adjust the array to point to just one row
+  if (schema->format[0] != '+') { // Not a struct
+    // For primitive arrays, offset to the right row
+    array->offset = row_idx;
+    array->length = 1;
+  }
+
+  // Capture the output in a string
+  FILE *old_stdout = stdout;
+  FILE *temp_file = tmpfile();
+  if (!temp_file) {
+    printf("%-*s", width, "ERROR");
+    return;
+  }
+  stdout = temp_file;
+
+  // Print just one value
+  print_array_value_simple(array, schema);
+
+  // Reset stdout and read the captured output
+  stdout = old_stdout;
+  rewind(temp_file);
+  size_t bytes_read = fread(buffer, 1, sizeof(buffer) - 1, temp_file);
+  buffer[bytes_read] = '\0';
+  fclose(temp_file);
+
+  // Restore original array state
+  array->length = orig_length;
+  array->offset = orig_offset;
+
+  // Truncate if needed and print with fixed width
+  if (strlen(buffer) > width) {
+    buffer[width - 3] = '.';
+    buffer[width - 2] = '.';
+    buffer[width - 1] = '.';
+    buffer[width] = '\0';
+  }
+  printf("%-*s", width, buffer);
+}
+
+// Helper function to print a struct array (record batch)
+void print_record_batch(struct ArrowArray *array, struct ArrowSchema *schema,
+                        int max_rows) {
+  printf("Record batch with %ld rows\n", array->length);
+
+  // Column widths - adjust based on your data
+  const int COL_WIDTH = 20;
+  const int MAX_TABLE_WIDTH = 200; // Increased to allow more columns
+
+  // Calculate effective number of columns to display based on terminal width
+  int eff_cols = schema->n_children;
+  if (eff_cols * (COL_WIDTH + 1) > MAX_TABLE_WIDTH) {
+    eff_cols = MAX_TABLE_WIDTH / (COL_WIDTH + 1);
+  }
+
+  // Print the top border of the table
+  printf("+");
+  for (int i = 0; i < eff_cols; i++) {
+    for (int j = 0; j < COL_WIDTH; j++)
+      printf("-");
+    printf("+");
+  }
+  printf("\n");
+
+  // Print the header row
+  printf("|");
+  for (int64_t col = 0; col < eff_cols; col++) {
+    const char *name =
+        schema->children[col]->name ? schema->children[col]->name : "(unnamed)";
+    char truncated_name[COL_WIDTH + 1];
+    strncpy(truncated_name, name, COL_WIDTH);
+    truncated_name[COL_WIDTH] = '\0';
+    printf("%-*s|", COL_WIDTH, truncated_name);
+  }
+  printf("\n");
+
+  // Print separator
+  printf("+");
+  for (int i = 0; i < eff_cols; i++) {
+    for (int j = 0; j < COL_WIDTH; j++)
+      printf("-");
+    printf("+");
+  }
+  printf("\n");
+
+  // For each row up to max_rows
+  for (int64_t row = 0; row < array->length && row < max_rows; row++) {
+    printf("|");
+
+    // For each column
+    for (int64_t col = 0; col < eff_cols; col++) {
+      // Get the column array
+      struct ArrowArray *col_array = array->children[col];
+      struct ArrowSchema *col_schema = schema->children[col];
+
+      // Print the value with fixed width
+      print_value_cell(col_array, col_schema, row, COL_WIDTH);
+      printf("|");
+    }
+    printf("\n");
+  }
+
+  // Print the bottom border
+  printf("+");
+  for (int i = 0; i < eff_cols; i++) {
+    for (int j = 0; j < COL_WIDTH; j++)
+      printf("-");
+    printf("+");
+  }
+  printf("\n");
+
+  if (array->length > max_rows) {
+    printf("... %ld more rows\n", array->length - max_rows);
+  }
+}
+
+int main(int argc, char *argv[]) {
+  if (argc < 2) {
+    fprintf(stderr, "Usage: %s <parquet_file>\n", argv[0]);
+    return 1;
+  }
+
+  const char *parquet_file = argv[1];
+  printf("Reading Parquet file: %s using Arrow C Stream Interface\n",
+         parquet_file);
+
+  // Create an empty ArrowArrayStream
+  struct ArrowArrayStream stream = {0};
+
+  // Export the parquet file to the stream
+  int ret = export_parquet_file_to_stream(parquet_file, &stream);
+  if (ret != 0) {
+    fprintf(stderr, "Failed to export parquet file to stream: error code %d\n",
+            ret);
+    return 1;
+  }
+
+  // Get the schema
+  struct ArrowSchema schema = {0};
+  ret = stream.get_schema(&stream, &schema);
+  if (ret != 0) {
+    fprintf(stderr, "Failed to get schema: error code %d\n", ret);
+    if (stream.get_last_error) {
+      fprintf(stderr, "Error: %s\n", stream.get_last_error(&stream));
+    }
+    stream.release(&stream);
+    return 1;
+  }
+
+  // Print schema information
+  printf("\nSchema:\n");
+  print_schema(&schema, 0);
+
+  // Read record batches
+  int batch_num = 0;
+  int64_t total_rows = 0;
+
+  while (1) {
+    struct ArrowArray array = {0};
+
+    // Get next batch
+    ret = stream.get_next(&stream, &array);
+    if (ret != 0) {
+      fprintf(stderr, "Failed to get next batch: error code %d\n", ret);
+      if (stream.get_last_error) {
+        fprintf(stderr, "Error: %s\n", stream.get_last_error(&stream));
+      }
+      break;
+    }
+
+    // Check if we've reached the end of the stream
+    if (array.release == NULL) {
+      printf("\nEnd of stream reached.\n");
+      break;
+    }
+
+    // Print batch information
+    batch_num++;
+    total_rows += array.length;
+    if (batch_num < 10) {
+      printf("\nBatch %d:\n", batch_num);
+      print_record_batch(&array, &schema, 5); // Print up to 5 rows per batch
+    }
+
+    // Release the batch
+    array.release(&array);
+  }
+
+  printf("\nSummary: Read %d batches with a total of %ld rows\n", batch_num,
+         total_rows);
+
+  // Release the schema and stream
+  if (schema.release) {
+    schema.release(&schema);
+  }
+
+  stream.release(&stream);
+
+  return 0;
+}
