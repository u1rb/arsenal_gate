+    // This is tricky in a void function used by callback... maybe set a global
+    // error flag?
+    return;
+  }
+
+  // Create child schemas based on the definition
+  for (size_t i = 0; i < num_columns; ++i) {
+    schema->children[i] =
+        (struct ArrowSchema *)malloc(sizeof(struct ArrowSchema));
+    if (!schema->children[i]) {
+      fprintf(stderr, "Failed to allocate memory for schema child %zu\n", i);
