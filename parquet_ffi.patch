diff --git a/parquet_ffi/src/write_lib.rs b/parquet_ffi/src/write_lib.rs
new file mode 100644
index 0000000..99c3c71
--- /dev/null
+++ b/parquet_ffi/src/write_lib.rs
@@ -0,0 +1,121 @@
+use std::fs::File;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use arrow::array::{StructArray, UInt64Builder};
+use arrow::datatypes::DataType::UInt64;
+use arrow::datatypes::{Field, Schema};
+use clap::{Parser, ValueEnum};
+use parquet::arrow::ArrowWriter as ParquetWriter;
+use parquet::basic::Encoding;
+use parquet::errors::Result;
+use parquet::file::properties::{BloomFilterPosition, WriterProperties};
+use sysinfo::{ProcessRefreshKind, ProcessesToUpdate, RefreshKind, System};
+
+#[derive(ValueEnum, Clone)]
+enum BloomFilterPositionArg {
+    End,
+    AfterRowGroup,
+}
+
+#[derive(Parser)]
+#[command(version)]
+/// Writes sequences of integers, with a Bloom Filter, while logging timing and memory usage.
+pub struct Args {
+    #[arg(long, default_value_t = 1000)]
+    /// Number of batches to write
+    iterations: u64,
+
+    #[arg(long, default_value_t = 1000000)]
+    /// Number of rows in each batch
+    batch: u64,
+
+    #[arg(long, value_enum, default_value_t=BloomFilterPositionArg::AfterRowGroup)]
+    /// Where to write Bloom Filters
+    bloom_filter_position: BloomFilterPositionArg,
+
+    /// Path to the file to write
+    path: PathBuf,
+}
+
+fn now() -> String {
+    chrono::Local::now().format("%Y-%m-%d %H:%M:%S").to_string()
+}
+
+fn mem(system: &mut System) -> String {
+    let pid = match sysinfo::get_current_pid() {
+        Ok(pid) => pid,
+        Err(e) => return format!("Can't get process PID: {e}"),
+    };
+
+    let remove_dead_processes = true;
+    system.refresh_processes_specifics(
+        ProcessesToUpdate::Some(&[pid]),
+        remove_dead_processes,
+        ProcessRefreshKind::everything(),
+    );
+
+    system
+        .process(pid)
+        .map(|proc| format!("{}MB", proc.memory() / 1_000_000))
+        .unwrap_or("N/A".to_string())
+}
+
+pub fn do_write(args: Args) -> Result<()> {
+    let bloom_filter_position = match args.bloom_filter_position {
+        BloomFilterPositionArg::End => BloomFilterPosition::End,
+        BloomFilterPositionArg::AfterRowGroup => BloomFilterPosition::AfterRowGroup,
+    };
+
+    let properties = WriterProperties::builder()
+        .set_column_bloom_filter_enabled("id".into(), true)
+        .set_column_encoding("id".into(), Encoding::DELTA_BINARY_PACKED)
+        .set_bloom_filter_position(bloom_filter_position)
+        .build();
+    let schema = Arc::new(Schema::new(vec![Field::new("id", UInt64, false)]));
+    // Create parquet file that will be read.
+    let file = File::create(args.path).unwrap();
+    let mut writer = ParquetWriter::try_new(file, schema.clone(), Some(properties))?;
+
+    let mut system = System::new_with_specifics(RefreshKind::everything());
+    eprintln!(
+        "{} Writing {} batches of {} rows. RSS = {}",
+        now(),
+        args.iterations,
+        args.batch,
+        mem(&mut system)
+    );
+
+    let mut array_builder = UInt64Builder::new();
+    let mut last_log = Instant::now();
+    for i in 0..args.iterations {
+        if Instant::now() - last_log > Duration::new(10, 0) {
+            last_log = Instant::now();
+            eprintln!(
+                "{} Iteration {}/{}. RSS = {}",
+                now(),
+                i + 1,
+                args.iterations,
+                mem(&mut system)
+            );
+        }
+        for j in 0..args.batch {
+            array_builder.append_value(i + j);
+        }
+        writer.write(
+            &StructArray::new(
+                schema.fields().clone(),
+                vec![Arc::new(array_builder.finish())],
+                None,
+            )
+            .into(),
+        )?;
+    }
+    writer.flush()?;
+    writer.close()?;
+
+    eprintln!("{} Done. RSS = {}", now(), mem(&mut system));
+
+    Ok(())
+}
diff --git a/parquet_ffi/src/write_stream_lib.rs b/parquet_ffi/src/write_stream_lib.rs
new file mode 100644
index 0000000..6900c65
--- /dev/null
+++ b/parquet_ffi/src/write_stream_lib.rs
@@ -0,0 +1,230 @@
+use arrow::array::ffi_stream::{ArrowArrayStreamReader, FFI_ArrowArrayStream};
+use arrow::error::ArrowError;
+use parquet::arrow::ArrowWriter;
+use parquet::file::properties::WriterProperties;
+use std::ffi::{c_void, CStr};
+use std::fs::File;
+use std::os::raw::{c_char, c_int};
+
+// Struct to hold the state of the Parquet writer across FFI calls
+struct ParquetStreamWriterState {
+    writer: ArrowWriter<File>,
+    path: String, // Store path for error messages
+    total_rows: usize,
+    batch_count: usize,
+}
+
+/// Helper to read the next batch from a raw stream pointer.
+/// Takes ownership and releases the stream if an error occurs during batch read.
+unsafe fn read_next_batch(
+    stream_ptr: *mut FFI_ArrowArrayStream,
+) -> Result<Option<arrow::record_batch::RecordBatch>, ArrowError> {
+    let stream = FFI_ArrowArrayStream::from_raw(stream_ptr);
+    let mut reader = ArrowArrayStreamReader::try_new(stream)?;
+    let batch_result = reader.next().transpose();
+    // If there's an error reading the batch, the original stream will be dropped
+    // by the reader, releasing it.
+    // If successful (Some or None), we need to prevent the reader from dropping the stream,
+    // so we forget the reader.
+    if batch_result.is_ok() {
+        std::mem::forget(reader);
+    }
+    batch_result
+}
+
+/// C-compatible function to initialize a Parquet writer and write the first batch.
+/// Returns an opaque pointer (`void*`) to the writer state.
+#[no_mangle]
+pub unsafe extern "C" fn parquet_stream_writer_init(
+    stream_ptr: *mut FFI_ArrowArrayStream,
+    path_ptr: *const c_char,
+) -> *mut c_void {
+    if stream_ptr.is_null() || path_ptr.is_null() {
+        eprintln!("parquet_stream_writer_init: received null pointer");
+        return std::ptr::null_mut();
+    }
+
+    // Convert C string to Rust string
+    let path_str = match CStr::from_ptr(path_ptr).to_str() {
+        Ok(s) => s.to_string(),
+        Err(e) => {
+            eprintln!("parquet_stream_writer_init: Invalid path string: {}", e);
+            // Manually release the stream if path is invalid
+            let stream = FFI_ArrowArrayStream::from_raw(stream_ptr);
+            if let Some(release) = stream.release {
+                release(stream_ptr);
+            }
+            return std::ptr::null_mut();
+        }
+    };
+
+    // Take ownership and read the first batch
+    // We need the schema from the first batch to initialize the writer.
+    let first_batch = match read_next_batch(stream_ptr) {
+        Ok(Some(batch)) => batch,
+        Ok(None) => {
+            eprintln!(
+                "parquet_stream_writer_init: Stream for '{}' was empty, cannot initialize writer.",
+                path_str
+            );
+            // Stream is released by read_next_batch on Ok(None)
+            return std::ptr::null_mut();
+        }
+        Err(e) => {
+            eprintln!(
+                "parquet_stream_writer_init: Error reading first batch from stream for '{}': {}",
+                path_str, e
+            );
+            // Stream is released by read_next_batch on Err
+            return std::ptr::null_mut();
+        }
+    };
+
+    let schema = first_batch.schema();
+
+    // Create writer properties
+    let props = WriterProperties::builder()
+        .set_compression(parquet::basic::Compression::SNAPPY)
+        .set_dictionary_enabled(false)
+        .set_max_row_group_size(1048576)
+        .build();
+
+    // Create Parquet file and writer
+    let file = match File::create(&path_str) {
+        Ok(f) => f,
+        Err(e) => {
+            eprintln!(
+                "parquet_stream_writer_init: Error creating file '{}': {}",
+                path_str, e
+            );
+            return std::ptr::null_mut(); // Batch/Schema are dropped, resources cleaned up
+        }
+    };
+
+    let mut writer = match ArrowWriter::try_new(file, schema, Some(props)) {
+        Ok(w) => w,
+        Err(e) => {
+            eprintln!(
+                "parquet_stream_writer_init: Error creating parquet writer for '{}': {}",
+                path_str, e
+            );
+            return std::ptr::null_mut();
+        }
+    };
+
+    // Write the first batch
+    let rows = first_batch.num_rows();
+    let batch_count = 1;
+    if let Err(e) = writer.write(&first_batch) {
+        eprintln!(
+            "parquet_stream_writer_init: Error writing first batch to '{}': {}",
+            path_str, e
+        );
+        // Close the writer to attempt to finalize the file partially
+        let _ = writer.close();
+        return std::ptr::null_mut();
+    }
+
+    // println!(
+    //     "parquet_stream_writer_init: Wrote batch {} with {} rows to '{}'",
+    //     batch_count, rows, path_str
+    // );
+
+    // Create state struct
+    let state = ParquetStreamWriterState {
+        writer,
+        path: path_str,
+        total_rows: rows,
+        batch_count,
+    };
+
+    // Box it and return the raw pointer cast to void*
+    Box::into_raw(Box::new(state)) as *mut c_void
+}
+
+/// C-compatible function to write a subsequent batch to an initialized Parquet writer.
+#[no_mangle]
+pub unsafe extern "C" fn parquet_stream_writer_write_batch(
+    state_ptr_void: *mut c_void, // Accept void*
+    stream_ptr: *mut FFI_ArrowArrayStream,
+) -> c_int {
+    if state_ptr_void.is_null() || stream_ptr.is_null() {
+        eprintln!("parquet_stream_writer_write_batch: received null pointer");
+        return -1;
+    }
+
+    // Cast void* back to the concrete type
+    let state_ptr = state_ptr_void as *mut ParquetStreamWriterState;
+    // Get a mutable reference to the state without taking ownership
+    let state = &mut *state_ptr;
+
+    // Read the next batch from the stream
+    let batch = match read_next_batch(stream_ptr) {
+        Ok(Some(batch)) => batch,
+        Ok(None) => {
+            // This indicates the end of the stream for this specific batch flush,
+            // which shouldn't happen if C side checks current_row > 0 before calling.
+            // If it does happen, it's not an error, just nothing to write.
+            // Stream is released by read_next_batch
+            return 0; // Indicate success (nothing to write)
+        }
+        Err(e) => {
+            eprintln!(
+                "parquet_stream_writer_write_batch: Error reading batch from stream for '{}': {}",
+                state.path, e
+            );
+            // Stream is released by read_next_batch on Err
+            return -1; // Indicate error
+        }
+    };
+
+    // Write the batch
+    let rows = batch.num_rows();
+    state.batch_count += 1;
+    if let Err(e) = state.writer.write(&batch) {
+        eprintln!(
+            "parquet_stream_writer_write_batch: Error writing batch {} to '{}': {}",
+            state.batch_count, state.path, e
+        );
+        return -1; // Indicate error
+    }
+
+    state.total_rows += rows;
+    // println!(
+    //     "parquet_stream_writer_write_batch: Wrote batch {} with {} rows (total: {} rows) to '{}'",
+    //     state.batch_count, rows, state.total_rows, state.path
+    // );
+
+    0 // Indicate success
+}
+
+/// C-compatible function to close the Parquet writer and free resources.
+#[no_mangle]
+pub unsafe extern "C" fn parquet_stream_writer_close(
+    state_ptr_void: *mut c_void, // Accept void*
+) -> c_int {
+    if state_ptr_void.is_null() {
+        return 0; // Nothing to close
+    }
+
+    // Cast void* back and take ownership of the Box to close and drop
+    let state_ptr = state_ptr_void as *mut ParquetStreamWriterState;
+    let state = Box::from_raw(state_ptr);
+
+    println!(
+        "parquet_stream_writer_close: Closing '{}'. Total rows: {}, Total batches: {}",
+        state.path, state.total_rows, state.batch_count
+    );
+
+    match state.writer.close() {
+        Ok(_) => 0, // Indicate success
+        Err(e) => {
+            eprintln!(
+                "parquet_stream_writer_close: Error closing writer for '{}': {}",
+                state.path, e
+            );
+            -1 // Indicate error
+        }
+    }
+    // state is dropped here, closing the file
+}
