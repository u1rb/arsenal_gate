@@ -0,0 +1,1079 @@
+use std::ffi::{c_char, CStr};
+use std::fs::File;
+use std::path::Path;
+use std::ptr::null_mut;
+use std::sync::Arc;
+use libc::size_t;
+use tracing::{debug, error, info};
+
+use arrow::array::{
+    ArrayBuilder, ArrayRef, BooleanBuilder, Float32Builder,
+    Float64Builder, Int32Builder, Int64Builder, Int8Builder, StringBuilder,
+    UInt32Builder, UInt64Builder, UInt8Builder, PrimitiveBuilder, BinaryBuilder,
+};
+use arrow::datatypes::{DataType, Field, Schema, ArrowPrimitiveType};
+use arrow::record_batch::RecordBatch;
+use parquet::arrow::ArrowWriter;
+use parquet::basic::{BrotliLevel, Compression, Encoding, GzipLevel, ZstdLevel};
+use parquet::file::properties::{EnabledStatistics, WriterProperties};
+
+use crate::ffi::types::{
+    ParquetColumnDef, ParquetCompression, ParquetDataType, ParquetError, ParquetWriterHandle,
+    ParquetWriterOptions, ParquetEncoding,
+};
+
+/// Structure that holds writer state
+pub struct ParquetWriter {
+    writer: Option<ArrowWriter<File>>,
+    schema: Arc<Schema>,
+    current_arrays: Vec<Box<dyn ArrayBuilder>>,
+    column_types: Vec<ParquetDataType>,
+    buffered_rows: usize,            // Number of rows currently buffered
+    row_buffer_size: usize,          // Max number of rows to buffer before auto-flush
+}
+
+/// Convert a C-string to a Rust String
+fn c_char_to_string(ptr: *const c_char) -> Result<String, ParquetError> {
+    if ptr.is_null() {
+        error!("Invalid path: null pointer");
+        return Err(ParquetError::ParquetInvalidPath);
+    }
+
+    let c_str = unsafe { CStr::from_ptr(ptr) };
+    match c_str.to_str() {
+        Ok(s) => Ok(s.to_string()),
+        Err(_) => {
+            error!("Invalid path: not valid UTF-8");
+            Err(ParquetError::ParquetInvalidPath)
+        }
+    }
+}
+
+/// Convert from ParquetCompression to Parquet Compression
+fn to_parquet_compression(compression: ParquetCompression) -> Compression {
+    match compression {
+        ParquetCompression::ParquetCompressionUncompressed => Compression::UNCOMPRESSED,
+        ParquetCompression::ParquetCompressionSnappy => Compression::SNAPPY,
+        ParquetCompression::ParquetCompressionGzip => Compression::GZIP(GzipLevel::default()),
+        ParquetCompression::ParquetCompressionLzo => Compression::LZO,
+        ParquetCompression::ParquetCompressionBrotli => Compression::BROTLI(BrotliLevel::default()),
+        ParquetCompression::ParquetCompressionZstd => Compression::ZSTD(ZstdLevel::default()),
+    }
+}
+
+/// Convert from ParquetEncoding to Parquet Encoding
+fn to_parquet_encoding(encoding: ParquetEncoding) -> Encoding {
+    match encoding {
+        ParquetEncoding::ParquetEncodingPlain => Encoding::PLAIN,
+        ParquetEncoding::ParquetEncodingDictionary => Encoding::PLAIN,
+        ParquetEncoding::ParquetEncodingRle => Encoding::RLE,
+        ParquetEncoding::ParquetEncodingBitPacked => Encoding::RLE_DICTIONARY,
+        ParquetEncoding::ParquetEncodingDeltaBinaryPacked => Encoding::DELTA_BINARY_PACKED,
+        ParquetEncoding::ParquetEncodingDeltaLengthByteArray => Encoding::DELTA_LENGTH_BYTE_ARRAY,
+        ParquetEncoding::ParquetEncodingDeltaByteArray => Encoding::DELTA_BYTE_ARRAY,
+    }
+}
+
+/// Convert from ParquetDataType to Arrow DataType
+fn to_arrow_data_type(data_type: ParquetDataType) -> DataType {
+    match data_type {
+        ParquetDataType::ParquetBoolean => DataType::Boolean,
+        ParquetDataType::ParquetInt8 => DataType::Int8,
+        ParquetDataType::ParquetInt16 => DataType::Int16,
+        ParquetDataType::ParquetInt32 => DataType::Int32,
+        ParquetDataType::ParquetInt64 => DataType::Int64,
+        ParquetDataType::ParquetUint8 => DataType::UInt8,
+        ParquetDataType::ParquetUint16 => DataType::UInt16,
+        ParquetDataType::ParquetUint32 => DataType::UInt32,
+        ParquetDataType::ParquetUint64 => DataType::UInt64,
+        ParquetDataType::ParquetFloat => DataType::Float32,
+        ParquetDataType::ParquetDouble => DataType::Float64,
+        ParquetDataType::ParquetString => DataType::Utf8,
+        ParquetDataType::ParquetBinary => DataType::Binary,
+        ParquetDataType::ParquetDate32 => DataType::Date32,
+        ParquetDataType::ParquetTimestampMs => {
+            DataType::Timestamp(arrow::datatypes::TimeUnit::Millisecond, None)
+        }
+        ParquetDataType::ParquetTimestampUs => {
+            DataType::Timestamp(arrow::datatypes::TimeUnit::Microsecond, None)
+        }
+        ParquetDataType::ParquetTimestampNs => {
+            DataType::Timestamp(arrow::datatypes::TimeUnit::Nanosecond, None)
+        }
+    }
+}
+
+/// Create a new array builder based on data type
+fn create_array_builder(data_type: ParquetDataType) -> Box<dyn ArrayBuilder> {
+    match data_type {
+        ParquetDataType::ParquetBoolean => Box::new(BooleanBuilder::new()),
+        ParquetDataType::ParquetInt8 => Box::new(Int8Builder::new()),
+        ParquetDataType::ParquetInt32 => Box::new(Int32Builder::new()),
+        ParquetDataType::ParquetInt64 => Box::new(Int64Builder::new()),
+        ParquetDataType::ParquetUint8 => Box::new(UInt8Builder::new()),
+        ParquetDataType::ParquetUint32 => Box::new(UInt32Builder::new()),
+        ParquetDataType::ParquetUint64 => Box::new(UInt64Builder::new()),
+        ParquetDataType::ParquetFloat => Box::new(Float32Builder::new()),
+        ParquetDataType::ParquetDouble => Box::new(Float64Builder::new()),
+        ParquetDataType::ParquetString => Box::new(StringBuilder::new()),
+        ParquetDataType::ParquetBinary => Box::new(BinaryBuilder::new()),
+        // For other types, we'd add more builders or handle conversions
+        _ => Box::new(StringBuilder::new()), // Default for now
+    }
+}
+
+/// Create a new Parquet writer
+#[no_mangle]
+pub extern "C" fn parquet_writer_open(
+    path: *const c_char,
+    columns: *const ParquetColumnDef,
+    num_columns: usize,
+    options: ParquetWriterOptions,
+    handle: *mut *mut ParquetWriterHandle,
+) -> ParquetError {
+    // Check parameters
+    if path.is_null() {
+        error!("Invalid path: null pointer");
+        return ParquetError::ParquetInvalidPath;
+    }
+    if columns.is_null() || num_columns == 0 {
+        error!("Invalid schema: null columns or zero columns");
+        return ParquetError::ParquetInvalidSchema;
+    }
+    if handle.is_null() {
+        error!("Invalid handle: null pointer");
+        return ParquetError::ParquetInvalidHandle;
+    }
+
+    // Set handle to null initially
+    unsafe { *handle = null_mut() };
+
+    // Get the file path
+    let path_str = match c_char_to_string(path) {
+        Ok(s) => s,
+        Err(e) => return e,
+    };
+    let path_obj = Path::new(&path_str);
+    info!("Opening Parquet writer for file: {}", path_str);
+
+    // Create the Arrow schema from column definitions
+    let mut fields = Vec::with_capacity(num_columns);
+    let mut column_types = Vec::with_capacity(num_columns);
+    let mut current_arrays = Vec::with_capacity(num_columns);
+    let mut column_encodings = Vec::with_capacity(num_columns);
+
+    // Read the column definitions from C
+    let columns_slice = unsafe { std::slice::from_raw_parts(columns, num_columns) };
+
+    for col in columns_slice {
+        // Get column name
+        let name = match c_char_to_string(col.name) {
+            Ok(s) => s,
+            Err(e) => return e,
+        };
+
+        // Convert to Arrow data type
+        let data_type = to_arrow_data_type(col.data_type);
+
+        // Create field with nullable flag
+        fields.push(Field::new(&name, data_type, col.nullable));
+
+        // Store column type for later reference
+        column_types.push(col.data_type);
+        
+        // Store column encoding for later reference
+        column_encodings.push(col.encoding);
+
+        // Create array builder for this type
+        current_arrays.push(create_array_builder(col.data_type));
+    }
+
+    // Create Arrow schema
+    let schema = Arc::new(Schema::new(fields));
+
+    // Create Parquet writer properties
+    let mut props_builder =
+        WriterProperties::builder().set_compression(to_parquet_compression(options.compression));
+
+    // Set dictionary encoding based on option
+    if options.enable_dictionary {
+        props_builder = props_builder.set_dictionary_enabled(true);
+    } else {
+        props_builder = props_builder.set_dictionary_enabled(false);
+    }
+
+    // Set statistics based on option
+    if options.enable_statistics {
+        props_builder = props_builder.set_statistics_enabled(EnabledStatistics::Page);
+    } else {
+        props_builder = props_builder.set_statistics_enabled(EnabledStatistics::None);
+    }
+
+    // Enable/disable bloom filters and set encodings
+    for (i, field) in schema.fields().iter().enumerate() {
+        if options.enable_bloom_filter {
+            props_builder =
+                props_builder.set_column_bloom_filter_enabled(field.name().clone().into(), true);
+        }
+
+        // Set the encoding from the column definition
+        let encoding = to_parquet_encoding(column_encodings[i]);
+        props_builder = props_builder.set_column_encoding(field.name().clone().into(), encoding);
+    }
+
+    let props = props_builder.build();
+
+    // Open file for writing
+    let file = match File::create(path_obj) {
+        Ok(f) => f,
+        Err(e) => {
+            error!("Failed to create file {}: {}", path_str, e);
+            return ParquetError::ParquetFileOpenError;
+        }
+    };
+
+    // Create the Arrow writer
+    let writer = match ArrowWriter::try_new(file, schema.clone(), Some(props)) {
+        Ok(w) => w,
+        Err(e) => {
+            error!("Failed to create Arrow writer: {}", e);
+            return ParquetError::ParquetFileWriteError;
+        }
+    };
+
+    // Create and box our writer handle
+    let parquet_writer = ParquetWriter {
+        writer: Some(writer),
+        schema,
+        current_arrays,
+        column_types,
+        buffered_rows: 0,
+        row_buffer_size: if options.row_buffer_size > 0 { 
+            options.row_buffer_size as usize 
+        } else { 
+            1000 // Default to 1000 rows if not specified
+        },
+    };
+
+    let boxed_writer = Box::new(parquet_writer);
+
+    // Return the handle
+    unsafe {
+        *handle = Box::into_raw(boxed_writer) as *mut ParquetWriterHandle;
+    }
+    
+    info!("Parquet writer created successfully for {}", path_str);
+    ParquetError::ParquetOk
+}
+
+/// Get a mutable reference to the writer from a handle
+fn get_writer_mut(
+    handle: *mut ParquetWriterHandle,
+) -> Result<&'static mut ParquetWriter, ParquetError> {
+    unsafe {
+        if handle.is_null() {
+            error!("Invalid handle: null pointer");
+            return Err(ParquetError::ParquetInvalidHandle);
+        }
+
+        let writer = &mut *(handle as *mut ParquetWriter);
+        if writer.writer.is_none() {
+            error!("Invalid handle: writer is None");
+            return Err(ParquetError::ParquetInvalidHandle);
+        }
+
+        Ok(writer)
+    }
+}
