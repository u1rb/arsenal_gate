+#pragma once
+
+#include <stdbool.h> // for bool
+#include <stddef.h>  // for size_t
+#include <stdint.h>  // for uint8_t, int64_t, etc.
+
+#include "arrow_c.h"
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/*
+ * Error codes for the Parquet FFI interface
+ */
+typedef enum ParquetError {
+  ParquetOk = 0,
+  ParquetFileOpenError = 1,
+  ParquetFileWriteError = 2,
+  ParquetFileReadError = 3,
+  ParquetFileCloseError = 4,
+  ParquetInvalidHandle = 5,
+  ParquetInvalidPath = 6,
+  ParquetInvalidData = 7,
+  ParquetInvalidSchema = 8,
+  ParquetMemoryError = 9,
+  ParquetGeneralError = 10
+} ParquetError;
+
+/*
+ * Log levels for tracing
+ */
+typedef enum ParquetLogLevel {
+  ParquetLogOff = 0,
+  ParquetLogError = 1,
+  ParquetLogWarn = 2,
+  ParquetLogInfo = 3,
+  ParquetLogDebug = 4,
+  ParquetLogTrace = 5
+} ParquetLogLevel;
+
+/*
+ * Data types supported for Parquet columns
+ */
+typedef enum ParquetDataType {
+  ParquetBoolean = 0,
+  ParquetInt8 = 1,
+  ParquetInt16 = 2,
+  ParquetInt32 = 3,
+  ParquetInt64 = 4,
+  ParquetUint8 = 5,
+  ParquetUint16 = 6,
+  ParquetUint32 = 7,
+  ParquetUint64 = 8,
+  ParquetFloat = 9,
+  ParquetDouble = 10,
+  ParquetString = 11,
+  ParquetBinary = 12,
+  ParquetDate32 = 13,
+  ParquetTimestampMs = 14,
+  ParquetTimestampUs = 15,
+  ParquetTimestampNs = 16
+} ParquetDataType;
+
+/*
+ * Compression types for Parquet files
+ */
+typedef enum ParquetCompression {
+  ParquetCompressionUncompressed = 0,
+  ParquetCompressionSnappy = 1,
+  ParquetCompressionGzip = 2,
+  ParquetCompressionLzo = 3,
+  ParquetCompressionBrotli = 4,
+  ParquetCompressionZstd = 5
+} ParquetCompression;
+
+/*
+ * Encoding types for Parquet columns
+ */
+typedef enum ParquetEncoding {
+  ParquetEncodingPlain = 0,
+  ParquetEncodingDictionary = 1,
+  ParquetEncodingRle = 2,
+  ParquetEncodingBitPacked = 3,
+  ParquetEncodingDeltaBinaryPacked = 4,
+  ParquetEncodingDeltaLengthByteArray = 5,
+  ParquetEncodingDeltaByteArray = 6
+} ParquetEncoding;
+
+/*
+ * Column definition for creating Parquet schema
+ */
+typedef struct ParquetColumnDef {
+  const char *name;
+  ParquetDataType data_type;
+  bool nullable;
+  ParquetEncoding encoding;
+} ParquetColumnDef;
+
+/*
+ * Opaque handles for writer and reader
+ */
+typedef struct ParquetWriterHandle ParquetWriterHandle;
+typedef struct ParquetReaderHandle ParquetReaderHandle;
+
+/*
+ * Row batch structure for reading data
+ */
+typedef struct ParquetRowBatch {
+  uint64_t num_rows;
+  uint64_t num_columns;
+  void **column_data;
+  uint64_t *column_lengths;
+  uint8_t *null_maps;
+} ParquetRowBatch;
+
+/*
+ * Writer configuration options
+ */
+typedef struct ParquetWriterOptions {
+  uint32_t row_group_size;
+  ParquetCompression compression;
+  bool enable_dictionary;
+  bool enable_statistics;
+  bool enable_bloom_filter;
+  uint32_t row_buffer_size; // Number of rows to buffer before automatically
+                            // writing a batch
+} ParquetWriterOptions;
+
+/*
+ * Reader configuration options
+ */
+typedef struct ParquetReaderOptions {
+  uint32_t batch_size;
+  bool use_threads;
+  bool enable_buffering;
+} ParquetReaderOptions;
+
+/*
+ * Tracing functions
+ */
+
+/**
+ * Initialize tracing with a specific log level string
+ * Valid levels: "off", "error", "warn", "info", "debug", "trace"
+ *
+ * @param level Log level string (NULL for default "info" level)
+ */
+void parquet_init_tracing(const char *level);
+
+/**
+ * Initialize tracing with a specific log level enum
+ *
+ * @param level Log level enum value
+ */
+void parquet_init_tracing_with_level(ParquetLogLevel level);
+
+/*
+ * Writer functions
+ */
+
+/**
+ * Create a new Parquet writer with the specified schema
+ *
+ * @param path Path to the output file
+ * @param columns Array of column definitions
+ * @param num_columns Number of columns in the schema
+ * @param options Writer configuration options
+ * @param handle Output parameter to receive the writer handle
+ * @return Error code
+ */
+ParquetError parquet_writer_open(const char *path, ParquetColumnDef *columns,
+                                 size_t num_columns,
+                                 ParquetWriterOptions options,
+                                 ParquetWriterHandle **handle);
+
+/**
+ * Begin a new row group in the Parquet file
+ *
+ * @param handle Writer handle
+ * @return Error code
+ */
+ParquetError parquet_writer_start_row_group(ParquetWriterHandle *handle);
+
+/**
+ * Write primitive values to a column using a generic interface
+ *
+ * @param handle Writer handle
+ * @param column_index Index of the column to write to
+ * @param data_type The type of data being written (must match column's type)
+ * @param values Pointer to array of values (cast to appropriate type based on
+ * data_type)
+ * @param num_values Number of values to write
+ * @param valid_bits Bitmap indicating null values (0 = null), can be NULL if
+ * all values are valid
+ * @return Error code
+ */
+ParquetError parquet_writer_write_primitive_column(
+    ParquetWriterHandle *handle, size_t column_index, ParquetDataType data_type,
+    const void *values, size_t num_values, const uint8_t *valid_bits);
+
+/**
+ * Write a single row to the Parquet file
+ * Values are automatically buffered and written as batches when buffer size is
+ * reached
+ *
+ * @param handle Writer handle
+ * @param values Array of pointers to column values (must match schema order)
+ * @param is_valid Array of boolean flags indicating value validity (NULL = all
+ * valid)
+ * @return Error code
+ */
+ParquetError parquet_writer_write_row(ParquetWriterHandle *handle,
+                                      const void **values,
+                                      const bool *is_valid);
+
+/**
+ * Flush any buffered rows to the Parquet file
+ *
+ * @param handle Writer handle
+ * @return Error code
+ */
+ParquetError parquet_writer_flush_buffer(ParquetWriterHandle *handle);
+
+/**
+ * Finish the current row group
+ *
+ * @param handle Writer handle
+ * @return Error code
+ */
+ParquetError parquet_writer_end_row_group(ParquetWriterHandle *handle);
+
+/**
+ * Close the writer and finalize the Parquet file
+ *
+ * @param handle Writer handle
+ * @return Error code
+ */
+ParquetError parquet_writer_close(ParquetWriterHandle *handle);
+
+/*
+ * Reader functions
+ */
+
+/**
+ * Open a Parquet file for reading
+ *
+ * @param path Path to the Parquet file
+ * @param options Reader configuration options
+ * @param handle Output parameter to receive the reader handle
+ * @return Error code
+ */
+ParquetError parquet_reader_open(const char *path, ParquetReaderOptions options,
+                                 ParquetReaderHandle **handle);
+
+/**
+ * Get the number of rows in the Parquet file
+ *
+ * @param handle Reader handle
+ * @param num_rows Output parameter to receive the number of rows
+ * @return Error code
+ */
+ParquetError parquet_reader_get_num_rows(ParquetReaderHandle *handle,
+                                         uint64_t *num_rows);
+
+/**
+ * Get the number of columns in the Parquet file
+ *
+ * @param handle Reader handle
+ * @param num_columns Output parameter to receive the number of columns
+ * @return Error code
+ */
+ParquetError parquet_reader_get_num_columns(ParquetReaderHandle *handle,
+                                            uint64_t *num_columns);
+
+/**
+ * Get the schema of the Parquet file
+ *
+ * @param handle Reader handle
+ * @param columns Output parameter to receive column definitions (caller must
+ * free)
+ * @param num_columns Output parameter to receive the number of columns
+ * @return Error code
+ */
+ParquetError parquet_reader_get_schema(ParquetReaderHandle *handle,
+                                       ParquetColumnDef **columns,
+                                       size_t *num_columns);
+
+/**
+ * Read the next batch of rows from the Parquet file
+ *
+ * @param handle Reader handle
+ * @param batch Output parameter to receive the batch data
+ * @return Error code
+ */
+ParquetError parquet_reader_read_next_batch(ParquetReaderHandle *handle,
+                                            ParquetRowBatch *batch);
+
+/**
+ * Free resources associated with a row batch
+ *
+ * @param batch The batch to free
+ * @return Error code
+ */
+ParquetError parquet_reader_free_batch(ParquetRowBatch *batch);
+
+/**
+ * Free memory allocated specifically for variable-length data (strings,
+ * binaries) within a row batch. This should be called before
+ * parquet_reader_free_batch if string or binary columns are present.
+ *
+ * @param batch The batch containing data to free
+ * @param columns Array of column definitions for the schema
+ * @param num_columns Number of columns in the schema
+ * @return Error code
+ */
+ParquetError parquet_reader_free_batch_data(ParquetRowBatch *batch,
+                                            const ParquetColumnDef *columns,
+                                            size_t num_columns);
+
+/**
+ * Close the reader and free resources
+ *
+ * @param handle Reader handle
+ * @return Error code
+ */
+ParquetError parquet_reader_close(ParquetReaderHandle *handle);
+
+/**
+ * Export a Parquet file to an Arrow C Stream Interface
+ * This allows for efficient reading of Parquet data using the Arrow C Data
+ * Interface
+ *
+ * @param path Path to the Parquet file
+ * @param out_stream Output parameter to receive the Arrow array stream
+ * @return 0 on success, non-zero on error
+ */
+int export_parquet_file_to_stream(const char *path,
+                                  struct ArrowArrayStream *out_stream);
+
+/**
+ * Write data from an Arrow C Stream Interface to a Parquet file
