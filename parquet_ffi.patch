new file mode 100644
index 0000000..040e9f0
--- /dev/null
+++ b/parquet_ffi/cxx_examples/read_example.c
@@ -0,0 +1,249 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdbool.h>
+#include <parquet_ffi.h>
+
+// Helper function to print binary data in hex format
+void print_binary_hex(const uint8_t* data, size_t length, size_t max_bytes) {
+    printf("0x");
+    size_t display_length = length < max_bytes ? length : max_bytes;
+    for (size_t i = 0; i < display_length; i++) {
+        printf("%02x", data[i]);
+    }
+    if (length > max_bytes) {
+        printf("... (%zu bytes total)", length);
+    }
+}
+
+void print_data_type(ParquetDataType type) {
+    switch (type) {
+        case ParquetBoolean: printf("Boolean"); break;
+        case ParquetInt8: printf("Int8"); break;
+        case ParquetInt16: printf("Int16"); break;
+        case ParquetInt32: printf("Int32"); break;
+        case ParquetInt64: printf("Int64"); break;
+        case ParquetUint8: printf("UInt8"); break;
+        case ParquetUint16: printf("UInt16"); break;
+        case ParquetUint32: printf("UInt32"); break;
+        case ParquetUint64: printf("UInt64"); break;
+        case ParquetFloat: printf("Float"); break;
+        case ParquetDouble: printf("Double"); break;
+        case ParquetString: printf("String"); break;
+        case ParquetBinary: printf("Binary"); break;
+        case ParquetDate32: printf("Date32"); break;
+        case ParquetTimestampMs: printf("Timestamp(ms)"); break;
+        case ParquetTimestampUs: printf("Timestamp(us)"); break;
+        case ParquetTimestampNs: printf("Timestamp(ns)"); break;
+        default: printf("Unknown"); break;
+    }
+}
+
+int main(int argc, char* argv[]) {
+    if (argc < 2) {
+        fprintf(stderr, "Usage: %s <parquet_file>\n", argv[0]);
+        return 1;
+    }
+    
+    const char* parquet_file = argv[1];
+
+    parquet_init_tracing_with_level(ParquetLogError);
+    
+    // Configure reader options
+    ParquetReaderOptions options;
+    options.batch_size = 4096;
+    options.use_threads = false;
+    options.enable_buffering = true;
+    
+    // Open the reader
+    ParquetReaderHandle* reader;
+    ParquetError error = parquet_reader_open(parquet_file, options, &reader);
+    if (error != ParquetOk) {
+        fprintf(stderr, "Failed to open parquet file: error code %d\n", error);
+        return 1;
+    }
+    
+    printf("Parquet file opened successfully\n");
+    
+    // Get the number of rows and columns
+    uint64_t num_rows = 0;
+    uint64_t num_columns = 0;
+    
+    error = parquet_reader_get_num_rows(reader, &num_rows);
+    if (error != ParquetOk) {
+        fprintf(stderr, "Failed to get row count: error code %d\n", error);
+        parquet_reader_close(reader);
+        return 1;
+    }
+    
+    error = parquet_reader_get_num_columns(reader, &num_columns);
+    if (error != ParquetOk) {
+        fprintf(stderr, "Failed to get column count: error code %d\n", error);
+        parquet_reader_close(reader);
+        return 1;
+    }
+    
+    printf("File contains %lu rows and %lu columns\n", num_rows, num_columns);
+    
+    // Get the schema
+    ParquetColumnDef* columns = NULL;
+    size_t schema_column_count = 0;
+    
+    error = parquet_reader_get_schema(reader, &columns, &schema_column_count);
+    if (error != ParquetOk) {
+        fprintf(stderr, "Failed to get schema: error code %d\n", error);
+        parquet_reader_close(reader);
+        return 1;
+    }
+    
+    printf("\nSchema:\n");
+    for (size_t i = 0; i < schema_column_count; i++) {
+        printf("  Column %zu: '%s', Type: ", i, columns[i].name);
+        print_data_type(columns[i].data_type);
+        printf(", Nullable: %s\n", columns[i].nullable ? "true" : "false");
+    }
+    
+    // Now read the data in batches
+    ParquetRowBatch batch;
+    int batch_num = 0;
+    
+    printf("\nData:\n");
+    
+    while (1) {
+        // Initialize batch struct
+        memset(&batch, 0, sizeof(ParquetRowBatch));
+        
+        // Read next batch
+        error = parquet_reader_read_next_batch(reader, &batch);
+        if (error != ParquetOk) {
+            fprintf(stderr, "Failed to read batch: error code %d\n", error);
+            parquet_reader_close(reader);
+            return 1;
+        }
+        
+        // If no rows, we're done
+        if (batch.num_rows == 0) {
+            break;
+        }
+        
+        printf("\nBatch %d: %lu rows\n", ++batch_num, batch.num_rows);
+        
+        // Print first few rows (max 10)
+        uint64_t rows_to_print = batch.num_rows < 10 ? batch.num_rows : 10;
+        
+        for (uint64_t row = 0; row < rows_to_print; row++) {
+            printf("  Row %lu: ", row);
+            
+            for (uint64_t col = 0; col < batch.num_columns; col++) {
+                // Check if value is null using the null map
+                uint64_t byte_idx = row / 8;
+                uint8_t bit_idx = row % 8;
+                bool is_valid = (batch.null_maps[col * ((batch.num_rows + 7) / 8) + byte_idx] & (1 << bit_idx)) != 0;
+                
+                if (!is_valid) {
+                    printf("NULL");
+                } else {
+                    // Get the value based on the column type
+                    switch (columns[col].data_type) {
+                        case ParquetBoolean: {
+                            bool* values = (bool*)batch.column_data[col];
+                            printf("%s", values[row] ? "true" : "false");
+                            break;
+                        }
+                        case ParquetInt32: {
+                            int32_t* values = (int32_t*)batch.column_data[col];
+                            printf("%d", values[row]);
+                            break;
+                        }
+                        case ParquetInt8: {
+                            int8_t* values = (int8_t*)batch.column_data[col];
+                            printf("%d", values[row]);
+                            break;
+                        }
+                        case ParquetUint8: {
+                            uint8_t* values = (uint8_t*)batch.column_data[col];
+                            printf("%u", values[row]);
+                            break;
+                        }
+                        case ParquetInt64: {
+                            int64_t* values = (int64_t*)batch.column_data[col];
+                            printf("%ld", values[row]);
+                            break;
+                        }
+                        case ParquetUint32: {
+                            uint32_t* values = (uint32_t*)batch.column_data[col];
+                            printf("%u", values[row]);
+                            break;
+                        }
+                        case ParquetUint64: {
+                            uint64_t* values = (uint64_t*)batch.column_data[col];
+                            printf("%lu", values[row]);
+                            break;
+                        }
+                        case ParquetFloat: {
+                            float* values = (float*)batch.column_data[col];
+                            printf("%f", values[row]);
+                            break;
+                        }
+                        case ParquetDouble: {
+                            double* values = (double*)batch.column_data[col];
+                            printf("%f", values[row]);
+                            break;
+                        }
+                        case ParquetString: {
+                            char** values = (char**)batch.column_data[col];
+                            if (values[row] != NULL) {
+                                printf("\"%s\"", values[row]);
+                            } else {
+                                printf("NULL");
+                            }
+                            break;
+                        }
+                        case ParquetBinary: {
+                            // For binary data, we get a pointer to a struct containing pointers and lengths
+                            void* struct_ptr = batch.column_data[col];
+                            uint8_t** data_ptrs = *(uint8_t***)struct_ptr;
+                            size_t* lengths = *((size_t**)((char*)struct_ptr + sizeof(uint8_t**)));
+                            
+                            if (data_ptrs[row] != NULL) {
+                                print_binary_hex(data_ptrs[row], lengths[row], 8); // Show up to 8 bytes
+                            } else {
+                                printf("NULL");
+                            }
+                            break;
+                        }
+                        default:
+                            printf("<unsupported type>");
+                            break;
+                    }
+                }
+                
+                if (col < batch.num_columns - 1) {
+                    printf(", ");
+                }
+            }
+            
+            printf("\n");
+        }
+        
+        // Free variable-length data using the new FFI function
+        parquet_reader_free_batch_data(&batch, columns, schema_column_count);
+        
+        // Free the batch resources (top-level pointers)
+        parquet_reader_free_batch(&batch);
+    }
+    
+    // Free schema resources
+    // In a real application, you would free the column name strings as well
+    free(columns);
+    
+    // Close the reader
+    error = parquet_reader_close(reader);
+    if (error != ParquetOk) {
+        fprintf(stderr, "Failed to close reader: error code %d\n", error);
+        return 1;
+    }
+    
+    printf("\nParquet file read successfully\n");
+    return 0;
+} 
