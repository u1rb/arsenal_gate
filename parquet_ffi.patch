+
+  writer->filename = strdup(filename);
+  if (!writer->filename) {
+    fprintf(stderr, "Failed to duplicate filename\n");
+    free(writer);
+    return NULL;
+  }
+  writer->batch_size = batch_size;
+
+  writer->schema_def = schema_def; // Store schema info
+  writer->num_columns = num_columns;
