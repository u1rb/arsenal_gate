diff --git a/parquet_ffi/cxx_examples/e_write_stream.c b/parquet_ffi/cxx_examples/e_write_stream.c
new file mode 100644
index 0000000..b5ce670
--- /dev/null
+++ b/parquet_ffi/cxx_examples/e_write_stream.c
@@ -0,0 +1,1011 @@
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <time.h> // For clock()
+
+// clang-format off
+#include <parquet_stream.h> // Include the FFI header
+#include "arrow_c.h" // Include Arrow C Data Interface header for flags
+// clang-format on
+
+// Default buffer sizes
+#define DEFAULT_STRING_BUFFER_SIZE                                             \
+  (1024 * 1024) // 1 MB for string data per batch
+
+// User-defined schema structure for columns
+typedef struct {
+  const char *name;
+  const char *format; // Arrow C Data Interface format string
+  bool nullable;
+} UserColumnDef;
+
+// Struct to hold offset for variable binary data (string in this case)
+typedef struct {
+  int32_t offset; // Offset into the writer's string_data_buffer
+} StringOffset;
+
+// Helper structure to manage row buffering and stream callbacks (similar to
+// write_stream.c)
+typedef struct {
+  const char *filename;
+  int64_t batch_size;
+
+  // Column buffers for the current batch
+  void **column_data_buffers;
+  bool **column_null_flags; // Array of pointers to boolean null flag buffers
+
+  // Contiguous buffer for string data
+  char *string_data_buffer;
+  size_t string_buffer_size;
+  size_t string_buffer_used;
+
+  int64_t current_row;
+  int64_t total_rows;
+
+  // Opaque handle to the Rust ArrowWriter state
+  void *rust_writer_handle;
+
+  // Schema definition (owned by caller, e.g., main)
+  const UserColumnDef *schema_def;
+  size_t num_columns;
+} RowWriter;
+
+// --- Forward Declarations ---
+void row_writer_free(RowWriter *writer);
+void create_schema(struct ArrowSchema *schema, const UserColumnDef *schema_def,
+                   size_t num_columns);
+void release_schema(struct ArrowSchema *schema);
+void release_array(struct ArrowArray *array);
+int row_writer_flush(RowWriter *writer);
+size_t get_type_size_from_format(const char *format); // Declare helper
+
+// Stream callback functions
+int get_schema(struct ArrowArrayStream *stream, struct ArrowSchema *out_schema);
+int get_next(struct ArrowArrayStream *stream, struct ArrowArray *out_array);
+const char *get_last_error(struct ArrowArrayStream *stream);
+void release_stream(struct ArrowArrayStream *stream);
+
+// --- RowWriter Implementation ---
+
+// Helper to get element size (handles fixed types and offset structs)
+size_t get_type_size_from_format(const char *format) {
+  if (!format || format[0] == '\0')
+    return 0; // Check for null/empty
+  switch (format[0]) {
+  case 'n':
+    return 0;
+  case 'b':
+    return sizeof(bool);
+  case 'c':
+    return sizeof(int8_t);
+  case 'C':
+    return sizeof(uint8_t);
+  case 's':
+    return sizeof(int16_t);
+  case 'S':
+    return sizeof(uint16_t);
+  case 'i':
+    return sizeof(int32_t);
+  case 'I':
+    return sizeof(uint32_t);
+  case 'l':
+    return sizeof(int64_t); // int64
+  case 'L':
+    return sizeof(uint64_t); // uint64
+  case 'f':
+    return sizeof(float);
+  case 'g':
+    return sizeof(double); // double
+  case 'u':                // Fall-through: Variable-size UTF-8 String
+  case 'U':                // Fall-through: Large variable-size UTF-8 String
+    return sizeof(StringOffset); // Store StringOffset struct
+  // Add other types like date/time/binary if needed, returning appropriate size
+  default:
+    return 0; // Unsupported
+  }
+}
+
+// Create a new row writer
+RowWriter *row_writer_create(const char *filename, int64_t batch_size,
+                             const UserColumnDef *schema_def,
+                             size_t num_columns) {
+  RowWriter *writer = (RowWriter *)calloc(1, sizeof(RowWriter));
+  if (!writer)
+    return NULL;
+
+  writer->filename = strdup(filename);
+  if (!writer->filename) {
+    free(writer);
+    return NULL;
+  }
+  writer->batch_size = batch_size;
+  writer->schema_def = schema_def;
+  writer->num_columns = num_columns;
+
+  writer->column_data_buffers = (void **)calloc(num_columns, sizeof(void *));
+  writer->column_null_flags = (bool **)calloc(num_columns, sizeof(bool *));
+  if (!writer->column_data_buffers || !writer->column_null_flags) {
+    row_writer_free(writer);
+    return NULL;
+  }
+
+  for (size_t i = 0; i < num_columns; ++i) {
+    size_t element_size = get_type_size_from_format(schema_def[i].format);
+    if (element_size == 0) { // Check specifically for string types handled here
+      if (!(schema_def[i].format[0] == 'u' || schema_def[i].format[0] == 'U')) {
+        fprintf(stderr, "Unsupported format: %s for column %s\n",
+                schema_def[i].format, schema_def[i].name);
+        row_writer_free(writer);
+        return NULL;
+      }
+      element_size = sizeof(StringOffset); // Size for string offset struct
+    }
+
+    writer->column_data_buffers[i] = malloc(batch_size * element_size);
+    if (!writer->column_data_buffers[i]) {
+      row_writer_free(writer);
+      return NULL;
+    }
+
+    if (schema_def[i].nullable) {
+      writer->column_null_flags[i] = (bool *)calloc(batch_size, sizeof(bool));
+      if (!writer->column_null_flags[i]) {
+        row_writer_free(writer);
+        return NULL;
+      }
+    } else {
+      writer->column_null_flags[i] = NULL;
+    }
+  }
+
+  writer->string_buffer_size = DEFAULT_STRING_BUFFER_SIZE;
+  writer->string_data_buffer = (char *)malloc(writer->string_buffer_size);
+  if (!writer->string_data_buffer) {
+    row_writer_free(writer);
+    return NULL;
+  }
+
+  return writer;
+}
+
+// Free writer resources
+void row_writer_free(RowWriter *writer) {
+  if (!writer)
+    return;
+  // Ensure the writer is closed ONLY IF the handle exists (might be NULL if
+  // init failed)
+  if (writer->rust_writer_handle) {
+    // printf("DEBUG: Calling close from row_writer_free for handle %p\n",
+    // writer->rust_writer_handle);
+    parquet_stream_writer_close(writer->rust_writer_handle);
+    writer->rust_writer_handle = NULL; // Avoid double close
+  }
+  free((void *)writer->filename);
+  if (writer->column_data_buffers) {
+    for (size_t i = 0; i < writer->num_columns; ++i)
+      free(writer->column_data_buffers[i]);
+    free(writer->column_data_buffers);
+  }
+  if (writer->column_null_flags) {
+    for (size_t i = 0; i < writer->num_columns; ++i)
+      free(writer->column_null_flags[i]);
+    free(writer->column_null_flags);
+  }
+  free(writer->string_data_buffer);
+  free(writer);
+}
+
+// Create Arrow schema from user definition
+void create_schema(struct ArrowSchema *schema, const UserColumnDef *schema_def,
+                   size_t num_columns) {
+  memset(schema, 0, sizeof(struct ArrowSchema));
+  schema->format = strdup("+s"); // Struct format
+  schema->name = strdup("");
+  schema->n_children = 0; // Start with 0, increment as children are added
+  schema->children =
+      (struct ArrowSchema **)calloc(num_columns, sizeof(struct ArrowSchema *));
+  if (!schema->children) { /* Handle alloc error */
+    goto fail_children_alloc;
+  }
+
+  schema->n_children = num_columns; // Set intended number before loop
+  for (size_t i = 0; i < num_columns; ++i) {
+    schema->children[i] =
+        (struct ArrowSchema *)calloc(1, sizeof(struct ArrowSchema));
+    if (!schema->children[i]) { /* Handle allocation error */
+      goto fail_child_alloc;
+    }
+    schema->children[i]->format = strdup(schema_def[i].format);
+    schema->children[i]->name = strdup(schema_def[i].name);
+    if (!schema->children[i]->format || !schema->children[i]->name) {
+      // Handle strdup failure
+      release_schema(schema->children[i]); // Release partially allocated child
+      schema->children[i] = NULL;
+      goto fail_child_alloc;
+    }
+    schema->children[i]->flags =
+        schema_def[i].nullable ? ARROW_FLAG_NULLABLE : 0;
+    schema->children[i]->release = release_schema;
+  }
+  schema->release = release_schema;
+  return;
+
+fail_child_alloc:
+  fprintf(stderr, "Failed to allocate schema child or its members.\n");
+  // Release already allocated children before freeing the children array itself
+  if (schema->children) {
+    for (size_t j = 0; j < num_columns; ++j) { // Iterate all potential slots
+      if (schema->children[j]) {
+        release_schema(
+            schema->children[j]);   // Let release handle freeing members
+        schema->children[j] = NULL; // Avoid double free in outer release
+      }
+    }
+    free(schema->children);
+    schema->children = NULL;
+  }
+fail_children_alloc: // Label for freeing the children array pointer itself
+  free((char *)schema->format);
+  free((char *)schema->name);
+  memset(schema, 0, sizeof(struct ArrowSchema)); // Mark as invalid
+  // release callback is implicitly NULL now
+}
+
+// Release Arrow schema resources
+void release_schema(struct ArrowSchema *schema) {
+  if (!schema || !schema->release)
+    return;
+  if (schema->children) {
+    for (int64_t i = 0; i < schema->n_children; i++) {
+      if (schema->children[i]) {
+        if (schema->children[i]->release)
+          schema->children[i]->release(schema->children[i]);
+        // Don't free schema->children[i] here, the recursive release call
+        // handles it
+      }
+    }
+    free(schema->children);
+  }
+  free((char *)schema->format);
+  free((char *)schema->name);
+  // Free other members if allocated (metadata, dictionary)
+  schema->release = NULL; // Mark as released
+}
+
+// Release Arrow array resources
+void release_array(struct ArrowArray *array) {
+  if (!array || !array->release)
+    return;
+  if (array->children) {
+    for (int64_t i = 0; i < array->n_children; i++) {
+      if (array->children[i]) {
+        if (array->children[i]->release) {
+          array->children[i]->release(array->children[i]);
+        }
+        // Don't free the child struct itself here, the release callback does
+      }
+    }
+    free(array->children); // Free the array of child pointers
+  }
+  if (array->buffers) {
+    // Buffers allocated by helpers need freeing here
+    // Note: Buffers[0] (validity) and Buffers[1 onwards] (data, offsets)
+    for (int i = 0; i < array->n_buffers; i++) {
+      free((void *)array->buffers[i]);
+    }
+    free((void **)array->buffers); // Free the array of buffer pointers
+  }
+  // Free dictionary if present
+  if (array->dictionary && array->dictionary->release) {
+    array->dictionary->release(array->dictionary);
+  }
+  free(array->dictionary);
+
+  array->release = NULL; // Mark as released
+}
+
+// Helper to create validity bitmap
+uint8_t *create_validity_buffer(const bool *null_flags, int64_t num_rows,
+                                int64_t *out_null_count) {
+  if (!null_flags) { // Column is not nullable
+    *out_null_count = 0;
+    return NULL; // Arrow convention: NULL buffer means all valid
+  }
+
+  *out_null_count = 0;
+  int64_t n_bytes = (num_rows + 7) / 8;
+  // Handle case where num_rows is 0
+  if (n_bytes == 0) {
+    *out_null_count = 0;
+    return NULL; // No validity buffer needed for 0 rows
+  }
+  uint8_t *validity = (uint8_t *)calloc(n_bytes, 1); // calloc initializes to 0
+  if (!validity)
+    return NULL;
+
+  for (int64_t i = 0; i < num_rows; i++) {
+    if (!null_flags[i]) {
+      validity[i / 8] |= (1 << (i % 8)); // Set bit if valid (not null)
+    } else {
+      (*out_null_count)++;
+    }
+  }
+  return validity;
+}
+
+// Helper to create Arrow child array for fixed-size types
+static int create_fixed_size_child_array(RowWriter *writer, size_t col_idx,
+                                         struct ArrowArray *child) {
+  const UserColumnDef *col_def = &writer->schema_def[col_idx];
+  const bool *null_flags = writer->column_null_flags[col_idx];
+  size_t type_size = get_type_size_from_format(col_def->format);
+
+  child->n_buffers = 2; // validity, data
+  child->buffers = (const void **)calloc(child->n_buffers, sizeof(void *));
+  if (!child->buffers)
+    return 0;
+
+  int64_t null_count = 0;
+  uint8_t *validity_buffer =
+      create_validity_buffer(null_flags, writer->current_row, &null_count);
+  if (!validity_buffer && col_def->nullable &&
+      null_count > 0) { // Check if alloc failed AND there were nulls
+    fprintf(stderr,
+            "Failed to allocate validity buffer for fixed-size column %zu\n",
+            col_idx);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0;
+  }
+  child->null_count = null_count;
+  child->buffers[0] = validity_buffer; // Can be NULL if not nullable
+
+  size_t data_size = writer->current_row * type_size;
+  void *value_buffer = NULL;
+  if (data_size > 0) {
+    value_buffer = malloc(data_size);
+    if (!value_buffer) {
+      fprintf(stderr,
+              "Failed to allocate value buffer for fixed-size column %zu\n",
+              col_idx);
+      free(validity_buffer);
+      free((void **)child->buffers);
+      child->buffers = NULL;
+      return 0;
+    }
+    memcpy(value_buffer, writer->column_data_buffers[col_idx], data_size);
+  } else {
+    // Arrow expects a buffer pointer even if size is 0, but it can be NULL
+    // or point to dummy data. Let's allocate a single byte to be safe?
+    // Or maybe NULL is fine? Let's try NULL for 0-length data.
+    value_buffer = NULL;
+  }
+  child->buffers[1] = value_buffer;
+
+  return 1;
+}
+
+// Helper to create Arrow child array for string types ('u')
+static int create_string_child_array(RowWriter *writer, size_t col_idx,
+                                     struct ArrowArray *child) {
+  const UserColumnDef *col_def = &writer->schema_def[col_idx];
+  const bool *null_flags = writer->column_null_flags[col_idx];
+
+  child->n_buffers = 3; // validity, offsets, data
+  child->buffers = (const void **)calloc(child->n_buffers, sizeof(void *));
+  if (!child->buffers)
+    return 0;
+
+  int64_t null_count = 0;
+  uint8_t *validity_buffer =
+      create_validity_buffer(null_flags, writer->current_row, &null_count);
+  if (!validity_buffer && col_def->nullable && null_count > 0) {
+    fprintf(stderr,
+            "Failed to allocate validity buffer for string column %zu\n",
+            col_idx);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0;
+  }
+  child->null_count = null_count;
+  child->buffers[0] = validity_buffer;
+
+  // Calculate Arrow offsets and total data length needed
+  int32_t *offsets =
+      (int32_t *)malloc((writer->current_row + 1) * sizeof(int32_t));
+  if (!offsets) {
+    fprintf(stderr, "Failed to allocate offsets buffer for string column %zu\n",
+            col_idx);
+    free(validity_buffer);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0;
+  }
+  offsets[0] = 0;
+  StringOffset *col_offsets_buffer =
+      (StringOffset *)writer->column_data_buffers[col_idx];
+  int32_t current_arrow_offset = 0;
+  for (int64_t row = 0; row < writer->current_row; ++row) {
+    bool is_row_null = null_flags && null_flags[row];
+    if (!is_row_null) {
+      int32_t start_offset = col_offsets_buffer[row].offset;
+      // Use strlen on the data in the contiguous buffer to get length
+      size_t len = strlen(writer->string_data_buffer + start_offset);
+      current_arrow_offset += len;
+    }
+    offsets[row + 1] = current_arrow_offset;
+  }
+  child->buffers[1] = offsets;
+
+  // Copy data from contiguous string buffer to final value buffer
+  size_t total_data_len = current_arrow_offset;
+  uint8_t *value_buffer = NULL;
+  if (total_data_len > 0) {
+    value_buffer = (uint8_t *)malloc(total_data_len);
+    if (!value_buffer) {
+      fprintf(stderr, "Failed to allocate value buffer for string column %zu\n",
+              col_idx);
+      free(validity_buffer);
+      free(offsets);
+      free((void **)child->buffers);
+      child->buffers = NULL;
+      return 0;
+    }
+
+    int32_t current_write_pos = 0;
+    for (int64_t row = 0; row < writer->current_row; ++row) {
+      bool is_row_null = null_flags && null_flags[row];
+      if (!is_row_null) {
+        int32_t start_offset = col_offsets_buffer[row].offset;
+        size_t len = strlen(writer->string_data_buffer + start_offset);
+        memcpy(value_buffer + current_write_pos,
+               writer->string_data_buffer + start_offset, len);
+        current_write_pos += len;
+      }
+    }
+    assert(current_write_pos == total_data_len);
+  } else {
+    // Arrow expects a buffer pointer even if size is 0. NULL should be ok.
+    value_buffer = NULL;
+  }
+  child->buffers[2] = value_buffer;
+
+  return 1;
+}
+
+// Convert current batch data to an ArrowArray (record batch)
+void batch_to_arrow_array(RowWriter *writer, struct ArrowArray *array) {
+  if (writer->current_row == 0) { // Handle empty batch
+    memset(array, 0, sizeof(struct ArrowArray));
+    array->length = 0;
+    array->release = release_array; // Still needs release callback
+    return;
+  }
+
+  memset(array, 0, sizeof(struct ArrowArray));
+  array->length = writer->current_row;
+  array->null_count = 0; // Struct array itself is not null
+  array->offset = 0;
+  array->n_buffers = 1; // Only has a (typically null) validity buffer
+  array->buffers = (const void **)calloc(1, sizeof(void *));
+  if (!array->buffers)
+    goto fail_top_buffers;
+  array->buffers[0] = NULL; // Struct validity is null
+
+  array->n_children = writer->num_columns;
+  array->children = (struct ArrowArray **)calloc(writer->num_columns,
+                                                 sizeof(struct ArrowArray *));
+  if (!array->children)
+    goto fail_children_alloc;
+
+  array->release = release_array;
+
+  for (size_t i = 0; i < writer->num_columns; ++i) {
+    array->children[i] =
+        (struct ArrowArray *)calloc(1, sizeof(struct ArrowArray));
+    if (!array->children[i])
+      goto fail_child_alloc; // Clean up previous
+
+    struct ArrowArray *child = array->children[i];
+    child->length = writer->current_row;
+    child->offset = 0;
+    child->release = release_array; // Use same release for children
+
+    const char *format = writer->schema_def[i].format;
+    int success = 0;
+    if (format[0] == 'u' || format[0] == 'U') {
+      success = create_string_child_array(writer, i, child);
+    } else { // Assume fixed-size otherwise for this example
+      success = create_fixed_size_child_array(writer, i, child);
+    }
+
+    if (!success) {
+      fprintf(stderr, "Failed to create child array %zu (%s)\n", i,
+              writer->schema_def[i].name);
+      // Don't free child here, release_array will handle it if we set release
+      // correctly Mark this child slot as NULL and trigger cleanup
+      array->children[i] = NULL; // Mark as failed
+      goto fail_child_alloc;     // Trigger cleanup
+    }
+  }
+  return; // Success
+
+fail_child_alloc:
+  fprintf(stderr, "Cleaning up partially created Arrow array...\n");
+  // Release already created children and their buffers using release_array
+  if (array->children) {
+    for (size_t j = 0; j < writer->num_columns; ++j) {
+      if (array->children[j]) {
+        if (array->children[j]->release) {
+          array->children[j]->release(array->children[j]);
+        } else {
+          // If creation failed before release was set, free the struct itself
+          free(array->children[j]);
+        }
+        array->children[j] = NULL; // Avoid double free in top level release
+      }
+    }
+    free(array->children);
+    array->children = NULL;
+  }
+fail_children_alloc: // Label for freeing the children array pointer
+  free((void **)array->buffers);
+  array->buffers = NULL;
+fail_top_buffers:
+  fprintf(stderr, "Error creating Arrow array for batch.\n");
+  memset(array, 0, sizeof(struct ArrowArray)); // Mark as invalid
+  array->release = NULL; // Ensure release is NULL to signal failure
+}
+
+// Add a row to the writer's internal batch buffers
+int row_writer_add_row(RowWriter *writer, const void **row_values,
+                       const bool *is_null_flags) {
+  if (writer->current_row >= writer->batch_size) {
+    if (!row_writer_flush(writer)) {
+      fprintf(stderr, "Failed to flush full batch before adding row.\n");
+      return 0;
+    }
+  }
+
+  int64_t current_idx = writer->current_row;
+  for (size_t i = 0; i < writer->num_columns; ++i) {
+    bool is_null = writer->schema_def[i].nullable && is_null_flags[i];
+
+    if (writer->column_null_flags[i]) {
+      writer->column_null_flags[i][current_idx] = is_null;
+    } else if (is_null) {
+      fprintf(stderr, "Error: NULL value for non-nullable column %zu (%s)\n", i,
+              writer->schema_def[i].name);
+      return 0;
+    }
+
+    if (!is_null) {
+      const char *format = writer->schema_def[i].format;
+      const void *source_value = row_values[i];
+      size_t element_size = get_type_size_from_format(format);
+      void *target_col_buffer = writer->column_data_buffers[i];
+
+      if (format[0] == 'u' || format[0] == 'U') { // String
+        const char *str_value = (const char *)source_value;
+        size_t str_len = strlen(str_value) + 1; // Include null terminator
+
+        // Resize string buffer if needed
+        if (writer->string_buffer_used + str_len > writer->string_buffer_size) {
+          size_t needed = writer->string_buffer_used + str_len;
+          size_t new_size = writer->string_buffer_size * 2 > needed
+                                ? writer->string_buffer_size * 2
+                                : needed + DEFAULT_STRING_BUFFER_SIZE;
+          char *new_buf = (char *)realloc(writer->string_data_buffer, new_size);
+          if (!new_buf) {
+            fprintf(stderr, "Failed to resize string buffer to %zu bytes\n",
+                    new_size);
+            return 0; // Cannot add string
+          }
+          writer->string_data_buffer = new_buf;
+          writer->string_buffer_size = new_size;
+        }
+
+        // Store offset
+        StringOffset *offset_struct_buffer = (StringOffset *)target_col_buffer;
+        offset_struct_buffer[current_idx].offset =
+            (int32_t)writer->string_buffer_used;
+
+        // Copy string data
+        memcpy(writer->string_data_buffer + writer->string_buffer_used,
+               str_value, str_len);
+        writer->string_buffer_used += str_len;
+
+      } else if (element_size > 0) { // Fixed-size
+        void *dest = (char *)target_col_buffer + current_idx * element_size;
+        memcpy(dest, source_value, element_size);
+      } else {
+        // Should not happen if get_type_size_from_format and create handle
+        // types consistently
+        fprintf(stderr,
+                "Internal error: Cannot handle type %s for column %zu\n",
+                format, i);
+        return 0;
+      }
+    } else {
+      // Handle null value for the column (e.g., zero out the slot in the data
+      // buffer)
+      size_t element_size =
+          get_type_size_from_format(writer->schema_def[i].format);
+      if (element_size > 0) {
+        void *target_col_buffer = writer->column_data_buffers[i];
+        void *dest = (char *)target_col_buffer + current_idx * element_size;
+        memset(dest, 0, element_size); // Zero out fixed value or offset struct
+      }
+    }
+  }
+
+  writer->current_row++;
+  return 1;
+}
+
+// Flush the current batch using the FFI writer
+int row_writer_flush(RowWriter *writer) {
+  if (writer->current_row == 0)
+    return 1; // Nothing to flush
+
+  int64_t rows_in_batch = writer->current_row; // Save before get_next resets it
+
+  // Prepare the stream object pointing to our writer and callbacks
+  struct ArrowArrayStream stream;
+  memset(&stream, 0, sizeof(struct ArrowArrayStream));
+  stream.get_schema = get_schema;
+  stream.get_next = get_next;
+  stream.get_last_error = get_last_error;
+  stream.release = release_stream;
+  stream.private_data = writer;
+
+  int result = 0;
+  if (writer->rust_writer_handle == NULL) {
+    // First flush: Initialize the Rust writer
+    // printf("Initializing Parquet writer and writing first batch (%ld
+    // rows)...\n", rows_in_batch);
+    writer->rust_writer_handle =
+        parquet_stream_writer_init(&stream, writer->filename);
+    result = (writer->rust_writer_handle == NULL) ? -1 : 0;
+  } else {
+    // Subsequent flush: Write the next batch
+    // printf("Writing subsequent batch (%ld rows)...\n", rows_in_batch);
+    result =
+        parquet_stream_writer_write_batch(writer->rust_writer_handle, &stream);
+  }
+
+  // get_next (called by Rust FFI functions) will have consumed the batch data
+  // and reset current_row, string_buffer_used etc. if result was 0.
+  // If result != 0, get_next might not have been called or might have failed.
+  if (result == 0) {
+    writer->total_rows += rows_in_batch;
+    // Resetting of current_row etc. is done inside get_next
+    return 1; // Success
+  } else {
+    fprintf(stderr, "Error flushing batch to Parquet file (returned %d).\n",
+            result);
+    // Don't assume current_row was reset if flush failed.
+    // The FFI layer should ideally handle stream release on error.
+    return 0; // Failure
+  }
+}
+
+// Close the writer (flushes remaining data)
+int row_writer_close(RowWriter *writer) {
+  int flush_status = 1;
+  if (writer->current_row > 0) {
+    // printf("Flushing final batch (%ld rows)...\n", writer->current_row);
+    flush_status = row_writer_flush(writer);
+    if (!flush_status) {
+      fprintf(stderr, "Failed to flush final batch.\n");
+      // Proceed to try closing, but report overall failure later
+    }
+  }
+
+  int close_status = 0;
+  if (writer->rust_writer_handle) {
+    // printf("Closing Parquet writer (handle %p)...\n",
+    // writer->rust_writer_handle);
+    close_status = parquet_stream_writer_close(writer->rust_writer_handle);
+    writer->rust_writer_handle = NULL; // Mark as closed *after* calling close
+    if (close_status != 0) {
+      fprintf(stderr, "Error closing Parquet writer (returned %d).\n",
+              close_status);
+    }
+  } else {
+    // Handle case where no rows were written or init failed
+    if (writer->total_rows == 0 && flush_status) {
+      // printf("No data written, writer was not initialized.\n");
+    } else if (flush_status) { // Init must have failed if handle is NULL after
+                               // flush was attempted
+      fprintf(stderr,
+              "Writer handle was NULL, likely initialization failed.\n");
+      close_status = -1; // Indicate failure even if close wasn't called
+    }
+    // If flush failed, we might still be here with handle=NULL
+  }
+
+  if (flush_status && close_status == 0) {
+    // printf("Successfully wrote %ld total rows to %s\n", writer->total_rows,
+    // writer->filename);
+    return 1; // Success
+  } else {
+    fprintf(stderr, "Writer finished with errors. Total rows reported: %ld\n",
+            writer->total_rows);
+    return 0; // Failure
+  }
+}
+
+// --- Arrow C Stream Callbacks ---
+
+int get_schema(struct ArrowArrayStream *stream,
+               struct ArrowSchema *out_schema) {
+  RowWriter *writer = (RowWriter *)stream->private_data;
+  create_schema(out_schema, writer->schema_def, writer->num_columns);
+  // Check if schema creation failed (schema->release will be NULL)
+  if (out_schema->release == NULL) {
+    fprintf(stderr, "get_schema: Failed to create schema.\n");
+    return -1; // Use Arrow error code convention EIO
+  }
+  return 0; // Success
+}
+
+int get_next(struct ArrowArrayStream *stream, struct ArrowArray *out_array) {
+  RowWriter *writer = (RowWriter *)stream->private_data;
+
+  // Convert current batch data to ArrowArray format
+  batch_to_arrow_array(writer, out_array);
+
+  // Check if conversion failed (array->release will be NULL)
+  if (out_array->release == NULL && writer->current_row > 0) {
+    fprintf(stderr, "get_next: Failed to convert batch to Arrow array.\n");
+    // Arrow spec: return non-zero on error
+    return -1; // Use Arrow error code convention EIO? Standard error codes?
+               // Let's use -1
+  }
+
+  // If conversion succeeded OR the batch was empty (current_row == 0),
+  // reset writer state for the next potential batch.
+  if (out_array->release != NULL || writer->current_row == 0) {
+    writer->current_row = 0;
+    writer->string_buffer_used = 0;
+    // Reset null flags
+    for (size_t i = 0; i < writer->num_columns; ++i) {
+      if (writer->column_null_flags[i]) {
+        // Only reset if batch size > 0 to avoid writing to NULL pointer
+        if (writer->batch_size > 0) {
+          memset(writer->column_null_flags[i], 0,
+                 writer->batch_size * sizeof(bool));
+        }
+      }
+    }
+  }
+
+  // If array->release is NULL here, it means the batch was empty *and* no error
+  // occurred during conversion attempt OR conversion failed, but we return -1
+  // above in that case. Arrow spec expects 0 on success (batch produced or
+  // stream ended cleanly)
+  return 0;
+}
+
+const char *get_last_error(struct ArrowArrayStream *stream) {
+  // This basic example doesn't track detailed errors in the writer state.
+  // A more robust implementation could store the last error message here.
+  // Arrow spec: return NULL if no error message is available.
+  return NULL;
+}
+
+void release_stream(struct ArrowArrayStream *stream) {
+  // The stream doesn't own the RowWriter, so just clear the private data
+  // and mark as released. The RowWriter is freed separately in main.
+  stream->private_data = NULL;
+  stream->release = NULL;
+}
+
+// --- Main Function ---
+
+int main(int argc, char *argv[]) {
+  if (argc < 4) {
+    fprintf(stderr, "Usage: %s <output_file.parquet> <num_rows> <batch_size>\n",
+            argv[0]);
+    return 1;
+  }
+
+  const char *output_file = argv[1];
+  int64_t num_rows = atoll(argv[2]);
+  int64_t batch_size = atoll(argv[3]);
+
+  if (num_rows <= 0 || batch_size <= 0) {
+    fprintf(stderr, "Error: num_rows and batch_size must be positive.\n");
+    return 1;
+  }
+
+  // Define Order Book Event Schema
+  const UserColumnDef schema_def[] = {
+      {.name = "timestamp_ns",
+       .format = "L",
+       .nullable = false}, // uint64 nanoseconds since epoch
+      {.name = "sequence_num",
+       .format = "L",
+       .nullable = false}, // uint64 sequence number
+      {.name = "order_id",
+       .format = "l",
+       .nullable = false}, // int64 order identifier
+      {.name = "side",
+       .format = "u",
+       .nullable = false}, // string "BID" or "ASK"
+      {.name = "price", .format = "g", .nullable = false}, // double price level
+      {.name = "quantity", .format = "g", .nullable = false}, // double quantity
+      {.name = "event_type",
+       .format = "u",
+       .nullable = false}, // string "NEW", "CANCEL", "MODIFY", "FILL"
+      {.name = "is_filled",
+       .format = "b",
+       .nullable = false}, // boolean true if fully filled by this event
+      {.name = "trade_id",
+       .format = "l",
+       .nullable = true}, // int64 trade identifier (nullable)
+      {.name = "comment",
+       .format = "u",
+       .nullable = true} // string optional comment (nullable)
+  };
+  const size_t num_columns = sizeof(schema_def) / sizeof(schema_def[0]);
+
+  printf("--- Order Book Event Parquet Stream Writer ---\n");
+  printf("Output File: %s\n", output_file);
+  printf("Total Rows:  %ld\n", num_rows);
+  printf("Batch Size:  %ld\n", batch_size);
+  printf("Schema:\n");
+  for (size_t i = 0; i < num_columns; ++i) {
+    printf("  - %s (%s, %s)\n", schema_def[i].name, schema_def[i].format,
+           schema_def[i].nullable ? "nullable" : "required");
+  }
+  printf("--------------------------------------------\n");
+
+  RowWriter *writer =
+      row_writer_create(output_file, batch_size, schema_def, num_columns);
+  if (!writer) {
+    fprintf(stderr, "Failed to create RowWriter.\n");
+    return 1;
+  }
+
+  // --- Data Generation Loop ---
+  clock_t start = clock();
+
+  // Pre-allocate buffers for one row's data pointers and null flags
+  const void *row_values[num_columns];
+  bool is_null_flags[num_columns];
+
+  // Temporary storage for row data (ensure types match schema)
+  uint64_t timestamp_ns;
+  uint64_t sequence_num = 0;
+  int64_t order_id;
+  const char *side;
+  double price;
+  double quantity;
+  const char *event_type;
+  bool is_filled;
+  int64_t trade_id; // Needs to be accessible for nullable setting
+  char comment_buffer[128];
+
+  for (int64_t i = 0; i < num_rows; ++i) {
+    // Simulate order book data
+    timestamp_ns = (uint64_t)time(NULL) * 1000000000 +
+                   (i % 1000) * 1000000; // Simulate ns timestamps
+    sequence_num++;
+    order_id = 10000 + (i % 500); // Cycle through some order IDs
+    side = (i % 2 == 0) ? "BID" : "ASK";
+    price =
+        100.0 + (double)(i % 100) * 0.01 * (strcmp(side, "BID") == 0 ? -1 : 1);
+    quantity = 1.0 + (double)(i % 10) * 0.1;
+    is_filled = false;
+
+    int event_choice = i % 4;
+    bool make_trade_id_null = true;
+    bool make_comment_null =
+        (i % 10 != 0); // Make comment non-null every 10 rows
+
+    switch (event_choice) {
+    case 0:
+      event_type = "NEW";
+      break;
+    case 1:
+      event_type = "CANCEL";
+      quantity = 0.0;
+      break; // Cancel often zeroes quantity
+    case 2:
+      event_type = "MODIFY";
+      break;
+    case 3:
+      event_type = "FILL";
+      is_filled = (i % 5 == 0);   // Sometimes fully filled
+      trade_id = 50000 + (i / 4); // Generate a trade ID for fills
+      make_trade_id_null = false;
+      break;
+    default:
+      event_type = "UNKNOWN";
+      break; // Should not happen
+    }
+
+    // Prepare pointers for row_writer_add_row
+    row_values[0] = &timestamp_ns;
+    is_null_flags[0] = false;
+    row_values[1] = &sequence_num;
+    is_null_flags[1] = false;
+    row_values[2] = &order_id;
+    is_null_flags[2] = false;
+    row_values[3] = side;
+    is_null_flags[3] = false;
+    row_values[4] = &price;
+    is_null_flags[4] = false;
+    row_values[5] = &quantity;
+    is_null_flags[5] = false;
+    row_values[6] = event_type;
+    is_null_flags[6] = false;
+    row_values[7] = &is_filled;
+    is_null_flags[7] = false;
+
+    // Handle nullable columns
+    is_null_flags[8] = make_trade_id_null;
+    if (!make_trade_id_null) {
+      row_values[8] = &trade_id;
+    } else {
+      row_values[8] = NULL; // Pointer doesn't matter if null flag is true
+    }
+
+    is_null_flags[9] = make_comment_null;
+    if (!make_comment_null) {
+      snprintf(comment_buffer, sizeof(comment_buffer), "Comment for row %ld",
+               i);
+      row_values[9] = comment_buffer;
+    } else {
+      row_values[9] = NULL;
+    }
+
+    // Add the row to the writer's buffer (flushes automatically if full)
+    if (!row_writer_add_row(writer, row_values, is_null_flags)) {
+      fprintf(stderr, "Error adding row %ld. Aborting.\n", i);
+      // row_writer_free will attempt to close the handle if it exists
+      row_writer_free(writer); // Free resources before exiting
+      return 1;
+    }
+  }
+
+  // --- Finalize ---
+  // Close the writer (flushes any remaining data)
+  printf("Writing complete. Closing writer...\n");
+  int success = row_writer_close(
+      writer); // This handles final flush and closes FFI writer
+
+  clock_t end = clock();
+  double elapsed_secs = (double)(end - start) / CLOCKS_PER_SEC;
+
+  // Retrieve total rows from writer *before* freeing it
+  int64_t final_total_rows = writer ? writer->total_rows : 0;
+
+  double rows_per_sec = (success && elapsed_secs > 0)
+                            ? (double)final_total_rows / elapsed_secs
+                            : 0;
+
+  printf("--------------------------------------------\n");
+  if (success) {
+    printf("Successfully wrote %ld rows in %.2f seconds (%.1f rows/sec).\n",
+           final_total_rows, elapsed_secs, rows_per_sec);
+  } else {
+    fprintf(
+        stderr,
+        "Failed to write Parquet file. Total rows reported by writer: %ld\n",
+        final_total_rows);
+  }
+  printf("--------------------------------------------\n");
+
+  // Free the C-side RowWriter structure
+  // Note: row_writer_close already handled closing the FFI writer handle
+  // So row_writer_free will now just free C buffers
+  row_writer_free(writer);
+
+  return success ? 0 : 1;
+}
