+// Helper to create validity bitmap from boolean flags
+uint8_t *create_validity_buffer(const bool *null_flags, int64_t num_rows,
+                                int64_t *out_null_count) {
+  if (!null_flags) { // Column is not nullable
+    *out_null_count = 0;
+    int64_t valid_bytes = (num_rows + 7) / 8;
+    uint8_t *validity = (uint8_t *)calloc(valid_bytes, 1);
+    if (validity) {
+      memset(validity, 0xFF, valid_bytes); // All valid
+    }
+    return validity;
+  }
+
+  *out_null_count = 0;
+  int64_t valid_bytes = (num_rows + 7) / 8;
+  uint8_t *validity = (uint8_t *)calloc(valid_bytes, 1);
+  if (!validity) {
+    return NULL; // Allocation failed
+  }
+
+  for (int64_t i = 0; i < num_rows; i++) {
+    if (!null_flags[i]) {
+      // Set bit for non-null values
+      int byte_idx = i / 8;
+      int bit_idx = i % 8;
+      validity[byte_idx] |= (1 << bit_idx);
+    } else {
+      (*out_null_count)++;
+    }
+  }
+  return validity;
+}
+
+// Helper to create Arrow child array for fixed-size primitive types
+static int create_fixed_size_child_array(RowWriter *writer, size_t col_idx,
+                                         struct ArrowArray *child) {
+  const UserColumnDef *col_def = &writer->schema_def[col_idx];
+  const bool *null_flags = writer->column_null_flags[col_idx];
+  const char *format = col_def->format;
+
+  child->n_buffers = 2; // validity, data
+  child->buffers = (const void **)calloc(child->n_buffers, sizeof(void *));
+  if (!child->buffers) {
+    fprintf(stderr,
+            "Failed to allocate buffers for fixed-size column %zu (%s)\n",
+            col_idx, col_def->name);
+    return 0; // Failure
+  }
+
+  // 1. Create Validity Buffer
+  int64_t null_count = 0;
+  uint8_t *validity_buffer =
+      create_validity_buffer(null_flags, writer->current_row, &null_count);
+  if (!validity_buffer && col_def->nullable) {
+    fprintf(
+        stderr,
+        "Failed to allocate validity buffer for fixed-size column %zu (%s)\n",
+        col_idx, col_def->name);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0; // Failure
+  }
+  child->null_count = null_count;
+  child->buffers[0] = validity_buffer;
+
+  // 2. Copy data buffer
+  size_t type_size = get_type_size_from_format(format);
+  assert(type_size > 0); // Should be > 0 for fixed types
+  size_t data_size = writer->current_row * type_size;
+  void *value_buffer = malloc(data_size);
+  if (!value_buffer) {
+    fprintf(stderr,
+            "Failed to allocate value buffer for fixed-size column %zu (%s)\n",
+            col_idx, col_def->name);
+    free(validity_buffer);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0; // Failure
+  }
+  memcpy(value_buffer, writer->column_data_buffers[col_idx], data_size);
+  child->buffers[1] = value_buffer;
+
+  return 1; // Success
+}
+
+// Helper to create Arrow child array for string types ('u', 'U')
+static int create_string_child_array(RowWriter *writer, size_t col_idx,
+                                     struct ArrowArray *child) {
+  const UserColumnDef *col_def = &writer->schema_def[col_idx];
+  const bool *null_flags = writer->column_null_flags[col_idx];
+
+  child->n_buffers = 3; // validity, offsets, data
+  child->buffers = (const void **)calloc(child->n_buffers, sizeof(void *));
+  if (!child->buffers) {
+    fprintf(stderr, "Failed to allocate buffers for string column %zu (%s)\n",
+            col_idx, col_def->name);
+    return 0; // Failure
+  }
+
+  // 1. Create Validity Buffer
+  int64_t null_count = 0;
+  uint8_t *validity_buffer =
+      create_validity_buffer(null_flags, writer->current_row, &null_count);
+  if (!validity_buffer && col_def->nullable) {
+    fprintf(stderr,
+            "Failed to allocate validity buffer for string column %zu (%s)\n",
+            col_idx, col_def->name);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0; // Failure
+  }
+  child->null_count = null_count;
+  child->buffers[0] = validity_buffer;
+
+  // 2. Calculate and populate Arrow offsets buffer
+  int32_t *offsets =
+      (int32_t *)malloc((writer->current_row + 1) * sizeof(int32_t));
+  if (!offsets) {
+    fprintf(stderr,
+            "Failed to allocate offsets buffer for string column %zu (%s)\n",
+            col_idx, col_def->name);
+    free(validity_buffer);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0; // Failure
+  }
+  offsets[0] = 0; // First offset is always 0
+  int32_t *col_offsets_buffer = (int32_t *)writer->column_data_buffers[col_idx];
+  int32_t current_arrow_offset = 0;
+  for (int64_t row = 0; row < writer->current_row; ++row) {
+    bool is_row_null = null_flags && null_flags[row];
+    if (!is_row_null) {
+      int32_t start_offset = col_offsets_buffer[row];
+      // Use strlen on the data in the contiguous buffer to get length
+      size_t len = strlen(writer->string_data_buffer + start_offset);
+      current_arrow_offset += len;
+    }
+    offsets[row + 1] = current_arrow_offset;
+  }
+  child->buffers[1] = offsets;
+
+  // 3. Copy data from contiguous string buffer
+  // The total size needed is the final offset value
+  size_t total_data_len = current_arrow_offset;
+  uint8_t *value_buffer = (uint8_t *)malloc(total_data_len);
+  if (!value_buffer) {
+    fprintf(stderr,
+            "Failed to allocate value buffer for string column %zu (%s)\n",
+            col_idx, col_def->name);
+    free(validity_buffer);
+    free(offsets);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0; // Failure
+  }
+  // Consolidate non-null string data into the Arrow value buffer
+  int32_t current_write_pos = 0;
+  for (int64_t row = 0; row < writer->current_row; ++row) {
+    bool is_row_null = null_flags && null_flags[row];
+    if (!is_row_null) {
+      int32_t start_offset = col_offsets_buffer[row];
+      size_t len = strlen(writer->string_data_buffer + start_offset);
+      memcpy(value_buffer + current_write_pos,
+             writer->string_data_buffer + start_offset, len);
+      current_write_pos += len;
+    }
+  }
+  assert(current_write_pos == total_data_len);
+
+  child->buffers[2] = value_buffer;
+
+  return 1; // Success
+}
+
+// Helper to create Arrow child array for binary types ('z', 'Z')
+static int create_binary_child_array(RowWriter *writer, size_t col_idx,
+                                     struct ArrowArray *child) {
+  const UserColumnDef *col_def = &writer->schema_def[col_idx];
+  const bool *null_flags = writer->column_null_flags[col_idx];
+
+  child->n_buffers = 3; // validity, offsets, data
+  child->buffers = (const void **)calloc(child->n_buffers, sizeof(void *));
+  if (!child->buffers) {
+    fprintf(stderr, "Failed to allocate buffers for binary column %zu (%s)\n",
+            col_idx, col_def->name);
+    return 0; // Failure
+  }
+
+  // 1. Create Validity Buffer
+  int64_t null_count = 0;
+  uint8_t *validity_buffer =
+      create_validity_buffer(null_flags, writer->current_row, &null_count);
+  if (!validity_buffer && col_def->nullable) {
+    fprintf(stderr,
+            "Failed to allocate validity buffer for binary column %zu (%s)\n",
+            col_idx, col_def->name);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0; // Failure
+  }
+  child->null_count = null_count;
+  child->buffers[0] = validity_buffer;
+
+  // 2. Calculate and populate Arrow offsets buffer
+  int32_t *offsets =
+      (int32_t *)malloc((writer->current_row + 1) * sizeof(int32_t));
+  if (!offsets) {
+    fprintf(stderr,
+            "Failed to allocate offsets buffer for binary column %zu (%s)\n",
+            col_idx, col_def->name);
+    free(validity_buffer);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0; // Failure
+  }
+  offsets[0] = 0;
+  int32_t current_arrow_offset = 0;
+  BinaryOffsetSize *col_bin_buffer =
+      (BinaryOffsetSize *)writer->column_data_buffers[col_idx];
+
+  for (int64_t row = 0; row < writer->current_row; ++row) {
+    bool is_row_null = null_flags && null_flags[row];
+    int32_t len = 0;
+    if (!is_row_null) {
+      len = col_bin_buffer[row].size;
+    }
+    current_arrow_offset += len;
+    offsets[row + 1] = current_arrow_offset;
+  }
+  child->buffers[1] = offsets;
+
+  // 3. Copy data from contiguous binary buffer
+  size_t total_data_len = current_arrow_offset;
+  uint8_t *value_buffer = (uint8_t *)malloc(total_data_len);
+  if (!value_buffer) {
+    fprintf(stderr,
+            "Failed to allocate value buffer for binary column %zu (%s)\n",
+            col_idx, col_def->name);
+    free(validity_buffer);
+    free(offsets);
+    free((void **)child->buffers);
+    child->buffers = NULL;
+    return 0; // Failure
+  }
+  // Consolidate non-null binary data into the Arrow value buffer
+  int32_t current_write_pos = 0;
+  for (int64_t row = 0; row < writer->current_row; ++row) {
+    bool is_row_null = null_flags && null_flags[row];
+    if (!is_row_null) {
+      int32_t start_offset = col_bin_buffer[row].offset;
+      int32_t len = col_bin_buffer[row].size;
+      memcpy(value_buffer + current_write_pos,
+             writer->binary_data_buffer + start_offset, len);
+      current_write_pos += len;
+    }
+  }
+  assert(current_write_pos == total_data_len);
+
+  child->buffers[2] = value_buffer;
+
+  return 1; // Success
+}
+
+// Convert the current batch to an Arrow array ready for writing
+void batch_to_arrow_array(RowWriter *writer, struct ArrowArray *array) {
+  // Skip if no rows in the current batch
+  if (writer->current_row == 0) {
+    memset(array, 0, sizeof(struct ArrowArray));
+    array->release = release_array; // Still set release callback
+    return;
+  }
+
+  memset(array, 0, sizeof(struct ArrowArray));
+  array->length = writer->current_row;
+  array->null_count = 0; // Top-level struct array has no nulls itself
+  array->offset = 0;
+  array->n_buffers = 1; // Usually NULL validity buffer for struct
+  array->buffers =
+      (const void **)calloc(1, sizeof(void *)); // Allocate buffer array
+  if (!array->buffers) {
+    fprintf(
+        stderr,
+        "batch_to_arrow_array: Failed to allocate top-level buffers array\n");
+    goto fail_top_buffers;
+  }
+  array->buffers[0] = NULL; // Struct validity buffer is null
+
+  array->n_children = writer->num_columns;
+  array->children = (struct ArrowArray **)calloc(writer->num_columns,
+                                                 sizeof(struct ArrowArray *));
+  if (!array->children) {
+    fprintf(stderr,
+            "batch_to_arrow_array: Failed to allocate children array\n");
+    goto fail_children_alloc;
+  }
+
+  array->release = release_array; // Set release callback
+
+  // Build child arrays for each column
+  for (size_t i = 0; i < writer->num_columns; ++i) {
+    const UserColumnDef *col_def = &writer->schema_def[i];
+    array->children[i] =
+        (struct ArrowArray *)calloc(1, sizeof(struct ArrowArray));
+    if (!array->children[i]) {
+      fprintf(stderr,
+              "batch_to_arrow_array: Failed to allocate child array %zu (%s)\n",
+              i, col_def->name);
+      goto fail_child_alloc; // Need to clean up previous children
+    }
+    struct ArrowArray *child = array->children[i];
+    child->length = writer->current_row;
+    child->offset = 0;
+    child->release = release_array; // Use the same release function
+
+    const char *format = col_def->format;
+    int success = 0;
+
+    // Call the appropriate helper based on type format string
+    if (format[0] == 'u' || format[0] == 'U') { // String
+      success = create_string_child_array(writer, i, child);
+    } else if (format[0] == 'z' || format[0] == 'Z') { // Binary
+      success = create_binary_child_array(writer, i, child);
+    } else { // Fixed-size primitive types
+      success = create_fixed_size_child_array(writer, i, child);
+    }
+
+    if (!success) {
+      fprintf(stderr,
+              "batch_to_arrow_array: Failed to create child array %zu (%s)\n",
+              i, col_def->name);
+      // Free the partially allocated child struct itself
+      free(child);
+      array->children[i] = NULL;
+      goto fail_child_alloc; // Trigger cleanup of previous children
+    }
+  }
+
+  // Success
+  return;
+
+// Error handling: Clean up allocations
+fail_child_alloc: // Renamed label for clarity
+  fprintf(stderr, "Error creating Arrow array for batch, cleaning up partially "
+                  "created array.\n");
+  // Release already created children and their buffers
+  if (array->children) {
+    // Iterate through all potential children indices
+    for (size_t j = 0; j < writer->num_columns; ++j) {
+      // Only cleanup if the child pointer is valid (was allocated)
+      if (array->children[j]) {
+        // Child-specific buffers are freed by the child's release function if
+        // set. If the helper failed before setting release, buffers might leak.
+        // However, the helpers aim to clean up their own allocations on
+        // failure.
+        if (array->children[j]->release) {
+          array->children[j]->release(array->children[j]);
+        } else {
+          // If release wasn't set (e.g., helper failed early), free known
+          // pointers
+          if (array->children[j]->buffers) {
+            // Helpers are responsible for freeing buffers[0], buffers[1] etc.
+            // on failure. If they fail *before* allocating buffers array, this
+            // won't run. If they fail *after* allocating buffers array but
+            // before setting buffers[n], those pointers will be NULL.
+            // free(NULL) is safe. We primarily need to free the buffers array
+            // itself here.
+            free((void *)array->children[j]->buffers);
+          }
+        }
+        // Free the child struct itself
+        free(array->children[j]);
+        array->children[j] = NULL;
+      }
+    }
+    // Free the children array itself
+    free(array->children);
+    array->children = NULL;
+    array->n_children = 0; // Reflect partially cleaned state
+  }
+fail_children_alloc:
+  free((void **)array->buffers); // Free the top-level buffers array
+  array->buffers = NULL;
+  array->n_buffers = 0;
+fail_top_buffers:
+  // Mark array as unusable by clearing fields, release should be NULL
+  array->release = NULL;
+  array->length = 0;
+  memset(array, 0, sizeof(struct ArrowArray)); // Clear remaining fields
+}
+
+// Callback for getting schema from stream
+int get_schema(struct ArrowArrayStream *stream,
+               struct ArrowSchema *out_schema) {
+  RowWriter *writer = (RowWriter *)stream->private_data;
+  // Use schema info stored in the writer
+  create_schema(out_schema, writer->schema_def, writer->num_columns);
+  return 0;
+}
+
+// Callback for getting next batch from stream
+int get_next(struct ArrowArrayStream *stream, struct ArrowArray *out_array) {
+  RowWriter *writer = (RowWriter *)stream->private_data;
+
+  // End of stream signal from C side? (If current_row is 0 after a flush)
+  if (writer->current_row == 0) {
+    memset(out_array, 0, sizeof(struct ArrowArray));
+    out_array->release = release_array; // Still needs a valid release callback
+    return 0; // Indicate end of stream for this specific call
+  }
+
+  // Convert current batch to arrow array
+  batch_to_arrow_array(writer, out_array);
+
+  // Check if batch_to_arrow_array failed (indicated by length 0 and release
+  // NULL)
+  if (out_array->release == NULL && out_array->length == 0 &&
+      writer->current_row > 0) {
+    fprintf(
+        stderr,
+        "get_next: batch_to_arrow_array failed to produce a valid array.\n");
+    // Mark stream as failed? Arrow C Stream doesn't have a specific error code
+    // return here, but the FFI layer in Rust should see the NULL handle from
+    // init/write_batch. We return 0 but the out_array is invalid.
+    return 0; // Or maybe return an error code if the spec allows? Let's stick
+              // to 0.
+  }
+
+  // Clear/reset the writer's internal batch buffers for the next batch
+  writer->current_row = 0;
+  writer->string_buffer_used = 0;
+  writer->binary_buffer_used = 0;
+  // Null flags buffers don't strictly need resetting if they are fully
+  // overwritten by the next batch's add_row calls before the next flush.
+  // However, zeroing them might prevent stale flags if a batch is partially
+  // filled. for (size_t col_idx = 0; col_idx < writer->num_columns; ++col_idx)
+  // {
+  //   if (writer->column_null_flags[col_idx]) {
+  //     memset(writer->column_null_flags[col_idx], 0, writer->batch_size *
+  //     sizeof(bool));
+  //   }
+  // }
+
+  return 0; // Indicate success producing a batch (or empty batch if current_row
+            // was 0 initially)
+}
+
+// Callback for getting last error from stream
+const char *get_last_error(struct ArrowArrayStream *stream) { return NULL; }
+
+// Callback for releasing stream
+void release_stream(struct ArrowArrayStream *stream) {
+  if (!stream->release)
+    return;
+  // We don't own the writer, so just clear the private data pointer
+  stream->private_data = NULL;
+  stream->release = NULL;
+}
+
+// Add a row to the writer
+int row_writer_add_row(RowWriter *writer, const void **row_values,
+                       const bool *is_null_flags, const size_t *row_sizes) {
+  // Check if batch is full
+  if (writer->current_row >= writer->batch_size) {
+    // Batch full, flush required before adding new row
+    if (!row_writer_flush(writer)) {
+      fprintf(stderr, "row_writer_add_row: Failed to flush full batch.\n");
+      return 0; // Indicate failure to add row because flush failed
+    }
+    // After successful flush, current_row is 0, buffers are reset, ready for
+    // new batch
+    assert(writer->current_row == 0);
+    assert(writer->string_buffer_used == 0);
+    assert(writer->binary_buffer_used == 0);
+  }
+
+  // Add values to the correct column buffers based on schema
+  int64_t current_idx = writer->current_row;
+  for (size_t i = 0; i < writer->num_columns; ++i) {
+    bool is_null = writer->schema_def[i].nullable && is_null_flags[i];
+
+    // Set null flag
+    if (writer->schema_def[i].nullable) {
+      // Ensure null buffer exists (allocated in create)
+      if (writer->column_null_flags[i]) {
+        writer->column_null_flags[i][current_idx] = is_null;
+      } else {
+        fprintf(stderr,
+                "Error: Null buffer missing for nullable column %zu (%s)\n", i,
+                writer->schema_def[i].name);
+        // This indicates a bug in create
+        return 0; // Indicate error
+      }
+    } else if (is_null) {
+      // Error: tried to add null to a non-nullable column
+      fprintf(stderr,
+              "Error: Attempted to add NULL to non-nullable column %zu (%s)\n",
+              i, writer->schema_def[i].name);
+      return 0; // Indicate error
+    }
+
+    // Copy data if not null
+    if (!is_null) {
+      const char *format = writer->schema_def[i].format;
+      const void *source_value = row_values[i];
+      int success = 0;
+
+      // Handle variable-length types
+      if (format[0] == 'u' ||
+          format[0] ==
+              'U') { // String: copy to string_data_buffer, store offset
+        success = add_string_value(writer, i, current_idx,
+                                   (const char *)source_value);
+
+      } else if (format[0] == 'z' ||
+                 format[0] == 'Z') { // Binary: copy to binary_data_buffer,
+                                     // store offset/size
+        size_t binary_size = row_sizes[i]; // Get size from input array
+        success =
+            add_binary_value(writer, i, current_idx, source_value, binary_size);
+
+      } else { // Fixed-size primitive types
+        success = add_fixed_size_value(writer, i, current_idx, source_value);
+      }
+
+      if (!success) {
+        fprintf(stderr, "Failed to add value for column %zu (row %ld)\n", i,
+                current_idx);
+        // Error already printed by helper. Maybe mark row as failed?
+        // For now, return 0 to indicate row add failure.
+        return 0;
+      }
+    } else {
+      // Value is null. Clear the corresponding slot in the column buffer.
+      const char *format = writer->schema_def[i].format;
+      size_t element_size = 0;
+      if (format[0] == 'u' || format[0] == 'U')
+        element_size = sizeof(int32_t);
+      else if (format[0] == 'z' || format[0] == 'Z')
+        element_size = sizeof(BinaryOffsetSize);
+      else
+        element_size = get_type_size_from_format(format);
+
+      if (element_size > 0) {
+        void *target_col_buffer = writer->column_data_buffers[i];
+        void *dest = (char *)target_col_buffer + current_idx * element_size;
+        memset(dest, 0, element_size); // Zero out offset, offset/size struct,
+                                       // or fixed value
+      }
+    }
+  }
+
+  writer->current_row++;
+  return 1;
+}
+
+// Helper function to add a fixed-size value to the appropriate column buffer
+static int add_fixed_size_value(RowWriter *writer, size_t col_idx,
+                                int64_t row_idx, const void *value) {
+  const char *format = writer->schema_def[col_idx].format;
+  void *target_col_buffer = writer->column_data_buffers[col_idx];
+  size_t type_size = get_type_size_from_format(format);
+
+  if (type_size > 0) {
+    // Calculate target address: buffer_start + index * type_size
+    void *dest = (char *)target_col_buffer + row_idx * type_size;
+    memcpy(dest, value, type_size);
+    return 1; // Success
+  } else {
+    fprintf(stderr,
+            "Internal Error: add_fixed_size_value called for non-fixed-size "
+            "format %s (col %zu)\n",
+            format, col_idx);
+    return 0; // Failure
+  }
+}
+
+// Helper function to add a string value
+// Copies the string into the contiguous string buffer and stores the offset.
+// Handles buffer full conditions by dynamically resizing the buffer.
+static int add_string_value(RowWriter *writer, size_t col_idx, int64_t row_idx,
+                            const char *value) {
+  void *target_col_buffer = writer->column_data_buffers[col_idx];
+  size_t str_len = strlen(value) + 1; // Include null terminator
+
+  // Check for buffer space and resize if necessary
+  if (writer->string_buffer_used + str_len > writer->string_buffer_size) {
+    size_t needed_size = writer->string_buffer_used + str_len;
+    // Grow by at least 1.5x or the needed size, whichever is larger
+    size_t new_size =
+        writer->string_buffer_size + (writer->string_buffer_size / 2);
+    if (new_size < needed_size) {
+      new_size = needed_size;
+    }
+    // Add some headroom (e.g., another default block size) to avoid frequent
+    // reallocs
+    new_size +=
+        DEFAULT_STRING_BUFFER_SIZE / 4; // Add 25% of default as headroom
+
+    // fprintf(stderr, "DEBUG: Resizing string buffer from %zu to %zu (needed
+    // %zu)\n", writer->string_buffer_size, new_size, needed_size); // Optional
+    // debug
+
+    char *new_buffer = (char *)realloc(writer->string_data_buffer, new_size);
+    if (!new_buffer) {
+      fprintf(stderr,
+              "Error: Failed to reallocate string buffer to %zu bytes "
+              "(col %zu, row %ld)\n",
+              new_size, col_idx, row_idx);
+      // Flush is not easily possible here as the current row is incomplete.
+      return 0; // Failure
+    }
+    writer->string_data_buffer = new_buffer;
+    writer->string_buffer_size = new_size;
+  }
+
+  // Store offset in the column buffer
+  int32_t *offset_buffer = (int32_t *)target_col_buffer;
+  offset_buffer[row_idx] = (int32_t)writer->string_buffer_used;
+
+  // Copy data to string buffer
+  memcpy(writer->string_data_buffer + writer->string_buffer_used, value,
+         str_len);
+  writer->string_buffer_used += str_len;
+  return 1; // Success
+}
+
+// Helper function to add a binary value
+// Copies the data into the contiguous binary buffer and stores offset/size.
+// Handles buffer full conditions by dynamically resizing the buffer.
+static int add_binary_value(RowWriter *writer, size_t col_idx, int64_t row_idx,
+                            const void *value, size_t size) {
+  void *target_col_buffer = writer->column_data_buffers[col_idx];
+
+  // Check for buffer space and resize if necessary
+  if (writer->binary_buffer_used + size > writer->binary_buffer_size) {
+    size_t needed_size = writer->binary_buffer_used + size;
+    // Grow by at least 1.5x or the needed size, whichever is larger
+    size_t new_size =
+        writer->binary_buffer_size + (writer->binary_buffer_size / 2);
+    if (new_size < needed_size) {
+      new_size = needed_size;
+    }
+    // Add some headroom (e.g., another default block size) to avoid frequent
+    // reallocs
+    new_size +=
+        DEFAULT_BINARY_BUFFER_SIZE / 4; // Add 25% of default as headroom
+
+    // fprintf(stderr, "DEBUG: Resizing binary buffer from %zu to %zu (needed
+    // %zu)\n", writer->binary_buffer_size, new_size, needed_size); // Optional
+    // debug
+
+    uint8_t *new_buffer =
+        (uint8_t *)realloc(writer->binary_data_buffer, new_size);
+    if (!new_buffer) {
+      fprintf(stderr,
+              "Error: Failed to reallocate binary buffer to %zu bytes "
+              "(col %zu, row %ld)\n",
+              new_size, col_idx, row_idx);
+      // Flush is not easily possible here as the current row is incomplete.
+      return 0; // Failure
+    }
+    writer->binary_data_buffer = new_buffer;
+    writer->binary_buffer_size = new_size;
+  }
+
+  // Store offset and size in the column buffer
+  BinaryOffsetSize *offset_size_buffer = (BinaryOffsetSize *)target_col_buffer;
+  offset_size_buffer[row_idx].offset = (int32_t)writer->binary_buffer_used;
+  offset_size_buffer[row_idx].size = (int32_t)size;
+
+  // Copy data to binary buffer
+  memcpy(writer->binary_data_buffer + writer->binary_buffer_used, value, size);
+  writer->binary_buffer_used += size;
+  return 1; // Success
+}
+
+// Flush the current batch to the file
+int row_writer_flush(RowWriter *writer) {
+  if (writer->current_row == 0) {
+    return 1; // Nothing to flush
+  }
+
+  // Save the current row count before we potentially reset it in get_next
+  int64_t rows_in_batch = writer->current_row;
+
+  // Set up Arrow stream for the current batch
+  struct ArrowArrayStream stream;
+  memset(&stream, 0, sizeof(struct ArrowArrayStream));
+
+  stream.get_schema = get_schema;
+  stream.get_next = get_next; // get_next will use and clear the current batch
+  stream.get_last_error = get_last_error;
+  stream.release = release_stream; // Release stream, not the writer
+  stream.private_data = writer;    // Pass writer to callbacks
+
+  int result = 0;
+  if (writer->rust_writer_handle == NULL) {
+    // First flush: Initialize the Rust writer and write the first batch
+    printf("Initializing Parquet stream writer and writing first batch (%ld "
+           "rows)...\n",
+           rows_in_batch);
+    writer->rust_writer_handle =
+        parquet_stream_writer_init(&stream, writer->filename);
+    if (writer->rust_writer_handle == NULL) {
+      fprintf(stderr, "Failed to initialize Parquet stream writer\n");
+      result = -1; // Indicate failure
+    } else {
+      result = 0; // Indicate success (init includes first write)
+    }
+  } else {
+    // Subsequent flush: Write the next batch using the existing writer handle
+    // printf("Writing subsequent Parquet stream batch (%ld rows)...\n",
+    // rows_in_batch);
+    result =
+        parquet_stream_writer_write_batch(writer->rust_writer_handle, &stream);
+    if (result != 0) {
+      fprintf(stderr,
+              "Failed to write subsequent batch to Parquet stream file\n");
+    }
+  }
+
+  // Important: The get_next callback (called by Rust functions)
+  // consumes the batch data and resets writer->current_row.
+  // We only update total_rows if the write was successful.
+  if (result == 0) {
+    writer->total_rows += rows_in_batch;
+  } else {
+    // If write failed, stream release might not have happened correctly in
+    // Rust. We might need to manually release C-side stream resources if
+    // applicable, but ArrowArrayStream created here has minimal C resources
+    // outside get_next. The primary resource is the batch data, which get_next
+    // should handle even on error. We should probably ensure `release_stream`
+    // is robust or called manually here.
+    if (stream.release) {
+      // Call release manually if we suspect Rust didn't
+      // release_stream(&stream);
+      // ^-- Be cautious: might double-release if Rust *did* release.
+      // For now, rely on Rust's error handling in read_next_batch to release.
+    }
+  }
+
+  // Reset batch strings if they weren't freed by get_next (e.g., on error
+  // before get_next runs?) This shouldn't be necessary if get_next always runs
+  // or handles its own cleanup. for (int64_t i = 0; i < rows_in_batch; i++) {
+  //    writer->string_values[i] = NULL; // Mark as potentially freed
+  // }
+  // writer->current_row = 0; // Already done by get_next
+
+  return (result == 0);
+}
+
+// Finish writing and close the writer
+int row_writer_close(RowWriter *writer) {
+  int flush_result = 1;
+
+  // Flush any remaining rows
+  if (writer->current_row > 0) {
+    printf("Flushing final batch (%ld rows)...\n", writer->current_row);
+    flush_result = row_writer_flush(writer);
+    if (!flush_result) {
+      fprintf(stderr, "Failed to flush final batch.\n");
+      // Don't attempt to close if final flush failed,
+      // but still report failure.
+    }
+  }
+
+  int close_result = 0;
+  if (writer->rust_writer_handle != NULL) {
+    printf("Closing Parquet stream writer...\n");
+    close_result = parquet_stream_writer_close(writer->rust_writer_handle);
+    if (close_result != 0) {
+      fprintf(stderr, "Failed to close Parquet stream writer cleanly.\n");
+    }
+    writer->rust_writer_handle = NULL; // Mark as closed
+  } else {
+    if (writer->total_rows == 0) {
+      // No rows were ever written, no handle created.
+      printf("No data written, nothing to close.\n");
+    } else {
+      // Handle exists but is NULL? Should not happen if flush_result was ok.
+      fprintf(stderr, "Warning: Writer handle is NULL after writing data, "
+                      "potential issue.\n");
+    }
+  }
+
+  if (flush_result && close_result == 0) {
+    printf("Successfully wrote %ld total rows to %s\n", writer->total_rows,
+           writer->filename);
+  } else {
+    fprintf(stderr, "Writer finished with errors. Total rows reported: %ld\n",
+            writer->total_rows);
+  }
+
+  return (flush_result && close_result == 0);
+}
+
+// Helper function to prepare data for a single row based on its index
+// This populates the arrays needed by row_writer_add_row
+static void
+prepare_row_data(int64_t row_index, size_t num_columns,
+                 const void **out_row_values, /* Array of pointers to data */
+                 bool *out_is_null_flags,     /* Array of bool flags */
+                 size_t *out_row_sizes        /* Array of sizes for binary */
+) {
+  // --- Data Preparation for one row ---
+  // This section MUST match the schema_def defined in main.
+
+  // Declare local temporary storage for the current row's data
+  // Need static storage duration so their addresses remain valid after
+  // returning, but before the data is copied by row_writer_add_row. WARNING:
+  // This makes the function non-reentrant (cannot be called concurrently).
+  static int32_t local_id;
+  static uint64_t local_id2;
+  static double local_value;
+  static char local_label_buffer[64];
+  static uint8_t local_binary_buffer[128]; // Increased size slightly
+
+  // Initialize sizes to 0
+  memset(out_row_sizes, 0, sizeof(size_t) * num_columns);
+
+  // Column 0: "id", format "i" (int32), nullable=false
+  local_id = (int32_t)row_index;
+  out_row_values[0] = &local_id;
+  out_is_null_flags[0] = false;
+
+  // Column 1: "id2", format "L" (uint64), nullable=false
+  local_id2 = (uint64_t)row_index;
+  out_row_values[1] = &local_id2;
+  out_is_null_flags[1] = false;
+
+  // Column 2: "value", format "g" (double), nullable=true
+  local_value = row_index * 0.01;
+  bool is_value_null = (row_index % 5 == 0); // Make every 5th value null
+  out_row_values[2] = &local_value;
+  out_is_null_flags[2] = is_value_null;
+
+  // Column 3: "label", format "u" (string), nullable=false
+  snprintf(local_label_buffer, sizeof(local_label_buffer), "label-%ld",
+           row_index);
+  out_row_values[3] = local_label_buffer;
+  out_is_null_flags[3] = false;
+
+  // Column 4: "binary_data", format "z" (binary), nullable=false
+  // Create data like "bin-<i>\0<suffix>"
+  int prefix_len = snprintf((char *)local_binary_buffer,
+                            sizeof(local_binary_buffer), "bin-%ld", row_index);
+  // Add embedded null (if space allows)
+  if (prefix_len > 0 &&
+      prefix_len + 6 <
+          sizeof(local_binary_buffer)) { // prefix + null + suffix + final_null
+    local_binary_buffer[prefix_len] = 0x00; // Embedded null
+    snprintf((char *)local_binary_buffer + prefix_len + 1,
+             sizeof(local_binary_buffer) - prefix_len - 1, "-sufx");
+  } else if (prefix_len > 0 && prefix_len < sizeof(local_binary_buffer)) {
+    // Ensure null termination if suffix doesn't fit
+    local_binary_buffer[prefix_len] = 0x00;
+  } else {
+    // Handle snprintf error or zero length prefix
+    prefix_len = 3;                        // Length of "ERR"
+    if (sizeof(local_binary_buffer) > 3) { // Check space for "ERR"+\0
+      local_binary_buffer[0] = 'E';
+      local_binary_buffer[1] = 'R';
+      local_binary_buffer[2] = 'R';
+      local_binary_buffer[3] = 0;
+    } else {
+      // Not enough space even for "ERR", maybe return empty?
+      prefix_len = 0;
+      if (sizeof(local_binary_buffer) > 0)
+        local_binary_buffer[0] = 0;
+    }
+  }
+
+  // Calculate the actual size of the binary data created, including embedded
+  // nulls
+  size_t binary_data_size =
+      strlen((char *)local_binary_buffer); // Find first null
+  // Check if there was a suffix after the embedded null
+  if (local_binary_buffer[binary_data_size] == 0x00 &&
+      binary_data_size + 1 < sizeof(local_binary_buffer)) {
+    // Include the embedded null and the suffix length
+    binary_data_size +=
+        1 + strlen((char *)local_binary_buffer + binary_data_size + 1);
+  }
+
+  out_row_values[4] = local_binary_buffer;
+  out_is_null_flags[4] = false;
+  out_row_sizes[4] = binary_data_size; // Set size for column 4
+
+  // --- End Data Preparation ---
+}
+
+// Main function
+int main(int argc, char *argv[]) {
+  if (argc < 4) {
+    fprintf(stderr, "Usage: %s <output_file> <num_rows> <batch_size>\n",
+            argv[0]);
+    return 1;
+  }
+
+  // Define the schema (column names, types, nullability) locally within main
+  // See Arrow C Data Interface format strings:
+  // https://arrow.apache.org/docs/format/CDataInterface.html#data-type-description-format-strings
+  const UserColumnDef schema_def[] = {
+      {.name = "id", .format = "i", .nullable = false},    // int32
+      {.name = "id2", .format = "L", .nullable = false},   // uint64
+      {.name = "value", .format = "g", .nullable = true},  // double (nullable)
+      {.name = "label", .format = "u", .nullable = false}, // string (utf-8)
+      {.name = "binary_data", .format = "z", .nullable = false} // binary
+  };
+  const size_t num_columns = sizeof(schema_def) / sizeof(schema_def[0]);
+
+  // IMPORTANT: If you change the schema definition above, you MUST also update
+  // the data generation logic below (inside the loop) and the
+  // `batch_to_arrow_array` function to match the new structure, types,
+  // nullability.
+
+  const char *output_file = argv[1];
+  int64_t num_rows = atoll(argv[2]);
+  int64_t batch_size = atoll(argv[3]);
+
+  if (num_rows <= 0 || batch_size <= 0) {
+    fprintf(stderr, "num_rows and batch_size must be positive\n");
+    return 1;
+  }
+
+  // Cap batch_size to a reasonable value
+  if (batch_size > 1000000) {
+    fprintf(stderr, "Warning: Limiting batch size to 1,000,000 rows\n");
+    batch_size = 1000000;
+  }
+
+  printf("Writing to Parquet file: %s\n", output_file);
+  printf("Number of rows: %ld\n", num_rows);
+  printf("Batch size: %ld\n", batch_size);
+
+  // Create a single writer for the whole file
+  RowWriter *writer =
+      row_writer_create(output_file, batch_size, schema_def, num_columns);
+  if (!writer) {
+    fprintf(stderr, "Failed to create row writer\n");
+    return 1;
+  }
+
+  // Measure time
+  clock_t start = clock();
+
+  // Allocate pointers/flags/sizes arrays that will be populated by
+  // prepare_row_data and passed to add_row
+  const void *row_values[num_columns];
+  bool is_null_flags[num_columns];
+  size_t row_sizes[num_columns];
+
+  // Add all rows
+  for (int64_t i = 0; i < num_rows; i++) {
+
+    // Prepare the data for the current row using the helper function
+    // This function now uses internal static buffers
+    prepare_row_data(i, num_columns, row_values, is_null_flags, row_sizes);
+
+    // Add the prepared row data to the writer
+    if (!row_writer_add_row(writer, row_values, is_null_flags, row_sizes)) {
+      fprintf(stderr, "Failed to add row %ld\n", i);
+      row_writer_free(writer);
+      return 1;
+    }
+
+    // Progress report (kept in the loop)
+    if (i > 0 && i % 1000000 == 0) {
+      printf("Added %ld rows to memory...\n", i);
+    }
+  }
+
+  // Now flush everything at once
+  printf("Flushing all rows to Parquet file...\n");
+  if (!row_writer_flush(writer)) {
+    fprintf(stderr, "Failed to flush data\n");
+    row_writer_free(writer);
+    return 1;
+  }
+
+  // Close writer
+  if (!row_writer_close(writer)) {
+    fprintf(stderr, "Failed to close writer\n");
+    row_writer_free(writer);
+    return 1;
+  }
+
+  // Free resources
+  row_writer_free(writer);
+
+  // Calculate elapsed time
+  clock_t end = clock();
+  double elapsed = (double)(end - start) / CLOCKS_PER_SEC;
+
+  printf("Completed in %.2f seconds\n", elapsed);
+
+  return 0;
+}
+
+// Helper function to get type size in bytes from Arrow format string
+// For variable types ('u', 'z'), returns the size of the element stored
+// in the column buffer (offset or offset/size struct), not the data itself.
+// Returns 0 for unsupported types or nested types.
+size_t get_type_size_from_format(const char *format) {
+  if (!format || format[0] == '\0')
+    return 0;
+
+  // Based on:
+  // https://arrow.apache.org/docs/format/CDataInterface.html#data-type-description-format-strings
+  switch (format[0]) {
+  case 'n':
+    return 0; // Null type has no buffer stored per row
+  case 'b':
+    return sizeof(bool); // Boolean (usually 1 byte)
+  case 'c':
+    return sizeof(int8_t);
+  case 'C':
+    return sizeof(uint8_t);
+  case 's':
+    return sizeof(int16_t);
+  case 'S':
+    return sizeof(uint16_t);
+  case 'i':
+    return sizeof(int32_t);
+  case 'I':
+    return sizeof(uint32_t);
+  case 'l':
+    return sizeof(int64_t);
+  case 'L':
+    return sizeof(uint64_t);
+  // case 'e': return sizeof(float16); // Needs specific handling/library
+  case 'f':
+    return sizeof(float);
+  case 'g':
+    return sizeof(double);
+  case 'z': // Fall-through: Variable-size Binary
+  case 'Z': // Fall-through: Large variable-size Binary
+    // Store BinaryOffsetSize struct { int32_t offset; int32_t size; }
+    return sizeof(BinaryOffsetSize);
+  case 'u': // Fall-through: Variable-size UTF-8 String
+  case 'U': // Fall-through: Large variable-size UTF-8 String
+    // Store offset (int32_t) into string_data_buffer
+    return sizeof(int32_t);
+  case 'w': // Fixed-size binary (requires size info from format)
+    // Example: "w:10" means 10 bytes.
+    // Need parsing logic here if we want to support this.
+    // If supported, return the parsed size. For now, return 0.
+    return 0; // Not supported yet
+  // Time / Date types
+  case 't':
+    switch (format[1]) {
+    case 'd': // Date
+      if (format[2] == 'D')
+        return sizeof(int32_t); // Days since epoch
+      if (format[2] == 'm')
+        return sizeof(int64_t); // Milliseconds since epoch
+      break;
+    case 't': // Time
+      if (format[2] == 's')
+        return sizeof(int32_t); // Second
+      if (format[2] == 'm')
+        return sizeof(int32_t); // Millisecond
+      if (format[2] == 'u')
+        return sizeof(int64_t); // Microsecond
+      if (format[2] == 'n')
+        return sizeof(int64_t); // Nanosecond
+      break;
+    case 's': // Timestamp
+      // Format: "ts{unit}:{timezone}" -> need unit
+      // Example: "tss:", "tsm:", "tsu:", "tsn:"
+      if (strchr("smun", format[2]))
+        return sizeof(int64_t);
+      break;
+      // Other time types (Duration 'td', Interval 'ti') not handled yet
+    }
+    return 0; // Unsupported time/date format
+
+  // Nested types (+l, +L, +s, +m, +w, +r) are not directly sized here
+  // They don't have a single primitive data buffer in the same way.
+  case '+':
+    return 0; // Not handled
+
+  default:
+    fprintf(
+        stderr,
+        "Warning: Unknown format character '%c' in get_type_size_from_format\n",
+        format[0]);
+    return 0; // Unknown format
+  }
+}
