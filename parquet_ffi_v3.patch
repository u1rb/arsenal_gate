+  } else {
+    fprintf(stderr, "Failed to allocate memory for binary data\n");
+    binary.length = 0; // Ensure length is 0 on allocation failure
+  }
+  
+  return binary;
+}
+
+// Helper function to free binary data
+void free_binary_data(BinaryData *binary) {
+  if (binary && binary->data) {
+    free(binary->data);
+    binary->data = NULL;
+    binary->length = 0;
+  }
+}
+
+int main(int argc, char *argv[]) {
+  parquet_init_tracing_with_level(ParquetLogError);
+
+  if (argc < 3) {
+    fprintf(stderr, "Usage: %s <filename> <total_rows> [buffer_size]\n", argv[0]);
+    return 1;
+  }
+  
+  char *filename = argv[1];
+  size_t total_rows = atoi(argv[2]);
+  size_t buffer_size = (argc > 3) ? atoi(argv[3]) : 1000; // Default buffer size is 1000
+
+  
+  if (buffer_size == 0) {
+    fprintf(stderr, "Buffer size must be greater than 0\n");
+    return 1;
+  }
+  
+  printf("Writing %zu rows to %s with buffer size of %zu\n", total_rows, filename, buffer_size);
+  
+  // Define schema
+  const char *column_names[] = {"integer_values", "int8_values", "uint8_values", "double_values", "string_values", "binary_values", "uint64_values"};
+  size_t column_count = sizeof(column_names) / sizeof(column_names[0]);
+  
+  ParquetDataType column_types[] = {ParquetInt32, ParquetInt8, ParquetUint8, ParquetDouble, ParquetString, ParquetBinary, ParquetUint64};
+  bool column_nullable[] = {true, true, true, true, true, true, true};
+  
+  // Create column definitions
+  ParquetColumnDef *columns = (ParquetColumnDef*)malloc(column_count * sizeof(ParquetColumnDef));
+  if (!columns) {
+    fprintf(stderr, "Memory allocation failed\n");
+    return 1;
+  }
+  
+  for (size_t i = 0; i < column_count; i++) {
+    columns[i].name = column_names[i];
+    columns[i].data_type = column_types[i];
+    columns[i].nullable = column_nullable[i];
+    
+    // Set appropriate encoding based on column type
+    if (column_types[i] == ParquetInt32 || column_types[i] == ParquetInt8 || 
+        column_types[i] == ParquetUint8 || column_types[i] == ParquetUint64) {
+      // Use delta encoding for integer columns
+      columns[i].encoding = ParquetEncodingDeltaBinaryPacked;
+    } else if (column_types[i] == ParquetString) {
+      // For string columns we enable dictionary at the writer level
+      // But use plain encoding at the column level as dictionary isn't a valid column encoding
+      columns[i].encoding = ParquetEncodingPlain;
+    } else if (column_types[i] == ParquetBinary) {
+      // Use delta length encoding for binary columns
+      columns[i].encoding = ParquetEncodingDeltaLengthByteArray;
+    } else {
+      // Default to plain encoding for other types
+      columns[i].encoding = ParquetEncodingPlain;
+    }
+  }
+  
+  // Configure writer options
+  ParquetWriterOptions options;
+  options.row_group_size = 1024;
+  options.compression = ParquetCompressionSnappy;
+  options.enable_dictionary = true;
+  options.enable_statistics = true;
+  options.enable_bloom_filter = true;
+  options.row_buffer_size = buffer_size;
+  
+  // Open the writer
+  ParquetWriterHandle *writer = NULL;
+  ParquetError error = parquet_writer_open(filename, columns, column_count, options, &writer);
+  free(columns); // Free columns array after use
+  
+  if (!check_error(error, "opening writer", NULL)) {
+    return 1;
+  }
+  
+  printf("Writer created successfully\n");
+  
+  // Start row group (optional - the writer will handle row groups automatically)
+  error = parquet_writer_start_row_group(writer);
+  if (!check_error(error, "starting row group", writer)) {
+    return 1;
+  }
+  
+  // Write rows one by one
+  for (size_t i = 0; i < total_rows; i++) {
+    // Prepare row data
+    int32_t int_value = i;
+    int8_t int8_value = (int8_t)(i % 128);  // Limit to int8 range
+    uint8_t uint8_value = (uint8_t)(i % 256); // Limit to uint8 range
+    double double_value = i * 1.5;
+    char *string_value = create_sample_string(i);
+    BinaryData binary_value = create_sample_binary(i);
+    uint64_t uint64_value = i * 10000000000ULL; // Large uint64 value
+    
+    // Create array of value pointers
+    const void *values[7];
+    values[0] = &int_value;
+    values[1] = &int8_value;
+    values[2] = &uint8_value;
+    values[3] = &double_value;
+    values[4] = string_value;
+    
+    // For binary data, we need to provide both pointer and length
+    // We create a small struct on the stack to hold this information
+    struct {
+      const uint8_t *data;
+      size_t length;
+    } binary_info = {binary_value.data, binary_value.length};
+    values[5] = &binary_info;
+    values[6] = &uint64_value;
+    
+    // Create validity flags (all valid in this example)
+    bool is_valid[7] = {true, true, true, true, true, true, true};
+    
+    // Make some values NULL to demonstrate null handling
+    if (i % 7 == 0) is_valid[0] = false;  // Make some int values NULL
+    if (i % 9 == 0) is_valid[1] = false;  // Make some int8 values NULL
+    if (i % 15 == 0) is_valid[2] = false; // Make some uint8 values NULL
+    if (i % 11 == 0) is_valid[3] = false; // Make some double values NULL
+    if (i % 5 == 0) is_valid[4] = false;  // Make some string values NULL
+    if (i % 13 == 0) is_valid[5] = false; // Make some binary values NULL
+    if (i % 17 == 0) is_valid[6] = false; // Make some uint64 values NULL
+    
+    // Write the row
+    error = parquet_writer_write_row(writer, values, is_valid);
+    
+    // Free the string and binary data after use
+    free(string_value);
+    free_binary_data(&binary_value);
+    
+    if (!check_error(error, "writing row", writer)) {
+      return 1;
+    }
+    
+    // Print progress every 5% or 5M rows, whichever is less
+    size_t report_interval = (total_rows / 20) < 5000000 ? (total_rows / 20) : 5000000;
+    if (report_interval > 0 && i % report_interval == 0) {
+      printf("Wrote %zu rows (%.1f%%)\n", i, (float)i / total_rows * 100.0);
+    }
+  }
+  
+  // Flush any remaining buffered rows
+  error = parquet_writer_flush_buffer(writer);
+  if (!check_error(error, "flushing buffer", writer)) {
+    return 1;
+  }
+  
+  // End row group
+  error = parquet_writer_end_row_group(writer);
+  if (!check_error(error, "ending row group", writer)) {
+    return 1;
+  }
+  
+  // Close the writer to finalize the file
+  error = parquet_writer_close(writer);
+  if (!check_error(error, "closing writer", NULL)) {
+    return 1;
+  }
+  
+  printf("Parquet file written successfully with %zu rows\n", total_rows);
+  
+  return 0;
+} 
