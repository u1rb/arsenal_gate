+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/time.h>
+#include <time.h>
+// Include for aligned_alloc if needed (usually in stdlib.h with C11)
+
+/* --- Packet Stream Abstraction --- */
+
+typedef struct PacketStream PacketStream; // Forward declaration
+
+/* Packet data structure */
+typedef struct {
+  uint64_t key;   // Key for sorting/comparison
+  uint32_t value; // Some payload data
+} Packet;
+
+/* Run structures for each stream */
+typedef struct {
+  Packet *buf;   // circular buffer (size = WINDOW = 4096)
+  uint32_t head; // index of next element to read
+  uint32_t tail; // index of first empty slot
+  bool eof;      // producer delivered last batch
+
+  // For lazy stream generation
+  uint64_t next_key;   // Next key to generate (increasing)
+  uint64_t total_size; // Total expected size of this run
+  uint32_t produced;   // How many elements we've produced so far
+  uint32_t run_id;     // ID of this run (for key generation)
+} Run;
+
+// Define stream types for _Generic dispatch
+typedef enum { PS_NOMERGE, PS_NAIVE, PS_BINARYHEAP, PS_LOSERTREE } PsKind;
+
+// Forward declarations of concrete state structures
+typedef struct NoMerger NoMerger;
+typedef struct NaiveMerger NaiveMerger;
+typedef struct Merger Merger;
+typedef struct LoserTree LoserTree;
+
+// The stream structure with embedded union for concrete implementations
+struct PacketStream {
+  PsKind kind; // Type tag for dispatch
+  union {
+    NoMerger *no_merger;
+    NaiveMerger *naive_merger;
+    Merger *merger;
+    LoserTree *loser_tree;
+  } impl; // Direct pointers to implementations
+};
+
+// Function declarations for all implementations
+Packet *no_merger_next(NoMerger *nm);
+void no_merger_cleanup(NoMerger *nm);
+Packet *naive_merger_next(NaiveMerger *nm);
+void naive_merger_cleanup(NaiveMerger *nm);
+Packet *merger_next(Merger *m);
+void merger_cleanup(Merger *m);
+Packet *loser_tree_next(LoserTree *t);
+void loser_tree_cleanup(LoserTree *t);
+
+// Optimized next function using _Generic dispatch
+#define packet_stream_next(stream)                                             \
+  ((stream)->kind == PS_NOMERGE ? no_merger_next((stream)->impl.no_merger)     \
+   : (stream)->kind == PS_NAIVE                                                \
+       ? naive_merger_next((stream)->impl.naive_merger)                        \
+   : (stream)->kind == PS_BINARYHEAP                                           \
+       ? merger_next((stream)->impl.merger)                                    \
+       : loser_tree_next((stream)->impl.loser_tree))
+
+// Helper function to release stream resources
+static inline void packet_stream_release(PacketStream *stream) {
+  if (stream) {
+    switch (stream->kind) {
+    case PS_NOMERGE:
+      no_merger_cleanup(stream->impl.no_merger);
+      free(stream->impl.no_merger);
+      break;
+    case PS_NAIVE:
+      naive_merger_cleanup(stream->impl.naive_merger);
+      free(stream->impl.naive_merger);
+      break;
+    case PS_BINARYHEAP:
+      merger_cleanup(stream->impl.merger);
+      free(stream->impl.merger);
+      break;
+    case PS_LOSERTREE:
+      loser_tree_cleanup(stream->impl.loser_tree);
+      free(stream->impl.loser_tree);
+      break;
+    }
+  }
+}
+
+/* --- End Packet Stream Abstraction --- */
+// Add compile flag to enable/disable aligned memory allocation
+// USE_ALIGNED_ALLOC: Define to use aligned memory allocation
+// If not defined, regular malloc will be used instead
+#if defined(USE_ALIGNED_ALLOC)
+#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
+// aligned_alloc is standard in C11
+#define my_aligned_alloc aligned_alloc
+#elif defined(_ISOC11_SOURCE)
+// Or if explicitly requested
+#define my_aligned_alloc aligned_alloc
+#elif defined(_WIN32) || defined(_WIN64)
+#include <malloc.h>                          // For _aligned_malloc on Windows
+static inline void *my_aligned_alloc(size_t alignment, size_t size) {
+  return _aligned_malloc(size, alignment);
+}
+#define free_aligned(ptr) _aligned_free(ptr) // Use corresponding free
+#else
+// Provide a simple fallback if not available - WARN: might not be truly aligned
+// Use posix_memalign on POSIX systems if available
+#if defined(_POSIX_C_SOURCE) && _POSIX_C_SOURCE >= 200112L
+#include <malloc.h> // posix_memalign is often declared here
+static inline void *my_aligned_alloc(size_t alignment, size_t size) {
+  void *ptr = NULL;
+  if (posix_memalign(&ptr, alignment, size) != 0) {
+    return NULL;
+  }
+  return ptr;
+}
+#else               // Fallback to malloc if posix_memalign is not available
+#include <stdlib.h>
+static inline void *my_aligned_alloc(size_t alignment, size_t size) {
+  // Simple malloc fallback - alignment not guaranteed
+  // You might add a warning here in debug builds
+  return malloc(size);
+}
+#endif // POSIX_C_SOURCE
+#endif // defined(__STDC_VERSION__), _ISOC11_SOURCE, _WIN32/_WIN64
+
+// Define a consistent free function
+#ifndef free_aligned
+#define free_aligned(ptr) free(ptr)
+#endif
+#else
+// If USE_ALIGNED_ALLOC is not defined, always use regular malloc
+#include <stdlib.h>
+static inline void *my_aligned_alloc(size_t alignment, size_t size) {
+  (void)alignment; // Suppress unused parameter warning
+  return malloc(size);
+}
+#define free_aligned(ptr) free(ptr)
+#endif // USE_ALIGNED_ALLOC
+
+#define MAXK 1024
+#define WINDOW 4096
+#define INF_KEY 0xFFFFFFFFFFFFFFFFull
+
+/* --- Common --- */
+
+/* Pregenerated random steps to avoid rand() in hot loops */
+static uint64_t random_steps[WINDOW];
+static bool random_steps_initialized = false;
+
+/* Initialize random steps array */
+static void init_random_steps() {
+  if (!random_steps_initialized) {
+    // Use a fixed seed for deterministic key generation during benchmark runs
+    // srand(time(NULL)); // Seed random number generator once
+    srand(12345); // Fixed seed
+    for (int i = 0; i < WINDOW; i++) {
+      random_steps[i] = (rand() % 10) + 1;
+    }
+    random_steps_initialized = true;
+  }
+}
+
+/* Round x up to next power of two. */
+static inline uint32_t pow2_ceil(uint32_t x) {
+  // Clearest and often fastest way for modern compilers
+  if (x <= 1)
+    return 1; // Handle 0 and 1
+    // For C/C++, using __builtin_clz or equivalent intrinsic is often faster
+#if defined(__GNUC__) || defined(__clang__)
+  return 1u << (32 - __builtin_clz(x - 1));
+#else
+  // Portable fallback
+  x--;
+  x |= x >> 1;
+  x |= x >> 2;
+  x |= x >> 4;
+  x |= x >> 8;
+  x |= x >> 16;
+  return x + 1;
+#endif
+}
+
+/* Pull a batch of data into a run's buffer */
+static inline void pull_batch(Run *r) {
+  uint32_t count = 0;
+  Packet *restrict buffer = r->buf; // Use restrict if compiler supports it well
+  uint64_t current_next_key = r->next_key; // Load into local var
+  uint32_t current_produced = r->produced;
+  const uint64_t total_run_size = r->total_size;
+
+  // Determine how many new elements we can potentially generate
+  const uint32_t remaining_in_run =
+      (uint32_t)(total_run_size - current_produced);
+  const uint32_t limit =
+      (WINDOW < remaining_in_run) ? WINDOW : remaining_in_run;
+
+  // Reset head as buffer is being overwritten from the start
+  r->head = 0;
+  r->tail = 0; // Reset tail assuming we fill from index 0
+
+  while (count < limit) {
+    // Use pregenerated random step
+    current_next_key += random_steps[current_produced % WINDOW];
+
+    // Create the packet directly in the buffer
+    buffer[count].key = current_next_key;
+    buffer[count].value = current_produced; // Value could be anything really
+
+    current_produced++;
+    count++;
+  }
+
+  r->tail = count;                // Set tail to the number of elements added
+  r->next_key = current_next_key; // Store updated key back
+  r->produced = current_produced; // Store updated count back
+
+  // Update EOF flag based on whether we produced the full limit
+  // If count < WINDOW, it means we hit the end of the run's data.
+  if (count < WINDOW) {
+    r->eof = true;
+  } else {
+    // Check if we exactly finished the run
+    r->eof = (current_produced >= total_run_size);
+  }
+}
+
+/* --- No Merge Implementation --- */
+
+struct NoMerger {
+  Run *run;                // Pointer to the single run being processed
+  uint64_t processed;      // Counter for processed packets
+  uint64_t total_expected; // Total expected packets for this single run
+};
+
+// Direct function, no stream indirection
+Packet *no_merger_next(NoMerger *nm) {
+  Run *r = nm->run;
+
+  // Check if we've processed everything expected
+  if (nm->processed >= nm->total_expected) {
+    return NULL;
+  }
+
+  // Check if current buffer is exhausted
+  if (r->head >= r->tail) {
+    // If run is already marked EOF and buffer is empty, we are done
+    if (r->eof) {
+      return NULL;
+    }
+
+    // Try to pull a new batch
+    pull_batch(r);
+    // If buffer is still empty after pulling, we are done from this run
+    if (r->tail == 0) {
+      assert(r->eof && "Pull batch returned 0 elements but EOF is not set.");
+      return NULL;
+    }
+    // If pull_batch worked, head is already 0, continue below
+  }
+
+  // Get packet from the current head position
+  Packet *result = &r->buf[r->head];
+  nm->processed++;
+
+  // Advance head for the next call
+  r->head++;
+
+  return result;
+}
+
+void no_merger_cleanup(NoMerger *nm) {
+  // Nothing to free inside NoMerger
+}
+
+int no_merger_init_stream(PacketStream *stream, Run *runs, uint32_t K /* K=1 */,
+                          uint64_t total_expected) {
+  NoMerger *nm = (NoMerger *)malloc(sizeof(NoMerger));
+  if (!nm)
+    return -1; // Allocation failed
+
+  nm->run = &runs[0]; // NoMerger only uses the first run
+  nm->processed = 0;
+  nm->total_expected = total_expected;
+
+  // Reset the specific run
+  nm->run->head = 0;
+  nm->run->tail = 0;
+  nm->run->eof = false;
+  nm->run->produced = 0;
+
+  // Initial batch fill only if needed
+  if (nm->run->produced < nm->run->total_size) {
+    pull_batch(nm->run);
+  } else {
+    nm->run->eof = true; // Already at total size
+  }
+
+  stream->kind = PS_NOMERGE;
+  stream->impl.no_merger = nm;
+  return 0; // Success
+}
+
+/* --- Naive Merge Implementation --- */
+
+struct NaiveMerger {
+  uint32_t K;              // Number of input streams
+  Run *runs;               // Array of runs
+  uint64_t processed;      // Counter for processed packets
+  uint64_t total_expected; // Total expected packets
+};
+
+// Direct function, no stream indirection
+Packet *naive_merger_next(NaiveMerger *nm) {
+  // Check overall processed count first
+  if (nm->processed >= nm->total_expected) {
+    return NULL;
+  }
+
+  // Find minimum element among current stream heads (by checking buffers)
+  int32_t min_idx = -1;
+  uint64_t min_key = INF_KEY; // Use the max possible key value
+
+  for (uint32_t i = 0; i < nm->K; i++) {
+    // Check if the run has data (head < tail)
+    Run *current_run = &nm->runs[i];
+    if (current_run->head < current_run->tail) {
+      // Access key via buffer head
+      uint64_t current_key = current_run->buf[current_run->head].key;
+
+      if (current_key < min_key) {
+        min_key = current_key;
+        min_idx = i;
+      }
+    }
+  }
+
+  // If no stream had data (min_idx remains -1), we are done.
+  if (min_idx == -1) {
+    if (nm->processed < nm->total_expected) {
+      fprintf(stderr,
+              "Warning: Naive merge finished with min_idx -1, but not all "
+              "packets processed. %lu / %lu\n",
+              nm->processed, nm->total_expected);
+    }
+    return NULL;
+  }
+
+  // We found the minimum element at min_idx.
+  Run *winning_run = &nm->runs[min_idx];
+  Packet *result_packet_ptr = &winning_run->buf[winning_run->head];
+
+  nm->processed++; // Increment count *after* successfully finding a packet
+
+  // Advance the head for the winning run
+  winning_run->head++;
+
+  // Check if the winning run's buffer is now empty and try to refill
+  if (winning_run->head >= winning_run->tail) {
+    // Try to refill the buffer only if the run is not already marked EOF
+    if (!winning_run->eof) {
+      pull_batch(winning_run); // This updates tail and eof internally
+    }
+    // Check if the buffer is *still* empty after pulling (or if it was EOF)
+    if (winning_run->tail == 0) {
+      winning_run->eof = true; // Ensure it's marked if pull_batch didn't
+    } else {
+      // Buffer was successfully refilled, reset head
+      winning_run->head = 0;
+    }
+  }
+
+  return result_packet_ptr;
+}
+
+void naive_merger_cleanup(NaiveMerger *nm) {
+  // Nothing to free inside NaiveMerger
+}
+
+int naive_merger_init_stream(PacketStream *stream, Run *runs, uint32_t K,
+                             uint64_t total_expected) {
+  NaiveMerger *nm = (NaiveMerger *)malloc(sizeof(NaiveMerger));
+  if (!nm)
+    return -1;
+
+  nm->K = K;
+  nm->processed = 0;
+  nm->total_expected = total_expected;
+  nm->runs = runs;
+
+  // Reset runs and fetch first elements using pull_batch
+  for (uint32_t i = 0; i < K; i++) {
+    Run *r = &nm->runs[i];
+    r->head = 0;
+    r->tail = 0;
+    r->eof = false;
+    r->produced = 0;
+
+    // Initial fill using the *buffered* pull_batch method
+    if (r->produced < r->total_size) {
+      pull_batch(r); // Fills buffer up to WINDOW or total_size
+    } else {
+      r->eof = true; // Already at total size
+    }
+  }
+
+  stream->kind = PS_NAIVE;
+  stream->impl.naive_merger = nm;
+  return 0; // Success
+}
+
+/* --- Binary Heap Merger Implementation --- */
+
+/* Entry in our heap */
+typedef struct {
+  uint64_t key;       // Current key
+  uint32_t run_index; // Which run it belongs to
+} HeapEntry;
+
+/* Simple K-way merger using min-heap */
+struct Merger {
+  uint32_t K;              // Number of input streams
+  HeapEntry *heap;         // Min-heap of entries
+  uint32_t heap_size;      // Current size of heap
+  Run *runs;               // Array of runs
+  uint64_t processed;      // Counter for processed packets
+  uint64_t total_expected; // Total expected packets
+};
+
+/* Min-heap operations */
+static inline void swap_entries(HeapEntry *a, HeapEntry *b) {
+  HeapEntry temp = *a;
+  *a = *b;
+  *b = temp;
+}
+
+// Restores heap property downwards from index (Iterative version)
+static inline void heapify_down(HeapEntry *heap, uint32_t heap_size,
+                                uint32_t index) {
+  uint32_t current_index = index;
+  while (true) {
+    uint32_t smallest_idx = current_index;
+    uint32_t left_child_idx = 2 * current_index + 1;
+    uint32_t right_child_idx = 2 * current_index + 2;
+
+    // Check left child
+    if (left_child_idx < heap_size &&
+        heap[left_child_idx].key < heap[smallest_idx].key)
+      smallest_idx = left_child_idx;
+
+    // Check right child
+    if (right_child_idx < heap_size &&
+        heap[right_child_idx].key < heap[smallest_idx].key)
+      smallest_idx = right_child_idx;
+
+    // If smallest is still the current node, heap property is satisfied
+    if (smallest_idx == current_index)
+      break;
+
+    // Otherwise, swap with the smallest child and continue down
+    swap_entries(&heap[current_index], &heap[smallest_idx]);
+    current_index = smallest_idx; // Move down to the swapped child's index
+  }
+}
+
+// Builds min-heap from an arbitrary array
+static void build_heap(HeapEntry *heap, uint32_t heap_size) {
+  // Start from the last non-leaf node and heapify down
+  // Using int for loop condition safety with unsigned subtraction
+  // i >= 0 handles the case where heap_size is 0 or 1 correctly.
+  for (int i = (int)(heap_size / 2) - 1; i >= 0; i--) {
+    heapify_down(heap, heap_size, (uint32_t)i);
+  }
+}
+
+// Direct function, no stream indirection
+Packet *merger_next(Merger *m) {
+  // Check if heap is empty or we've processed enough
+  if (m->heap_size == 0 || m->processed >= m->total_expected)
+    return NULL;
+
+  // Root of the heap has the minimum element
+  uint32_t winner_run_index = m->heap[0].run_index;
+  Run *run = &m->runs[winner_run_index];
+
+  // Get pointer to the winning packet and increment processed count
+  Packet *result = &run->buf[run->head];
+  m->processed++;
+
+  // Advance head pointer in the winning run's buffer
+  run->head++;
+
+  // --- Update heap or remove run ---
+  // Check if the buffer for the winning run is now exhausted
+  if (run->head >= run->tail) {
+    // Try to refill the buffer only if the run is not already marked EOF
+    if (!run->eof) {
+      pull_batch(run);
+    }
+
+    // After attempting refill, check if the run is now exhausted
+    if (run->tail == 0) {
+      run->eof = true; // Ensure EOF is marked if pull_batch didn't
+      // Run is exhausted, remove it from heap
+      // Replace root with the last element from the heap
+      m->heap[0] = m->heap[m->heap_size - 1];
+      m->heap_size--; // Decrease heap size
+      // Restore heap property if heap is not empty
+      if (m->heap_size > 0) {
+        heapify_down(m->heap, m->heap_size, 0);
+      }
+      // Return the packet we retrieved before removing the run
+      return result;
+    } else {
+      // Successfully refilled, reset head
+      run->head = 0;
+      // Update the key in the heap with the new head element's key.
+      m->heap[0].key = run->buf[run->head].key;
+      // Heapify down to restore property
+      heapify_down(m->heap, m->heap_size, 0);
+    }
+  } else {
+    // Buffer still had elements. Update heap root with the next element's key.
+    m->heap[0].key = run->buf[run->head].key;
+    // Heapify down to restore property.
+    heapify_down(m->heap, m->heap_size, 0);
+  }
+
+  return result; // Return the packet obtained earlier
+}
+
+void merger_cleanup(Merger *m) {
+  if (m->heap) {
+    free(m->heap);
+    m->heap = NULL;
+  }
+}
+
+int merger_init_stream(PacketStream *stream, Run *runs, uint32_t K,
+                       uint64_t total_expected) {
+  Merger *m = (Merger *)malloc(sizeof(Merger));
+  if (!m)
+    return -1;
+
+  m->K = K;
+  m->runs = runs;
+  // Allocate memory for the heap
+  m->heap = (HeapEntry *)malloc(sizeof(HeapEntry) * K);
+  if (!m->heap) {
+    free(m);
+    return -1; // Allocation failed
+  }
+  m->heap_size = 0;
+  m->processed = 0;
+  m->total_expected = total_expected;
+
+  // Reset runs, fill initial window, and load initial heap entries
+  for (uint32_t i = 0; i < K; i++) {
+    Run *r = &m->runs[i];
+    // Initialize/Reset run state
+    r->head = 0;
+    r->tail = 0;
+    r->eof = false;
+    r->produced = 0;
+
+    // Initial fill only if needed
+    if (r->produced < r->total_size) {
+      pull_batch(r);
+    } else {
+      r->eof = true; // Already at total size
+    }
+
+    if (r->tail > 0) { // Only add to heap if the run has data
+      HeapEntry entry;
+      entry.key = r->buf[r->head].key; // Key of the first element
+      entry.run_index = i;
+      m->heap[m->heap_size++] = entry;
+    } else {
+      r->eof = true; // Mark as EOF if initially empty or immediately exhausted
+    }
+  }
+
+  // Build the initial heap from the loaded entries
+  if (m->heap_size > 0) {
+    build_heap(m->heap, m->heap_size);
+  }
+
+  stream->kind = PS_BINARYHEAP;
+  stream->impl.merger = m;
+  return 0; // Success
+}
+
+/* --- Loser Tree Implementation --- */
+
+struct LoserTree {
+  uint32_t K;     // Number of streams
+  uint32_t Kpow2; // Next power of 2 >= K
+  uint32_t
+      *restrict tree; // Loser tree array (internal nodes store loser index)
+  uint64_t *restrict keys; // Current key for each run (external nodes)
+  Run *restrict runs;      // External array of Run[K]
+  uint32_t winner;         // Index of current overall winner run
+  uint64_t processed;      // Counter for processed packets
+  uint64_t total_expected; // Total expected packets
+};
+
+/* Adjust function to maintain loser tree structure (Optimized Version) */
+// challenger_idx: index of the run that provided the last element
+//                 (and thus needs its key updated in the tree)
+static inline void loser_tree_adjust(LoserTree *restrict t,
+                                     uint32_t challenger_idx) {
+  // Start with the index of the run that needs updating
+  uint32_t current_challenger_index = challenger_idx;
+  // Determine the starting tree node index (parent of the leaf)
+  uint32_t tree_node_idx = (current_challenger_index + t->Kpow2) / 2;
+
+  uint32_t *restrict tree_arr = t->tree; // Local pointer for tree array
+  uint64_t *restrict key_arr = t->keys;  // Local pointer for key array
+
+  while (tree_node_idx > 0) {
+    // Get the index of the loser currently stored at this tree node
+    uint32_t current_loser_idx = tree_arr[tree_node_idx];
+
+    // Compare the current challenger's key against the current loser's key
+    // INF keys are handled naturally (INF > any valid key)
+    if (key_arr[current_challenger_index] > key_arr[current_loser_idx]) {
+      // The challenger is larger (loses) and gets stored at this node.
+      tree_arr[tree_node_idx] = current_challenger_index;
+
+      // The previous loser becomes the new challenger to continue up the tree.
+      current_challenger_index = current_loser_idx;
+    }
+    // If challenger_key <= current_loser_key, the challenger wins this
+    // comparison and continues up the tree unchanged. The current_loser_idx
+    // remains stored at this node.
+
+    // Move up to the parent node for the next round of comparison
+    tree_node_idx /= 2;
+  }
+  // After the loop, current_challenger_index holds the index of the overall
+  // winner.
+  t->winner = current_challenger_index;
+}
+
+// Direct function, no stream indirection
+Packet *loser_tree_next(LoserTree *t) {
+  // Check if already processed enough or if the tree is known to be
+  // empty/exhausted
+  if (t->processed >= t->total_expected || t->winner == t->K ||
+      t->keys[t->winner] == INF_KEY) {
+    if (t->processed < t->total_expected && t->keys[t->winner] == INF_KEY) {
+      fprintf(stderr,
+              "Warning: LoserTree winner key is INF, but not all packets "
+              "processed. %lu / %lu\n",
+              t->processed, t->total_expected);
+    }
+    return NULL;
+  }
+
+  // Get index of the winning run
+  uint32_t winner_run_idx = t->winner;
+  Run *restrict run = &t->runs[winner_run_idx];
+
+  // Sanity check: Winning run should have data if its key is not INF
+  assert(run->head < run->tail && "Loser tree winner run has empty buffer!");
+
+  // Get pointer to the winning packet
+  Packet *result = &run->buf[run->head];
+  t->processed++;
+
+  // Advance head pointer in the winning run's buffer
+  run->head++;
+
+  // --- Refill Logic ---
+  // Check if the buffer for the winning run is now exhausted
+  if (run->head >= run->tail) {
+    // Try to refill the buffer only if the run is not already marked EOF
+    if (!run->eof) {
+      pull_batch(run); // Refills buffer, updates tail/eof flags internally
+    }
+
+    // After attempting refill, check if the run has any data in the buffer
+    if (run->tail > 0) {
+      // Successfully refilled or was already refilled by a previous pull_batch
+      run->head = 0; // Reset head
+      t->keys[winner_run_idx] =
+          run->buf[run->head].key; // Update key from new head
+    } else {
+      // pull_batch didn't get any more data, or it was already EOF
+      run->eof = true; // Ensure EOF is marked
+      t->keys[winner_run_idx] =
+          INF_KEY; // Mark stream as finished in the tree keys
+    }
+  } else {
+    // Buffer still had elements. Update key from the new head.
+    t->keys[winner_run_idx] = run->buf[run->head].key;
+  }
+
+  // Adjust the loser tree based on the new key of the run
+  loser_tree_adjust(t, winner_run_idx);
+
+  return result; // Return the packet obtained earlier
+}
+
+void loser_tree_cleanup(LoserTree *t) {
+  if (t->tree) {
+    free_aligned(t->tree);
+    t->tree = NULL;
+  }
+  if (t->keys) {
+    free_aligned(t->keys);
+    t->keys = NULL;
+  }
+}
+
+int loser_tree_init_stream(PacketStream *stream, Run *runs, uint32_t K,
+                           uint64_t total_expected) {
+  LoserTree *t = (LoserTree *)malloc(sizeof(LoserTree));
+  if (!t)
+    return -1;
+  t->K = K;
+  t->Kpow2 = pow2_ceil(K);
+  t->runs = runs;
+  t->processed = 0;
+  t->total_expected = total_expected;
+
+  // Allocate memory using aligned_alloc if enabled, otherwise use malloc
+#ifdef USE_ALIGNED_ALLOC
+  t->tree = (uint32_t *)my_aligned_alloc(64, t->Kpow2 * sizeof(uint32_t));
+  t->keys = (uint64_t *)my_aligned_alloc(64, K * sizeof(uint64_t));
+#else
+  t->tree = (uint32_t *)malloc(t->Kpow2 * sizeof(uint32_t));
+  t->keys = (uint64_t *)malloc(K * sizeof(uint64_t));
+#endif
+  if (!t->tree || !t->keys) {
+    free_aligned(t->keys);
+    free_aligned(t->tree);
+    free(t);   // Cleanup partial allocation
+    return -1; // Allocation failed
+  }
+
+  // Initialize runs and fetch initial keys/status
+  uint32_t first_active_run = K; // Sentinel: index of first run found with data
+  for (uint32_t i = 0; i < K; i++) {
+    Run *r = &t->runs[i];
+    // Initialize/Reset run state (redundant if reset_runs is called before
+    // init, but safe)
+    r->head = 0;
+    r->tail = 0;
+    r->eof = false;
+    r->produced = 0;
+    // `next_key` start handled by reset_runs
+
+    // Initial fill only if needed
+    if (r->produced < r->total_size) {
+      pull_batch(r);
+    } else {
+      r->eof = true; // Already at total size
+    }
+
+    if (r->tail > 0) {
+      t->keys[i] = r->buf[r->head].key;
+      if (first_active_run == K) { // Track the first run with data found
+        first_active_run = i;
+      }
+    } else {
+      t->keys[i] = INF_KEY; // Mark exhausted
+      r->eof = true;
+    }
+  }
+
+  // Check if all streams were initially empty
+  if (first_active_run == K) {
+    // Initialize tree nodes to point to a valid index (e.g., 0)
+    // This state indicates an empty merge tree
+    for (uint32_t i = 0; i < t->Kpow2; ++i)
+      t->tree[i] = 0; // Pointing to 0 is safe as long as K>0
+    // Mark processed as total expected to prevent next() calls
+    t->processed = t->total_expected;
+    t->winner = K; // Use K as an invalid winner index to signal empty tree
+  } else {
+    // Initialize tree: conceptually set all nodes to point to the first active
+    // run initially, this is a common way to set up the initial state
+    for (uint32_t i = 0; i < t->Kpow2; ++i) {
+      t->tree[i] = first_active_run;
+    }
+    t->winner = first_active_run; // Set initial winner explicitly
+
+    // Build the initial tree state by adjusting for each run.
+    // The initial `winner` is set to `first_active_run`. The `adjust` calls
+    // for subsequent runs will correctly compare and update the tree nodes,
+    // eventually settling on the true minimum as the winner.
+    for (uint32_t i = 0; i < K; i++) {
+      // Only adjust if the stream is not initially exhausted.
+      // Adjust Function handles INF_KEY correctly by making them always lose
+      loser_tree_adjust(t, i);
+    }
+    // After initializing all nodes and adjusting, the winner should be correct.
+  }
+
+  stream->kind = PS_LOSERTREE;
+  stream->impl.loser_tree = t;
+  return 0; // Success
+}
