+
+/// Function to write string values to a column
+fn write_string_column(
+    handle: *mut ParquetWriterHandle,
+    column_index: usize,
+    values: *const *const c_char,
+    num_values: usize,
+    valid_bits: *const u8,
+) -> ParquetError {
+    // Get writer
+    let writer = match get_writer_mut(handle) {
+        Ok(w) => w,
+        Err(e) => return e,
+    };
+
+    // Check column index
+    if column_index >= writer.current_arrays.len() {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Check data type
+    if writer.column_types[column_index] != ParquetDataType::ParquetString {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Check values pointer
+    if values.is_null() && num_values > 0 {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Get the values as a slice
+    let values_slice = if num_values > 0 {
+        unsafe { std::slice::from_raw_parts(values, num_values) }
+    } else {
+        &[]
+    };
+
+    // Get the string builder
+    let builder = writer.current_arrays[column_index]
+        .as_any_mut()
+        .downcast_mut::<StringBuilder>()
+        .unwrap();
+
+    // If valid_bits is null, all values are valid
+    if valid_bits.is_null() {
+        for &value_ptr in values_slice {
+            if !value_ptr.is_null() {
+                let c_str = unsafe { CStr::from_ptr(value_ptr) };
+                match c_str.to_str() {
+                    Ok(s) => builder.append_value(s),
+                    Err(_) => return ParquetError::ParquetInvalidData,
+                }
+            } else {
+                builder.append_null();
+            }
+        }
+    } else {
+        // Otherwise use the validity bitmap
+        let valid_bits_slice =
+            unsafe { std::slice::from_raw_parts(valid_bits, (num_values + 7) / 8) };
+
+        for (i, &value_ptr) in values_slice.iter().enumerate() {
+            let byte_index = i / 8;
+            let bit_index = i % 8;
+            let is_valid = (valid_bits_slice[byte_index] & (1 << bit_index)) != 0;
+
+            if is_valid && !value_ptr.is_null() {
+                let c_str = unsafe { CStr::from_ptr(value_ptr) };
+                match c_str.to_str() {
+                    Ok(s) => builder.append_value(s),
+                    Err(_) => return ParquetError::ParquetInvalidData,
+                }
+            } else {
+                builder.append_null();
+            }
+        }
+    }
+
+    ParquetError::ParquetOk
+}
+
+/// Function to write binary values to a column
+fn write_binary_column(
+    handle: *mut ParquetWriterHandle,
+    column_index: usize,
+    values: *const *const u8,
+    lengths: *const size_t,
+    num_values: usize,
+    valid_bits: *const u8,
+) -> ParquetError {
+    // Get writer
+    let writer = match get_writer_mut(handle) {
+        Ok(w) => w,
+        Err(e) => return e,
+    };
+
+    // Check column index
+    if column_index >= writer.current_arrays.len() {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Check data type
+    if writer.column_types[column_index] != ParquetDataType::ParquetBinary {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Check values and lengths pointers
+    if (values.is_null() || lengths.is_null()) && num_values > 0 {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Get the values and lengths as slices
+    let values_slice = if num_values > 0 {
+        unsafe { std::slice::from_raw_parts(values, num_values) }
+    } else {
+        &[]
+    };
+
+    let lengths_slice = if num_values > 0 {
+        unsafe { std::slice::from_raw_parts(lengths, num_values) }
+    } else {
+        &[]
+    };
+
+    // Get the binary builder
+    let builder = writer.current_arrays[column_index]
+        .as_any_mut()
+        .downcast_mut::<BinaryBuilder>()
+        .unwrap();
+
+    // If valid_bits is null, all values are valid
+    if valid_bits.is_null() {
+        for (i, &value_ptr) in values_slice.iter().enumerate() {
+            if !value_ptr.is_null() {
+                let length = lengths_slice[i];
+                let binary_data = unsafe { std::slice::from_raw_parts(value_ptr, length) };
+                builder.append_value(binary_data);
+            } else {
+                builder.append_null();
+            }
+        }
+    } else {
+        // Otherwise use the validity bitmap
+        let valid_bits_slice =
+            unsafe { std::slice::from_raw_parts(valid_bits, (num_values + 7) / 8) };
+
+        for (i, &value_ptr) in values_slice.iter().enumerate() {
+            let byte_index = i / 8;
+            let bit_index = i % 8;
+            let is_valid = (valid_bits_slice[byte_index] & (1 << bit_index)) != 0;
+
+            if is_valid && !value_ptr.is_null() {
+                let length = lengths_slice[i];
+                let binary_data = unsafe { std::slice::from_raw_parts(value_ptr, length) };
+                builder.append_value(binary_data);
+            } else {
+                builder.append_null();
+            }
+        }
+    }
+
+    ParquetError::ParquetOk
+}
+
+/// End the current row group and flush it to the file
+#[no_mangle]
+pub extern "C" fn parquet_writer_end_row_group(handle: *mut ParquetWriterHandle) -> ParquetError {
+    parquet_writer_start_row_group(handle) // Just call start_row_group which writes current data
+}
+
+/// Write primitive values to a column using a generic interface
+#[no_mangle]
+pub extern "C" fn parquet_writer_write_primitive_column(
+    handle: *mut ParquetWriterHandle,
+    column_index: usize,
+    data_type: ParquetDataType,
+    values: *const std::ffi::c_void,
+    num_values: usize,
+    valid_bits: *const u8,
+) -> ParquetError {
+    // Get writer
+    let writer = match get_writer_mut(handle) {
+        Ok(w) => w,
+        Err(e) => return e,
+    };
+
+    // Check column index
+    if column_index >= writer.current_arrays.len() {
+        error!("Invalid column index: {} (max: {})", column_index, writer.current_arrays.len() - 1);
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Check that the provided data type matches the column's data type
+    if writer.column_types[column_index] != data_type {
+        error!("Data type mismatch for column {}: expected {:?}, got {:?}",
+            column_index, writer.column_types[column_index], data_type);
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Check values pointer
+    if values.is_null() && num_values > 0 {
+        error!("Null values pointer provided for column {} with {} values", column_index, num_values);
+        return ParquetError::ParquetInvalidData;
+    }
+
+    debug!("Writing {} values of type {:?} to column {}", num_values, data_type, column_index);
+
+    // Dispatch to appropriate writer function based on data type
+    match data_type {
+        ParquetDataType::ParquetBoolean => {
+            let bool_values = values as *const bool;
+            write_boolean_column(handle, column_index, bool_values, num_values, valid_bits)
+        },
+        ParquetDataType::ParquetInt8 => {
+            let int8_values = values as *const i8;
+            write_primitive_numeric_column::<i8, arrow::datatypes::Int8Type>(
+                handle, column_index, data_type, int8_values, num_values, valid_bits
+            )
+        },
+        ParquetDataType::ParquetInt32 => {
+            let int32_values = values as *const i32;
+            write_primitive_numeric_column::<i32, arrow::datatypes::Int32Type>(
+                handle, column_index, data_type, int32_values, num_values, valid_bits
+            )
+        },
+        ParquetDataType::ParquetInt64 => {
+            let int64_values = values as *const i64;
+            write_primitive_numeric_column::<i64, arrow::datatypes::Int64Type>(
+                handle, column_index, data_type, int64_values, num_values, valid_bits
+            )
+        },
+        ParquetDataType::ParquetUint8 => {
+            let uint8_values = values as *const u8;
+            write_primitive_numeric_column::<u8, arrow::datatypes::UInt8Type>(
+                handle, column_index, data_type, uint8_values, num_values, valid_bits
+            )
+        },
+        ParquetDataType::ParquetUint32 => {
+            let uint32_values = values as *const u32;
+            write_primitive_numeric_column::<u32, arrow::datatypes::UInt32Type>(
+                handle, column_index, data_type, uint32_values, num_values, valid_bits
+            )
+        },
+        ParquetDataType::ParquetUint64 => {
+            let uint64_values = values as *const u64;
+            write_primitive_numeric_column::<u64, arrow::datatypes::UInt64Type>(
+                handle, column_index, data_type, uint64_values, num_values, valid_bits
+            )
+        },
+        ParquetDataType::ParquetFloat => {
+            let float_values = values as *const f32;
+            write_primitive_numeric_column::<f32, arrow::datatypes::Float32Type>(
+                handle, column_index, data_type, float_values, num_values, valid_bits
+            )
+        },
+        ParquetDataType::ParquetDouble => {
+            let double_values = values as *const f64;
+            write_primitive_numeric_column::<f64, arrow::datatypes::Float64Type>(
+                handle, column_index, data_type, double_values, num_values, valid_bits
+            )
+        },
+        ParquetDataType::ParquetString => {
+            let string_values = values as *const *const c_char;
+            write_string_column(handle, column_index, string_values, num_values, valid_bits)
+        },
+        ParquetDataType::ParquetBinary => {
+            // For binary, we expect a pointer to a struct with pointers and lengths
+            let struct_ptr = values as *const std::ffi::c_void;
+            let binary_values = unsafe { *(struct_ptr as *const *const *const u8) };
+            let binary_lengths = unsafe { *((struct_ptr as *const u8).add(std::mem::size_of::<*const *const u8>()) as *const *const size_t) };
+            write_binary_column(handle, column_index, binary_values, binary_lengths, num_values, valid_bits)
+        },
+        // For other types, return an error
+        _ => {
+            error!("Unsupported data type: {:?}", data_type);
+            ParquetError::ParquetInvalidData
+        },
+    }
+}
+
+/// Close the writer and finalize the Parquet file
+#[no_mangle]
+pub extern "C" fn parquet_writer_close(handle: *mut ParquetWriterHandle) -> ParquetError {
+    // Get writer
+    let writer = match get_writer_mut(handle) {
+        Ok(w) => w,
+        Err(e) => return e,
+    };
+
+    info!("Closing Parquet writer");
+
+    // Flush any buffered rows
+    if writer.buffered_rows > 0 {
+        debug!("Flushing {} buffered rows before closing", writer.buffered_rows);
+        let result = parquet_writer_flush_buffer(handle);
+        if result != ParquetError::ParquetOk {
+            error!("Failed to flush buffer during close: error code {:?}", result);
+            return result;
+        }
+    }
+
+    // Take the writer out of the handle
+    if let Some(parquet_writer) = writer.writer.take() {
+        // Close the writer
+        if let Err(e) = parquet_writer.close() {
+            error!("Error closing writer: {}", e);
+            return ParquetError::ParquetFileCloseError;
+        }
+    }
+
+    // Free the handle memory
+    unsafe {
+        let _ = Box::from_raw(handle as *mut ParquetWriter);
+    }
+
+    info!("Parquet writer closed successfully");
+    ParquetError::ParquetOk
+}
+
+/// Write a single row to the Parquet file, buffering it until reaching the configured buffer size
+#[no_mangle]
+pub extern "C" fn parquet_writer_write_row(
+    handle: *mut ParquetWriterHandle,
+    values: *const *const std::ffi::c_void,
+    is_valid: *const bool,
+) -> ParquetError {
+    // Get writer
+    let writer = match get_writer_mut(handle) {
+        Ok(w) => w,
+        Err(e) => return e,
+    };
+
+    // Check values pointer
+    if values.is_null() {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    let column_count = writer.column_types.len();
+    let values_slice = unsafe { std::slice::from_raw_parts(values, column_count) };
+    
+    // Determine validity
+    let is_valid_slice = if is_valid.is_null() {
+        None
+    } else {
+        Some(unsafe { std::slice::from_raw_parts(is_valid, column_count) })
+    };
+
+    // Add the row to each column's builder
+    for (i, &value_ptr) in values_slice.iter().enumerate() {
+        let is_valid = is_valid_slice.map_or(true, |v| v[i]);
+        
+        if !is_valid || value_ptr.is_null() {
+            // Handle null values based on column type
+            match writer.column_types[i] {
+                ParquetDataType::ParquetBoolean => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<BooleanBuilder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                ParquetDataType::ParquetInt8 => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<Int8Builder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                ParquetDataType::ParquetInt32 => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<Int32Builder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                ParquetDataType::ParquetInt64 => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<Int64Builder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                ParquetDataType::ParquetUint8 => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<UInt8Builder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                ParquetDataType::ParquetUint32 => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<UInt32Builder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                ParquetDataType::ParquetUint64 => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<UInt64Builder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                ParquetDataType::ParquetFloat => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<Float32Builder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                ParquetDataType::ParquetDouble => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<Float64Builder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                ParquetDataType::ParquetString => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<StringBuilder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                ParquetDataType::ParquetBinary => {
+                    let builder = writer.current_arrays[i]
+                        .as_any_mut()
+                        .downcast_mut::<BinaryBuilder>()
+                        .unwrap();
+                    builder.append_null();
+                }
+                // Add other types as needed
+                _ => return ParquetError::ParquetInvalidData,
+            }
+            continue;
+        }
+        
+        // Add value based on column type
+        match writer.column_types[i] {
+            ParquetDataType::ParquetBoolean => {
+                let value = unsafe { *(value_ptr as *const bool) };
+                let builder = writer.current_arrays[i]
+                    .as_any_mut()
+                    .downcast_mut::<BooleanBuilder>()
+                    .unwrap();
+                builder.append_value(value);
+            }
+            ParquetDataType::ParquetInt8 => {
+                let value = unsafe { *(value_ptr as *const i8) };
+                let builder = writer.current_arrays[i]
+                    .as_any_mut()
+                    .downcast_mut::<Int8Builder>()
+                    .unwrap();
+                builder.append_value(value);
+            }
+            ParquetDataType::ParquetInt32 => {
+                let value = unsafe { *(value_ptr as *const i32) };
+                let builder = writer.current_arrays[i]
+                    .as_any_mut()
+                    .downcast_mut::<Int32Builder>()
+                    .unwrap();
+                builder.append_value(value);
+            }
+            ParquetDataType::ParquetInt64 => {
+                let value = unsafe { *(value_ptr as *const i64) };
+                let builder = writer.current_arrays[i]
+                    .as_any_mut()
+                    .downcast_mut::<Int64Builder>()
+                    .unwrap();
+                builder.append_value(value);
+            }
+            ParquetDataType::ParquetUint8 => {
+                let value = unsafe { *(value_ptr as *const u8) };
+                let builder = writer.current_arrays[i]
+                    .as_any_mut()
+                    .downcast_mut::<UInt8Builder>()
+                    .unwrap();
+                builder.append_value(value);
+            }
+            ParquetDataType::ParquetUint32 => {
+                let value = unsafe { *(value_ptr as *const u32) };
+                let builder = writer.current_arrays[i]
+                    .as_any_mut()
+                    .downcast_mut::<UInt32Builder>()
+                    .unwrap();
+                builder.append_value(value);
+            }
+            ParquetDataType::ParquetUint64 => {
+                let value = unsafe { *(value_ptr as *const u64) };
+                let builder = writer.current_arrays[i]
+                    .as_any_mut()
+                    .downcast_mut::<UInt64Builder>()
+                    .unwrap();
+                builder.append_value(value);
+            }
+            ParquetDataType::ParquetFloat => {
+                let value = unsafe { *(value_ptr as *const f32) };
+                let builder = writer.current_arrays[i]
+                    .as_any_mut()
+                    .downcast_mut::<Float32Builder>()
+                    .unwrap();
+                builder.append_value(value);
+            }
+            ParquetDataType::ParquetDouble => {
+                let value = unsafe { *(value_ptr as *const f64) };
+                let builder = writer.current_arrays[i]
+                    .as_any_mut()
+                    .downcast_mut::<Float64Builder>()
+                    .unwrap();
+                builder.append_value(value);
+            }
+            ParquetDataType::ParquetString => {
+                let c_str = unsafe { CStr::from_ptr(value_ptr as *const c_char) };
+                match c_str.to_str() {
+                    Ok(s) => {
+                        let builder = writer.current_arrays[i]
+                            .as_any_mut()
+                            .downcast_mut::<StringBuilder>()
+                            .unwrap();
+                        builder.append_value(s);
+                    }
+                    Err(_) => return ParquetError::ParquetInvalidData,
+                }
+            }
+            ParquetDataType::ParquetBinary => {
+                // For binary, we expect a struct with a pointer and a length
+                let binary_data = unsafe {
+                    let data_ptr = *(value_ptr as *const *const u8);
+                    let data_len = *((value_ptr as *const u8).add(std::mem::size_of::<*const u8>()) as *const size_t);
+                    std::slice::from_raw_parts(data_ptr, data_len)
+                };
+                
+                let builder = writer.current_arrays[i]
+                    .as_any_mut()
+                    .downcast_mut::<BinaryBuilder>()
+                    .unwrap();
+                builder.append_value(binary_data);
+            }
+            // Add other types as needed
+            _ => return ParquetError::ParquetInvalidData,
+        }
+    }
+
+    // Increment buffered row count
+    writer.buffered_rows += 1;
+
+    // Auto-flush if buffer is full
+    if writer.buffered_rows >= writer.row_buffer_size {
+        return parquet_writer_flush_buffer(handle);
+    }
+
+    ParquetError::ParquetOk
+}
+
+/// Flush buffered rows to a Parquet file
+#[no_mangle]
+pub extern "C" fn parquet_writer_flush_buffer(handle: *mut ParquetWriterHandle) -> ParquetError {
+    // Get writer
+    let writer = match get_writer_mut(handle) {
+        Ok(w) => w,
+        Err(e) => return e,
+    };
+
+    // If no rows buffered, return early
+    if writer.buffered_rows == 0 {
+        return ParquetError::ParquetOk;
+    }
+
+    // Create a record batch from the current arrays
+    let mut arrays: Vec<ArrayRef> = Vec::with_capacity(writer.current_arrays.len());
+    let mut new_builders: Vec<Box<dyn ArrayBuilder>> = Vec::with_capacity(writer.current_arrays.len());
+
+    for (i, builder) in writer.current_arrays.iter_mut().enumerate() {
+        // Finish array and convert to ArrayRef
+        arrays.push(builder.finish());
+        
+        // Create new builder of the same type
+        new_builders.push(create_array_builder(writer.column_types[i]));
+    }
+
+    // Replace the old builders with new ones
+    writer.current_arrays = new_builders;
+
+    // Create a record batch from the arrays
+    let batch = match RecordBatch::try_new(writer.schema.clone(), arrays) {
+        Ok(b) => b,
+        Err(_) => return ParquetError::ParquetGeneralError,
+    };
+
+    // Write the batch
+    if let Some(parquet_writer) = &mut writer.writer {
+        if let Err(_) = parquet_writer.write(&batch) {
+            return ParquetError::ParquetFileWriteError;
+        }
+    } else {
+        return ParquetError::ParquetInvalidHandle;
+    }
+
+    // Reset buffered row count
+    writer.buffered_rows = 0;
+
+    ParquetError::ParquetOk
+}
