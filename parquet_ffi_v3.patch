@@ -0,0 +1,75 @@
+use std::sync::Once;
+use tracing_subscriber::{fmt, EnvFilter};
+use crate::ffi::types::ParquetLogLevel;
+
+static INIT: Once = Once::new();
+
+/// Initialize tracing with default configuration
+pub fn init() {
+    INIT.call_once(|| {
+        // Set the default environment filter to INFO level
+        // This can be overridden with the RUST_LOG environment variable
+        let env_filter = EnvFilter::try_from_default_env()
+            .unwrap_or_else(|_| EnvFilter::new("info"));
+
+        // Initialize the tracing subscriber
+        fmt::fmt()
+            .with_env_filter(env_filter)
+            .with_target(true)
+            .with_ansi(false) // Disable ANSI color codes for better compatibility with C logging
+            .init();
+
+        tracing::info!("Tracing initialized for parquet_ffi");
+    });
+}
+
+/// Initialize tracing with a specific log level
+pub fn init_with_level(level: &str) {
+    INIT.call_once(|| {
+        // Use the provided level
+        let env_filter = EnvFilter::new(level);
+
+        // Initialize the tracing subscriber
+        fmt::fmt()
+            .with_env_filter(env_filter)
+            .with_target(true)
+            .with_ansi(false)
+            .init();
+
+        tracing::info!("Tracing initialized for parquet_ffi with level: {}", level);
+    });
+}
+
+/// Convert ParquetLogLevel to a string level for tracing
+fn log_level_to_str(level: ParquetLogLevel) -> &'static str {
+    match level {
+        ParquetLogLevel::ParquetLogOff => "off",
+        ParquetLogLevel::ParquetLogError => "error",
+        ParquetLogLevel::ParquetLogWarn => "warn",
+        ParquetLogLevel::ParquetLogInfo => "info",
+        ParquetLogLevel::ParquetLogDebug => "debug",
+        ParquetLogLevel::ParquetLogTrace => "trace",
+    }
+}
+
+/// FFI function to initialize tracing with a specific log level string
+#[no_mangle]
+pub extern "C" fn parquet_init_tracing(level: *const std::os::raw::c_char) {
+    if level.is_null() {
+        init();
+        return;
+    }
+
+    let c_str = unsafe { std::ffi::CStr::from_ptr(level) };
+    match c_str.to_str() {
+        Ok(level_str) => init_with_level(level_str),
+        Err(_) => init(), // Default to INFO if string conversion fails
+    }
+}
+
+/// FFI function to initialize tracing with a specific enum log level
+#[no_mangle]
+pub extern "C" fn parquet_init_tracing_with_level(level: ParquetLogLevel) {
+    let level_str = log_level_to_str(level);
+    init_with_level(level_str);
+} 
