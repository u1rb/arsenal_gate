diff --git a/parquet_ffi/src/write_lib.rs b/parquet_ffi/src/write_lib.rs
new file mode 100644
index 0000000..99c3c71
--- /dev/null
+++ b/parquet_ffi/src/write_lib.rs
@@ -0,0 +1,121 @@
+use std::fs::File;
+use std::path::PathBuf;
+use std::sync::Arc;
+use std::time::{Duration, Instant};
+
+use arrow::array::{StructArray, UInt64Builder};
+use arrow::datatypes::DataType::UInt64;
+use arrow::datatypes::{Field, Schema};
+use clap::{Parser, ValueEnum};
+use parquet::arrow::ArrowWriter as ParquetWriter;
+use parquet::basic::Encoding;
+use parquet::errors::Result;
+use parquet::file::properties::{BloomFilterPosition, WriterProperties};
+use sysinfo::{ProcessRefreshKind, ProcessesToUpdate, RefreshKind, System};
+
+#[derive(ValueEnum, Clone)]
+enum BloomFilterPositionArg {
+    End,
+    AfterRowGroup,
+}
+
+#[derive(Parser)]
+#[command(version)]
+/// Writes sequences of integers, with a Bloom Filter, while logging timing and memory usage.
+pub struct Args {
+    #[arg(long, default_value_t = 1000)]
+    /// Number of batches to write
+    iterations: u64,
+
+    #[arg(long, default_value_t = 1000000)]
+    /// Number of rows in each batch
+    batch: u64,
+
+    #[arg(long, value_enum, default_value_t=BloomFilterPositionArg::AfterRowGroup)]
+    /// Where to write Bloom Filters
+    bloom_filter_position: BloomFilterPositionArg,
+
+    /// Path to the file to write
+    path: PathBuf,
+}
+
+fn now() -> String {
+    chrono::Local::now().format("%Y-%m-%d %H:%M:%S").to_string()
+}
+
+fn mem(system: &mut System) -> String {
+    let pid = match sysinfo::get_current_pid() {
+        Ok(pid) => pid,
+        Err(e) => return format!("Can't get process PID: {e}"),
+    };
+
+    let remove_dead_processes = true;
+    system.refresh_processes_specifics(
+        ProcessesToUpdate::Some(&[pid]),
+        remove_dead_processes,
+        ProcessRefreshKind::everything(),
+    );
+
+    system
+        .process(pid)
+        .map(|proc| format!("{}MB", proc.memory() / 1_000_000))
+        .unwrap_or("N/A".to_string())
+}
+
+pub fn do_write(args: Args) -> Result<()> {
+    let bloom_filter_position = match args.bloom_filter_position {
+        BloomFilterPositionArg::End => BloomFilterPosition::End,
+        BloomFilterPositionArg::AfterRowGroup => BloomFilterPosition::AfterRowGroup,
+    };
+
+    let properties = WriterProperties::builder()
+        .set_column_bloom_filter_enabled("id".into(), true)
+        .set_column_encoding("id".into(), Encoding::DELTA_BINARY_PACKED)
+        .set_bloom_filter_position(bloom_filter_position)
+        .build();
+    let schema = Arc::new(Schema::new(vec![Field::new("id", UInt64, false)]));
+    // Create parquet file that will be read.
+    let file = File::create(args.path).unwrap();
+    let mut writer = ParquetWriter::try_new(file, schema.clone(), Some(properties))?;
+
+    let mut system = System::new_with_specifics(RefreshKind::everything());
+    eprintln!(
+        "{} Writing {} batches of {} rows. RSS = {}",
+        now(),
+        args.iterations,
+        args.batch,
+        mem(&mut system)
+    );
+
+    let mut array_builder = UInt64Builder::new();
+    let mut last_log = Instant::now();
+    for i in 0..args.iterations {
+        if Instant::now() - last_log > Duration::new(10, 0) {
+            last_log = Instant::now();
+            eprintln!(
+                "{} Iteration {}/{}. RSS = {}",
+                now(),
+                i + 1,
+                args.iterations,
+                mem(&mut system)
+            );
+        }
+        for j in 0..args.batch {
+            array_builder.append_value(i + j);
+        }
+        writer.write(
+            &StructArray::new(
+                schema.fields().clone(),
+                vec![Arc::new(array_builder.finish())],
+                None,
+            )
+            .into(),
+        )?;
+    }
+    writer.flush()?;
+    writer.close()?;
+
+    eprintln!("{} Done. RSS = {}", now(), mem(&mut system));
+
+    Ok(())
+}
diff --git a/parquet_ffi/src/write_stream_lib.rs b/parquet_ffi/src/write_stream_lib.rs
new file mode 100644
index 0000000..6900c65
--- /dev/null
+++ b/parquet_ffi/src/write_stream_lib.rs
@@ -0,0 +1,230 @@
+use arrow::array::ffi_stream::{ArrowArrayStreamReader, FFI_ArrowArrayStream};
+use arrow::error::ArrowError;
+use parquet::arrow::ArrowWriter;
+use parquet::file::properties::WriterProperties;
+use std::ffi::{c_void, CStr};
+use std::fs::File;
+use std::os::raw::{c_char, c_int};
+
+// Struct to hold the state of the Parquet writer across FFI calls
+struct ParquetStreamWriterState {
+    writer: ArrowWriter<File>,
+    path: String, // Store path for error messages
+    total_rows: usize,
+    batch_count: usize,
+}
+
+/// Helper to read the next batch from a raw stream pointer.
+/// Takes ownership and releases the stream if an error occurs during batch read.
+unsafe fn read_next_batch(
+    stream_ptr: *mut FFI_ArrowArrayStream,
+) -> Result<Option<arrow::record_batch::RecordBatch>, ArrowError> {
+    let stream = FFI_ArrowArrayStream::from_raw(stream_ptr);
+    let mut reader = ArrowArrayStreamReader::try_new(stream)?;
+    let batch_result = reader.next().transpose();
+    // If there's an error reading the batch, the original stream will be dropped
+    // by the reader, releasing it.
+    // If successful (Some or None), we need to prevent the reader from dropping the stream,
+    // so we forget the reader.
+    if batch_result.is_ok() {
+        std::mem::forget(reader);
+    }
+    batch_result
+}
+
+/// C-compatible function to initialize a Parquet writer and write the first batch.
+/// Returns an opaque pointer (`void*`) to the writer state.
+#[no_mangle]
+pub unsafe extern "C" fn parquet_stream_writer_init(
+    stream_ptr: *mut FFI_ArrowArrayStream,
+    path_ptr: *const c_char,
+) -> *mut c_void {
+    if stream_ptr.is_null() || path_ptr.is_null() {
+        eprintln!("parquet_stream_writer_init: received null pointer");
+        return std::ptr::null_mut();
+    }
+
+    // Convert C string to Rust string
+    let path_str = match CStr::from_ptr(path_ptr).to_str() {
+        Ok(s) => s.to_string(),
+        Err(e) => {
+            eprintln!("parquet_stream_writer_init: Invalid path string: {}", e);
+            // Manually release the stream if path is invalid
+            let stream = FFI_ArrowArrayStream::from_raw(stream_ptr);
+            if let Some(release) = stream.release {
+                release(stream_ptr);
+            }
+            return std::ptr::null_mut();
+        }
+    };
+
+    // Take ownership and read the first batch
+    // We need the schema from the first batch to initialize the writer.
+    let first_batch = match read_next_batch(stream_ptr) {
+        Ok(Some(batch)) => batch,
+        Ok(None) => {
+            eprintln!(
+                "parquet_stream_writer_init: Stream for '{}' was empty, cannot initialize writer.",
+                path_str
+            );
+            // Stream is released by read_next_batch on Ok(None)
+            return std::ptr::null_mut();
+        }
+        Err(e) => {
+            eprintln!(
+                "parquet_stream_writer_init: Error reading first batch from stream for '{}': {}",
+                path_str, e
+            );
+            // Stream is released by read_next_batch on Err
+            return std::ptr::null_mut();
+        }
+    };
+
+    let schema = first_batch.schema();
+
+    // Create writer properties
+    let props = WriterProperties::builder()
+        .set_compression(parquet::basic::Compression::SNAPPY)
+        .set_dictionary_enabled(false)
+        .set_max_row_group_size(1048576)
+        .build();
+
+    // Create Parquet file and writer
+    let file = match File::create(&path_str) {
+        Ok(f) => f,
+        Err(e) => {
+            eprintln!(
+                "parquet_stream_writer_init: Error creating file '{}': {}",
+                path_str, e
+            );
+            return std::ptr::null_mut(); // Batch/Schema are dropped, resources cleaned up
+        }
+    };
+
+    let mut writer = match ArrowWriter::try_new(file, schema, Some(props)) {
+        Ok(w) => w,
+        Err(e) => {
+            eprintln!(
+                "parquet_stream_writer_init: Error creating parquet writer for '{}': {}",
+                path_str, e
+            );
+            return std::ptr::null_mut();
+        }
+    };
+
+    // Write the first batch
+    let rows = first_batch.num_rows();
+    let batch_count = 1;
+    if let Err(e) = writer.write(&first_batch) {
+        eprintln!(
+            "parquet_stream_writer_init: Error writing first batch to '{}': {}",
+            path_str, e
+        );
+        // Close the writer to attempt to finalize the file partially
+        let _ = writer.close();
+        return std::ptr::null_mut();
+    }
+
+    // println!(
+    //     "parquet_stream_writer_init: Wrote batch {} with {} rows to '{}'",
+    //     batch_count, rows, path_str
+    // );
+
+    // Create state struct
+    let state = ParquetStreamWriterState {
+        writer,
+        path: path_str,
+        total_rows: rows,
+        batch_count,
+    };
+
+    // Box it and return the raw pointer cast to void*
+    Box::into_raw(Box::new(state)) as *mut c_void
+}
+
+/// C-compatible function to write a subsequent batch to an initialized Parquet writer.
+#[no_mangle]
+pub unsafe extern "C" fn parquet_stream_writer_write_batch(
+    state_ptr_void: *mut c_void, // Accept void*
+    stream_ptr: *mut FFI_ArrowArrayStream,
+) -> c_int {
+    if state_ptr_void.is_null() || stream_ptr.is_null() {
+        eprintln!("parquet_stream_writer_write_batch: received null pointer");
+        return -1;
+    }
+
+    // Cast void* back to the concrete type
+    let state_ptr = state_ptr_void as *mut ParquetStreamWriterState;
+    // Get a mutable reference to the state without taking ownership
+    let state = &mut *state_ptr;
+
+    // Read the next batch from the stream
+    let batch = match read_next_batch(stream_ptr) {
+        Ok(Some(batch)) => batch,
+        Ok(None) => {
+            // This indicates the end of the stream for this specific batch flush,
+            // which shouldn't happen if C side checks current_row > 0 before calling.
+            // If it does happen, it's not an error, just nothing to write.
+            // Stream is released by read_next_batch
+            return 0; // Indicate success (nothing to write)
+        }
+        Err(e) => {
+            eprintln!(
+                "parquet_stream_writer_write_batch: Error reading batch from stream for '{}': {}",
+                state.path, e
+            );
+            // Stream is released by read_next_batch on Err
+            return -1; // Indicate error
+        }
+    };
+
+    // Write the batch
+    let rows = batch.num_rows();
+    state.batch_count += 1;
+    if let Err(e) = state.writer.write(&batch) {
+        eprintln!(
+            "parquet_stream_writer_write_batch: Error writing batch {} to '{}': {}",
+            state.batch_count, state.path, e
+        );
+        return -1; // Indicate error
+    }
+
+    state.total_rows += rows;
+    // println!(
+    //     "parquet_stream_writer_write_batch: Wrote batch {} with {} rows (total: {} rows) to '{}'",
+    //     state.batch_count, rows, state.total_rows, state.path
+    // );
+
+    0 // Indicate success
+}
+
+/// C-compatible function to close the Parquet writer and free resources.
+#[no_mangle]
+pub unsafe extern "C" fn parquet_stream_writer_close(
+    state_ptr_void: *mut c_void, // Accept void*
+) -> c_int {
+    if state_ptr_void.is_null() {
+        return 0; // Nothing to close
+    }
+
+    // Cast void* back and take ownership of the Box to close and drop
+    let state_ptr = state_ptr_void as *mut ParquetStreamWriterState;
+    let state = Box::from_raw(state_ptr);
+
+    println!(
+        "parquet_stream_writer_close: Closing '{}'. Total rows: {}, Total batches: {}",
+        state.path, state.total_rows, state.batch_count
+    );
+
+    match state.writer.close() {
+        Ok(_) => 0, // Indicate success
+        Err(e) => {
+            eprintln!(
+                "parquet_stream_writer_close: Error closing writer for '{}': {}",
+                state.path, e
+            );
+            -1 // Indicate error
+        }
+    }
+    // state is dropped here, closing the file
+}
diff --git a/parquet_ffi/tests/b_from_flash.c b/parquet_ffi/tests/b_from_flash.c
new file mode 100644
index 0000000..cf51e0a
--- /dev/null
+++ b/parquet_ffi/tests/b_from_flash.c
@@ -0,0 +1,1044 @@
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/time.h>
+#include <time.h>
+// Include for aligned_alloc if needed (usually in stdlib.h with C11)
+#if defined(__STDC_VERSION__) && __STDC_VERSION__ >= 201112L
+// aligned_alloc is standard
+#elif defined(_ISOC11_SOURCE)
+// Or if explicitly requested
+#elif defined(_WIN32) || defined(_WIN64)
+#include <malloc.h>                  // For _aligned_malloc on Windows
+static inline void *aligned_alloc(size_t alignment, size_t size) {
+  return _aligned_malloc(size, alignment);
+}
+#define free(ptr) _aligned_free(ptr) // Use corresponding free
+#else
+// Provide a simple fallback if not available - WARN: might not be truly aligned
+// Use posix_memalign on POSIX systems if available
+#if defined(_POSIX_C_SOURCE) && _POSIX_C_SOURCE >= 200112L
+#include <malloc.h> // posix_memalign is often declared here
+static inline void *aligned_alloc(size_t alignment, size_t size) {
+  void *ptr = NULL;
+  if (posix_memalign(&ptr, alignment, size) != 0) {
+    return NULL;
+  }
+  return ptr;
+}
+#else               // Fallback to malloc if posix_memalign is not available
+#include <stdlib.h>
+static inline void *aligned_alloc(size_t alignment, size_t size) {
+  // Simple malloc fallback - alignment not guaranteed
+  // You might add a warning here in debug builds
+  return malloc(size);
+}
+#endif // POSIX_C_SOURCE
+#endif // defined(__STDC_VERSION__), _ISOC11_SOURCE, _WIN32/_WIN64
+
+/* Packet data structure */
+typedef struct {
+  uint64_t key;   // Key for sorting/comparison
+  uint32_t value; // Some payload data
+} Packet;
+
+/* Run structures for each stream */
+typedef struct {
+  Packet *buf;   // circular buffer (size = WINDOW = 4096)
+  uint32_t head; // index of next element to read
+  uint32_t tail; // index of first empty slot
+  bool eof;      // producer delivered last batch
+
+  // For lazy stream generation
+  uint64_t next_key;   // Next key to generate (increasing)
+  uint64_t total_size; // Total expected size of this run
+  uint32_t produced;   // How many elements we've produced so far
+  uint32_t run_id;     // ID of this run (for key generation)
+} Run;
+
+#define MAXK 1024
+#define WINDOW 4096
+#define INF_KEY 0xFFFFFFFFFFFFFFFFull
+
+/* --- Common --- */
+
+/* Pregenerated random steps to avoid rand() in hot loops */
+static uint64_t random_steps[WINDOW];
+static bool random_steps_initialized = false;
+
+/* Initialize random steps array */
+static void init_random_steps() {
+  if (!random_steps_initialized) {
+    // Use a fixed seed for deterministic key generation during benchmark runs
+    // srand(time(NULL)); // Seed random number generator once
+    srand(12345); // Fixed seed
+    for (int i = 0; i < WINDOW; i++) {
+      random_steps[i] = (rand() % 10) + 1;
+    }
+    random_steps_initialized = true;
+  }
+}
+
+/* Round x up to next power of two. */
+static inline uint32_t pow2_ceil(uint32_t x) {
+  // Clearest and often fastest way for modern compilers
+  if (x <= 1)
+    return 1; // Handle 0 and 1
+    // For C/C++, using __builtin_clz or equivalent intrinsic is often faster
+#if defined(__GNUC__) || defined(__clang__)
+  return 1u << (32 - __builtin_clz(x - 1));
+#else
+  // Portable fallback
+  x--;
+  x |= x >> 1;
+  x |= x >> 2;
+  x |= x >> 4;
+  x |= x >> 8;
+  x |= x >> 16;
+  return x + 1;
+#endif
+}
+
+/* Pull a batch of data into a run's buffer */
+static inline void pull_batch(Run *r) {
+  uint32_t count = 0;
+  Packet *restrict buffer = r->buf; // Use restrict if compiler supports it well
+  uint64_t current_next_key = r->next_key; // Load into local var
+  uint32_t current_produced = r->produced;
+  const uint64_t total_run_size = r->total_size;
+
+  // Determine how many new elements we can potentially generate
+  const uint32_t remaining_in_run =
+      (uint32_t)(total_run_size - current_produced);
+  const uint32_t limit =
+      (WINDOW < remaining_in_run) ? WINDOW : remaining_in_run;
+
+  // Reset head as buffer is being overwritten from the start
+  r->head = 0;
+  r->tail = 0; // Reset tail assuming we fill from index 0
+
+  while (count < limit) {
+    // Use pregenerated random step
+    current_next_key += random_steps[current_produced % WINDOW];
+
+    // Create the packet directly in the buffer
+    buffer[count].key = current_next_key;
+    buffer[count].value = current_produced; // Value could be anything really
+
+    current_produced++;
+    count++;
+  }
+
+  r->tail = count;                // Set tail to the number of elements added
+  r->next_key = current_next_key; // Store updated key back
+  r->produced = current_produced; // Store updated count back
+
+  // Update EOF flag based on whether we produced the full limit
+  // If count < WINDOW, it means we hit the end of the run's data.
+  if (count < WINDOW) {
+    r->eof = true;
+  } else {
+    // Check if we exactly finished the run
+    r->eof = (current_produced >= total_run_size);
+  }
+}
+
+/* --- No Merge Implementation --- */
+
+typedef struct {
+  Run *run;                // Pointer to the single run being processed
+  uint64_t processed;      // Counter for processed packets
+  uint64_t total_expected; // Total expected packets for this single run
+} NoMerger;
+
+void no_merger_init(NoMerger *nm, Run *single_run, uint64_t total_expected) {
+  nm->run = single_run;
+  nm->processed = 0;
+  nm->total_expected = total_expected;
+
+  // Reset the specific run - important parts
+  // Head, tail, eof, produced, next_key are handled by reset_runs
+  // Resetting them here ensures a clean state for this specific merger's use
+  nm->run->head = 0;
+  nm->run->tail = 0;
+  nm->run->eof = false;
+  nm->run->produced = 0;
+
+  // Initial batch fill only if needed
+  if (nm->run->produced < nm->run->total_size) {
+    pull_batch(nm->run);
+    // pull_batch sets eof flag internally now
+  } else {
+    nm->run->eof = true; // Already at total size
+  }
+}
+
+Packet *no_merger_next(NoMerger *nm) {
+  Run *r = nm->run; // Local pointer
+
+  // Check if we've processed everything expected
+  if (nm->processed >= nm->total_expected) {
+    return NULL;
+  }
+
+  // Check if current buffer is exhausted
+  if (r->head >= r->tail) {
+    // If run is already marked EOF and buffer is empty, we are done
+    if (r->eof) {
+      // Double check tail is 0 if eof is true and head >= tail
+      // This assertion might fail if total_size is a multiple of WINDOW
+      // assert(r->tail == 0 && "Run buffer head >= tail but tail not 0, and EOF
+      // is set.");
+      return NULL;
+    }
+
+    // Try to pull a new batch
+    pull_batch(r);
+    // If buffer is still empty after pulling, we are done from this run
+    if (r->tail == 0) {
+      // Ensure EOF is marked if tail is 0 after pull_batch attempt
+      // (pull_batch should handle this, but assert for safety)
+      assert(r->eof && "Pull batch returned 0 elements but EOF is not set.");
+      return NULL;
+    }
+    // If pull_batch worked, head is already 0, continue below
+  }
+
+  // We've already checked total_expected at the start of the function.
+  // We know head < tail here.
+
+  // Get packet from the current head position
+  Packet *result = &r->buf[r->head];
+  nm->processed++;
+
+  // Advance head for the next call
+  r->head++;
+
+  return result;
+}
+
+void no_merger_cleanup(NoMerger *nm) {
+  // Nothing to free specific to NoMerger struct itself
+}
+
+/* --- Naive Merge Implementation --- */
+
+// Naive Merger now uses the same buffered approach internally
+
+typedef struct {
+  uint32_t K; // Number of input streams
+  Run *runs;  // Array of runs
+  // No longer need stream_heads, access runs directly
+  uint64_t processed;      // Counter for processed packets
+  uint64_t total_expected; // Total expected packets
+} NaiveMerger;
+
+void naive_merger_init(NaiveMerger *nm, Run *runs, uint32_t K,
+                       uint64_t total_expected) {
+  nm->K = K;
+  nm->processed = 0;
+  nm->total_expected = total_expected;
+
+  // Runs pointer is passed in, assign it
+  nm->runs = runs;
+
+  // Reset runs and fetch first elements using pull_batch
+  for (uint32_t i = 0; i < K; i++) {
+    Run *r = &nm->runs[i];
+    // Reset state (redundant if reset_runs called before, but safe)
+    r->head = 0;
+    r->tail = 0;
+    r->eof = false;
+    r->produced = 0; // Should be done by reset_runs, but ensure
+    // `next_key` reset by reset_runs
+
+    // Initial fill using the *buffered* pull_batch method
+    if (r->produced < r->total_size) {
+      pull_batch(r); // Fills buffer up to WINDOW or total_size
+    } else {
+      r->eof = true; // Already at total size
+    }
+
+    // No need to store head separately now, just check r->head < r->tail
+  }
+}
+
+Packet *naive_merger_next(NaiveMerger *nm) {
+  // Check overall processed count first
+  if (nm->processed >= nm->total_expected) {
+    return NULL;
+  }
+
+  // Find minimum element among current stream heads (by checking buffers)
+  int32_t min_idx = -1;
+  uint64_t min_key = INF_KEY; // Use the max possible key value
+
+  for (uint32_t i = 0; i < nm->K; i++) {
+    // Check if the run has data (head < tail)
+    Run *current_run = &nm->runs[i];
+    if (current_run->head < current_run->tail) {
+      // Access key via buffer head
+      uint64_t current_key = current_run->buf[current_run->head].key;
+
+      if (current_key < min_key) {
+        min_key = current_key;
+        min_idx = i;
+      }
+    }
+  }
+
+  // If no stream had data (min_idx remains -1), we are done.
+  // We already checked processed < total_expected at the start.
+  if (min_idx == -1) {
+    // This implies all streams are exhausted.
+    // Double-check against processed count for safety.
+    if (nm->processed < nm->total_expected) {
+      // This might indicate an issue if it happens before expected.
+      fprintf(stderr,
+              "Warning: Naive merge finished with min_idx -1, but not all "
+              "packets processed. %lu / %lu\n",
+              nm->processed, nm->total_expected);
+    }
+    return NULL;
+  }
+
+  // We found the minimum element at min_idx.
+  // Return a pointer to the packet in the winning run's buffer.
+  Run *winning_run = &nm->runs[min_idx];
+  Packet *result_packet_ptr = &winning_run->buf[winning_run->head];
+
+  nm->processed++; // Increment count *after* successfully finding a packet
+
+  // Advance the head for the winning run
+  winning_run->head++;
+
+  // Check if the winning run's buffer is now empty and try to refill
+  if (winning_run->head >= winning_run->tail) {
+    // Try to refill the buffer only if the run is not already marked EOF
+    if (!winning_run->eof) {
+      pull_batch(winning_run); // This updates tail and eof internally
+    }
+    // Check if the buffer is *still* empty after pulling (or if it was EOF)
+    if (winning_run->tail == 0) {
+      // Run is now exhausted (or was already EOF and empty)
+      // pull_batch sets eof to true if tail becomes 0
+      winning_run->eof = true; // Ensure it's marked if pull_batch didn't
+    } else {
+      // Buffer was successfully refilled, reset head
+      winning_run->head = 0;
+    }
+  }
+
+  return result_packet_ptr; // Return pointer to the packet (valid until next
+                            // call)
+}
+
+void naive_merger_cleanup(NaiveMerger *nm) {
+  // Nothing specific to free for the NaiveMerger struct itself anymore
+}
+
+/* --- Binary Heap Merger Implementation --- */
+
+/* Entry in our heap */
+typedef struct {
+  uint64_t key;       // Current key
+  uint32_t run_index; // Which run it belongs to
+} HeapEntry;
+
+/* Simple K-way merger using min-heap */
+typedef struct {
+  uint32_t K;              // Number of input streams
+  HeapEntry *heap;         // Min-heap of entries
+  uint32_t heap_size;      // Current size of heap
+  Run *runs;               // Array of runs
+  uint64_t processed;      // Counter for processed packets
+  uint64_t total_expected; // Total expected packets
+} Merger;
+
+/* Min-heap operations */
+static inline void swap_entries(HeapEntry *a, HeapEntry *b) {
+  HeapEntry temp = *a;
+  *a = *b;
+  *b = temp;
+}
+
+// Restores heap property downwards from index (Iterative version)
+static inline void heapify_down(HeapEntry *heap, uint32_t heap_size,
+                                uint32_t index) {
+  uint32_t current_index = index;
+  while (true) {
+    uint32_t smallest_idx = current_index;
+    uint32_t left_child_idx = 2 * current_index + 1;
+    uint32_t right_child_idx = 2 * current_index + 2;
+
+    // Check left child
+    if (left_child_idx < heap_size &&
+        heap[left_child_idx].key < heap[smallest_idx].key)
+      smallest_idx = left_child_idx;
+
+    // Check right child
+    if (right_child_idx < heap_size &&
+        heap[right_child_idx].key < heap[smallest_idx].key)
+      smallest_idx = right_child_idx;
+
+    // If smallest is still the current node, heap property is satisfied
+    if (smallest_idx == current_index)
+      break;
+
+    // Otherwise, swap with the smallest child and continue down
+    swap_entries(&heap[current_index], &heap[smallest_idx]);
+    current_index = smallest_idx; // Move down to the swapped child's index
+  }
+}
+
+// Builds min-heap from an arbitrary array
+static void build_heap(HeapEntry *heap, uint32_t heap_size) {
+  // Start from the last non-leaf node and heapify down
+  // Using int for loop condition safety with unsigned subtraction
+  // i >= 0 handles the case where heap_size is 0 or 1 correctly.
+  for (int i = (int)(heap_size / 2) - 1; i >= 0; i--) {
+    heapify_down(heap, heap_size, (uint32_t)i);
+  }
+}
+
+/* Initialize merger */
+void merger_init(Merger *m, Run *runs, uint32_t K, uint64_t total_expected) {
+  m->K = K;
+  m->runs = runs;
+  // Allocate memory for the heap
+  m->heap = (HeapEntry *)malloc(sizeof(HeapEntry) * K);
+  if (!m->heap) {
+    perror("Failed to allocate memory for heap merger");
+    exit(EXIT_FAILURE);
+  }
+  m->heap_size = 0;
+  m->processed = 0;
+  m->total_expected = total_expected;
+
+  // Reset runs, fill initial window, and load initial heap entries
+  for (uint32_t i = 0; i < K; i++) {
+    Run *r = &m->runs[i];
+    // Initialize/Reset run state (redundant if reset_runs is called before
+    // init, but safe)
+    r->head = 0;
+    r->tail = 0;
+    r->eof = false;
+    r->produced = 0;
+    // `next_key` start handled by reset_runs
+
+    // Initial fill only if needed
+    if (r->produced < r->total_size) {
+      pull_batch(r);
+    } else {
+      r->eof = true; // Already at total size
+    }
+
+    if (r->tail > 0) { // Only add to heap if the run has data
+      HeapEntry entry;
+      entry.key = r->buf[r->head].key; // Key of the first element
+      entry.run_index = i;
+      m->heap[m->heap_size++] = entry;
+    } else {
+      // Even if pull_batch was called, it might result in tail=0 if total_size
+      // was reached exactly or was 0 initially.
+      r->eof = true; // Mark as EOF if initially empty or immediately exhausted
+    }
+  }
+
+  // Build the initial heap from the loaded entries
+  if (m->heap_size > 0) {
+    build_heap(m->heap, m->heap_size);
+  }
+}
+
+/* Get next packet */
+Packet *merger_next(Merger *m) {
+  // Check if heap is empty or we've processed enough
+  if (m->heap_size == 0 || m->processed >= m->total_expected)
+    return NULL;
+
+  // Root of the heap has the minimum element
+  uint32_t winner_run_index = m->heap[0].run_index;
+  Run *run = &m->runs[winner_run_index];
+
+  // Get pointer to the winning packet and increment processed count
+  Packet *result = &run->buf[run->head];
+  m->processed++;
+
+  // Advance head pointer in the winning run's buffer
+  run->head++;
+
+  // --- Update heap or remove run ---
+  // Check if the buffer for the winning run is now exhausted
+  if (run->head >= run->tail) {
+    // Try to refill the buffer only if the run is not already marked EOF
+    // NOTE: pull_batch updates run->tail and run->eof
+    if (!run->eof) {
+      pull_batch(run);
+    }
+
+    // After attempting refill, check if the run is now exhausted
+    if (run->tail == 0) {
+      // pull_batch didn't get any more data, or it was already EOF
+      run->eof = true; // Ensure EOF is marked if pull_batch didn't
+      // Run is exhausted, remove it from heap
+      // Replace root with the last element from the heap
+      m->heap[0] = m->heap[m->heap_size - 1];
+      m->heap_size--; // Decrease heap size
+      // Restore heap property if heap is not empty
+      if (m->heap_size > 0) {
+        heapify_down(m->heap, m->heap_size, 0);
+      }
+      // Return the packet we retrieved before removing the run
+      return result;
+    } else {
+      // Successfully refilled, reset head
+      run->head = 0;
+      // Update the key in the heap with the new head element's key.
+      m->heap[0].key = run->buf[run->head].key;
+      // Heapify down to restore property
+      heapify_down(m->heap, m->heap_size, 0);
+    }
+  } else {
+    // Buffer still had elements. Update heap root with the next element's key.
+    m->heap[0].key = run->buf[run->head].key;
+    // Heapify down to restore property.
+    heapify_down(m->heap, m->heap_size, 0);
+  }
+
+  return result; // Return the packet obtained earlier
+}
+
+void merger_cleanup(Merger *m) {
+  if (m->heap) {
+    free(m->heap);
+    m->heap = NULL;
+  }
+}
+
+/* --- Loser Tree Implementation --- */
+
+typedef struct {
+  uint32_t K;     // Number of streams
+  uint32_t Kpow2; // Next power of 2 >= K
+  uint32_t
+      *restrict tree; // Loser tree array (internal nodes store loser index)
+  uint64_t *restrict keys; // Current key for each run (external nodes)
+                           // keys[i] == INF_KEY means run i is exhausted
+  Run *restrict runs;      // External array of Run[K]
+  uint32_t winner;         // Index of current overall winner run
+  uint64_t processed;      // Counter for processed packets
+  uint64_t total_expected; // Total expected packets
+} LoserTree;
+
+/* Adjust function to maintain loser tree structure (Optimized Version) */
+// challenger_idx: index of the run that provided the last element
+//                 (and thus needs its key updated in the tree)
+static inline void loser_tree_adjust(LoserTree *restrict t,
+                                     uint32_t challenger_idx) {
+  // Start with the index of the run that needs updating
+  uint32_t current_challenger_index = challenger_idx;
+  // Determine the starting tree node index (parent of the leaf)
+  uint32_t tree_node_idx = (current_challenger_index + t->Kpow2) / 2;
+
+  uint32_t *restrict tree_arr = t->tree; // Local pointer for tree array
+  uint64_t *restrict key_arr = t->keys;  // Local pointer for key array
+
+  while (tree_node_idx > 0) {
+    // Get the index of the loser currently stored at this tree node
+    uint32_t current_loser_idx = tree_arr[tree_node_idx];
+
+    // Compare the current challenger's key against the current loser's key
+    // INF keys are handled naturally (INF > any valid key)
+    if (key_arr[current_challenger_index] > key_arr[current_loser_idx]) {
+      // The challenger is larger (loses) and gets stored at this node.
+      tree_arr[tree_node_idx] = current_challenger_index;
+
+      // The previous loser becomes the new challenger to continue up the tree.
+      current_challenger_index = current_loser_idx;
+    }
+    // If challenger_key <= current_loser_key, the challenger wins this
+    // comparison and continues up the tree unchanged. The current_loser_idx
+    // remains stored at this node.
+
+    // Move up to the parent node for the next round of comparison
+    tree_node_idx /= 2;
+  }
+  // After the loop, current_challenger_index holds the index of the overall
+  // winner.
+  t->winner = current_challenger_index;
+}
+
+/* Initialize loser tree */
+void loser_tree_init(LoserTree *t, Run *runs, uint32_t K,
+                     uint64_t total_expected) {
+  t->K = K;
+  t->Kpow2 = pow2_ceil(K);
+  t->runs = runs;
+  t->processed = 0;
+  t->total_expected = total_expected;
+
+  // Allocate memory using aligned_alloc might help cache alignment slightly
+  t->tree = (uint32_t *)aligned_alloc(64, t->Kpow2 * sizeof(uint32_t));
+  t->keys = (uint64_t *)aligned_alloc(64, K * sizeof(uint64_t));
+  // t->tree = (uint32_t *)malloc(t->Kpow2 * sizeof(uint32_t)); // Fallback
+  // t->keys = (uint64_t *)malloc(K * sizeof(uint64_t)); // Fallback
+  if (!t->tree || !t->keys) {
+    perror("Failed to allocate memory for loser tree");
+    exit(EXIT_FAILURE);
+  }
+
+  // Initialize runs and fetch initial keys/status
+  uint32_t first_active_run = K; // Sentinel: index of first run found with data
+  for (uint32_t i = 0; i < K; i++) {
+    Run *r = &t->runs[i];
+    // Initialize/Reset run state (redundant if reset_runs is called before
+    // init, but safe)
+    r->head = 0;
+    r->tail = 0;
+    r->eof = false;
+    r->produced = 0;
+    // `next_key` start handled by reset_runs
+
+    // Initial fill only if needed
+    if (r->produced < r->total_size) {
+      pull_batch(r);
+    } else {
+      r->eof = true; // Already at total size
+    }
+
+    if (r->tail > 0) {
+      t->keys[i] = r->buf[r->head].key;
+      if (first_active_run == K) { // Track the first run with data found
+        first_active_run = i;
+      }
+    } else {
+      t->keys[i] = INF_KEY; // Mark exhausted
+      r->eof = true;
+    }
+  }
+
+  // Check if all streams were initially empty
+  if (first_active_run == K) {
+    // Initialize tree nodes to point to a valid index (e.g., 0)
+    // This state indicates an empty merge tree
+    for (uint32_t i = 0; i < t->Kpow2; ++i)
+      t->tree[i] = 0; // Pointing to 0 is safe as long as K>0
+    // Mark processed as total expected to prevent next() calls
+    t->processed = t->total_expected;
+    t->winner = K; // Use K as an invalid winner index to signal empty tree
+  } else {
+    // Initialize tree: conceptually set all nodes to point to the first active
+    // run initially, this is a common way to set up the initial state
+    for (uint32_t i = 0; i < t->Kpow2; ++i) {
+      t->tree[i] = first_active_run;
+    }
+    t->winner = first_active_run; // Set initial winner explicitly
+
+    // Build the initial tree state by adjusting for each run.
+    // The initial `winner` is set to `first_active_run`. The `adjust` calls
+    // for subsequent runs will correctly compare and update the tree nodes,
+    // eventually settling on the true minimum as the winner.
+    for (uint32_t i = 0; i < K; i++) {
+      // Only adjust if the stream is not initially exhausted.
+      // Adjust Function handles INF_KEY correctly by making them always lose
+      loser_tree_adjust(t, i);
+    }
+    // After initializing all nodes and adjusting, the winner should be correct.
+  }
+}
+
+/* Get next packet from loser tree */
+Packet *loser_tree_next(LoserTree *t) {
+  // Check if already processed enough or if the tree is known to be
+  // empty/exhausted t->winner == K indicates an empty tree from init
+  // t->keys[t->winner] == INF_KEY indicates all remaining streams are exhausted
+  if (t->processed >= t->total_expected || t->winner == t->K ||
+      t->keys[t->winner] == INF_KEY) {
+    // Check if processed matches expected at the end for verification
+    if (t->processed < t->total_expected && t->keys[t->winner] == INF_KEY) {
+      fprintf(stderr,
+              "Warning: LoserTree winner key is INF, but not all packets "
+              "processed. %lu / %lu\n",
+              t->processed, t->total_expected);
+    }
+    return NULL;
+  }
+
+  // Get index of the winning run
+  uint32_t winner_run_idx = t->winner;
+  Run *restrict run = &t->runs[winner_run_idx];
+
+  // Sanity check: Winning run should have data if its key is not INF
+  assert(run->head < run->tail && "Loser tree winner run has empty buffer!");
+
+  // Get pointer to the winning packet
+  Packet *result = &run->buf[run->head];
+  t->processed++;
+
+  // Advance head pointer in the winning run's buffer
+  run->head++;
+
+  // --- Refill Logic ---
+  // Check if the buffer for the winning run is now exhausted
+  if (run->head >= run->tail) {
+    // Try to refill the buffer only if the run is not already marked EOF
+    // NOTE: pull_batch updates run->tail and run->eof
+    if (!run->eof) {
+      pull_batch(run); // Refills buffer, updates tail/eof flags internally
+    }
+
+    // After attempting refill, check if the run has any data in the buffer
+    if (run->tail > 0) {
+      // Successfully refilled or was already refilled by a previous pull_batch
+      run->head =
+          0; // Reset head as buffer is conceptually refilled from the start
+      t->keys[winner_run_idx] =
+          run->buf[run->head].key; // Update key from new head
+    } else {
+      // pull_batch didn't get any more data, or it was already EOF with an
+      // empty buffer
+      run->eof = true; // Ensure EOF is marked
+      t->keys[winner_run_idx] =
+          INF_KEY; // Mark stream as finished in the tree keys
+    }
+  } else {
+    // Buffer still had elements. Update key from the new head.
+    t->keys[winner_run_idx] = run->buf[run->head].key;
+  }
+
+  // Adjust the loser tree based on the new key (or INF_KEY) of the run that
+  // just yielded the element.
+  loser_tree_adjust(t, winner_run_idx);
+
+  return result; // Return the packet obtained earlier
+}
+
+void loser_tree_cleanup(LoserTree *t) {
+  if (t->tree) {
+    free(t->tree); // Use specific free for aligned alloc if needed (handled by
+                   // macro now)
+    t->tree = NULL;
+  }
+  if (t->keys) {
+    free(t->keys); // Use specific free for aligned alloc if needed
+    t->keys = NULL;
+  }
+}
+
+/* --- Test Framework --- */
+
+/* Initialize runs with lazy stream generation */
+void initialize_lazy_streams(Run *runs, uint32_t K, uint32_t elements_per_run) {
+  printf("Initializing %u lazy streams with %u elements per stream\n", K,
+         elements_per_run);
+  init_random_steps(); // Ensure random steps are ready
+
+  for (uint32_t i = 0; i < K; i++) {
+    if (!runs[i].buf) { // Allocate buffer only if not already allocated
+      // Use aligned allocation for potentially better performance? (Minimal
+      // effect usually). Using posix_memalign fallback for POSIX.
+      runs[i].buf = (Packet *)aligned_alloc(64, WINDOW * sizeof(Packet));
+      if (!runs[i].buf) {
+        perror("Failed to allocate run buffer");
+        fprintf(stderr, "Attempting malloc fallback...\n");
+        // Attempt malloc fallback if aligned_alloc failed on some systems
+        runs[i].buf = (Packet *)malloc(WINDOW * sizeof(Packet));
+        if (!runs[i].buf) {
+          perror("Failed to allocate run buffer with malloc fallback");
+          exit(EXIT_FAILURE);
+        }
+        fprintf(
+            stderr,
+            "Warning: aligned_alloc failed, using malloc for run buffer %u.\n",
+            i);
+      }
+    }
+    runs[i].head = 0;
+    runs[i].tail = 0;
+    runs[i].eof = false;
+    runs[i].produced = 0;
+    runs[i].total_size = elements_per_run;
+    runs[i].run_id = i;
+
+    // Set starting point for this run's key generation
+    // Distribute starting keys more evenly to avoid initial clumping
+    runs[i].next_key = ((uint64_t)i * (UINT64_MAX / (K + 1))) / 2;
+  }
+}
+
+/* Reset runs state without reallocating buffers */
+void reset_runs(Run *runs, uint32_t K) {
+  init_random_steps(); // Ensure random steps are reset if seed is fixed
+  for (uint32_t i = 0; i < K; i++) {
+    runs[i].head = 0;
+    runs[i].tail = 0;
+    runs[i].eof = false;
+    runs[i].produced = 0;
+    // Reset starting key based on run_id for consistency across tests
+    // Reset next_key to its initial deterministic value.
+    runs[i].next_key = ((uint64_t)runs[i].run_id * (UINT64_MAX / (K + 1))) / 2;
+    // Ensure total_size remains correct (it should not change unless
+    // K/elements_per_run change) runs[i].total_size = elements_per_run; //
+    // Usually set in initialize_lazy_streams
+  }
+}
+
+/* Simple checksum calculation */
+static uint64_t calculate_checksum(Packet *pkt) {
+  // Simple checksum to ensure packet data is used
+  // Shift and XOR to mix bits a bit
+  uint64_t sum = pkt->key;
+  sum = sum ^ ((uint64_t)pkt->value << 16);
+  // Using just key and value now. Run ID is implicitly part of value.
+  return sum;
+}
+
+/* Baseline test - process a single run with no merging */
+void test_no_merge(Run *runs, uint32_t K, uint32_t elements_per_run) {
+  struct timeval start, end;
+  // Only process the first run for the baseline
+  uint64_t total_packets_to_process = elements_per_run;
+  NoMerger nm;
+  Packet *pkt;
+  uint64_t count = 0;
+  volatile uint64_t checksum = 0; // Prevent optimizing out packet access
+
+  // Reset runs state before init (Important!), only affects the first run for
+  // this test
+  reset_runs(runs, K); // Resets all runs, but only runs[0] is used
+  // Need to ensure runs[0]'s total_size is set correctly for this test
+  runs[0].total_size =
+      elements_per_run; // Ensure total_size is correct for the single run test
+
+  // Initialize the "no merger" for the first run
+  no_merger_init(&nm, &runs[0], total_packets_to_process);
+
+  gettimeofday(&start, NULL);
+  // Process all packets from the single stream
+  while ((pkt = no_merger_next(&nm)) != NULL) {
+    checksum += calculate_checksum(pkt); // Access the data
+    count++;
+  }
+  gettimeofday(&end, NULL);
+
+  double elapsed =
+      (end.tv_sec - start.tv_sec) + (end.tv_usec - start.tv_usec) / 1000000.0;
+  double rate =
+      (count > 0 && elapsed > 0) ? (double)count / elapsed / 1000000.0 : 0.0;
+
+  printf("Single stream (no merge) of %lu packets: %.3f seconds (%.1f M "
+         "pkts/sec) [Chk: %lu]\n",
+         total_packets_to_process, elapsed, rate, checksum); // Print checksum
+  if (count != total_packets_to_process) {
+    fprintf(stderr, "ERROR: NoMerge processed %lu packets, expected %lu\n",
+            count, total_packets_to_process);
+  }
+
+  no_merger_cleanup(&nm);
+}
+
+/* Naive merge using the refactored interface */
+void test_naive_merge(Run *runs, uint32_t K, uint32_t elements_per_run) {
+  struct timeval start, end;
+  uint64_t total_packets = (uint64_t)K * elements_per_run;
+  NaiveMerger nm;
+  Packet *pkt;
+  uint64_t count = 0;
+  volatile uint64_t checksum = 0; // Prevent optimizing out packet access
+
+  // Reset runs state before init (Important!)
+  reset_runs(runs, K);
+  // Initialize naive merger (now uses buffered approach)
+  naive_merger_init(&nm, runs, K, total_packets);
+
+  gettimeofday(&start, NULL);
+  // Process all elements, always taking the minimum key
+  while ((pkt = naive_merger_next(&nm)) != NULL) {
+    checksum += calculate_checksum(pkt); // Access the data
+    count++;
+  }
+  gettimeofday(&end, NULL);
+
+  double elapsed =
+      (end.tv_sec - start.tv_sec) + (end.tv_usec - start.tv_usec) / 1000000.0;
+  double rate =
+      (count > 0 && elapsed > 0) ? (double)count / elapsed / 1000000.0 : 0.0;
+
+  printf(
+      "Naive merge of %lu packets: %.3f seconds (%.1f M pkts/sec) [Chk: %lu]\n",
+      total_packets, elapsed, rate, checksum);
+  if (count != total_packets) {
+    fprintf(stderr, "ERROR: NaiveMerge processed %lu packets, expected %lu\n",
+            count, total_packets);
+  }
+  naive_merger_cleanup(&nm); // Added cleanup call
+}
+
+/* Test k-way merge performance with binary heap */
+void test_kway_merge(Run *runs, uint32_t K, uint32_t elements_per_run) {
+  struct timeval start, end;
+  uint64_t total_packets = (uint64_t)K * elements_per_run;
+  Merger m;
+  Packet *pkt;
+  uint64_t count = 0;
+  volatile uint64_t checksum = 0; // Prevent optimizing out packet access
+
+  // Reset runs state before init (Important!)
+  reset_runs(runs, K);
+  // Initialize merger
+  merger_init(&m, runs, K, total_packets);
+
+  gettimeofday(&start, NULL);
+  // Process all packets using the binary heap merger
+  while ((pkt = merger_next(&m)) != NULL) {
+    checksum += calculate_checksum(pkt); // Access the data
+    count++;
+  }
+  gettimeofday(&end, NULL);
+
+  double elapsed =
+      (end.tv_sec - start.tv_sec) + (end.tv_usec - start.tv_usec) / 1000000.0;
+  double rate =
+      (count > 0 && elapsed > 0) ? (double)count / elapsed / 1000000.0 : 0.0;
+
+  printf("Binary heap merge of %lu packets: %.3f seconds (%.1f M pkts/sec) "
+         "[Chk: %lu]\n",
+         total_packets, elapsed, rate, checksum);
+  if (count != total_packets) {
+    fprintf(stderr, "ERROR: HeapMerge processed %lu packets, expected %lu\n",
+            count, total_packets);
+  }
+
+  merger_cleanup(&m);
+}
+
+/* Test the optimized loser tree implementation */
+void test_loser_tree_merge(Run *runs, uint32_t K, uint32_t elements_per_run) {
+  struct timeval start, end;
+  uint64_t total_packets = (uint64_t)K * elements_per_run;
+  LoserTree t;
+  Packet *pkt;
+  uint64_t count = 0;
+  volatile uint64_t checksum = 0; // Prevent optimizing out packet access
+
+  // Reset runs state before init (Important!)
+  reset_runs(runs, K);
+  // Initialize loser tree
+  loser_tree_init(&t, runs, K, total_packets);
+
+  gettimeofday(&start, NULL);
+  // Process all packets using the proper loser tree
+  while ((pkt = loser_tree_next(&t)) != NULL) {
+    checksum += calculate_checksum(pkt); // Access the data
+    count++;
+  }
+  gettimeofday(&end, NULL);
+
+  double elapsed =
+      (end.tv_sec - start.tv_sec) + (end.tv_usec - start.tv_usec) / 1000000.0;
+  double rate =
+      (count > 0 && elapsed > 0) ? (double)count / elapsed / 1000000.0 : 0.0;
+
+  printf("Loser tree merge of %lu packets: %.3f seconds (%.1f M pkts/sec) "
+         "[Chk: %lu]\n",
+         total_packets, elapsed, rate, checksum);
+  if (count != total_packets) {
+    fprintf(stderr, "ERROR: LoserTree processed %lu packets, expected %lu\n",
+            count, total_packets);
+  }
+
+  loser_tree_cleanup(&t);
+}
+
+/* Cleanup allocated run buffers */
+void cleanup_runs(Run *runs, uint32_t K) {
+  if (runs) {
+    for (uint32_t i = 0; i < K; i++) {
+      if (runs[i].buf) {   // Check if buffer was allocated
+        free(runs[i].buf); // Use specific free for aligned alloc if needed,
+                           // handled by macro
+        runs[i].buf = NULL;
+      }
+    }
+    free(runs);
+  }
+}
+
+int main(int argc, char *argv[]) {
+  // Default parameters
+  uint32_t K = 16;                     // Number of input streams
+  uint32_t elements_per_run = 1000000; // Elements per stream
+
+  // Allow command line override
+  if (argc > 1) {
+    long temp_k_long = strtol(argv[1], NULL, 10);
+    if (temp_k_long > 0 && temp_k_long <= MAXK) {
+      K = (uint32_t)temp_k_long;
+    } else {
+      fprintf(stderr,
+              "Warning: Invalid K value provided ('%s'). Using default K=%u.\n",
+              argv[1], K);
+      if (temp_k_long > MAXK) {
+        fprintf(stderr, "Reason: K exceeds MAXK (%d).\n", MAXK);
+      } else if (temp_k_long <= 0) {
+        fprintf(stderr, "Reason: K must be a positive integer.\n");
+      }
+    }
+  }
+
+  if (argc > 2) {
+    long temp_elements_long = strtol(argv[2], NULL, 10);
+    if (temp_elements_long > 0) {
+      elements_per_run = (uint32_t)temp_elements_long;
+    } else {
+      fprintf(stderr,
+              "Warning: Invalid elements_per_run provided ('%s'). Using "
+              "default N=%u.\n",
+              argv[2], elements_per_run);
+      fprintf(stderr, "Reason: elements_per_run must be a positive integer.\n");
+    }
+  }
+
+  // Allocate Run structures (buffers allocated in initialize_lazy_streams)
+  // Use calloc for zero-initialization, helpful for buf pointers initially
+  Run *runs = (Run *)calloc(K, sizeof(Run));
+  if (!runs) {
+    perror("Failed to allocate Run structures");
+    return 1;
+  }
+
+  // Determine total expected packets *before* initialization
+  uint64_t total_expected_packets = (uint64_t)K * elements_per_run;
+
+  // Initialize lazy streams (allocates buffers, sets initial state)
+  // This also sets total_size for each run to elements_per_run
+  initialize_lazy_streams(runs, K, elements_per_run);
+
+  printf("\n--- Starting performance tests ---\n");
+  printf("Parameters: K=%u streams, N=%u elements/stream\n", K,
+         elements_per_run);
+  printf("Total elements: %lu, Buffer window size (per stream): %d\n",
+         total_expected_packets, WINDOW);
+  printf("Optimization flags: (Check your Makefile/build command, e.g., -O2, "
+         "-O3, -march=native)\n");
+
+  // IMPORTANT: Each test function calls reset_runs internally to ensure
+  // a consistent starting state for the runs array.
+
+  printf("\n--- Benchmarks ---\n");
+  test_no_merge(runs, K, elements_per_run);    // Baseline (only uses runs[0])
+  test_naive_merge(runs, K, elements_per_run); // Now uses buffered approach
+  test_kway_merge(runs, K, elements_per_run);  // Binary Heap
+  test_loser_tree_merge(runs, K, elements_per_run); // Optimized Loser Tree
+
+  printf("\n--- Tests finished ---\n");
+
+  // Cleanup run buffers and the runs array itself
+  cleanup_runs(runs, K);
+
+  return 0;
+}
