+/// Creates a new empty FFI_ArrowArrayStream for receiving data from C
+pub fn create_empty_stream() -> FFI_ArrowArrayStream {
+    FFI_ArrowArrayStream::empty()
+}
+
+/// Export the FFI_ArrowArrayStream into a raw pointer for C consumption
+///
+/// # Safety
+///
+/// The caller must ensure the stream is properly released
+#[no_mangle]
+pub unsafe extern "C" fn export_parquet_file_to_stream(
+    path: *const std::os::raw::c_char,
+    out_stream: *mut FFI_ArrowArrayStream,
+) -> c_int {
+    use std::ffi::CStr;
+
+    if path.is_null() || out_stream.is_null() {
+        return -1;
+    }
+
+    let c_path = CStr::from_ptr(path);
+    let path_str = match c_path.to_str() {
+        Ok(s) => s,
+        Err(_) => return -1,
+    };
+
+    match export_parquet_to_ffi(path_str) {
+        Ok(stream) => {
+            std::ptr::write(out_stream, stream);
+            0
+        }
+        Err(_) => -1,
+    }
+}
