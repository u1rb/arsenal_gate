+/* --- Test Framework --- */
+
+/* Initialize runs with lazy stream generation */
+void initialize_lazy_streams(Run *runs, uint32_t K, uint32_t elements_per_run) {
+  printf("Initializing %u lazy streams with %u elements per stream\n", K,
+         elements_per_run);
+  init_random_steps(); // Ensure random steps are ready
+
+  for (uint32_t i = 0; i < K; i++) {
+    if (!runs[i].buf) { // Allocate buffer only if not already allocated
+                        // Use aligned allocation based on compile flag
+#ifdef USE_ALIGNED_ALLOC
+      runs[i].buf = (Packet *)my_aligned_alloc(64, WINDOW * sizeof(Packet));
+      if (!runs[i].buf) {
+        perror("Failed to allocate run buffer");
+        fprintf(stderr, "Attempting malloc fallback...\n");
+        // Attempt malloc fallback if aligned_alloc failed on some systems
+        runs[i].buf = (Packet *)malloc(WINDOW * sizeof(Packet));
+        if (!runs[i].buf) {
+          perror("Failed to allocate run buffer with malloc fallback");
+          exit(EXIT_FAILURE);
+        }
+        fprintf(stderr,
+                "Warning: aligned allocation failed, using malloc for run "
+                "buffer %u.\n",
+                i);
+      }
+#else
+      // When USE_ALIGNED_ALLOC is not defined, directly use malloc
+      runs[i].buf = (Packet *)malloc(WINDOW * sizeof(Packet));
+      if (!runs[i].buf) {
+        perror("Failed to allocate run buffer with malloc");
+        exit(EXIT_FAILURE);
+      }
+#endif
+    }
+    runs[i].head = 0;
+    runs[i].tail = 0;
+    runs[i].eof = false;
+    runs[i].produced = 0;
+    runs[i].total_size = elements_per_run;
+    runs[i].run_id = i;
+
+    // Set starting point for this run's key generation
+    // Distribute starting keys more evenly to avoid initial clumping
+    runs[i].next_key = ((uint64_t)i * (UINT64_MAX / (K + 1))) / 2;
+  }
+}
+
+/* Reset runs state without reallocating buffers */
+void reset_runs(Run *runs, uint32_t K) {
+  init_random_steps(); // Ensure random steps are reset if seed is fixed
+  for (uint32_t i = 0; i < K; i++) {
+    runs[i].head = 0;
+    runs[i].tail = 0;
+    runs[i].eof = false;
+    runs[i].produced = 0;
+    // Reset starting key based on run_id for consistency across tests
+    // Reset next_key to its initial deterministic value.
+    runs[i].next_key = ((uint64_t)runs[i].run_id * (UINT64_MAX / (K + 1))) / 2;
+    // Ensure total_size remains correct (it should not change unless
+    // K/elements_per_run change) runs[i].total_size = elements_per_run; //
+    // Usually set in initialize_lazy_streams
+  }
+}
+
+/* Simple checksum calculation */
+static uint64_t calculate_checksum(Packet *pkt) {
+  // Simple checksum to ensure packet data is used
+  // Shift and XOR to mix bits a bit
+  uint64_t sum = pkt->key;
+  sum = sum ^ ((uint64_t)pkt->value << 16);
+  // Using just key and value now. Run ID is implicitly part of value.
+  return sum;
+}
+
+/* Baseline test - process a single run with no merging */
+void test_no_merge(Run *runs, uint32_t K, uint32_t elements_per_run) {
+  struct timeval start, end;
+  // Only process the first run for the baseline
+  uint64_t total_packets_to_process = elements_per_run;
+  PacketStream stream = {0}; // Initialize stream
+  Packet *pkt;
+  uint64_t count = 0;
+  volatile uint64_t checksum = 0; // Prevent optimizing out packet access
+
+  // Reset runs state before init (Important!), only affects the first run for
+  // this test
+  reset_runs(runs, K); // Resets all runs, but only runs[0] is used
+  // Need to ensure runs[0]'s total_size is set correctly for this test
+  runs[0].total_size =
+      elements_per_run; // Ensure total_size is correct for the single run test
+
+  // Initialize the "no merger" for the first run
+  if (no_merger_init_stream(&stream, runs, 1, total_packets_to_process) != 0) {
+    perror("Failed to initialize no_merge stream");
+    return; // Or handle error appropriately
+  }
+
+  // Get direct accessor for better performance
+  NoMerger *nm = stream.impl.no_merger;
+
+  gettimeofday(&start, NULL);
+  // Process all packets directly using the optimized function
+  while ((pkt = no_merger_next(nm)) != NULL) {
+    checksum += calculate_checksum(pkt); // Access the data
+    count++;
+  }
+  gettimeofday(&end, NULL);
+
+  double elapsed =
+      (end.tv_sec - start.tv_sec) + (end.tv_usec - start.tv_usec) / 1000000.0;
+  double rate =
+      (count > 0 && elapsed > 0) ? (double)count / elapsed / 1000000.0 : 0.0;
+
+  printf("Single stream (no merge) of %lu packets: %.3f seconds (%.1f M "
+         "pkts/sec) [Chk: %lu]\n",
+         total_packets_to_process, elapsed, rate, checksum); // Print checksum
+  if (count != total_packets_to_process) {
+    fprintf(stderr, "ERROR: NoMerge processed %lu packets, expected %lu\n",
+            count, total_packets_to_process);
+  }
+
+  // Use the stream's cleanup function pointer via helper
+  packet_stream_release(&stream);
+}
