+    const int32_t *values = (const int32_t *)array->buffers[1];
+    const uint8_t *validity = (const uint8_t *)array->buffers[0];
+
+    // Check validity
+    if (validity &&
+        !(validity[array->offset / 8] & (1 << (array->offset % 8)))) {
+      printf("null");
+    } else {
+      printf("%d", values[array->offset]);
+    }
+  } else if (strcmp(schema->format, "c") == 0) {
