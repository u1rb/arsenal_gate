diff --git a/parquet_ffi/src/ffi/reader.rs b/parquet_ffi/src/ffi/reader.rs
new file mode 100644
index 0000000..6575b12
--- /dev/null
+++ b/parquet_ffi/src/ffi/reader.rs
@@ -0,0 +1,892 @@
+use std::ffi::{c_char, CStr, CString};
+use std::fs::File;
+use std::path::Path;
+use std::ptr::null_mut;
+use std::sync::Arc;
+
+use arrow::array::RecordBatchReader;
+use arrow::array::{Array, BinaryArray, BooleanArray, PrimitiveArray, StringArray};
+use arrow::datatypes::{ArrowPrimitiveType, DataType, Schema};
+use arrow::record_batch::RecordBatch;
+use parquet::arrow::arrow_reader::{ParquetRecordBatchReader, ParquetRecordBatchReaderBuilder};
+use parquet::file::metadata::ParquetMetaData;
+use parquet::file::reader::{FileReader, SerializedFileReader};
+
+use crate::ffi::types::{
+    ParquetColumnDef, ParquetDataType, ParquetError, ParquetReaderHandle, ParquetReaderOptions,
+    ParquetRowBatch,
+};
+
+/// Structure that holds reader state
+pub struct ParquetReader {
+    reader: ParquetRecordBatchReader,
+    schema: Arc<Schema>,
+    file_metadata: Arc<ParquetMetaData>,
+    column_types: Vec<ParquetDataType>,
+    current_batch: Option<RecordBatch>,
+}
+
+/// Convert a C-string to a Rust String
+fn c_char_to_string(ptr: *const c_char) -> Result<String, ParquetError> {
+    if ptr.is_null() {
+        return Err(ParquetError::ParquetInvalidPath);
+    }
+
+    let c_str = unsafe { CStr::from_ptr(ptr) };
+    match c_str.to_str() {
+        Ok(s) => Ok(s.to_string()),
+        Err(_) => Err(ParquetError::ParquetInvalidPath),
+    }
+}
+
+/// Convert from Arrow DataType to ParquetDataType
+fn to_parquet_data_type(data_type: &DataType) -> ParquetDataType {
+    match data_type {
+        DataType::Boolean => ParquetDataType::ParquetBoolean,
+        DataType::Int8 => ParquetDataType::ParquetInt8,
+        DataType::Int16 => ParquetDataType::ParquetInt16,
+        DataType::Int32 => ParquetDataType::ParquetInt32,
+        DataType::Int64 => ParquetDataType::ParquetInt64,
+        DataType::UInt8 => ParquetDataType::ParquetUint8,
+        DataType::UInt16 => ParquetDataType::ParquetUint16,
+        DataType::UInt32 => ParquetDataType::ParquetUint32,
+        DataType::UInt64 => ParquetDataType::ParquetUint64,
+        DataType::Float32 => ParquetDataType::ParquetFloat,
+        DataType::Float64 => ParquetDataType::ParquetDouble,
+        DataType::Utf8 => ParquetDataType::ParquetString,
+        DataType::Binary => ParquetDataType::ParquetBinary,
+        DataType::Date32 => ParquetDataType::ParquetDate32,
+        DataType::Timestamp(arrow::datatypes::TimeUnit::Millisecond, _) => {
+            ParquetDataType::ParquetTimestampMs
+        }
+        DataType::Timestamp(arrow::datatypes::TimeUnit::Microsecond, _) => {
+            ParquetDataType::ParquetTimestampUs
+        }
+        DataType::Timestamp(arrow::datatypes::TimeUnit::Nanosecond, _) => {
+            ParquetDataType::ParquetTimestampNs
+        }
+        _ => ParquetDataType::ParquetString, // Default to string for unsupported types
+    }
+}
+
+/// Open a Parquet file for reading
+#[no_mangle]
+pub extern "C" fn parquet_reader_open(
+    path: *const c_char,
+    options: ParquetReaderOptions,
+    handle: *mut *mut ParquetReaderHandle,
+) -> ParquetError {
+    // Check parameters
+    if path.is_null() {
+        return ParquetError::ParquetInvalidPath;
+    }
+    if handle.is_null() {
+        return ParquetError::ParquetInvalidHandle;
+    }
+
+    // Set handle to null initially
+    unsafe { *handle = null_mut() };
+
+    // Get the file path
+    let path_str = match c_char_to_string(path) {
+        Ok(s) => s,
+        Err(e) => return e,
+    };
+    let path_obj = Path::new(&path_str);
+
+    // Open the file for reading
+    let file = match File::open(path_obj) {
+        Ok(f) => f,
+        Err(_) => return ParquetError::ParquetFileOpenError,
+    };
+
+    // Get file metadata first
+    let file_reader = match SerializedFileReader::new(file.try_clone().unwrap()) {
+        Ok(r) => r,
+        Err(_) => return ParquetError::ParquetFileReadError,
+    };
+
+    let file_metadata = Arc::new(file_reader.metadata().clone());
+
+    // Create a batch reader builder
+    let reader_builder = match ParquetRecordBatchReaderBuilder::try_new(file) {
+        Ok(b) => b,
+        Err(_) => return ParquetError::ParquetFileReadError,
+    };
+
+    // Configure the reader
+    let reader_builder = reader_builder.with_batch_size(options.batch_size as usize);
+
+    // Build the reader
+    let reader = match reader_builder.build() {
+        Ok(r) => r,
+        Err(_) => return ParquetError::ParquetFileReadError,
+    };
+
+    // Get the schema
+    let schema = reader.schema();
+
+    // Map Arrow types to our ParquetDataType enum
+    let mut column_types = Vec::with_capacity(schema.fields().len());
+    for field in schema.fields() {
+        column_types.push(to_parquet_data_type(field.data_type()));
+    }
+
+    // Create the reader struct
+    let parquet_reader = ParquetReader {
+        reader,
+        schema,
+        file_metadata,
+        column_types,
+        current_batch: None,
+    };
+
+    // Return the handle
+    let boxed_reader = Box::new(parquet_reader);
+    unsafe {
+        *handle = Box::into_raw(boxed_reader) as *mut ParquetReaderHandle;
+    }
+
+    ParquetError::ParquetOk
+}
+
+/// Get a mutable reference to the reader from a handle
+fn get_reader_mut(
+    handle: *mut ParquetReaderHandle,
+) -> Result<&'static mut ParquetReader, ParquetError> {
+    unsafe {
+        if handle.is_null() {
+            return Err(ParquetError::ParquetInvalidHandle);
+        }
+
+        Ok(&mut *(handle as *mut ParquetReader))
+    }
+}
+
+/// Get a reference to the reader from a handle
+fn get_reader(handle: *mut ParquetReaderHandle) -> Result<&'static ParquetReader, ParquetError> {
+    unsafe {
+        if handle.is_null() {
+            return Err(ParquetError::ParquetInvalidHandle);
+        }
+
+        Ok(&*(handle as *mut ParquetReader))
+    }
+}
+
+/// Get the number of rows in the Parquet file
+#[no_mangle]
+pub extern "C" fn parquet_reader_get_num_rows(
+    handle: *mut ParquetReaderHandle,
+    num_rows: *mut u64,
+) -> ParquetError {
+    // Check parameters
+    if num_rows.is_null() {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Get reader
+    let reader = match get_reader(handle) {
+        Ok(r) => r,
+        Err(e) => return e,
+    };
+
+    // Get the number of rows
+    let row_count = reader.file_metadata.file_metadata().num_rows();
+
+    // Return the count
+    unsafe {
+        *num_rows = row_count as u64;
+    }
+
+    ParquetError::ParquetOk
+}
