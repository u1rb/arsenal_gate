+/* Test k-way merge performance with binary heap */
+void test_kway_merge(Run *runs, uint32_t K, uint32_t elements_per_run) {
+  struct timeval start, end;
+  uint64_t total_packets = (uint64_t)K * elements_per_run;
+  PacketStream stream = {0}; // Initialize stream
+  Packet *pkt;
+  uint64_t count = 0;
+  volatile uint64_t checksum = 0; // Prevent optimizing out packet access
+
+  // Reset runs state before init (Important!)
+  reset_runs(runs, K);
+  // Initialize merger
+  if (merger_init_stream(&stream, runs, K, total_packets) != 0) {
+    perror("Failed to initialize kway_merge stream");
+    return; // Or handle error appropriately
+  }
+
+  // Get direct accessor for better performance
+  Merger *m = stream.impl.merger;
+
+  gettimeofday(&start, NULL);
+  // Process all packets directly using the optimized function
+  while ((pkt = merger_next(m)) != NULL) {
+    checksum += calculate_checksum(pkt); // Access the data
+    count++;
+  }
+  gettimeofday(&end, NULL);
+
+  double elapsed =
+      (end.tv_sec - start.tv_sec) + (end.tv_usec - start.tv_usec) / 1000000.0;
+  double rate =
+      (count > 0 && elapsed > 0) ? (double)count / elapsed / 1000000.0 : 0.0;
+
+  printf("Binary heap merge of %lu packets: %.3f seconds (%.1f M pkts/sec) "
+         "[Chk: %lu]\n",
+         total_packets, elapsed, rate, checksum);
+  if (count != total_packets) {
+    fprintf(stderr, "ERROR: HeapMerge processed %lu packets, expected %lu\n",
+            count, total_packets);
+  }
+
+  // Use the stream's cleanup function pointer via helper
+  packet_stream_release(&stream);
+}
+
+/* Test the optimized loser tree implementation */
+void test_loser_tree_merge(Run *runs, uint32_t K, uint32_t elements_per_run) {
+  struct timeval start, end;
+  uint64_t total_packets = (uint64_t)K * elements_per_run;
+  PacketStream stream = {0}; // Initialize stream
+  Packet *pkt;
+  uint64_t count = 0;
+  volatile uint64_t checksum = 0; // Prevent optimizing out packet access
+
+  // Reset runs state before init (Important!)
+  reset_runs(runs, K);
+  // Initialize loser tree
+  if (loser_tree_init_stream(&stream, runs, K, total_packets) != 0) {
+    perror("Failed to initialize loser_tree stream");
+    return; // Or handle error appropriately
+  }
+
+  // Get direct accessor for better performance
+  LoserTree *t = stream.impl.loser_tree;
+
+  gettimeofday(&start, NULL);
+  // Process all packets directly using the optimized function
+  while ((pkt = loser_tree_next(t)) != NULL) {
+    checksum += calculate_checksum(pkt); // Access the data
+    count++;
+  }
+  gettimeofday(&end, NULL);
+
+  double elapsed =
+      (end.tv_sec - start.tv_sec) + (end.tv_usec - start.tv_usec) / 1000000.0;
+  double rate =
+      (count > 0 && elapsed > 0) ? (double)count / elapsed / 1000000.0 : 0.0;
+
+  printf("Loser tree merge of %lu packets: %.3f seconds (%.1f M pkts/sec) "
+         "[Chk: %lu]\n",
+         total_packets, elapsed, rate, checksum);
+  if (count != total_packets) {
+    fprintf(stderr, "ERROR: LoserTree processed %lu packets, expected %lu\n",
+            count, total_packets);
+  }
+
+  // Use the stream's cleanup function pointer via helper
+  packet_stream_release(&stream);
+}
+
+/* Cleanup allocated run buffers */
+void cleanup_runs(Run *runs, uint32_t K) {
+  if (runs) {
+    for (uint32_t i = 0; i < K; i++) {
+      if (runs[i].buf) {           // Check if buffer was allocated
+        free_aligned(runs[i].buf); // Use specific free for aligned alloc if
+                                   // needed, handled by macro
+        runs[i].buf = NULL;
+      }
+    }
+    free(runs);
+  }
+}
+
+int main(int argc, char *argv[]) {
+  // Default parameters
+  uint32_t K = 16;                     // Number of input streams
+  uint32_t elements_per_run = 1000000; // Elements per stream
+
+  // Allow command line override
+  if (argc > 1) {
+    long temp_k_long = strtol(argv[1], NULL, 10);
+    if (temp_k_long > 0 && temp_k_long <= MAXK) {
+      K = (uint32_t)temp_k_long;
+    } else {
+      fprintf(stderr,
+              "Warning: Invalid K value provided ('%s'). Using default K=%u.\n",
+              argv[1], K);
+      if (temp_k_long > MAXK) {
+        fprintf(stderr, "Reason: K exceeds MAXK (%d).\n", MAXK);
+      } else if (temp_k_long <= 0) {
+        fprintf(stderr, "Reason: K must be a positive integer.\n");
+      }
+    }
+  }
+
+  if (argc > 2) {
+    long temp_elements_long = strtol(argv[2], NULL, 10);
+    if (temp_elements_long > 0) {
+      elements_per_run = (uint32_t)temp_elements_long;
+    } else {
+      fprintf(stderr,
+              "Warning: Invalid elements_per_run provided ('%s'). Using "
+              "default N=%u.\n",
+              argv[2], elements_per_run);
+      fprintf(stderr, "Reason: elements_per_run must be a positive integer.\n");
+    }
+  }
+
+  // Allocate Run structures (buffers allocated in initialize_lazy_streams)
+  // Use calloc for zero-initialization, helpful for buf pointers initially
+  Run *runs = (Run *)calloc(K, sizeof(Run));
+  if (!runs) {
+    perror("Failed to allocate Run structures");
+    return 1;
+  }
+
+  // Determine total expected packets *before* initialization
+  uint64_t total_expected_packets = (uint64_t)K * elements_per_run;
+
+  // Initialize lazy streams (allocates buffers, sets initial state)
+  // This also sets total_size for each run to elements_per_run
+  initialize_lazy_streams(runs, K, elements_per_run);
+
+  printf("\n--- Starting performance tests ---\n");
+  printf("Parameters: K=%u streams, N=%u elements/stream\n", K,
+         elements_per_run);
+  printf("Total elements: %lu, Buffer window size (per stream): %d\n",
+         total_expected_packets, WINDOW);
+#ifdef USE_ALIGNED_ALLOC
+  printf("Memory allocation: Using aligned allocation (USE_ALIGNED_ALLOC "
+         "defined)\n");
+#else
+  printf("Memory allocation: Using standard malloc (USE_ALIGNED_ALLOC not "
+         "defined)\n");
+#endif
+  printf("Optimization flags: (Check your Makefile/build command, e.g., -O2, "
+         "-O3, -march=native)\n");
+
+  // IMPORTANT: Each test function calls reset_runs internally to ensure
+  // a consistent starting state for the runs array.
+
+  printf("\n--- Benchmarks ---\n");
+  test_no_merge(runs, K, elements_per_run);    // Baseline (only uses runs[0])
+  test_naive_merge(runs, K, elements_per_run); // Now uses buffered approach
+  test_kway_merge(runs, K, elements_per_run);  // Binary Heap
+  test_loser_tree_merge(runs, K, elements_per_run); // Optimized Loser Tree
+
+  printf("\n--- Tests finished ---\n");
+
+  // Cleanup run buffers and the runs array itself
+  cleanup_runs(runs, K);
+
+  return 0;
+}
