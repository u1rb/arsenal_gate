index 0000000..a7534b9
--- /dev/null
+++ b/parquet_ffi/cxx_examples/write_example.c
@@ -0,0 +1,294 @@
+#include <parquet_ffi.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <stdint.h>
+#include <stdbool.h>
+
+// Helper function to check for errors and handle them
+bool check_error(ParquetError error, const char *operation,
+                 ParquetWriterHandle *writer) {
+  if (error != ParquetOk) {
+    fprintf(stderr, "Error during %s: error code %d\n", operation, error);
+    if (writer != NULL) {
+      parquet_writer_close(writer);
+    }
+    return false;
+  }
+  return true;
+}
+
+// Generate test data for a column
+void generate_column_data(ParquetDataType data_type, size_t batch_size, 
+                          size_t offset, void **values, uint8_t **validity) {
+  // Allocate data arrays
+  *validity = (uint8_t*)malloc(batch_size * sizeof(uint8_t));
+  if (!*validity) {
+    fprintf(stderr, "Memory allocation failed for validity bitmap\n");
+    return;
+  }
+  
+  // Initialize all values as valid
+  memset(*validity, 1, batch_size);
+  
+  // Add some NULL values for demonstration
+  if (batch_size > 5) {
+    switch (data_type) {
+      case ParquetInt32:
+        (*validity)[batch_size % 7] = 0;
+        break;
+      case ParquetDouble:
+        (*validity)[batch_size % 11] = 0;
+        break;
+      case ParquetString:
+        (*validity)[batch_size % 5] = 0;
+        if (batch_size > 10)
+          (*validity)[batch_size % 13] = 0;
+        break;
+      default:
+        break;
+    }
+  }
+  
+  // Allocate and populate values based on data type
+  switch (data_type) {
+    case ParquetInt32: {
+      int32_t *int_values = (int32_t*)malloc(batch_size * sizeof(int32_t));
+      if (!int_values) {
+        fprintf(stderr, "Memory allocation failed for int values\n");
+        free(*validity);
+        *validity = NULL;
+        return;
+      }
+      
+      for (size_t i = 0; i < batch_size; i++) {
+        int_values[i] = (int32_t)(offset + i);
+      }
+      *values = int_values;
+      break;
+    }
+    
+    case ParquetDouble: {
+      double *double_values = (double*)malloc(batch_size * sizeof(double));
+      if (!double_values) {
+        fprintf(stderr, "Memory allocation failed for double values\n");
+        free(*validity);
+        *validity = NULL;
+        return;
+      }
+      
+      for (size_t i = 0; i < batch_size; i++) {
+        double_values[i] = (offset + i) * 1.5;
+      }
+      *values = double_values;
+      break;
+    }
+    
+    case ParquetString: {
+      char **string_values = (char**)malloc(batch_size * sizeof(char*));
+      if (!string_values) {
+        fprintf(stderr, "Memory allocation failed for string pointers\n");
+        free(*validity);
+        *validity = NULL;
+        return;
+      }
+      
+      for (size_t i = 0; i < batch_size; i++) {
+        if ((*validity)[i]) {
+          char buffer[64];
+          snprintf(buffer, sizeof(buffer), "String-%zu", offset + i);
+          string_values[i] = strdup(buffer);
+          if (!string_values[i]) {
+            // Free previously allocated strings
+            for (size_t j = 0; j < i; j++) {
+              free(string_values[j]);
+            }
+            free(string_values);
+            free(*validity);
+            *values = NULL;
+            *validity = NULL;
+            return;
+          }
+        } else {
+          string_values[i] = NULL;
+        }
+      }
+      *values = string_values;
+      break;
+    }
+    
+    default:
+      fprintf(stderr, "Unsupported data type\n");
+      free(*validity);
+      *validity = NULL;
+      return;
+  }
+}
+
+// Free column data
+void free_column_data(ParquetDataType data_type, void *values, uint8_t *validity, size_t count) {
+  if (data_type == ParquetString && values) {
+    char **string_values = (char**)values;
+    for (size_t i = 0; i < count; i++) {
+      free(string_values[i]);
+    }
+  }
+  free(values);
+  free(validity);
+}
+
+// Convert validity array to bitmap
+uint8_t* create_bitmap(const uint8_t *validity, size_t count) {
+  size_t bitmap_size = (count + 7) / 8; // Round up to nearest byte
+  uint8_t* bitmap = (uint8_t*)malloc(bitmap_size);
+  
+  if (!bitmap) {
+    return NULL;
+  }
+  
+  // Default all valid
+  memset(bitmap, 0xFF, bitmap_size);
+
+  for (size_t i = 0; i < count; i++) {
+    if (validity[i] == 0) {
+      // Clear the bit
+      size_t byte_index = i / 8;
+      size_t bit_index = i % 8;
+      bitmap[byte_index] &= ~(1 << bit_index);
+    }
+  }
+
+  return bitmap;
+}
+
+int main(int argc, char *argv[]) {
+  // Initialize tracing with debug level
+  parquet_init_tracing_with_level(ParquetLogError);
+  
+  if (argc < 3) {
+    fprintf(stderr, "Usage: %s <filename> <total_rows> [batch_size]\n", argv[0]);
+    return 1;
+  }
+  
+  char *filename = argv[1];
+  size_t total_rows = atoi(argv[2]);
+  size_t batch_size = (argc > 3) ? atoi(argv[3]) : 1000; // Default batch size is 1000
+  
+  if (batch_size == 0) {
+    fprintf(stderr, "Batch size must be greater than 0\n");
+    return 1;
+  }
+  
+  printf("Writing %zu rows to %s in batches of %zu\n", total_rows, filename, batch_size);
+  
+  // Define schema
+  const char *column_names[] = {"integer_values", "double_values", "string_values"};
+  ParquetDataType column_types[] = {ParquetInt32, ParquetDouble, ParquetString};
+  bool column_nullable[] = {true, true, true};
+  size_t column_count = sizeof(column_names) / sizeof(column_names[0]);
+  
+  // Create column definitions
+  ParquetColumnDef *columns = (ParquetColumnDef*)malloc(column_count * sizeof(ParquetColumnDef));
+  if (!columns) {
+    fprintf(stderr, "Memory allocation failed\n");
+    return 1;
+  }
+  
+  for (size_t i = 0; i < column_count; i++) {
+    columns[i].name = column_names[i];
+    columns[i].data_type = column_types[i];
+    columns[i].nullable = column_nullable[i];
+  }
+  
+  // Configure writer options
+  ParquetWriterOptions options;
+  options.row_group_size = 1024;
+  options.compression = ParquetCompressionSnappy;
+  options.enable_dictionary = true;
+  options.enable_statistics = true;
+  options.enable_bloom_filter = true;
+  options.row_buffer_size = batch_size;
+  
+  // Open the writer
+  ParquetWriterHandle *writer = NULL;
+  ParquetError error = parquet_writer_open(filename, columns, column_count, options, &writer);
+  free(columns); // Free columns array after use
+  
+  if (!check_error(error, "opening writer", NULL)) {
+    return 1;
+  }
+  
+  printf("Writer created successfully\n");
+  
+  // Write batches
+  size_t remaining_rows = total_rows;
+  size_t batch_index = 0;
+  
+  while (remaining_rows > 0) {
+    // Calculate batch size for this iteration
+    size_t current_batch_size = (remaining_rows < batch_size) ? remaining_rows : batch_size;
+    size_t offset = batch_index * batch_size;
+    
+    printf("Processing batch %zu with %zu rows\n", batch_index + 1, current_batch_size);
+    
+    // Start a new row group for this batch
+    error = parquet_writer_start_row_group(writer);
+    if (!check_error(error, "starting row group", writer)) {
+      return 1;
+    }
+    
+    // For each column
+    for (size_t col_idx = 0; col_idx < column_count; col_idx++) {
+      // Generate column data
+      void *values = NULL;
+      uint8_t *validity = NULL;
+      
+      generate_column_data(column_types[col_idx], current_batch_size, offset, &values, &validity);
+      if (!values || !validity) {
+        fprintf(stderr, "Failed to generate data for column %zu\n", col_idx);
+        return 1;
+      }
+      
+      // Convert validity array to bitmap
+      uint8_t *bitmap = create_bitmap(validity, current_batch_size);
+      if (!bitmap) {
+        fprintf(stderr, "Failed to create bitmap for column %zu\n", col_idx);
+        free_column_data(column_types[col_idx], values, validity, current_batch_size);
+        return 1;
+      }
+      
+      // Write the column
+      error = parquet_writer_write_primitive_column(
+          writer, col_idx, column_types[col_idx], values,
+          current_batch_size, bitmap);
+      
+      // Free resources
+      free(bitmap);
+      free_column_data(column_types[col_idx], values, validity, current_batch_size);
+      
+      if (!check_error(error, "writing column", writer)) {
+        return 1;
+      }
+    }
+    
+    // End the row group
+    error = parquet_writer_end_row_group(writer);
+    if (!check_error(error, "ending row group", writer)) {
+      return 1;
+    }
+    
+    // Update counters for next iteration
+    remaining_rows -= current_batch_size;
+    batch_index++;
+  }
+  
+  // Close the writer to finalize the file
+  error = parquet_writer_close(writer);
+  if (!check_error(error, "closing writer", NULL)) {
+    return 1;
+  }
+  
+  printf("Parquet file written successfully with %zu batches\n", batch_index);
+  
+  return 0;
+}
