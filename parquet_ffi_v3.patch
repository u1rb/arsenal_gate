+// Helper function to print schema information
+void print_schema(struct ArrowSchema *schema, int indent) {
+  char indent_str[64] = {0};
+  for (int i = 0; i < indent; i++) {
+    indent_str[i] = ' ';
+  }
+
+  printf("%sField: %s, Type: %s, Nullable: %s\n", indent_str,
+         schema->name ? schema->name : "(unnamed)",
+         schema->format ? schema->format : "(unknown)",
+         (schema->flags & 1) ? "false" : "true");
+
+  for (int64_t i = 0; i < schema->n_children; i++) {
+    print_schema(schema->children[i], indent + 2);
+  }
+}
+
+// Helper function to print primitive array values without brackets for single
+// values
+void print_array_value_simple(struct ArrowArray *array,
+                              struct ArrowSchema *schema) {
+  // This function is like print_array_values but without the brackets and
+  // limited to one value
+  if (strcmp(schema->format, "i") == 0) {
