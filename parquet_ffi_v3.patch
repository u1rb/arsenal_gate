+}
+
+/// Get the schema of the Parquet file
+#[no_mangle]
+pub extern "C" fn parquet_reader_get_schema(
+    handle: *mut ParquetReaderHandle,
+    columns: *mut *mut ParquetColumnDef,
+    num_columns: *mut usize,
+) -> ParquetError {
+    // Check parameters
+    if columns.is_null() || num_columns.is_null() {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Get reader
+    let reader = match get_reader(handle) {
+        Ok(r) => r,
+        Err(e) => return e,
+    };
+
+    // Get the fields
+    let fields = reader.schema.fields();
+    let field_count = fields.len();
+
+    // Allocate memory for the column definitions
+    let column_defs = unsafe {
+        let ptr = libc::malloc(std::mem::size_of::<ParquetColumnDef>() * field_count)
+            as *mut ParquetColumnDef;
+        if ptr.is_null() {
+            return ParquetError::ParquetMemoryError;
+        }
+        ptr
+    };
+
+    // Fill in the column definitions
+    for (i, field) in fields.iter().enumerate() {
+        // Convert field name to C string
+        let c_name = match CString::new(field.name().as_bytes()) {
+            Ok(s) => s,
+            Err(_) => {
+                // Free memory on error
+                unsafe { libc::free(column_defs as *mut libc::c_void) };
+                return ParquetError::ParquetMemoryError;
+            }
+        };
+
+        // Get a raw pointer to the C string (will be owned by C code)
+        let c_name_ptr = c_name.into_raw();
+
+        // Get the data type
+        let data_type = to_parquet_data_type(field.data_type());
+
+        // Fill in the column definition
+        unsafe {
+            let col_def = &mut *column_defs.add(i);
+            col_def.name = c_name_ptr;
+            col_def.data_type = data_type;
+            col_def.nullable = field.is_nullable();
+        }
+    }
+
+    // Return the results
+    unsafe {
+        *columns = column_defs;
+        *num_columns = field_count;
+    }
+
+    ParquetError::ParquetOk
+}
+
+/// Generic function to process primitive numeric arrays
+fn process_primitive_array<T, A>(
+    array: &dyn Array,
+    column_index: usize,
+    num_rows: usize,
+    column_data: *mut *mut libc::c_void,
+    null_maps: *mut u8,
+) -> Result<(), ParquetError>
+where
+    T: ArrowPrimitiveType,
+    A: Copy + From<<T as ArrowPrimitiveType>::Native>,
+{
+    if let Some(primitive_array) = array.as_any().downcast_ref::<PrimitiveArray<T>>() {
+        // Allocate memory for primitive values
+        let data = unsafe {
+            let ptr = libc::malloc(std::mem::size_of::<A>() * num_rows) as *mut A;
+            if ptr.is_null() {
+                return Err(ParquetError::ParquetMemoryError);
+            }
+            ptr
+        };
+
+        // Copy values and set validity
+        for (i, val) in primitive_array.iter().enumerate() {
+            if let Some(n) = val {
+                unsafe {
+                    *data.add(i) = A::from(n);
+
+                    // Set bit in null map (1 = valid)
+                    let byte_idx = i / 8;
+                    let bit_idx = i % 8;
+                    *null_maps.add(column_index * ((num_rows + 7) / 8) + byte_idx) |= 1 << bit_idx;
+                }
+            }
+        }
+
+        // Store the data pointer
+        unsafe {
+            *column_data.add(column_index) = data as *mut libc::c_void;
+        }
+
+        Ok(())
+    } else {
+        Err(ParquetError::ParquetGeneralError)
+    }
+}
+
+/// Read the next batch of rows from the Parquet file
+#[no_mangle]
+pub extern "C" fn parquet_reader_read_next_batch(
+    handle: *mut ParquetReaderHandle,
+    batch: *mut ParquetRowBatch,
+) -> ParquetError {
+    // Check parameters
+    if batch.is_null() {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    // Get reader
+    let reader = match get_reader_mut(handle) {
+        Ok(r) => r,
+        Err(e) => return e,
+    };
+
+    // Clear any previous batch data in the struct
+    unsafe {
+        (*batch).num_rows = 0;
+        (*batch).num_columns = 0;
+        (*batch).column_data = null_mut();
+        (*batch).column_lengths = null_mut();
+        (*batch).null_maps = null_mut();
+    }
+
+    // Try to read the next batch
+    let record_batch = match reader.reader.next() {
+        Some(Ok(rb)) => rb,
+        Some(Err(_)) => return ParquetError::ParquetFileReadError,
+        None => return ParquetError::ParquetOk, // End of file
+    };
+
+    // Store the batch for later
+    reader.current_batch = Some(record_batch.clone());
+
+    let num_columns = record_batch.num_columns();
+    let num_rows = record_batch.num_rows();
+
+    if num_rows == 0 {
+        return ParquetError::ParquetOk; // Empty batch
+    }
+
+    // Allocate memory for column data pointers
+    let column_data = unsafe {
+        let ptr = libc::malloc(std::mem::size_of::<*mut libc::c_void>() * num_columns)
+            as *mut *mut libc::c_void;
+        if ptr.is_null() {
+            return ParquetError::ParquetMemoryError;
+        }
+        ptr
+    };
+
+    // Allocate memory for column lengths
+    let column_lengths = unsafe {
+        let ptr = libc::malloc(std::mem::size_of::<u64>() * num_columns) as *mut u64;
+        if ptr.is_null() {
+            libc::free(column_data as *mut libc::c_void);
+            return ParquetError::ParquetMemoryError;
+        }
+        ptr
+    };
+
+    // Allocate memory for null maps
+    let null_maps = unsafe {
+        let ptr =
+            libc::malloc(std::mem::size_of::<u8>() * num_columns * ((num_rows + 7) / 8)) as *mut u8;
+        if ptr.is_null() {
+            libc::free(column_data as *mut libc::c_void);
+            libc::free(column_lengths as *mut libc::c_void);
+            return ParquetError::ParquetMemoryError;
+        }
+        std::ptr::write_bytes(ptr, 0, num_columns * ((num_rows + 7) / 8));
+        ptr
+    };
+
+    // Process each column
+    for col_idx in 0..num_columns {
+        let array = record_batch.column(col_idx);
+        let data_type = reader.column_types[col_idx];
+
+        // Process based on data type
+        let result = match data_type {
+            ParquetDataType::ParquetBoolean => {
+                if let Some(bool_array) = array.as_any().downcast_ref::<BooleanArray>() {
+                    // Allocate memory for boolean values
+                    let bool_data = unsafe {
+                        let ptr = libc::malloc(std::mem::size_of::<bool>() * num_rows) as *mut bool;
+                        if ptr.is_null() {
+                            return ParquetError::ParquetMemoryError;
+                        }
+                        ptr
+                    };
+
+                    // Copy boolean values
+                    for (i, val) in bool_array.iter().enumerate() {
+                        if let Some(b) = val {
+                            unsafe { *bool_data.add(i) = b };
+
+                            // Set bit in null map (1 = valid)
+                            unsafe {
+                                let byte_idx = i / 8;
+                                let bit_idx = i % 8;
+                                *null_maps.add(col_idx * ((num_rows + 7) / 8) + byte_idx) |=
+                                    1 << bit_idx;
+                            }
+                        }
+                    }
+
+                    // Store the data pointer
+                    unsafe {
+                        *column_data.add(col_idx) = bool_data as *mut libc::c_void;
+                        *column_lengths.add(col_idx) = num_rows as u64;
+                    }
+                    Ok(())
+                } else {
+                    Err(ParquetError::ParquetGeneralError)
+                }
+            }
+            ParquetDataType::ParquetInt8 => {
+                process_primitive_array::<arrow::datatypes::Int8Type, i8>(
+                    array.as_ref(),
+                    col_idx,
+                    num_rows,
+                    column_data,
+                    null_maps,
+                )
+            }
+            ParquetDataType::ParquetInt16 => {
+                process_primitive_array::<arrow::datatypes::Int16Type, i16>(
+                    array.as_ref(),
+                    col_idx,
+                    num_rows,
+                    column_data,
+                    null_maps,
+                )
+            }
+            ParquetDataType::ParquetInt32 => {
+                process_primitive_array::<arrow::datatypes::Int32Type, i32>(
+                    array.as_ref(),
+                    col_idx,
+                    num_rows,
+                    column_data,
+                    null_maps,
+                )
+            }
+            ParquetDataType::ParquetInt64 => {
+                process_primitive_array::<arrow::datatypes::Int64Type, i64>(
+                    array.as_ref(),
+                    col_idx,
+                    num_rows,
+                    column_data,
+                    null_maps,
+                )
+            }
+            ParquetDataType::ParquetUint8 => {
+                process_primitive_array::<arrow::datatypes::UInt8Type, u8>(
+                    array.as_ref(),
+                    col_idx,
+                    num_rows,
+                    column_data,
+                    null_maps,
+                )
+            }
+            ParquetDataType::ParquetUint16 => {
+                process_primitive_array::<arrow::datatypes::UInt16Type, u16>(
+                    array.as_ref(),
+                    col_idx,
+                    num_rows,
+                    column_data,
+                    null_maps,
+                )
+            }
+            ParquetDataType::ParquetUint32 => {
+                process_primitive_array::<arrow::datatypes::UInt32Type, u32>(
+                    array.as_ref(),
+                    col_idx,
+                    num_rows,
+                    column_data,
+                    null_maps,
+                )
+            }
+            ParquetDataType::ParquetUint64 => {
+                process_primitive_array::<arrow::datatypes::UInt64Type, u64>(
+                    array.as_ref(),
+                    col_idx,
+                    num_rows,
+                    column_data,
+                    null_maps,
+                )
+            }
+            ParquetDataType::ParquetFloat => {
+                process_primitive_array::<arrow::datatypes::Float32Type, f32>(
+                    array.as_ref(),
+                    col_idx,
+                    num_rows,
+                    column_data,
+                    null_maps,
+                )
+            }
+            ParquetDataType::ParquetDouble => {
+                process_primitive_array::<arrow::datatypes::Float64Type, f64>(
+                    array.as_ref(),
+                    col_idx,
+                    num_rows,
+                    column_data,
+                    null_maps,
+                )
+            }
+            ParquetDataType::ParquetString => {
+                if let Some(string_array) = array.as_any().downcast_ref::<StringArray>() {
+                    // Allocate memory for string pointers
+                    let string_data = unsafe {
+                        let ptr = libc::malloc(std::mem::size_of::<*mut c_char>() * num_rows)
+                            as *mut *mut c_char;
+                        if ptr.is_null() {
+                            return ParquetError::ParquetMemoryError;
+                        }
+                        ptr
+                    };
+
+                    // Create C strings for each value
+                    for (i, val) in string_array.iter().enumerate() {
+                        if let Some(s) = val {
+                            match CString::new(s.as_bytes()) {
+                                Ok(c_string) => {
+                                    unsafe { *string_data.add(i) = c_string.into_raw() };
+
+                                    // Set bit in null map (1 = valid)
+                                    unsafe {
+                                        let byte_idx = i / 8;
+                                        let bit_idx = i % 8;
+                                        *null_maps
+                                            .add(col_idx * ((num_rows + 7) / 8) + byte_idx) |=
+                                            1 << bit_idx;
+                                    }
+                                }
+                                Err(_) => unsafe { *string_data.add(i) = std::ptr::null_mut() },
+                            }
+                        } else {
+                            unsafe { *string_data.add(i) = std::ptr::null_mut() };
+                        }
+                    }
+
+                    // Store the data pointer
+                    unsafe {
+                        *column_data.add(col_idx) = string_data as *mut libc::c_void;
+                        *column_lengths.add(col_idx) = num_rows as u64;
+                    }
+                    Ok(())
+                } else {
+                    Err(ParquetError::ParquetGeneralError)
+                }
+            }
+            ParquetDataType::ParquetBinary => {
+                if let Some(binary_array) = array.as_any().downcast_ref::<BinaryArray>() {
+                    // Allocate memory for binary data pointers
+                    let binary_data = unsafe {
+                        let ptr =
+                            libc::malloc(std::mem::size_of::<*mut u8>() * num_rows) as *mut *mut u8;
+                        if ptr.is_null() {
+                            return ParquetError::ParquetMemoryError;
+                        }
+                        ptr
+                    };
+
+                    // Allocate memory for binary data lengths
+                    let binary_lengths = unsafe {
+                        let ptr =
+                            libc::malloc(std::mem::size_of::<usize>() * num_rows) as *mut usize;
+                        if ptr.is_null() {
+                            libc::free(binary_data as *mut libc::c_void);
+                            return ParquetError::ParquetMemoryError;
+                        }
+                        ptr
+                    };
+
+                    // Create a struct to hold pointers and lengths
+                    let binary_struct = unsafe {
+                        let ptr = libc::malloc(
+                            std::mem::size_of::<*mut *mut u8>() + std::mem::size_of::<*mut usize>(),
+                        ) as *mut libc::c_void;
+                        if ptr.is_null() {
+                            libc::free(binary_data as *mut libc::c_void);
+                            libc::free(binary_lengths as *mut libc::c_void);
+                            return ParquetError::ParquetMemoryError;
+                        }
+
+                        // Store the pointers in the struct
+                        *(ptr as *mut *mut *mut u8) = binary_data;
+                        let offset_ptr = (ptr as usize) + std::mem::size_of::<*mut *mut u8>();
+                        *(offset_ptr as *mut *mut usize) = binary_lengths;
+
+                        ptr
+                    };
+
+                    // Create binary data for each value
+                    for (i, val) in binary_array.iter().enumerate() {
+                        if let Some(binary) = val {
+                            // Allocate memory for the binary data
+                            let data_len = binary.len();
+                            let data_ptr = unsafe {
+                                let ptr = libc::malloc(data_len) as *mut u8;
+                                if ptr.is_null() {
+                                    // Free everything on error
+                                    for j in 0..i {
+                                        let ptr_to_free = *binary_data.add(j);
+                                        if !ptr_to_free.is_null() {
+                                            libc::free(ptr_to_free as *mut libc::c_void);
+                                        }
+                                    }
+                                    libc::free(binary_data as *mut libc::c_void);
+                                    libc::free(binary_lengths as *mut libc::c_void);
+                                    libc::free(binary_struct as *mut libc::c_void);
+                                    return ParquetError::ParquetMemoryError;
+                                }
+
+                                // Copy the binary data
+                                std::ptr::copy_nonoverlapping(binary.as_ptr(), ptr, data_len);
+                                ptr
+                            };
+
+                            // Store the pointer and length
+                            unsafe {
+                                *binary_data.add(i) = data_ptr;
+                                *binary_lengths.add(i) = data_len;
+                            }
+
+                            // Set bit in null map (1 = valid)
+                            unsafe {
+                                let byte_idx = i / 8;
+                                let bit_idx = i % 8;
+                                *null_maps.add(col_idx * ((num_rows + 7) / 8) + byte_idx) |=
+                                    1 << bit_idx;
+                            }
+                        } else {
+                            // Store null for invalid values
+                            unsafe {
+                                *binary_data.add(i) = std::ptr::null_mut();
+                                *binary_lengths.add(i) = 0;
+                            }
+                        }
+                    }
+
+                    // Store the struct pointer
+                    unsafe {
+                        *column_data.add(col_idx) = binary_struct;
+                        *column_lengths.add(col_idx) = num_rows as u64;
+                    }
+                    Ok(())
+                } else {
+                    Err(ParquetError::ParquetGeneralError)
+                }
+            }
+            // Handle other types as needed
+            _ => {
+                // For unsupported types, allocate but leave null
+                unsafe {
+                    *column_data.add(col_idx) = std::ptr::null_mut();
+                    *column_lengths.add(col_idx) = 0;
+                }
+                Ok(())
+            }
+        };
+
+        // Check if processing succeeded
+        if let Err(e) = result {
+            // Free allocated memory
+            for j in 0..col_idx {
+                unsafe {
+                    if !(*column_data.add(j)).is_null() {
+                        libc::free(*column_data.add(j) as *mut libc::c_void);
+                    }
+                }
+            }
+            unsafe {
+                libc::free(column_data as *mut libc::c_void);
+                libc::free(column_lengths as *mut libc::c_void);
+                libc::free(null_maps as *mut libc::c_void);
+            }
+            return e;
+        }
+
+        // Set the length
+        unsafe {
+            *column_lengths.add(col_idx) = num_rows as u64;
+        }
+    }
+
+    // Fill in the batch struct
+    unsafe {
+        (*batch).num_rows = num_rows as u64;
+        (*batch).num_columns = num_columns as u64;
+        (*batch).column_data = column_data as *mut *mut libc::c_void;
+        (*batch).column_lengths = column_lengths;
+        (*batch).null_maps = null_maps;
+    }
+
+    ParquetError::ParquetOk
+}
+
+/// Free memory allocated specifically for variable-length data (strings, binaries)
+/// within a row batch. This should be called before parquet_reader_free_batch
+/// if string or binary columns are present.
+#[no_mangle]
+pub extern "C" fn parquet_reader_free_batch_data(
+    batch: *mut ParquetRowBatch,
+    columns: *const ParquetColumnDef,
+    num_columns: usize,
+) -> ParquetError {
+    if batch.is_null() || columns.is_null() {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    let batch_ref = unsafe { &*batch };
+    let num_rows = batch_ref.num_rows as usize;
+
+    if batch_ref.column_data.is_null() {
+        return ParquetError::ParquetOk; // Nothing to free
+    }
+
+    for col_idx in 0..num_columns {
+        let column_def = unsafe { &*columns.add(col_idx) };
+        let col_ptr = unsafe { *batch_ref.column_data.add(col_idx) };
+
+        if col_ptr.is_null() {
+            continue;
+        }
+
+        match column_def.data_type {
+            ParquetDataType::ParquetString => {
+                let string_data = col_ptr as *mut *mut c_char;
+                for i in 0..num_rows {
+                    let c_str_ptr = unsafe { *string_data.add(i) };
+                    if !c_str_ptr.is_null() {
+                        // Reconstruct CString and let it drop/free the memory
+                        let _ = unsafe { CString::from_raw(c_str_ptr) };
+                    }
+                }
+                // The array of pointers (string_data) will be freed by parquet_reader_free_batch
+            }
+            ParquetDataType::ParquetBinary => {
+                // The column_data pointer points to a struct containing pointers
+                let binary_struct_ptr = col_ptr;
+                let binary_data_ptr_ptr = binary_struct_ptr as *mut *mut *mut u8;
+                let binary_lengths_ptr_ptr = unsafe {
+                    (binary_struct_ptr as *const u8)
+                        .add(std::mem::size_of::<*mut *mut u8>())
+                        as *mut *mut usize
+                };
+
+                let binary_data = unsafe { *binary_data_ptr_ptr };
+                let binary_lengths = unsafe { *binary_lengths_ptr_ptr };
+
+                if !binary_data.is_null() {
+                    for i in 0..num_rows {
+                        let data_ptr = unsafe { *binary_data.add(i) };
+                        if !data_ptr.is_null() {
+                            unsafe { libc::free(data_ptr as *mut libc::c_void) };
+                        }
+                    }
+                    // Free the array holding the data pointers
+                    unsafe { libc::free(binary_data as *mut libc::c_void) };
+                }
+
+                // Free the array holding the lengths
+                if !binary_lengths.is_null() {
+                    unsafe { libc::free(binary_lengths as *mut libc::c_void) };
+                }
+
+                // The struct pointer (binary_struct_ptr == col_ptr)
+                // will be freed by parquet_reader_free_batch
+            }
+            _ => {
+                // Primitive types' data pointers are freed by parquet_reader_free_batch
+            }
+        }
+    }
+
+    ParquetError::ParquetOk
+}
+
+/// Free resources associated with a row batch (top-level pointers)
+#[no_mangle]
+pub extern "C" fn parquet_reader_free_batch(batch: *mut ParquetRowBatch) -> ParquetError {
+    if batch.is_null() {
+        return ParquetError::ParquetInvalidData;
+    }
+
+    let num_columns = unsafe { (*batch).num_columns as usize };
+    let column_data = unsafe { (*batch).column_data };
+    let column_lengths = unsafe { (*batch).column_lengths };
+    let null_maps = unsafe { (*batch).null_maps };
+
+    // Free each column's data
+    if !column_data.is_null() {
+        for i in 0..num_columns {
+            unsafe {
+                let col_ptr = *column_data.add(i);
+                if !col_ptr.is_null() {
+                    // Free the column pointer - for binary data this will leak memory
+                    // but it's not possible to detect binary columns without extra information
+                    libc::free(col_ptr as *mut libc::c_void);
+                }
+            }
+        }
+
+        // Free the column data array
+        unsafe { libc::free(column_data as *mut libc::c_void) };
+    }
+
+    // Free column lengths array
+    if !column_lengths.is_null() {
+        unsafe { libc::free(column_lengths as *mut libc::c_void) };
+    }
+
+    // Free null maps array
+    if !null_maps.is_null() {
+        unsafe { libc::free(null_maps as *mut libc::c_void) };
+    }
+
+    // Clear the batch struct
+    unsafe {
+        (*batch).num_rows = 0;
+        (*batch).num_columns = 0;
+        (*batch).column_data = null_mut();
+        (*batch).column_lengths = null_mut();
+        (*batch).null_maps = null_mut();
+    }
+
+    ParquetError::ParquetOk
+}
+
+/// Close the reader and free resources
+#[no_mangle]
+pub extern "C" fn parquet_reader_close(handle: *mut ParquetReaderHandle) -> ParquetError {
+    if handle.is_null() {
+        return ParquetError::ParquetInvalidHandle;
+    }
+
+    // Convert back to Box and drop it
+    let _reader = unsafe { Box::from_raw(handle as *mut ParquetReader) };
+
+    ParquetError::ParquetOk
+}
