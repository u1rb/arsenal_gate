+
+# rm -rf build
+# Create build directory
+mkdir -p build
+
+# Configure with forced RocksDB compilation
+echo "Configuring build with FORCE_COMPILE_ROCKSDB=ON..."
+
+cmake -S. -B build -DFORCE_COMPILE_ROCKSDB=ON -G Ninja
+
+# Build the project
+echo "Building project..."
+cmake --build build
+
+echo "Build completed successfully!"
+
+# Check if executables were created
