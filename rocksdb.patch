+from rocksdict import Rdict, Options
+
+db_path = "/tmp/rocksdb_blob_example"
+db = Rdict(db_path, options=Options(raw_mode=True))
+
+# list column families
+cfs = Rdict.list_cf(db_path)
+print(cfs)
+
+# use one of the column families
+cf1 = db.get_column_family(cfs[0])
+
+# iterate through all key-value pairs in cf1
+print("key-value pairs")
+n = 10
+for k, v in cf1.items():
+    n -= 1
+    x = len(v)
+    print(f"{k} -> {x} bytes")
+    if n == 0:
+        break
+
+print("wide columns")
+
+# iterate through all wide columns in cf1
+n = 10
+for k, v in cf1.entities():
+    n -= 1
+    x = len(v[0][1])
+    print(f"{k} -> {x} bytes")
+    if n == 0:
+        break
