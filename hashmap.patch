+#include <ankerl/unordered_dense.h>
+#include <catch2/benchmark/catch_benchmark.hpp>
+#include <catch2/catch_test_macros.hpp>
+
+#include <cstdint>
+#include <random>
+#include <vector>
+
+// --------------------- helper ------------------------------------------------
+static std::vector<std::uint64_t>
+make_random_keys(std::size_t n, std::uint64_t seed = 0xC0FFEE) {
+  std::mt19937_64 rng(seed);
+  std::uniform_int_distribution<std::uint64_t> dist;
+  std::vector<std::uint64_t> keys;
+  keys.reserve(n);
+  for (std::size_t i = 0; i < n; ++i)
+    keys.push_back(dist(rng));
+  return keys;
+}
+
+// --------------------- benchmark --------------------------------------------
+TEST_CASE("unordered_dense read / find latency", "[bench]") {
+  constexpr std::size_t N = 1'000'0; // adjust to taste
+
+  // pre‑generate once; Catch2 reuses the same test case for each BENCHMARK run
+  static const auto keys = make_random_keys(N);
+
+  ankerl::unordered_dense::map<std::uint64_t, std::uint64_t> map;
+  map.reserve(N);
+  for (auto k : keys)
+    map.emplace(k, k);
+
+  REQUIRE(map.size() == N); // sanity
+
+  // Random number generator for selecting random keys
+  std::random_device rd;
+  std::mt19937 gen(rd());
+  std::uniform_int_distribution<std::size_t> dist(0, N - 1);
+
+  // Pre-generate a set of random indices to use
+  constexpr std::size_t NUM_LOOKUPS =
+      10000; // Number of random keys to pre-generate
+  std::vector<std::uint64_t> random_keys;
+  random_keys.reserve(NUM_LOOKUPS);
+  for (std::size_t i = 0; i < NUM_LOOKUPS; ++i) {
+    random_keys.push_back(keys[dist(gen)]);
+  }
+
+  // Index to keep track of current position in the random_keys vector
+  std::size_t idx = 0;
+
+  BENCHMARK("find single random key") {
+    // Get next key from pre-generated random keys
+    auto random_key = random_keys[idx];
+
+    // Increment and wrap index (without using modulus)
+    idx++;
+    if (idx >= random_keys.size()) {
+      idx = 0;
+    }
+
+    // Find the key in the map
+    auto it = map.find(random_key);
+    return it != map.end() ? 1 : 0; // Return to prevent optimization
+  };
+}
