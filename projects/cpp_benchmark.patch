+        for (int i = 0; i < INITIAL_SIZE; ++i) {
+            random_input.push_back(dis_for_random_idx(gen));
+        }
+
+        // Initialize both containers with INITIAL_SIZE elements
+        for (auto x : random_input) {
+            rb.push_back(x);
+            std_vec.push_back(x);
+        }
+        // Insert operations
+        for (int i = 0; i < NUM_OPERATIONS; ++i) {
+            size_t pos = random_input[i % INITIAL_SIZE] % (rb.size() + 1);  // Ensure valid position
+            rb.insert(pos, random_input[i % INITIAL_SIZE]);
+            std_vec.insert(std_vec.begin() + pos, random_input[i % INITIAL_SIZE]);
+        }
+
+        // Delete operations
+        for (int i = 0; i < NUM_OPERATIONS; ++i) {
+            if (!rb.empty()) {
+                size_t pos = random_input[i % INITIAL_SIZE] % rb.size();  // Ensure valid position
+                rb.erase(pos);
+                std_vec.erase(std_vec.begin() + pos);
+            }
+        }
+        assert(rb.size() == std_vec.size());
+        assert(rb.capacity() == std_vec.capacity());
+        assert(rb.copy_continous_data() == std_vec);
+    }
+
+    // Test 23: benchmark, compare with std::vector when performing random insertions and deletions
+    {
+        const int NUM_OPERATIONS = 1000000;
+        const int INITIAL_SIZE = 5000;
+        const int MODIFY_INDEX_RANGE = 10;
+        std::cout << "Benchmarking RingBuffer3 vs std::vector for " << NUM_OPERATIONS
+                  << " operations" << std::endl;
+
+        std::random_device rd;
+        std::mt19937 gen(rd());
+        std::uniform_int_distribution<> initial_value_dis(0, 100);
+        std::uniform_int_distribution<> pos_dis(0,
+                                                MODIFY_INDEX_RANGE);  // Random position in [0,100]
+        std::uniform_int_distribution<> op_dis(0, 1);                 // 0 for insert, 1 for delete
+
+        // Pre-generate all random numbers
+        std::vector<int> random_positions(NUM_OPERATIONS);
+        std::vector<int> random_values(NUM_OPERATIONS);
+        std::vector<bool> is_insert(NUM_OPERATIONS);
+
+        for (int i = 0; i < NUM_OPERATIONS; ++i) {
+            random_positions[i] = pos_dis(gen);
+            random_values[i] = initial_value_dis(gen);
+            is_insert[i] = op_dis(gen) == 0;
+        }
+
+        // Create and initialize RingBuffer3
+        RingBuffer3<int> rb(INITIAL_SIZE);
+        for (int i = 0; i < INITIAL_SIZE; ++i) {
+            rb.push_back(i);
+        }
+
+        // Create and initialize std::vector
+        std::vector<int> std_vec;
+        std_vec.reserve(INITIAL_SIZE);
+        for (int i = 0; i < INITIAL_SIZE; ++i) {
+            std_vec.push_back(i);
+        }
+
+        // Benchmark RingBuffer3
+        auto start_rb = std::chrono::high_resolution_clock::now();
+        for (int i = 0; i < NUM_OPERATIONS; ++i) {
+            size_t pos = random_positions[i] % (rb.size() + 1);  // Ensure valid position
+            if (is_insert[i]) {                                  // Insert
+                rb.insert(pos, random_values[i]);
+            } else if (!rb.empty()) {   // Delete
+                pos = pos % rb.size();  // Recalculate position for deletion
+                rb.erase(pos);
+            }
+        }
+        auto end_rb = std::chrono::high_resolution_clock::now();
+        auto duration_rb = std::chrono::duration_cast<std::chrono::microseconds>(end_rb - start_rb);
+
+        // Reset vector to initial state
+        std_vec.clear();
+        std_vec.reserve(INITIAL_SIZE);
+        for (int i = 0; i < INITIAL_SIZE; ++i) {
+            std_vec.push_back(i);
+        }
+
+        // Benchmark std::vector
+        auto start_vec = std::chrono::high_resolution_clock::now();
+        for (int i = 0; i < NUM_OPERATIONS; ++i) {
+            size_t pos = random_positions[i] % (std_vec.size() + 1);  // Ensure valid position
+            if (is_insert[i]) {                                       // Insert
+                std_vec.insert(std_vec.begin() + pos, random_values[i]);
+            } else if (!std_vec.empty()) {   // Delete
+                pos = pos % std_vec.size();  // Recalculate position for deletion
+                std_vec.erase(std_vec.begin() + pos);
+            }
+        }
+        auto end_vec = std::chrono::high_resolution_clock::now();
+        auto duration_vec =
+            std::chrono::duration_cast<std::chrono::microseconds>(end_vec - start_vec);
+
+        std::cout << "Benchmark results for " << NUM_OPERATIONS << " operations:" << std::endl;
+        std::cout << "RingBuffer3: " << duration_rb.count() << " microseconds" << std::endl;
+        std::cout << "std::vector: " << duration_vec.count() << " microseconds" << std::endl;
+        std::cout << "RingBuffer3 is "
+                  << static_cast<double>(duration_vec.count()) / duration_rb.count()
+                  << "x faster than std::vector" << std::endl;
+
+        assert(rb.copy_continous_data() == std_vec);
+    }
+
+    std::cout << "All tests passed!" << std::endl;
+}
