+template <typename T>
+class RingBuffer3 {
+public:
+    explicit RingBuffer3(size_t initial_capacity = 10) {
+        _data.resize(initial_capacity);
+        _capacity = initial_capacity;
+        _head = 0;
+        _tail = 0;
+        _current_size = 0;
+    }
+
+    void push_back(const T& value) {
+        if (_current_size == _capacity) {
+            grow();
+        }
+        _data[_tail] = value;
+        _tail = (_tail + 1) % _capacity;
+        _current_size++;
+    }
+
+    T pop_front() {
+        if (_current_size == 0) {
+            throw std::out_of_range("RingBuffer is empty");
+        }
+        T value = _data[_head];
+        _head = (_head + 1) % _capacity;
+        _current_size--;
+        return value;
+    }
+
+    class iterator;
+
+    iterator insert(iterator pos, const T& value) {
+        size_t offset = pos.get_offset();
+        insert(offset, value);
+        return iterator(this, offset);
+    }
+
+    iterator erase(iterator pos) {
+        size_t offset = pos.get_offset();
+        erase(offset);
+        return iterator(this, offset);
+    }
+
+    void insert(size_t pos, const T& value) {
+        if (pos > _current_size) {
+            throw std::out_of_range("Insert position out of range");
+        }
+        if (_current_size == _capacity) {
+            grow();
+        }
+        if (pos == 0) {
+            // Insert at front
+            _head = (_head - 1 + _capacity) % _capacity;
+            _data[_head] = value;
+        } else if (pos == _current_size) {
+            // Insert at back
+            _data[_tail] = value;
+            _tail = (_tail + 1) % _capacity;
+        } else {
+            size_t k = pos;
+            size_t physical_pos = (_head + k) % _capacity;
+            size_t left_moves = k;
+            size_t right_moves = _current_size - k;
+
+            if (left_moves <= right_moves) {
+                // Shift left part to the left
+                for (size_t i = 0; i < k; ++i) {
+                    size_t src = (_head + i) % _capacity;
+                    size_t dst = (src - 1 + _capacity) % _capacity;
+                    _data[dst] = std::move(_data[src]);
+                }
+                _head = (_head - 1 + _capacity) % _capacity;
+                physical_pos = (_head + k) % _capacity;
+            } else {
+                // Shift right part to the right
+                for (size_t i = _current_size; i > k; --i) {
+                    size_t src = (_head + i - 1) % _capacity;
+                    size_t dst = (src + 1) % _capacity;
+                    _data[dst] = std::move(_data[src]);
+                }
+                _tail = (_tail + 1) % _capacity;
+                physical_pos = (_head + k) % _capacity;
+            }
+            _data[physical_pos] = value;
+        }
+        _current_size++;
+    }
+
+    T erase(size_t pos) {
+        if (pos >= _current_size) {
+            throw std::out_of_range("Erase position out of range");
+        }
+        if (pos == 0) {
+            return pop_front();
+        } else if (pos == _current_size - 1) {
+            // Pop back
+            _tail = (_tail - 1 + _capacity) % _capacity;
+            T value = _data[_tail];
+            _current_size--;
+            return value;
+        } else {
+            size_t k = pos;
+            size_t physical_pos = (_head + k) % _capacity;
+            T value = _data[physical_pos];
+            size_t left_moves = k;
+            size_t right_moves = _current_size - k - 1;
+
+            if (left_moves <= right_moves) {
+                // Shift left part to the right
+                for (size_t i = k; i > 0; --i) {
+                    size_t dst = (_head + i) % _capacity;
+                    size_t src = (_head + i - 1) % _capacity;
+                    _data[dst] = std::move(_data[src]);
+                }
+                _head = (_head + 1) % _capacity;
+            } else {
+                // Shift right part to the left
+                for (size_t i = k + 1; i < _current_size; ++i) {
+                    size_t dst = (_head + i - 1) % _capacity;
+                    size_t src = (_head + i) % _capacity;
+                    _data[dst] = std::move(_data[src]);
+                }
+                _tail = (_tail - 1 + _capacity) % _capacity;
+            }
+            _current_size--;
+            return value;
+        }
+    }
+    void clear() {
+        _head = 0;
+        _tail = 0;
+        _current_size = 0;
+    }
+
+    size_t size() const {
+        return _current_size;
+    }
+    bool empty() const {
+        return _current_size == 0;
+    }
+    size_t capacity() const {
+        return _capacity;
+    }
+
+    // Iterator implementation
+    class iterator {
+    public:
+        using iterator_category = std::forward_iterator_tag;
+        using value_type = T;
+        using difference_type = std::ptrdiff_t;
+        using pointer = T*;
+        using reference = T&;
+
+        /*
+        constructor, initialize with ringbuffer and offset, offset is logical offset from the head
+        For example, we have a ringbuffer in contiguous memory
+                        [ 4, 5, _ , 1, 2, 3]
+                        head = 3
+                        tail = 2
+                        current_size = head - tail + capacity
+            if offset is 2, then the iterator points to the element value 3 because v[3+2] == 3
+        */
+        iterator(RingBuffer3* rb, size_t offset) : rb(rb), offset(offset) {}
+
+        iterator operator+(size_t n) const {
+            return iterator(rb, offset + n);
+        }
+
+        iterator operator-(size_t n) const {
+            if (n > offset) {
+                throw std::out_of_range("Iterator subtraction out of range");
+            }
+            return iterator(rb, offset - n);
+        }
+
+        reference operator*() const {
+            if (offset >= rb->size()) {
+                throw std::out_of_range("Iterator dereference out of range");
+            }
+            return rb->_data[(rb->_head + offset) % rb->_capacity];
+        }
+
+        pointer operator->() const {
+            if (offset >= rb->size()) {
+                throw std::out_of_range("Iterator arrow operator out of range");
+            }
+            return &(rb->_data[(rb->_head + offset) % rb->_capacity]);
+        }
+
+        iterator& operator++() {
+            ++offset;
+            return *this;
+        }
+
+        iterator operator++(int) {
+            iterator tmp = *this;
+            ++offset;
+            return tmp;
+        }
+
+        bool operator==(const iterator& other) const {
+            return rb == other.rb && offset == other.offset;
+        }
+
+        bool operator!=(const iterator& other) const {
+            return !(*this == other);
+        }
+
+        size_t get_offset() const {
+            return offset;
+        }
+
+    private:
+        size_t offset;  // Logical offset from the head
+        RingBuffer3* rb;
+    };
+
+    iterator begin() {
+        return iterator(this, 0);
+    }
+
+    iterator end() {
+        return iterator(this, _current_size);
+    }
+
+    template <typename Predicate>
+    iterator linear_partition_point(Predicate pred) {
+        // Returns the first iterator where pred returns false using linear search
+        // If all elements satisfy pred, returns end()
+        // Implements partition point via linear scan rather than binary search
+        iterator it = begin();
+        while (it != end() && pred(*it)) {
+            ++it;
+        }
+        return it;
+    }
+
+    void reserve(size_t new_capacity) {
+        if (new_capacity <= _capacity) {
+            return;
+        }
+        std::vector<T> new_data(new_capacity);
+
+        // Copy data in logical order
+        for (size_t i = 0; i < _current_size; ++i) {
+            new_data[i] = _data[(_head + i) % _capacity];
+        }
+
+        _head = 0;
+        _tail = _current_size;
+        _data = std::move(new_data);
+        _capacity = new_capacity;
+    }
+
+    // Returns a copy of the ringbuffer data in contiguous memory
+    std::vector<T> copy_continous_data() const {
+        std::vector<T> result(_current_size);
+        for (size_t i = 0; i < _current_size; ++i) {
+            result[i] = _data[(_head + i) % _capacity];
+        }
+        return result;
+    }
+
+private:
+    std::vector<T> _data;
+    size_t _head;
+    size_t _tail;
+    size_t _current_size;
+    size_t _capacity;
+
+    void grow() {
+        size_t new_capacity = _capacity * 2;
+        reserve(new_capacity);
+    }
+};
