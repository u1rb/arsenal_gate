+use clap::Parser;
+use std::fs;
+use std::fs::File;
+use std::io::{Read, Write};
+use std::os::unix::fs::FileExt;
+use std::time::Instant;
+
+#[derive(Parser, Debug)]
+#[command(
+    version,
+    about = "SSD Benchmark Tool",
+    long_about = "Measures sequential read/write speeds and random read performance of storage devices"
+)]
+struct Args {
+    /// Path to the test file (including filename)
+    #[arg(short, long)]
+    file: String,
+
+    /// File size to test with (e.g., 1G, 500M)
+    #[arg(short, long, default_value_t = String::from("1G"))]
+    file_size: String,
+
+    /// Buffer size for operations (e.g., 4096)
+    #[arg(short, long, default_value_t = 4096, value_parser = parse_size)]
+    buffer_size: usize,
+}
+
+fn parse_size(s: &str) -> Result<usize, String> {
+    let s = s.to_uppercase();
+    let mut multiplier = 1;
+    let (num_part, unit) = match s.find(|c: char| !c.is_digit(10)) {
+        Some(pos) => s.split_at(pos),
+        None => (&s[..], ""),
+    };
+
+    match unit {
+        "K" => multiplier = 1024,
+        "M" => multiplier = 1024 * 1024,
+        "G" => multiplier = 1024 * 1024 * 1024,
+        "" => multiplier = 1,
+        _ => return Err(format!("Invalid size unit: {}", unit)),
+    }
+
+    num_part
+        .parse::<usize>()
+        .map(|n| n * multiplier)
+        .map_err(|_| format!("Invalid number format: {}", num_part))
+}
+
+fn main() -> std::io::Result<()> {
+    let args = Args::parse();
+
+    // Parse file size
+    let file_size = parse_size(&args.file_size)
+        .map_err(|e| std::io::Error::new(std::io::ErrorKind::InvalidInput, e))?;
+
+    // Validate buffer size
+    if args.buffer_size > file_size {
+        return Err(std::io::Error::new(
+            std::io::ErrorKind::InvalidInput,
+            "Buffer size cannot be larger than file size",
+        ));
+    }
+
+    // Clean up any previous test file
+    let _ = fs::remove_file(&args.file);
+
+    // Sequential write test
+    let start_write = Instant::now();
+    let mut file = File::create(&args.file)?;
+    let data = vec![0u8; file_size];
+    file.write_all(&data)?;
+    file.sync_all()?;
+    let write_duration = start_write.elapsed();
+
+    // Sequential read test
+    let start_read = Instant::now();
+    let mut file = File::open(&args.file)?;
+    let mut buffer = Vec::with_capacity(file_size);
+    file.read_to_end(&mut buffer)?;
+    let read_duration = start_read.elapsed();
+
+    // Random read test
+    let start_random = Instant::now();
+    let file = File::open(&args.file)?;
+    for _ in 0..10_000 {
+        let offset = (rand::random::<usize>() % (file_size - args.buffer_size)) as u64;
+        let mut buffer = vec![0u8; args.buffer_size];
+        file.read_exact_at(&mut buffer, offset)?;
+    }
+    let random_duration = start_random.elapsed();
+
+    // Clean up
+    fs::remove_file(&args.file)?;
+
+    // Print results
+    println!("Test parameters:");
+    println!("- File size: {}", args.file_size);
+    println!("- Buffer size: {} bytes", args.buffer_size);
+    println!("\nResults:");
+    println!(
+        "Sequential Write Speed: {:.2} MB/s",
+        (file_size as f64 / 1024.0 / 1024.0) / write_duration.as_secs_f64()
+    );
+    println!(
+        "Sequential Read Speed:  {:.2} MB/s",
+        (file_size as f64 / 1024.0 / 1024.0) / read_duration.as_secs_f64()
+    );
+    println!(
+        "Random Read Speed:      {:.2} IOPS ({} byte operations)",
+        10_000f64 / random_duration.as_secs_f64(),
+        args.buffer_size
+    );
+
+    Ok(())
+}
