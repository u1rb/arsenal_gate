+#!/bin/bash
+set -e
+
+show_help() {
+    echo "Usage: $0 [-e exclude_pattern]... <source-dir> <include-patterns...>"
+    echo "Example:"
+    echo "  $0 -e '*.tmp' -e 'temp/**' . '*'"
+    echo "  $0 -e '.*' /project 'Cargo.*'"
+}
+
+# Parse command-line options
+exclude_patterns=()
+while getopts "e:h" opt; do
+    case $opt in
+        e) exclude_patterns+=("$OPTARG") ;;
+        h) show_help; exit 0 ;;
+        *) show_help >&2; exit 1 ;;
+    esac
+done
+shift $((OPTIND - 1))
+
+if [[ $# -lt 2 ]]; then
+    show_help >&2
+    exit 1
+fi
+
+source_dir=$(realpath "$1")
+shift
+include_patterns=("$@")
+
+temp_dir=$(mktemp -d)
+trap 'rm -rf "$temp_dir"' EXIT
+
+export GIT_AUTHOR_NAME="Patch Creator"
+export GIT_AUTHOR_EMAIL="patch@example.com"
+export GIT_COMMITTER_NAME="$GIT_AUTHOR_NAME"
+export GIT_COMMITTER_EMAIL="$GIT_AUTHOR_EMAIL"
+
+(
+    cd "$source_dir"
+    shopt -s globstar nullglob dotglob
+
+    # Process includes with directory expansion
+    included_files=()
+    for pattern in "${include_patterns[@]}"; do
+        [[ -d "$pattern" ]] && pattern="$pattern/**/*"
+        
+        if [[ "$pattern" == */* ]]; then
+            while IFS= read -r -d $'\0' file; do
+                included_files+=("$file")
+            done < <(find . -path "./${pattern#./}" -print0 2>/dev/null)
+        else
+            while IFS= read -r -d $'\0' file; do
+                included_files+=("$file")
+            done < <(find . -name "$pattern" -print0 2>/dev/null)
+        fi
+    done
+
+    # Process excludes with directory expansion
+    excluded_files=()
+    for pattern in "${exclude_patterns[@]}"; do
+        [[ "$pattern" == */ ]] && pattern="${pattern}**/*"  # Directory exclusion
+        [[ -d "$pattern" ]] && pattern="$pattern/**/*"
+        
+        if [[ "$pattern" == */* ]]; then
+            while IFS= read -r -d $'\0' file; do
+                excluded_files+=("$file")
+            done < <(find . -path "./${pattern#./}" -print0 2>/dev/null)
+        else
+            while IFS= read -r -d $'\0' file; do
+                excluded_files+=("$file")
+            done < <(find . -name "$pattern" -print0 2>/dev/null)
+        fi
+    done
+
+    # Create exclusion map with realpath for accuracy
+    declare -A exclusion_map
+    for file in "${excluded_files[@]}"; do
+        exclusion_map["$(realpath -m "$file")"]=1
+    done
+
+    # Filter files using hashmap with full paths
+    filtered_files=()
+    for file in "${included_files[@]}"; do
+        full_path=$(realpath -m "$file")
+        [[ ! ${exclusion_map["$full_path"]} ]] && filtered_files+=("$file")
+    done
+
+    if [[ ${#filtered_files[@]} -gt 0 ]]; then
+        rsync -aR --files-from=<(printf "%s\n" "${filtered_files[@]}") . "$temp_dir"
+    fi
+)
+
+(
+    cd "$temp_dir"
+    if [[ -n $(find . -mindepth 1 -print -quit) ]]; then
+        git init --quiet
+        git add . > /dev/null
+        git commit --quiet -m "Patch commit"
+        git format-patch --root --stdout > "../output.patch"
+    else
+        echo "Error: No files matched after exclusions" >&2
+        exit 1
+    fi
+)
+
+mv "$temp_dir/../output.patch" .
+echo "Patch created: output.patch"
