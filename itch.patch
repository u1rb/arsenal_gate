+// --- End Refactored FlatBuffers Serialization ---
+
+void print_usage(const char *prog_name) {
+  fprintf(
+      stderr,
+      "Usage: %s -i <input_file> [-d] [-o <output_file>] [-n <max_packets>]\n",
+      prog_name);
+  fprintf(stderr,
+          "  -i <input_file> : Path to the input ITCH data file (required).\n");
+  fprintf(stderr, "  -d              : Enable dump mode (serialize to "
+                  "FlatBuffers hex output).\n");
+  fprintf(stderr, "  -o <output_file>: Path to the output file for hex dump "
+                  "(required if -d is used).\n");
+  fprintf(stderr, "  -n <max_packets>: Maximum number of packets to process "
+                  "(optional, default: all).\n");
+}
+
+int main(int argc, char *argv[]) {
+  size_t max_packets = std::numeric_limits<size_t>::max();
+  bool dump_mode = false;
+  const char *input_path = nullptr;
+  const char *output_path = nullptr;
+  int opt;
+
+  // Parse command-line arguments using getopt
+  while ((opt = getopt(argc, argv, "i:o:dn:")) != -1) {
+    switch (opt) {
+    case 'i':
+      input_path = optarg;
+      break;
+    case 'o':
+      output_path = optarg;
+      break;
+    case 'd':
+      dump_mode = true;
+      break;
+    case 'n': { // Scope for variable declaration
+      char *endptr = nullptr;
+      errno = 0; // Reset errno before call
+      unsigned long long val = strtoull(optarg, &endptr, 10);
+      if (errno != 0 || *endptr != '\0' || endptr == optarg) {
+        fprintf(stderr, "Error: Invalid number for max_packets (-n): %s\n",
+                optarg);
+        print_usage(argv[0]);
+        return 1;
+      }
+      // Check if value fits in size_t
+      if (val > std::numeric_limits<size_t>::max()) {
+        fprintf(stderr, "Error: max_packets value (-n) too large: %s\n",
+                optarg);
+        print_usage(argv[0]);
+        return 1;
+      }
+      max_packets = static_cast<size_t>(val);
+    } break;
+    case '?': // Unknown option or missing argument
+      fprintf(stderr, "Error: Unknown option or missing argument.\n");
+      print_usage(argv[0]);
+      return 1;
+    default:
+      print_usage(argv[0]);
+      return 1;
+    }
+  }
+
+  // Validate required arguments
+  if (!input_path) {
+    fprintf(stderr, "Error: Input file path (-i) is required.\n");
+    print_usage(argv[0]);
+    return 1;
+  }
+  if (dump_mode && kConst::WRITE_TO_FILE && !output_path) {
+    fprintf(stderr, "Error: Output file path (-o) is required when dump mode "
+                    "(-d) is enabled and kConst::WRITE_TO_FILE is true.\n");
+    print_usage(argv[0]);
+    return 1;
+  }
+
+  // Open input file
+  int input_fd = open(input_path, O_RDONLY);
+  if (input_fd == -1) {
+    perror("Error opening input file");
+    return 1;
+  }
+
+  // Open output file only if dumping and writing
+  int output_fd = -1;
+  if (dump_mode && kConst::WRITE_TO_FILE) {
+    output_fd = open(output_path, O_WRONLY | O_CREAT | O_TRUNC, 0644);
+    if (output_fd == -1) {
+      perror("Error opening output file");
+      close(input_fd); // Close input file before exiting
+      return 1;
+    }
+    fprintf(stderr, "Dump mode enabled. Input: %s, Output: %s (Format: %s)\n",
+            input_path, output_path,
+            kConst::BUILD_FLATBUFFER
+                ? (kConst::OUTPUT_HEX ? "Hex" : "Raw Bytes")
+                : "Newline Only");
+  } else if (dump_mode) {
+    fprintf(stderr,
+            "Dump mode enabled. Input: %s (Output to file disabled by "
+            "kConst::WRITE_TO_FILE=false)\n",
+            input_path);
+  } else {
+    fprintf(stderr, "Order book mode enabled. Input: %s\n", input_path);
+  }
+
+  buf_t buf(1024);
+  buf.fd = input_fd;
+  // Initialize with default start time in case no packets are processed
+  std::chrono::steady_clock::time_point start =
+      std::chrono::steady_clock::now();
+  size_t npkts = 0;
+
+  // Initialize output buffer only if dumping and writing
+  fmt::memory_buffer output_buffer;
+  const size_t WRITE_THRESHOLD = 131072 * 32;
+  if (dump_mode && kConst::WRITE_TO_FILE) {
+    output_buffer.reserve(WRITE_THRESHOLD);
+  }
+
+  // Conditionally initialize order book structures if not dumping
+  if (!dump_mode) {
+    // order_book::oid_map.max_load_factor(0.5);
+    order_book::oid_map.reserve(
+        order_id_t(184118975 * 2)); // See original comments
+    printf("Order book size: %lu bytes\n",
+           sizeof(order_book) * order_book::MAX_BOOKS);
+  } // Removed the initial print statement for dump mode
+
+  while (is_ok(buf.ensure(3)) && npkts < max_packets) {
+    // Always increment packet count and track timing for both modes
+    if (npkts == 0) {
+      // Reset the start time when we process the first packet
+      start = std::chrono::steady_clock::now();
+    }
+    ++npkts;
+
+    itch_t const msgtype = itch_t(*buf.get(2));
+
+    // Flatbuffer builder instance (reused per message)
+    flatbuffers::FlatBufferBuilder builder(
+        1024); // Initial size, grows as needed
+
+    switch (msgtype) {
+    // --- Cases that just read and discard (no action in either mode yet) ---
+    case itch_t::SYSEVENT: {
+      PROCESS<itch_t::SYSEVENT>::read_from(&buf);
+      break;
+    }
+    case itch_t::STOCK_DIRECTORY: {
+      PROCESS<itch_t::STOCK_DIRECTORY>::read_from(&buf);
+      break;
+    }
+    case itch_t::TRADING_ACTION: {
+      PROCESS<itch_t::TRADING_ACTION>::read_from(&buf);
+      break;
+    }
+    case itch_t::REG_SHO_RESTRICT: {
+      PROCESS<itch_t::REG_SHO_RESTRICT>::read_from(&buf);
+      break;
+    }
+    case itch_t::MPID_POSITION: {
+      PROCESS<itch_t::MPID_POSITION>::read_from(&buf);
+      break;
+    }
+    case itch_t::MWCB_DECLINE: {
+      PROCESS<itch_t::MWCB_DECLINE>::read_from(&buf);
+      break;
+    }
+    case itch_t::MWCB_STATUS: {
+      PROCESS<itch_t::MWCB_STATUS>::read_from(&buf);
+      break;
+    }
+    case itch_t::IPO_QUOTE_UPDATE: {
+      PROCESS<itch_t::IPO_QUOTE_UPDATE>::read_from(&buf);
+      break;
+    }
+    case itch_t::TRADE: {
+      PROCESS<itch_t::TRADE>::read_from(&buf);
+      break;
+    }
+    case itch_t::CROSS_TRADE: {
+      PROCESS<itch_t::CROSS_TRADE>::read_from(&buf);
+      break;
+    }
+    case itch_t::BROKEN_TRADE: {
+      PROCESS<itch_t::BROKEN_TRADE>::read_from(&buf);
+      break;
+    }
+    case itch_t::NET_ORDER_IMBALANCE: {
+      PROCESS<itch_t::NET_ORDER_IMBALANCE>::read_from(&buf);
+      break;
+    }
+    case itch_t::RETAIL_PRICE_IMPROVEMENT: {
+      PROCESS<itch_t::RETAIL_PRICE_IMPROVEMENT>::read_from(&buf);
+      break;
+    }
+    case itch_t::PROCESS_LULD_AUCTION_COLLAR_MESSAGE: {
+      PROCESS<itch_t::PROCESS_LULD_AUCTION_COLLAR_MESSAGE>::read_from(&buf);
+      break;
+    }
+
+    // --- Cases with Order Book Logic OR FlatBuffer Dumping ---
+    case (itch_t::ADD_ORDER): {
+      auto const pkt = PROCESS<itch_t::ADD_ORDER>::read_from(&buf);
+      assert(uint64_t(pkt.oid) <
+             uint64_t(std::numeric_limits<int32_t>::max())); // Keep assertion
+
+      if (dump_mode) {
+        serialize_and_print<itch_t::ADD_ORDER>(output_buffer, builder, pkt);
+      } else {
+        order_book::add_order(order_id_t(pkt.oid), book_id_t(pkt.stock_locate),
+                              mksigned(pkt.price, pkt.buy), pkt.qty);
+      }
+      break;
+    }
+    case (itch_t::ADD_ORDER_MPID): {
+      auto const pkt = PROCESS<itch_t::ADD_ORDER_MPID>::read_from(&buf);
+      if (dump_mode) {
+        serialize_and_print<itch_t::ADD_ORDER_MPID>(output_buffer, builder,
+                                                    pkt);
+      } else {
+        order_book::add_order(
+            order_id_t(pkt.add_msg.oid), book_id_t(pkt.add_msg.stock_locate),
+            mksigned(pkt.add_msg.price, pkt.add_msg.buy), pkt.add_msg.qty);
+      }
+      break;
+    }
+    case (itch_t::EXECUTE_ORDER): {
+      auto const pkt = PROCESS<itch_t::EXECUTE_ORDER>::read_from(&buf);
+      if (dump_mode) {
+        serialize_and_print<itch_t::EXECUTE_ORDER>(output_buffer, builder, pkt);
+      } else {
+        order_book::execute_order(order_id_t(pkt.oid), pkt.qty);
+      }
+      break;
+    }
+    case (itch_t::EXECUTE_ORDER_WITH_PRICE): {
+      auto const pkt =
+          PROCESS<itch_t::EXECUTE_ORDER_WITH_PRICE>::read_from(&buf);
+      if (dump_mode) {
+        serialize_and_print<itch_t::EXECUTE_ORDER_WITH_PRICE>(output_buffer,
+                                                              builder, pkt);
+      } else {
+        order_book::execute_order(order_id_t(pkt.exec.oid), pkt.exec.qty);
+      }
+      break;
+    }
+    case (itch_t::REDUCE_ORDER): {
+      auto const pkt = PROCESS<itch_t::REDUCE_ORDER>::read_from(&buf);
+      if (dump_mode) {
+        serialize_and_print<itch_t::REDUCE_ORDER>(output_buffer, builder, pkt);
+      } else {
+        order_book::cancel_order(order_id_t(pkt.oid),
+                                 pkt.qty); // Note: C++ uses 'cancel'
+      }
+      break;
+    }
+    case (itch_t::DELETE_ORDER): {
+      auto const pkt = PROCESS<itch_t::DELETE_ORDER>::read_from(&buf);
+      if (dump_mode) {
+        serialize_and_print<itch_t::DELETE_ORDER>(output_buffer, builder, pkt);
+      } else {
+        order_book::delete_order(order_id_t(pkt.oid));
+      }
+      break;
+    }
+    case (itch_t::REPLACE_ORDER): {
+      auto const pkt = PROCESS<itch_t::REPLACE_ORDER>::read_from(&buf);
+      if (dump_mode) {
+        serialize_and_print<itch_t::REPLACE_ORDER>(output_buffer, builder, pkt);
+      } else {
+        // Note: mksigned used BUY_SELL::BUY here, potentially incorrect if
+        // replace can be sell?
+        order_book::replace_order(
+            order_id_t(pkt.oid), order_id_t(pkt.new_order_id), pkt.new_qty,
+            mksigned(pkt.new_price, BUY_SELL::BUY)); // Check this logic
+      }
+      break;
+    }
+    default: {
+      // Unknown message type, try to read base length to advance buffer
+      uint16_t const msglen = be16toh(*(uint16_t *)buf.get(0));
+      buf.advance(2); // Advance past length
+      std::cerr << "Warning: Unknown message type encountered: "
+                << char(msgtype) << " attempting to skip " << msglen
+                << " bytes." << std::endl;
+      if (is_ok(buf.ensure(msglen))) {
+        buf.advance(msglen);
+      } else {
+        std::cerr << "Error: Failed to skip unknown message, stopping."
+                  << std::endl;
+        goto end_loop; // Exit loop if we can't safely skip
+      }
+      // Old logic:
+      // printf("Uh oh bad code %d\n", char(msgtype));
+      // assert(false);
+      break;
+    }
+    }
+    builder.Clear(); // Clear builder for next message
+
+    // Check if output buffer needs flushing (only if dumping and writing)
+    if (dump_mode && kConst::WRITE_TO_FILE &&
+        output_buffer.size() >= WRITE_THRESHOLD) {
+      ssize_t written =
+          write(output_fd, output_buffer.data(), output_buffer.size());
+      if (written != (ssize_t)output_buffer.size()) {
+        perror("Error writing buffered data to output file");
+        // Consider breaking loop or handling error more robustly
+        goto end_loop; // Example: jump to cleanup on error
+      }
+      output_buffer.clear(); // Clear buffer after writing
+    }
+  }
+
+end_loop: // Label to jump to for graceful exit on error
+
+  // Write any remaining data in the output buffer
+  if (dump_mode && kConst::WRITE_TO_FILE && output_buffer.size() > 0) {
+    ssize_t written =
+        write(output_fd, output_buffer.data(), output_buffer.size());
+    if (written != (ssize_t)output_buffer.size()) {
+      perror("Error writing remaining buffered data to output file");
+    }
+  }
+
+  // Cleanup: Close files
+  if (input_fd != -1) {
+    close(input_fd);
+  }
+  if (output_fd != -1) {
+    close(output_fd);
+  }
+
+  // Only print performance stats if not dumping or if packets were processed
+  if (!dump_mode || npkts > 0) {
+    std::chrono::steady_clock::time_point end =
+        std::chrono::steady_clock::now();
+    size_t nanos = 0;
+    if (npkts > 0) { // Avoid division by zero if start time wasn't set
+      nanos = std::chrono::duration_cast<std::chrono::nanoseconds>(end - start)
+                  .count();
+    }
+    // Print performance stats to stderr to avoid polluting potential output
+    // file
+    fprintf(stderr,
+            "%lu packets processed in %lu nanos. Average: %.2f nanos/packet.\n",
+            npkts, nanos,
+            (npkts > 0) ? (nanos / static_cast<double>(npkts)) : 0.0);
+  }
+
+  return 0; // Indicate success
+}
diff --git a/itch-order-book/src/order_book.h b/itch-order-book/src/order_book.h
new file mode 100644
index 0000000..294a577
--- /dev/null
+++ b/itch-order-book/src/order_book.h
@@ -0,0 +1,783 @@
+#pragma once
+#include "../external/flat_hash_map/bytell_hash_map.hpp" // ska::bytell_hash_map
+#include "../external/parallel-hashmap/parallel_hashmap/btree.h" // phmap::btree_map
+#include "../external/parallel-hashmap/parallel_hashmap/phmap.h" // phmap::flat_hash_map
+#include "itch.h"
+#include <absl/container/flat_hash_map.h>
+#include <algorithm> // for std::lower_bound, std::remove_if
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <stdexcept>
+#include <vector>
+
+/* This is an optimized order book implementation.
+ * Conceptually an order book is two sets of levels, with each
+ * level representing all the queued orders at a price.
+ *
+ * This implementation provides O(1) lookup of the best bid and offer
+ * as well as the aggregated quantity for any price. It provides
+ * very fast throughput (61.5ns / tick at last benchmark), although
+ * note that there are some poor performance worst-case ticks.
+ *
+ * The ITCH feed sends some metadata about each order with each add_order
+ * message, such as the price, quantity and symbol (really a number
+ * referring to the symbol). The user is expected after that to keep
+ * track of the metadata; for instance the delete message only has
+ * the order id and the user is expected to know which symbol
+ * that refers to as well as the price and size.
+ *
+ * This implementation uses several tricks. The first is that, while
+ * a hashmap seems like a reasonable data structure to keep track of
+ * the metadata for each order, in practice the ITCH feed generates
+ * the order ids close together, not going past a max id of several
+ * hundred million. We thus store the metadata for each order in an
+ * array, so looking up the order metadata is a single dereference.
+ * The order id generation has a side benefit that new orders are
+ * likely to be near recently added orders, so the pages are likely
+ * to be in the TLB and memory cache.
+ *
+ * Each order knows which book and price level it belongs to. So
+ * to find all the data about an order requires two to three
+ * dereferences. Also the quantities in each price level are held
+ * in a pointed to data structure so that a reduce operation does
+ * not need to search the levels but can modify the quantity at the
+ * level directly from the pointer stored in the order metadata.
+ *
+ * Another trick is that each price level is represented as a price
+ * and quantity, and the levels are stored in a sorted array instead
+ * of a tree. Averagely speaking most activity is near the top of
+ * the book, so the implementation only needs to go 1-5 levels deep
+ * into the book. Thus using an array is fast since it improves
+ * locality and uses less memory. Note though that the worst case
+ * performance could be bad - if somebody adds and deletes orders
+ * far away from the inside of the book it could result in longer
+ * processing for those messages.
+ *
+ * Lastly, since the orders and levels are stored in their own global
+ * pools, they are likely to be local and there is very little pressure
+ * on the allocator. In fact the only allocations are bulk allocations
+ * from stl container resizing.
+ */
+
+#define MKPRIMITIVE(__x) ((std::underlying_type<decltype(__x)>::type)__x)
+
+constexpr bool is_power_of_two(uint64_t n) { // stolen from linux header
+  return (n != 0 && ((n & (n - 1)) == 0));
+}
+
+enum class sprice_t : int32_t {};
+bool constexpr is_bid(sprice_t const x) { return int32_t(x) >= 0; }
+#define MEMORY_DEFS                                                            \
+  using __ptr = ptr_t;                                                         \
+  using size_t__ = typename std::underlying_type<ptr_t>::type;
+
+/* A custom, pooling allocator. It uses a non-shrinking vector as its pool,
+ * and a vector (LIFO stack) as its free list.
+ * If there are no free locations, increment m_size, representing growing
+ * the pool. If there is a free location, pop its address off the free list
+ * and return that. To free an object, push its address onto the free list.
+ * Note that pointers are not guaranteed to be stable across invocations
+ * of `allocate`. To have a stable way of referencing an object use
+ * `get` on its address.
+ *
+ * Performance: Since the pool and the free list are both represented
+ * as arrays, an allocate is an increment if the free list is empty,
+ * or a decrement and dereference (to the tail of the pool which is
+ * likely in cache), if the free list is not empty.
+ * A deallocate is a decrement and a write to memory.
+ *
+ * The implementation uses custom pointer types to save space, and
+ * to preserve addresses if the underlying container is resized.
+ * For instance we define `enum class order_id_t : uint32_t {}`
+ * instead of (order *)
+ */
+template <class T, typename ptr_t, size_t SIZE_HINT> class pool {
+public:
+  MEMORY_DEFS;
+  std::vector<T> m_allocated;
+  std::vector<ptr_t> m_free;
+  pool() { m_allocated.reserve(SIZE_HINT); }
+  pool(size_t reserve_size) { m_allocated.reserve(reserve_size); }
+  T *get(ptr_t idx) { return &m_allocated[size_t__(idx)]; }
+  T &operator[](ptr_t idx) { return m_allocated[size_t__(idx)]; }
+#define ALLOC_INVARIANT                                                        \
+  (m_free_size >= 0) /* aka can't free more than has been allocated */
+  __ptr alloc(void) {
+    if (m_free.empty()) {
+      auto ret = __ptr(m_allocated.size());
+      m_allocated.push_back(T());
+      return ret;
+    } else {
+      auto ret = __ptr(m_free.back());
+      m_free.pop_back();
+      return ret;
+    }
+  }
+  void free(__ptr idx) { m_free.push_back(idx); }
+#undef ALLOC_INVARIANT
+};
+
+enum class book_id_t : uint16_t {};
+enum class level_id_t : uint32_t {};
+enum class order_id_t : uint32_t {};
+
+// Define map implementation types
+enum class OrderStoreImplementation {
+  VECTOR = 0,
+  ABSEIL_MAP = 1,
+  SKA_MAP = 2,
+  PHMAP_MAP = 3
+};
+
+// Enum to select level container implementation
+enum class LevelContainerType { BTREE_MAP, SORTED_VECTOR };
+
+// Configuration struct - replace #define with constexpr
+struct kOrderBookConfig {
+  // Select OID map implementation
+  static constexpr OrderStoreImplementation oidMapImpl =
+      OrderStoreImplementation::PHMAP_MAP;
+
+  // Select Level container implementation (BTREE_MAP or SORTED_VECTOR)
+  static constexpr LevelContainerType levelContainerImpl =
+      LevelContainerType::SORTED_VECTOR; // Default to vector for now
+
+  static constexpr bool TRACK_ORDERS_IN_LEVEL = true;
+
+  // Initial capacity of order vectors to reduce allocations
+  static constexpr size_t LEVEL_ORDERS_INITIAL_CAPACITY = 8;
+};
+
+// Hash function for order_id_t - enables use with std/absl hash maps
+template <> struct std::hash<order_id_t> {
+  std::size_t operator()(const order_id_t &id) const {
+    return std::hash<uint32_t>{}(static_cast<uint32_t>(id));
+  }
+};
+
+/* A datatype representing an order. Since this order book only wants
+ * to know the size at each level it just remembers its quantity. If
+ * one wanted to maintain knowledge about the queue it would probably
+ * be fast to maintain a doubly linked list.
+ * It also remember which book it belongs to and its price level. This
+ * is so that given just an oid we can look up the book structure
+ * as well as just the price level if we want to modify the quantity
+ * at the level without searching for it in the book.
+ */
+typedef struct order {
+  qty_t m_qty;
+  level_id_t level_idx;
+  book_id_t book_idx;
+} order_t;
+
+// Per-level order entry to store order information
+// at each price level for iteration
+// Only defined when tracking orders is enabled
+struct level_order_entry {
+  qty_t qty;
+  timestamp_t timestamp; // Optional: useful for FIFO matching
+  order_id_t oid;        // Added to store order ID with the entry
+  bool deleted;          // Flag for lazy deletion
+};
+using level_order_entry_t = level_order_entry;
+
+class level {
+public:
+  sprice_t m_price;
+  qty_t m_qty;
+
+  // Store orders in this level with a vector for better cache locality
+  // Only populated when tracking orders is enabled
+  std::vector<level_order_entry_t> m_orders;
+
+  // Count of logically deleted entries for cleanup tracking
+  size_t m_deleted_count;
+
+  // Threshold ratio for triggering cleanup (deleted/total)
+  static constexpr float CLEANUP_THRESHOLD = 0.25f;
+
+  level(sprice_t __price, qty_t __qty)
+      : m_price(__price), m_qty(__qty), m_deleted_count(0) {
+    // Pre-allocate vector capacity to reduce allocations
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      m_orders.reserve(kOrderBookConfig::LEVEL_ORDERS_INITIAL_CAPACITY);
+    }
+  }
+
+  level() : m_deleted_count(0) {
+    // Pre-allocate vector capacity to reduce allocations
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      m_orders.reserve(kOrderBookConfig::LEVEL_ORDERS_INITIAL_CAPACITY);
+    }
+  }
+
+  // Add an order to this level
+  void add_order(order_id_t oid, qty_t qty,
+                 timestamp_t timestamp = timestamp_t(0)) {
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      // Check if we need cleanup before adding a new order
+      maybe_cleanup();
+      level_order_entry_t entry{qty, timestamp, oid, false};
+      m_orders.push_back(entry);
+    }
+  }
+
+  // Reduce an order's quantity in this level
+  void reduce_order(order_id_t oid, qty_t qty) {
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      for (auto &entry : m_orders) {
+        if (!entry.deleted && entry.oid == oid) {
+          auto tmp = MKPRIMITIVE(entry.qty);
+          tmp -= MKPRIMITIVE(qty);
+          if (tmp > 0) {
+            // Partial reduction
+            entry.qty = qty_t(tmp);
+          } else {
+            // Complete reduction, mark as deleted
+            entry.deleted = true;
+            m_deleted_count++;
+          }
+          break;
+        }
+      }
+
+      // Check if we need cleanup after reducing
+      maybe_cleanup();
+    }
+  }
+
+  // Remove an order from this level - uses lazy deletion
+  void delete_order(order_id_t oid) {
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      for (auto &entry : m_orders) {
+        if (!entry.deleted && entry.oid == oid) {
+          entry.deleted = true;
+          m_deleted_count++;
+          break;
+        }
+      }
+
+      // Check if we need cleanup after deleting
+      maybe_cleanup();
+    }
+  }
+
+  // Check if cleanup should be performed and do it if needed
+  void maybe_cleanup() {
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      if (m_deleted_count > 0 &&
+          (float)m_deleted_count / m_orders.size() >= CLEANUP_THRESHOLD) {
+        cleanup();
+      }
+    }
+  }
+
+  // Perform actual removal of deleted orders
+  void cleanup() {
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      if (m_deleted_count == 0)
+        return;
+
+      // Use erase-remove idiom to remove deleted entries
+      m_orders.erase(std::remove_if(m_orders.begin(), m_orders.end(),
+                                    [](const level_order_entry_t &entry) {
+                                      return entry.deleted;
+                                    }),
+                     m_orders.end());
+
+      // Reset deleted count
+      m_deleted_count = 0;
+    }
+  }
+
+  // Helper to get number of orders at this level (non-deleted)
+  size_t order_count() const {
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      return m_orders.size() - m_deleted_count;
+    } else {
+      return (m_qty > qty_t(0)) ? 1 : 0;
+    }
+  }
+};
+
+// Comparator for sprice_t in btree_map
+struct sprice_comparator {
+  bool operator()(const sprice_t &lhs, const sprice_t &rhs) const {
+    // Bids are stored in descending order (highest first)
+    // Offers are stored in ascending order (lowest first)
+    // Since we'll have separate maps for bids and offers, we can
+    // use a single comparator for both with is_bid() check
+    if (is_bid(lhs) && is_bid(rhs)) {
+      // For bids, higher is better (descending order)
+      return int32_t(lhs) > int32_t(rhs);
+    } else {
+      // For offers, lower is better (ascending order)
+      return int32_t(lhs) < int32_t(rhs);
+    }
+  }
+};
+
+// CRTP Base class for all oidmap implementations
+template <class T, class Derived> class oidmap_base {
+public:
+  void reserve(order_id_t const oid) {
+    static_cast<Derived *>(this)->reserve_impl(oid);
+  }
+
+  T &operator[](order_id_t const oid) {
+    return static_cast<Derived *>(this)->operator_square_impl(oid);
+  }
+
+  T *get(order_id_t const oid) {
+    return static_cast<Derived *>(this)->get_impl(oid);
+  }
+};
+
+// Vector-based implementation using CRTP
+template <class T>
+class oidmap_vector_impl : public oidmap_base<T, oidmap_vector_impl<T>> {
+public:
+  std::vector<T> m_data;
+
+  void reserve_impl(order_id_t const oid) {
+    size_t const idx = size_t(oid);
+    if (idx >= m_data.size()) {
+      m_data.resize(idx + 1);
+    }
+  }
+
+  T &operator_square_impl(order_id_t const oid) {
+    size_t const idx = size_t(oid);
+    return m_data[idx];
+  }
+
+  T *get_impl(order_id_t const oid) {
+    size_t const idx = size_t(oid);
+    return &m_data[idx];
+  }
+};
+
+// absl::flat_hash_map implementation using CRTP
+template <class T>
+class oidmap_abseil_impl : public oidmap_base<T, oidmap_abseil_impl<T>> {
+public:
+  absl::flat_hash_map<order_id_t, T> m_data;
+
+  void reserve_impl(order_id_t const oid) {
+    // No need to pre-allocate specific indices
+    (void)oid;
+  }
+
+  T &operator_square_impl(order_id_t const oid) { return m_data[oid]; }
+
+  T *get_impl(order_id_t const oid) { return &m_data[oid]; }
+};
+
+// ska::bytell_hash_map implementation using CRTP
+template <class T>
+class oidmap_ska_impl : public oidmap_base<T, oidmap_ska_impl<T>> {
+public:
+  ska::bytell_hash_map<order_id_t, T> m_data;
+
+  void reserve_impl(order_id_t const oid) {
+    (void)oid;
+    // No need to pre-allocate specific indices
+  }
+
+  T &operator_square_impl(order_id_t const oid) { return m_data[oid]; }
+
+  T *get_impl(order_id_t const oid) { return &m_data[oid]; }
+};
+
+// phmap::flat_hash_map implementation using CRTP
+template <class T>
+class oidmap_phmap_impl : public oidmap_base<T, oidmap_phmap_impl<T>> {
+public:
+  phmap::flat_hash_map<order_id_t, T> m_data;
+
+  void reserve_impl(order_id_t const oid) {
+    (void)oid;
+    // No need to pre-allocate specific indices
+  }
+
+  T &operator_square_impl(order_id_t const oid) { return m_data[oid]; }
+
+  T *get_impl(order_id_t const oid) { return &m_data[oid]; }
+};
+
+// Type alias to select appropriate implementation based on config
+template <class T>
+using oidmap = std::conditional_t<
+    kOrderBookConfig::oidMapImpl == OrderStoreImplementation::VECTOR,
+    oidmap_vector_impl<T>,
+    std::conditional_t<
+        kOrderBookConfig::oidMapImpl == OrderStoreImplementation::ABSEIL_MAP,
+        oidmap_abseil_impl<T>,
+        std::conditional_t<kOrderBookConfig::oidMapImpl ==
+                               OrderStoreImplementation::SKA_MAP,
+                           oidmap_ska_impl<T>, oidmap_phmap_impl<T>>>>;
+
+qty_t operator+(qty_t const a, qty_t const b) {
+  return qty_t(MKPRIMITIVE(a) + MKPRIMITIVE(b));
+}
+
+// Define container traits and helper methods for different implementations
+// to avoid invalid method calls in if constexpr branches
+template <LevelContainerType T> struct level_container_traits {};
+
+// Specialization for BTREE_MAP container type
+template <> struct level_container_traits<LevelContainerType::BTREE_MAP> {
+  using bid_levels_t =
+      phmap::btree_map<sprice_t, level_id_t, sprice_comparator>;
+  using offer_levels_t = phmap::btree_map<sprice_t, level_id_t>;
+
+  // Find level in a btree map
+  static bool find_bid_level(const bid_levels_t &levels, sprice_t price,
+                             level_id_t &level_idx) {
+    auto it = levels.find(price);
+    if (it != levels.end()) {
+      level_idx = it->second;
+      return true;
+    }
+    return false;
+  }
+
+  static bool find_offer_level(const offer_levels_t &levels, sprice_t price,
+                               level_id_t &level_idx) {
+    auto it = levels.find(price);
+    if (it != levels.end()) {
+      level_idx = it->second;
+      return true;
+    }
+    return false;
+  }
+
+  // Add a new level to a btree map
+  static void add_bid_level(bid_levels_t &levels, sprice_t price,
+                            level_id_t level_idx) {
+    levels.emplace(price, level_idx);
+  }
+
+  static void add_offer_level(offer_levels_t &levels, sprice_t price,
+                              level_id_t level_idx) {
+    levels.emplace(price, level_idx);
+  }
+
+  // Remove a level from a btree map
+  static void remove_bid_level(bid_levels_t &levels, sprice_t price) {
+    levels.erase(price);
+  }
+
+  static void remove_offer_level(offer_levels_t &levels, sprice_t price) {
+    levels.erase(price);
+  }
+};
+
+// Specialization for SORTED_VECTOR container type
+template <> struct level_container_traits<LevelContainerType::SORTED_VECTOR> {
+  using level_entry_t = std::pair<sprice_t, level_id_t>;
+  using bid_levels_t = std::vector<level_entry_t>;
+  using offer_levels_t = std::vector<level_entry_t>;
+
+  // Find level using binary search in a sorted vector
+  static bool find_bid_level(const bid_levels_t &levels, sprice_t price,
+                             level_id_t &level_idx) {
+    auto it = std::lower_bound(levels.begin(), levels.end(), price,
+                               [](const level_entry_t &entry, sprice_t p) {
+                                 return int32_t(entry.first) >
+                                        int32_t(p); // Descending order for bids
+                               });
+
+    if (it != levels.end() && it->first == price) {
+      level_idx = it->second;
+      return true;
+    }
+    return false;
+  }
+
+  static bool find_offer_level(const offer_levels_t &levels, sprice_t price,
+                               level_id_t &level_idx) {
+    auto it =
+        std::lower_bound(levels.begin(), levels.end(), price,
+                         [](const level_entry_t &entry, sprice_t p) {
+                           return int32_t(entry.first) <
+                                  int32_t(p); // Ascending order for offers
+                         });
+
+    if (it != levels.end() && it->first == price) {
+      level_idx = it->second;
+      return true;
+    }
+    return false;
+  }
+
+  // Add a new level to a sorted vector
+  static void add_bid_level(bid_levels_t &levels, sprice_t price,
+                            level_id_t level_idx) {
+    auto it = std::lower_bound(levels.begin(), levels.end(), price,
+                               [](const level_entry_t &entry, sprice_t p) {
+                                 return int32_t(entry.first) >
+                                        int32_t(p); // Descending
+                               });
+
+    levels.insert(it, std::make_pair(price, level_idx));
+  }
+
+  static void add_offer_level(offer_levels_t &levels, sprice_t price,
+                              level_id_t level_idx) {
+    auto it = std::lower_bound(levels.begin(), levels.end(), price,
+                               [](const level_entry_t &entry, sprice_t p) {
+                                 return int32_t(entry.first) <
+                                        int32_t(p); // Ascending
+                               });
+
+    levels.insert(it, std::make_pair(price, level_idx));
+  }
+
+  // Remove a level from a sorted vector
+  static void remove_bid_level(bid_levels_t &levels, sprice_t price) {
+    auto it = std::lower_bound(levels.begin(), levels.end(), price,
+                               [](const level_entry_t &entry, sprice_t p) {
+                                 return int32_t(entry.first) >
+                                        int32_t(p); // Descending
+                               });
+
+    if (it != levels.end() && it->first == price) {
+      levels.erase(it);
+    }
+  }
+
+  static void remove_offer_level(offer_levels_t &levels, sprice_t price) {
+    auto it = std::lower_bound(levels.begin(), levels.end(), price,
+                               [](const level_entry_t &entry, sprice_t p) {
+                                 return int32_t(entry.first) <
+                                        int32_t(p); // Ascending
+                               });
+
+    if (it != levels.end() && it->first == price) {
+      levels.erase(it);
+    }
+  }
+};
+
+// Simplify accessing the correct trait for the configured container type
+using level_traits =
+    level_container_traits<kOrderBookConfig::levelContainerImpl>;
+
+class order_book {
+public:
+  static constexpr size_t MAX_BOOKS = 1 << 14;
+  static constexpr size_t NUM_LEVELS = 1 << 20;
+  static order_book *s_books; // can we allocate this on the stack?
+  static oidmap<order_t> oid_map;
+  using level_vector = pool<level, level_id_t, NUM_LEVELS>;
+
+  // Define map and vector types
+  using bid_btree_t = phmap::btree_map<sprice_t, level_id_t, sprice_comparator>;
+  using offer_btree_t = phmap::btree_map<sprice_t, level_id_t>;
+  using level_entry_t =
+      std::pair<sprice_t, level_id_t>; // Pair price with level ID
+  using bid_vector_t = std::vector<level_entry_t>;
+  using offer_vector_t = std::vector<level_entry_t>;
+
+  // Select types based on config
+  using bid_levels_t =
+      std::conditional_t<kOrderBookConfig::levelContainerImpl ==
+                             LevelContainerType::BTREE_MAP,
+                         bid_btree_t, bid_vector_t>;
+  using offer_levels_t =
+      std::conditional_t<kOrderBookConfig::levelContainerImpl ==
+                             LevelContainerType::BTREE_MAP,
+                         offer_btree_t, offer_vector_t>;
+
+  // A global allocator for all the price levels allocated by all the books.
+  static level_vector s_levels;
+
+  // Store bids and offers in the configured container type
+  bid_levels_t
+      m_bids; // Sorted descending by price (vector) or highest first (map)
+  offer_levels_t
+      m_offers; // Sorted ascending by price (vector) or lowest first (map)
+
+  using level_ptr_t = level_vector::__ptr;
+
+  static void add_order(order_id_t const oid, book_id_t const book_idx,
+                        sprice_t const price, qty_t const qty) {
+    oid_map.reserve(oid);
+    order *order = oid_map.get(oid);
+    order->m_qty = qty;
+    order->book_idx = book_idx;
+
+    s_books[size_t(book_idx)].ADD_ORDER(order, price, qty, oid);
+  }
+
+  void ADD_ORDER(order_t *order, sprice_t const price, qty_t const qty,
+                 order_id_t oid) {
+    level_id_t existing_level_idx;
+    bool found_level = false;
+
+    // Check if level already exists
+    if (is_bid(price)) {
+      found_level =
+          level_traits::find_bid_level(m_bids, price, existing_level_idx);
+    } else {
+      found_level =
+          level_traits::find_offer_level(m_offers, price, existing_level_idx);
+    }
+
+    // Existing level, update it
+    if (found_level) {
+      order->level_idx = existing_level_idx;
+    } else {
+      // Create new level
+      order->level_idx = s_levels.alloc();
+      s_levels[order->level_idx].m_qty = qty_t(0);
+      s_levels[order->level_idx].m_price = price;
+
+      // Add to appropriate container
+      if (is_bid(price)) {
+        level_traits::add_bid_level(m_bids, price, order->level_idx);
+      } else {
+        level_traits::add_offer_level(m_offers, price, order->level_idx);
+      }
+    }
+
+    // Update quantity at the level
+    s_levels[order->level_idx].m_qty = s_levels[order->level_idx].m_qty + qty;
+
+    // Add order to level if tracking orders
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      s_levels[order->level_idx].add_order(oid, qty);
+    }
+  }
+
+  static void delete_order(order_id_t const oid) {
+    order_t *order = oid_map.get(oid);
+    s_books[size_t(order->book_idx)].DELETE_ORDER(order, oid);
+  }
+  static void cancel_order(order_id_t const oid, qty_t const qty) {
+    order_t *order = oid_map.get(oid);
+    s_books[size_t(order->book_idx)].REDUCE_ORDER(order, qty, oid);
+  }
+  // shared between cancel(aka partial cancel aka reduce) and execute
+  void REDUCE_ORDER(order_t *order, qty_t const qty, order_id_t oid) {
+    auto tmp = MKPRIMITIVE(s_levels[order->level_idx].m_qty);
+    tmp -= MKPRIMITIVE(qty);
+    s_levels[order->level_idx].m_qty = qty_t(tmp);
+
+    tmp = MKPRIMITIVE(order->m_qty);
+    tmp -= MKPRIMITIVE(qty);
+    order->m_qty = qty_t(tmp);
+
+    // Update the order in the level's order map
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      s_levels[order->level_idx].reduce_order(oid, qty);
+    }
+  }
+  // shared between delete and execute
+  void DELETE_ORDER(order_t *order, order_id_t oid) {
+    assert(MKPRIMITIVE(s_levels[order->level_idx].m_qty) >=
+           MKPRIMITIVE(order->m_qty));
+    auto tmp = MKPRIMITIVE(s_levels[order->level_idx].m_qty);
+    tmp -= MKPRIMITIVE(order->m_qty);
+    level_id_t level_idx_to_free = order->level_idx;
+    s_levels[level_idx_to_free].m_qty = qty_t(tmp);
+
+    // Remove order from tracking if enabled
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      s_levels[level_idx_to_free].delete_order(oid);
+    }
+
+    // If level is now empty, remove it
+    if (qty_t(0) == s_levels[level_idx_to_free].m_qty) {
+      sprice_t price = s_levels[level_idx_to_free].m_price;
+
+      // Remove level from appropriate container
+      if (is_bid(price)) {
+        level_traits::remove_bid_level(m_bids, price);
+      } else {
+        level_traits::remove_offer_level(m_offers, price);
+      }
+
+      // Free the level
+      s_levels.free(level_idx_to_free);
+    }
+  }
+
+  static void execute_order(order_id_t const oid, qty_t const qty) {
+    order_t *order = oid_map.get(oid);
+    order_book *book = &s_books[MKPRIMITIVE(order->book_idx)];
+
+    if (qty == order->m_qty) {
+      book->DELETE_ORDER(order, oid);
+    } else {
+      book->REDUCE_ORDER(order, qty, oid);
+    }
+  }
+  static void replace_order(order_id_t const old_oid, order_id_t const new_oid,
+                            qty_t const new_qty, sprice_t new_price) {
+    order_t *order = oid_map.get(old_oid);
+    order_book *book = &s_books[MKPRIMITIVE(order->book_idx)];
+    bool const bid = is_bid(book->s_levels[order->level_idx].m_price);
+    book->DELETE_ORDER(order, old_oid);
+    if (!bid) {
+      new_price = sprice_t(-1 * MKPRIMITIVE(new_price));
+    }
+    book->add_order(new_oid, order->book_idx, new_price, new_qty);
+  }
+
+  // Helper method to get number of orders at a specific price
+  size_t orders_at_price(sprice_t price) const {
+    level_id_t level_idx;
+    bool found = false;
+
+    // Find the level
+    if (is_bid(price)) {
+      found = level_traits::find_bid_level(m_bids, price, level_idx);
+    } else {
+      found = level_traits::find_offer_level(m_offers, price, level_idx);
+    }
+
+    // Return count based on mode and if found
+    if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+      return found ? s_levels[level_idx].order_count() : 0;
+    } else {
+      return found ? 1 : 0; // Just check if level exists
+    }
+  }
+
+  // Helper to iterate through orders at a specific price level
+  template <typename Func>
+  void for_each_order_at_price(sprice_t price, Func func) const {
+    level_id_t level_idx;
+    bool found = false;
+
+    // Find the level
+    if (is_bid(price)) {
+      found = level_traits::find_bid_level(m_bids, price, level_idx);
+    } else {
+      found = level_traits::find_offer_level(m_offers, price, level_idx);
+    }
+
+    // Iterate through orders if level found
+    if (found) {
+      const level &lvl = s_levels[level_idx];
+      if constexpr (kOrderBookConfig::TRACK_ORDERS_IN_LEVEL) {
+        // L3 mode: Iterate through individual orders
+        for (const auto &entry : lvl.m_orders) {
+          if (!entry.deleted) {
+            func(entry.oid, entry.qty, entry.timestamp);
+          }
+        }
+      } else {
+        // L2 mode: Call once with aggregate qty
+        func(order_id_t(0), lvl.m_qty, timestamp_t(0));
+      }
+    }
+  }
+};
+
+oidmap<order_t> order_book::oid_map = oidmap<order_t>();
+order_book *order_book::s_books = new order_book[order_book::MAX_BOOKS];
+order_book::level_vector order_book::s_levels = level_vector();
