+      Order new_order{new_id, replace_order->new_price()->value(),
+                      replace_order->new_qty()->shares(), side, symbol};
+
+      order_store[new_index] = std::move(new_order);
+    }
+    break;
+  }
+  default:
+    // Other message types don't affect the order store
+    break;
+  }
