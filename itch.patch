+int main(int argc, char *argv[]) {
+  const char *input_path = nullptr;
+  int opt;
+
+  while ((opt = getopt(argc, argv, "i:")) != -1) {
+    switch (opt) {
+    case 'i':
+      input_path = optarg;
+      break;
+    case '?':
+    default:
+      itch_parser::print_usage(argv[0]);
+      return 1;
+    }
+  }
+
+  if (!input_path) {
+    fmt::print(stderr, "Error: Input file path (-i) is required.\n");
+    itch_parser::print_usage(argv[0]);
+    return 1;
+  }
+
+  // Run baseline first (just verification, no decoding)
+  double no_decoding_ns_per_op =
+      itch_parser::load_flatbuffers_no_decoding(input_path);
+  if (no_decoding_ns_per_op < 0) {
+    return 1;
+  }
+
+  // Run all other functions and compare performance
+  double no_store_ns_per_op =
+      itch_parser::load_flatbuffers_no_store(input_path);
+  if (no_store_ns_per_op < 0) {
+    return 1;
