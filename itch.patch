+  }
+  case Itch::ItchMessage_ExecuteOrder: {
+    auto execute_order = static_cast<const Itch::ExecuteOrder *>(msg_ptr);
+    if (execute_order->oid() && execute_order->qty()) {
+      uint64_t order_id = execute_order->oid()->id();
+      size_t index = static_cast<size_t>(order_id);
+
+      if (index < order_store.size() && order_store[index].has_value()) {
+        // Reduce quantity
+        uint32_t executed_qty = execute_order->qty()->shares();
+        if (executed_qty >= order_store[index]->quantity) {
+          // Order fully executed, remove it
+          order_store[index].reset();
+        } else {
+          // Order partially executed, update quantity
+          order_store[index]->quantity -= executed_qty;
+        }
+      }
+    }
+    break;
+  }
+  case Itch::ItchMessage_ExecuteOrderWithPrice: {
+    auto execute_with_price =
+        static_cast<const Itch::ExecuteOrderWithPrice *>(msg_ptr);
+    if (execute_with_price->execute_order() &&
+        execute_with_price->execute_order()->oid() &&
+        execute_with_price->execute_order()->qty()) {
+      uint64_t order_id = execute_with_price->execute_order()->oid()->id();
+      size_t index = static_cast<size_t>(order_id);
+
+      if (index < order_store.size() && order_store[index].has_value()) {
+        // Reduce quantity
+        uint32_t executed_qty =
+            execute_with_price->execute_order()->qty()->shares();
+        if (executed_qty >= order_store[index]->quantity) {
+          // Order fully executed, remove it
+          order_store[index].reset();
+        } else {
+          // Order partially executed, update quantity
+          order_store[index]->quantity -= executed_qty;
+        }
+      }
+    }
+    break;
+  }
+  case Itch::ItchMessage_ReduceOrder: {
+    auto reduce_order = static_cast<const Itch::ReduceOrder *>(msg_ptr);
+    if (reduce_order->oid() && reduce_order->qty()) {
+      uint64_t order_id = reduce_order->oid()->id();
+      size_t index = static_cast<size_t>(order_id);
+
+      if (index < order_store.size() && order_store[index].has_value()) {
+        // Reduce quantity
+        uint32_t reduced_qty = reduce_order->qty()->shares();
+        if (reduced_qty >= order_store[index]->quantity) {
+          // Order fully canceled, remove it
+          order_store[index].reset();
+        } else {
+          // Order partially canceled, update quantity
+          order_store[index]->quantity -= reduced_qty;
+        }
+      }
+    }
+    break;
+  }
+  case Itch::ItchMessage_DeleteOrder: {
+    auto delete_order = static_cast<const Itch::DeleteOrder *>(msg_ptr);
+    if (delete_order->oid()) {
+      uint64_t order_id = delete_order->oid()->id();
+      size_t index = static_cast<size_t>(order_id);
+
+      if (index < order_store.size()) {
+        order_store[index].reset();
+      }
+    }
+    break;
+  }
+  case Itch::ItchMessage_ReplaceOrder: {
+    auto replace_order = static_cast<const Itch::ReplaceOrder *>(msg_ptr);
+    if (replace_order->original_oid() && replace_order->new_oid() &&
+        replace_order->new_qty() && replace_order->new_price()) {
+      // Get indices
+      uint64_t original_id = replace_order->original_oid()->id();
+      size_t original_index = static_cast<size_t>(original_id);
+      uint64_t new_id = replace_order->new_oid()->id();
+      size_t new_index = static_cast<size_t>(new_id);
+
+      // Default values for side and symbol
+      Itch::BuySell side = Itch::BuySell_Unknown;
+      std::string symbol = "";
+
+      // If we found the original order, copy its side and symbol
+      if (original_index < order_store.size() &&
+          order_store[original_index].has_value()) {
+        side = order_store[original_index]->side;
+        symbol = order_store[original_index]->symbol;
+
+        // Remove original order
+        order_store[original_index].reset();
+      }
+
+      // Resize if needed for new order
+      if (new_index >= order_store.size()) {
+        order_store.resize(new_index + 1);
