+++ b/itch-order-book/src/load_fbs.cpp
@@ -0,0 +1,1254 @@
+// load_fbs.cpp
+
+#include <fb_schema/schema_itch_generated.h> // FlatBuffers generated code
+#include <flatbuffers/flatbuffers.h>         // FlatBuffers runtime
+
+#include <parallel_hashmap/phmap.h> // For phmap::flat_hash_map
+#include <chrono>                   // For timing
+#include <fmt/core.h>
+#include <fstream>   // For std::ifstream
+#include <getopt.h>  // For command line parsing
+#include <iomanip>   // For std::setw
+#include <iostream>  // For std::cerr, std::cout
+#include <optional>  // For std::optional in vector-based store
+#include <stdexcept> // For std::runtime_error
+#include <string>
+#include <unordered_map> // For message type stats and order store
+#include <variant>       // For std::monostate
+#include <vector>
+
+namespace itch_parser {
+
+// Define Order struct to store order information
+struct Order {
+  uint64_t order_id;
+  uint32_t price_value; // Raw price value
+  uint32_t quantity;
+  Itch::BuySell side;
+  std::string symbol;
+};
+
+// Define OrderStore type for tracking orders
+using OrderStore = std::unordered_map<uint64_t, Order>;
+// Define OrderStoreDense type using phmap::flat_hash_map
+using OrderStoreDense = phmap::flat_hash_map<uint64_t, Order>;
+// Define OrderStoreVector type using std::vector<std::optional<Order>>
+using OrderStoreVector = std::vector<std::optional<Order>>;
+
+// Helper function to convert a hex character to its integer value
+inline uint8_t hex_char_to_byte(char c) {
+  if (c >= '0' && c <= '9')
+    return c - '0';
+  if (c >= 'a' && c <= 'f')
+    return c - 'a' + 10;
+  if (c >= 'A' && c <= 'F')
+    return c - 'A' + 10;
+  throw std::runtime_error(fmt::format("Invalid hex character: {}", c));
+}
+
+// Helper function to convert a hex string to a byte vector
+std::vector<uint8_t> hex_string_to_bytes(const std::string &hex_str) {
+  if (hex_str.length() % 2 != 0) {
+    throw std::runtime_error(
+        "Hex string must have an even number of characters.");
+  }
+  std::vector<uint8_t> bytes;
+  bytes.reserve(hex_str.length() / 2);
+  for (size_t i = 0; i < hex_str.length(); i += 2) {
+    bytes.push_back((hex_char_to_byte(hex_str[i]) << 4) |
+                    hex_char_to_byte(hex_str[i + 1]));
+  }
+  return bytes;
+}
+
+// Global counter to limit printing to first 2 messages
+static size_t processed_msg_count = 0;
+static const size_t max_messages_to_print = 2;
+
+// Struct to hold timing statistics for each message type
+struct MessageStats {
+  std::string name;
+  size_t count = 0;
+  uint64_t total_ns = 0;
+
+  double avg_ns() const {
+    return count > 0 ? static_cast<double>(total_ns) / count : 0.0;
+  }
+};
+
+// Map to store stats for each message type
+static std::unordered_map<Itch::ItchMessage, MessageStats> message_stats;
+
+// Helper to get message type name
+std::string get_message_type_name(Itch::ItchMessage msg_type) {
+  return Itch::EnumNameItchMessage(msg_type);
+}
+
+// --- Printing Helper Functions for FlatBuffer Structs ---
+
+void print_timestamp(const Itch::Timestamp *ts) {
+  if (ts) {
+    fmt::print("  Timestamp (ns): {}\n", ts->nanoseconds());
+  }
+}
+
+void print_oid(const Itch::Oid *oid) {
+  if (oid) {
+    fmt::print("  OID: {}\n", oid->id());
+  }
+}
+
+void print_price(const Itch::Price *price) {
+  if (price) {
+    // Assuming price needs scaling (e.g., by 10000 for ITCH)
+    fmt::print("  Price: {} (raw: {})\n",
+               static_cast<double>(price->value()) / 10000.0, price->value());
+  }
+}
+
+void print_qty(const Itch::Qty *qty) {
+  if (qty) {
+    fmt::print("  Quantity: {}\n", qty->shares());
+  }
+}
+
+void print_add_order(const Itch::AddOrder *msg) {
+  fmt::print("--- Add Order ---\n");
+  fmt::print("  Stock Locate: {}\n", msg->stock_locate());
+  print_timestamp(msg->timestamp());
+  print_oid(msg->oid());
+  fmt::print("  Buy/Sell: {}\n", Itch::EnumNameBuySell(msg->buy_sell()));
+  print_qty(msg->qty());
+  fmt::print("  Stock Symbol: {}\n",
+             msg->stock_symbol() ? msg->stock_symbol()->str() : "N/A");
+  print_price(msg->price());
+}
+
+void print_add_order_mpid(const Itch::AddOrderMpid *msg) {
+  fmt::print("--- Add Order MPID ---\n");
+  if (msg->add_order()) {
+    print_add_order(msg->add_order()); // Reuse AddOrder printing
+  }
+  fmt::print("  MPID: {}\n", msg->mpid() ? msg->mpid()->str() : "N/A");
+}
+
+void print_execute_order(const Itch::ExecuteOrder *msg) {
+  fmt::print("--- Execute Order ---\n");
+  fmt::print("  Stock Locate: {}\n", msg->stock_locate());
+  print_timestamp(msg->timestamp());
+  print_oid(msg->oid());
+  print_qty(msg->qty());
+  fmt::print("  Match Number: {}\n", msg->match_number());
+}
+
+void print_execute_order_with_price(const Itch::ExecuteOrderWithPrice *msg) {
+  fmt::print("--- Execute Order With Price ---\n");
+  if (msg->execute_order()) {
+    print_execute_order(msg->execute_order()); // Reuse ExecuteOrder printing
+  }
+  fmt::print("  Printable: {}\n", msg->printable());
+  print_price(msg->price());
+  fmt::print("  Match Number: {}\n",
+             msg->match_number()); // Often redundant, but in schema
+}
+
+void print_reduce_order(const Itch::ReduceOrder *msg) {
+  fmt::print("--- Reduce Order (Cancel) ---\n");
+  fmt::print("  Stock Locate: {}\n", msg->stock_locate());
+  print_timestamp(msg->timestamp());
+  print_oid(msg->oid());
+  fmt::print("  New Quantity: {}\n", msg->qty() ? msg->qty()->shares() : 0);
+}
+
+void print_delete_order(const Itch::DeleteOrder *msg) {
+  fmt::print("--- Delete Order ---\n");
+  fmt::print("  Stock Locate: {}\n", msg->stock_locate());
+  print_timestamp(msg->timestamp());
+  print_oid(msg->oid());
+}
+
+void print_replace_order(const Itch::ReplaceOrder *msg) {
+  fmt::print("--- Replace Order ---\n");
+  fmt::print("  Stock Locate: {}\n", msg->stock_locate());
+  print_timestamp(msg->timestamp());
+  fmt::print("  Original OID: {}\n",
+             msg->original_oid() ? msg->original_oid()->id() : 0);
+  fmt::print("  New OID: {}\n", msg->new_oid() ? msg->new_oid()->id() : 0);
+  fmt::print("  New Quantity: {}\n",
+             msg->new_qty() ? msg->new_qty()->shares() : 0);
+  print_price(msg->new_price());
+}
+
+// --- End Printing Helpers ---
+
+// Function to handle order store operations based on message type
+void add_order_store(Itch::ItchMessage msg_type, const void *msg_ptr,
+                     OrderStore &order_store) {
+  switch (msg_type) {
+  case Itch::ItchMessage_AddOrder: {
+    auto add_order = static_cast<const Itch::AddOrder *>(msg_ptr);
+    if (add_order->oid() && add_order->qty() && add_order->price()) {
+      uint64_t order_id = add_order->oid()->id();
+      Order new_order{
+          order_id, add_order->price()->value(), add_order->qty()->shares(),
+          add_order->buy_sell(),
