+static sprice_t mksigned(price_t price, BUY_SELL buy) {
+  assert(MKPRIMITIVE(price) < std::numeric_limits<int32_t>::max());
+  auto ret = MKPRIMITIVE(price);
+  if (BUY_SELL::SELL == buy)
