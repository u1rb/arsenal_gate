+void print_usage(const char *prog_name) {
+  fmt::print(stderr, "Usage: {} -i <input_hex_fbs_file>\n", prog_name);
+  fmt::print(stderr,
+             "  -i <input_hex_fbs_file>: Path to the input file containing "
+             "hex-encoded FlatBuffers per line (required).\n");
+}
+
+// Core template function for processing flatbuffers
+template <typename State, typename ProcessFunc, typename ReportFunc>
+double load_and_process_template(const char *input_path,
+                                 const std::string &description,
+                                 State init_state, bool reset_counters,
+                                 ProcessFunc process_func,
+                                 ReportFunc report_func) {
+
+  fmt::print("\n[{}]\n", description);
+  fmt::print("Reading FlatBuffers messages from: {}\n", input_path);
+
+  std::ifstream input_file(input_path);
+  if (!input_file) {
+    fmt::print(stderr, "Error opening input file: {}\n", input_path);
+    return -1.0;
+  }
+
+  // Reset counters if needed
+  if (reset_counters) {
+    processed_msg_count = 0;
+  }
+
+  // State for processing
+  State state = init_state;
+
+  // Start timing
+  auto start_time = std::chrono::high_resolution_clock::now();
+
+  std::string hex_line;
+  size_t line_num = 0;
+  size_t total_processed = 0;
+
+  while (std::getline(input_file, hex_line)) {
+    line_num++;
+    if (hex_line.empty())
+      continue; // Skip empty lines
+
+    try {
+      std::vector<uint8_t> byte_buffer = hex_string_to_bytes(hex_line);
+      if (!byte_buffer.empty()) {
+        process_func(byte_buffer.data(), byte_buffer.size(), line_num, state);
+        total_processed++;
+      }
+    } catch (const std::runtime_error &e) {
+      fmt::print(stderr, "Error processing line {}: {}\n", line_num, e.what());
+    }
+  }
+
+  // End timing
+  auto end_time = std::chrono::high_resolution_clock::now();
+  auto total_duration = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                            end_time - start_time)
+                            .count();
+
+  // Calculate ns per operation
+  double ns_per_op = total_processed > 0
+                         ? static_cast<double>(total_duration) / total_processed
+                         : 0.0;
+
+  // Report results
+  report_func(total_processed, total_duration, ns_per_op, state);
+
+  return ns_per_op;
+}
+
+// Function to load and process flatbuffers file without any decoding (just
+// verification)
+double load_flatbuffers_no_decoding(const char *input_path) {
+  return load_and_process_template<std::monostate>(
+      input_path, "Running with No Decoding - Just Verification",
+      std::monostate{},
+      false, // Don't reset counters for this mode
+
+      // Process function
+      [](const uint8_t *buffer, size_t size, size_t line_num,
+         std::monostate &) {
+        process_fbs_buffer_no_decoding(buffer, size, line_num);
+      },
+
+      // Report function
+      [](size_t total_processed, uint64_t total_duration, double ns_per_op,
+         const std::monostate &) {
+        fmt::print("Finished processing {} messages.\n", total_processed);
+        fmt::print("Processing time: {:.2f} ms ({} ns)\n",
+                   total_duration / 1000000.0, total_duration);
+        fmt::print("Performance: {:.2f} ns/op\n", ns_per_op);
+      });
+}
