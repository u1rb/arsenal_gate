+      },
+
+      // Report function
+      [](size_t total_processed, uint64_t total_duration, double ns_per_op,
+         const OrderStoreVector &order_store) {
+        fmt::print("Finished processing {} messages (printed first {}).\n",
+                   total_processed,
+                   std::min(total_processed, max_messages_to_print));
+        fmt::print("Processing time: {:.2f} ms ({} ns)\n",
+                   total_duration / 1000000.0, total_duration);
+        fmt::print("Performance: {:.2f} ns/op\n", ns_per_op);
+
+        // Count active orders (non-nullopt elements)
+        size_t active_orders = 0;
+        for (const auto &opt_order : order_store) {
+          if (opt_order.has_value()) {
+            active_orders++;
+          }
+        }
+
+        fmt::print("Order store final size: {} (vector capacity: {}, active "
+                   "orders: {})\n",
+                   order_store.size(), order_store.capacity(), active_orders);
+      });
+}
