+
+  double with_store_ns_per_op = itch_parser::load_flatbuffers(input_path);
+  if (with_store_ns_per_op < 0) {
+    return 1;
+  }
+
+  double with_dense_store_ns_per_op =
+      itch_parser::load_flatbuffers_dense(input_path);
+  if (with_dense_store_ns_per_op < 0) {
+    return 1;
+  }
+
+  double with_vector_store_ns_per_op =
+      itch_parser::load_flatbuffers_vector(input_path);
+  if (with_vector_store_ns_per_op < 0) {
+    return 1;
+  }
+
+  // Calculate and print the performance differences
+  fmt::print("\n[Performance Comparison]\n");
+  fmt::print("Just verification (no decoding):           {:.2f} ns/op\n",
+             no_decoding_ns_per_op);
+  fmt::print("Without order store:                       {:.2f} ns/op\n",
+             no_store_ns_per_op);
+  fmt::print("With std::unordered_map:                   {:.2f} ns/op\n",
+             with_store_ns_per_op);
+  fmt::print("With phmap::flat_hash_map:                 {:.2f} ns/op\n",
+             with_dense_store_ns_per_op);
+  fmt::print("With std::vector:                          {:.2f} ns/op\n",
+             with_vector_store_ns_per_op);
+
+  fmt::print("\n[Overhead Analysis vs. No Decoding]\n");
+
+  double decode_overhead_ns = no_store_ns_per_op - no_decoding_ns_per_op;
+  double decode_overhead_percent =
+      (decode_overhead_ns / no_decoding_ns_per_op) * 100.0;
+  fmt::print(
+      "Message decoding overhead:                 +{:.2f} ns/op (+{:.2f}%)\n",
+      decode_overhead_ns, decode_overhead_percent);
+
+  double std_total_overhead_ns = with_store_ns_per_op - no_decoding_ns_per_op;
+  double std_total_overhead_percent =
+      (std_total_overhead_ns / no_decoding_ns_per_op) * 100.0;
+  fmt::print(
+      "std::unordered_map total overhead:         +{:.2f} ns/op (+{:.2f}%)\n",
+      std_total_overhead_ns, std_total_overhead_percent);
+
+  double dense_total_overhead_ns =
+      with_dense_store_ns_per_op - no_decoding_ns_per_op;
+  double dense_total_overhead_percent =
