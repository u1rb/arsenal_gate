+#!/bin/bash
+set -uexo pipefail
+
+# --- Configuration ---
+SCRIPT_DIR=`dirname $0`
+BUILD_DIR="$SCRIPT_DIR/build"
+OUTPUT_FILE="output_flatbuffers.hex"  # This should match output file in run.sh
+# --- End Configuration ---
+
+# Configure
+mkdir -p "$BUILD_DIR"
+cmake -S "$SCRIPT_DIR" -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Release -G Ninja -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
+
+
+# Build
+cmake --build "$BUILD_DIR" --target load_fbs --config Release
+
+# Check if output file exists
+if [ ! -f "$BUILD_DIR/$OUTPUT_FILE" ]; then
+  echo "Error: FlatBuffers output file not found: $BUILD_DIR/$OUTPUT_FILE"
+  echo "Please run './run.sh' with DUMP_MODE=true first to generate the file."
+  exit 1
+fi
+
+# Run
+echo "Running load_fbs..."
+cd "$BUILD_DIR" # Run from build directory
+time ./load_fbs -i "$OUTPUT_FILE"
+
+echo "Finished processing FlatBuffers file." 
