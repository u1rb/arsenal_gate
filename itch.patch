+    auto fb_buysell = map_buysell(pkt.buy);
+    auto add_order_offset =
+        Itch::CreateAddOrder(builder, pkt.stock_locate, fb_ts, fb_oid,
+                             fb_buysell, fb_qty, fb_stock_symbol, fb_price);
+    auto msg_offset = Itch::CreateMessageContainer(
+        builder, Itch::ItchMessage_AddOrder, add_order_offset.Union());
+    builder.Finish(msg_offset);
+    if constexpr (kConst::WRITE_TO_FILE) {
+      if constexpr (kConst::OUTPUT_HEX) {
+        print_hex_fmt(output_buffer, builder.GetBufferPointer(),
+                      builder.GetSize());
+      } else {
+        write_raw_bytes(output_buffer, builder.GetBufferPointer(),
+                        builder.GetSize());
+      }
+    }
+  } else if constexpr (kConst::WRITE_TO_FILE) {
+    output_buffer.push_back('\n');
+  }
+}
