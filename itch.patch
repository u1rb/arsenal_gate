+// Process FBS buffer with vector order store
+void process_fbs_buffer_vector(const uint8_t *buffer_ptr, size_t size,
+                               size_t line_num, OrderStoreVector &order_store) {
+  flatbuffers::Verifier verifier(buffer_ptr, size);
+  if (!Itch::VerifyMessageContainerBuffer(verifier)) {
+    fmt::print(stderr,
+               "Error: Invalid FlatBuffers message on line {}. Skipping.\n",
+               line_num);
+    return;
+  }
+
+  auto container = flatbuffers::GetRoot<Itch::MessageContainer>(buffer_ptr);
+  auto msg_type = container->message_type();
+  const void *msg_ptr = container->message();
+
+  if (!msg_ptr) {
+    fmt::print(stderr, "Warning: Null message payload on line {}.\n", line_num);
+    return;
+  }
+
+  // Process the message for order store - do this for all messages
+  add_order_store_vector(msg_type, msg_ptr, order_store);
+
+  // Only print if we haven't reached the maximum number of messages to print
+  bool should_print = (processed_msg_count < max_messages_to_print);
+  if (should_print) {
+    processed_msg_count++;
+
+    switch (msg_type) {
+    case Itch::ItchMessage_AddOrder:
+      print_add_order(static_cast<const Itch::AddOrder *>(msg_ptr));
+      break;
+    case Itch::ItchMessage_AddOrderMpid:
+      print_add_order_mpid(static_cast<const Itch::AddOrderMpid *>(msg_ptr));
+      break;
+    case Itch::ItchMessage_ExecuteOrder:
+      print_execute_order(static_cast<const Itch::ExecuteOrder *>(msg_ptr));
+      break;
+    case Itch::ItchMessage_ExecuteOrderWithPrice:
+      print_execute_order_with_price(
+          static_cast<const Itch::ExecuteOrderWithPrice *>(msg_ptr));
+      break;
+    case Itch::ItchMessage_ReduceOrder:
+      print_reduce_order(static_cast<const Itch::ReduceOrder *>(msg_ptr));
+      break;
+    case Itch::ItchMessage_DeleteOrder:
+      print_delete_order(static_cast<const Itch::DeleteOrder *>(msg_ptr));
+      break;
+    case Itch::ItchMessage_ReplaceOrder:
+      print_replace_order(static_cast<const Itch::ReplaceOrder *>(msg_ptr));
+      break;
+    case Itch::ItchMessage_NONE:
+      fmt::print(stderr, "Warning: NONE message type encountered on line {}.\n",
+                 line_num);
+      break;
+    default:
+      fmt::print("--- Unhandled Message Type: {} ---\n",
+                 Itch::EnumNameItchMessage(msg_type));
+      break;
+    }
+    fmt::print("\n"); // Separator between messages
+  }
+}
