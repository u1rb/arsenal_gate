+
+// Helper to print buffer as hex using fmt, appending to a memory buffer
+// Uses a lookup table for faster hex conversion.
+void print_hex_fmt(fmt::memory_buffer &buf, const uint8_t *buffer,
+                   size_t size) {
+  static constexpr char hex_chars[] = "0123456789abcdef";
+  buf.reserve(buf.size() + size * 2 + 1);
+
+  for (size_t i = 0; i < size; ++i) {
+    uint8_t b = buffer[i];
+    buf.push_back(hex_chars[(b >> 4) & 0x0F]);
+    buf.push_back(hex_chars[b & 0x0F]);
+  }
+  buf.push_back('\n');
+}
