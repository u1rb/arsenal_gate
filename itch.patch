@@ -0,0 +1,40 @@
+#!/bin/bash
+set -uexo pipefail
+
+# --- Configuration ---
+SCRIPT_DIR=`dirname $0`
+BUILD_DIR="$SCRIPT_DIR/build"
+DATA_FILE="../../local_data/01302020.NASDAQ_ITCH50" # Adjust if necessary
+MAX_PACKETS=50000000
+
+# Set to true to enable FlatBuffers hex dump mode
+# DUMP_MODE=true 
+DUMP_MODE=false 
+OUTPUT_FILE="output_flatbuffers.hex"
+# --- End Configuration ---
+
+# Configure
+mkdir -p "$BUILD_DIR"
+cmake -S "$SCRIPT_DIR" -B "$BUILD_DIR" -DCMAKE_BUILD_TYPE=Release -G Ninja -DCMAKE_EXPORT_COMPILE_COMMANDS=ON
+
+# Build
+cmake --build "$BUILD_DIR" --target itch_order_book --config Release
+
+# Run
+echo "Running..."
+cd "$BUILD_DIR" # Run from build directory
+
+# Prepare arguments
+ARGS=("-i" "$DATA_FILE" "-n" "$MAX_PACKETS")
+
+if [ "$DUMP_MODE" = true ]; then
+  echo "Dump mode enabled. Outputting FlatBuffers hex to $OUTPUT_FILE"
+  # Add dump mode flag and output file argument
+  ARGS+=("-d" "-o" "$OUTPUT_FILE")
+  time ./itch_order_book "${ARGS[@]}" 
+  echo "Hex output saved to $PWD/$OUTPUT_FILE"
+else
+  echo "Order book build mode enabled."
+  # Run normally (building order book) - only needs input and max packets
+  time ./itch_order_book "${ARGS[@]}" 
+fi
