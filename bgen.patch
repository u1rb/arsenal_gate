+++ b/try_bgen/CMakeLists.txt
@@ -0,0 +1,32 @@
+cmake_minimum_required(VERSION 3.14)
+
+project(BGenBenchmark C CXX)
+
+include(FetchContent)
+
+# Fetch the bgen library
+FetchContent_Declare(
+  bgen
+  GIT_REPOSITORY https://github.com/tidwall/bgen.git
+  GIT_TAG main
+)
+FetchContent_MakeAvailable(bgen)
+
+# Fetch Catch2 for testing
+FetchContent_Declare(
+  Catch2
+  GIT_REPOSITORY https://github.com/catchorg/Catch2.git
+  GIT_TAG v3.8.1
+)
+FetchContent_MakeAvailable(Catch2)
+
+add_executable(bgen_example main.c)
+target_include_directories(bgen_example PRIVATE ${bgen_SOURCE_DIR})
+
+add_executable(bgen_benchmark benchmark.cpp)
+
+# Link Catch2 and bgen
+target_link_libraries(bgen_benchmark PRIVATE Catch2::Catch2WithMain)
+target_include_directories(bgen_benchmark PRIVATE ${bgen_SOURCE_DIR})
+# target_include_directories(bgen_benchmark PRIVATE ${catch2_SOURCE_DIR}/src)
+target_compile_options(bgen_benchmark PRIVATE -fpermissive)
