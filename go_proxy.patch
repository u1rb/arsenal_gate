+package main
+
+import (
+	_ "embed"
+	"fmt"
+	"os"
+	"os/exec"
+	"path/filepath"
+	"strings"
+	"syscall"
+)
+
+//go:embed proxy-inject.js
+var proxyInjectJS string
+
+const (
+	defaultHost = "localhost"
+	defaultPort = "3128"
+)
+
+func getProxyURL() string {
+	host := os.Getenv("PROXY_HOST")
+	if host == "" {
+		host = defaultHost
+	}
+
+	port := os.Getenv("PROXY_PORT")
+	if port == "" {
+		port = defaultPort
+	}
+
+	return "http://" + host + ":" + port
+}
+
+// setupNodeProxyInjection extracts the embedded proxy-inject.js to a temp file
+// and returns the path. Returns empty string on error.
+func setupNodeProxyInjection() string {
+	// Create temp file
+	tmpDir := os.TempDir()
+	tmpFile := filepath.Join(tmpDir, "go_proxy_inject.js")
+
+	// Write embedded JS to temp file
+	err := os.WriteFile(tmpFile, []byte(proxyInjectJS), 0644)
+	if err != nil {
+		return ""
+	}
+
+	return tmpFile
+}
+
+func main() {
+	// Check if command is provided
+	if len(os.Args) < 2 {
+		fmt.Fprintf(os.Stderr, "Usage: %s <command> [args...]\n", os.Args[0])
+		fmt.Fprintf(os.Stderr, "Example: %s curl https://example.com\n", os.Args[0])
+		os.Exit(1)
+	}
+
+	// Get the command and arguments
+	cmdName := os.Args[1]
+	cmdArgs := os.Args[2:]
+
+	// Find the command in PATH
+	cmdPath, err := exec.LookPath(cmdName)
+	if err != nil {
+		fmt.Fprintf(os.Stderr, "Error: command '%s' not found: %v\n", cmdName, err)
+		os.Exit(1)
+	}
+
+	// Get proxy URL from environment or use default
+	proxyURL := getProxyURL()
+
+	// Prepare environment with proxy settings
+	env := os.Environ()
+	env = append(env,
+		"HTTP_PROXY="+proxyURL,
+		"HTTPS_PROXY="+proxyURL,
+		"http_proxy="+proxyURL,
+		"https_proxy="+proxyURL,
+	)
+
+	// Setup Node.js proxy injection for apps that don't honor HTTP_PROXY
+	injectPath := setupNodeProxyInjection()
+	if injectPath != "" {
+		// Get existing NODE_OPTIONS if any
+		existingNodeOpts := os.Getenv("NODE_OPTIONS")
+		nodeOpts := "-r " + injectPath
+		if existingNodeOpts != "" {
+			nodeOpts = nodeOpts + " " + strings.TrimSpace(existingNodeOpts)
+		}
+		env = append(env, "NODE_OPTIONS="+nodeOpts)
+	}
+
+	// Create the command
+	cmd := exec.Command(cmdPath, cmdArgs...)
+	cmd.Env = env
+	cmd.Stdin = os.Stdin
+	cmd.Stdout = os.Stdout
+	cmd.Stderr = os.Stderr
+
+	// Execute the command
+	err = cmd.Run()
+	if err != nil {
+		// Handle exit code from the child process
+		if exitError, ok := err.(*exec.ExitError); ok {
+			if status, ok := exitError.Sys().(syscall.WaitStatus); ok {
+				os.Exit(status.ExitStatus())
+			}
+		}
+		fmt.Fprintf(os.Stderr, "Error executing command: %v\n", err)
+		os.Exit(1)
+	}
+
+	// Exit with success
+	os.Exit(0)
+}
