+.PHONY: all server client clean test
+
+all: server client
+
+server:
+	@echo "Building proxy server..."
+	@go build -o go_proxy_server ./cmd/server
+
+client:
+	@echo "Building proxy client..."
+	@go build -o go_proxy ./cmd/client
+
+clean:
+	@echo "Cleaning build artifacts..."
+	@rm -f go_proxy_server go_proxy
+
+test:
+	@echo "Testing server in background..."
+	@./go_proxy_server &
+	@sleep 2
+	@echo "Testing with curl..."
+	@./go_proxy curl -I https://example.com
+	@pkill go_proxy_server || true
+
+install: all
+	@echo "Installing binaries to /usr/local/bin (requires sudo)..."
+	@sudo cp go_proxy_server /usr/local/bin/
+	@sudo cp go_proxy /usr/local/bin/
