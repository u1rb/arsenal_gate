+// proxy-inject.js
+// This script is automatically injected into Node.js processes to force HTTP/HTTPS proxy usage
+// It monkey-patches the http and https modules before the application starts
+
+(function() {
+  const http = require('http');
+  const https = require('https');
+  const url = require('url');
+
+  // Get proxy configuration from environment
+  const proxyHost = process.env.PROXY_HOST || 'localhost';
+  const proxyPort = process.env.PROXY_PORT || '3128';
+  const proxyUrl = `http://${proxyHost}:${proxyPort}`;
+
+  // Check if http-proxy-agent is available (optional dependency)
+  let HttpProxyAgent, HttpsProxyAgent;
+  try {
+    const proxyAgentModule = require('http-proxy-agent');
+    HttpProxyAgent = proxyAgentModule.HttpProxyAgent || proxyAgentModule;
+    HttpsProxyAgent = proxyAgentModule.HttpsProxyAgent || proxyAgentModule;
+  } catch (e) {
+    // http-proxy-agent not available, use basic implementation
+    HttpProxyAgent = null;
+    HttpsProxyAgent = null;
+  }
+
+  // Create proxy agents if available
+  const httpAgent = HttpProxyAgent ? new HttpProxyAgent(proxyUrl) : null;
+  const httpsAgent = HttpsProxyAgent ? new HttpsProxyAgent(proxyUrl) : null;
+
+  // Monkey-patch http.request
+  const originalHttpRequest = http.request;
+  http.request = function(input, options, callback) {
+    // Handle different call signatures
+    if (typeof input === 'string') {
+      input = new url.URL(input);
+    } else if (input instanceof url.URL) {
+      input = input;
+    }
+
+    if (typeof options === 'function') {
+      callback = options;
+      options = input;
+    } else if (options) {
+      options = Object.assign({}, input, options);
+    } else {
+      options = input;
+    }
+
+    // Inject proxy agent if not already set and agent is available
+    if (httpAgent && !options.agent && options.agent !== false) {
+      options.agent = httpAgent;
+    }
+
+    return originalHttpRequest.call(this, options, callback);
+  };
+
+  // Monkey-patch http.get
+  const originalHttpGet = http.get;
+  http.get = function(input, options, callback) {
+    const req = http.request(input, options, callback);
+    req.end();
+    return req;
+  };
+
+  // Monkey-patch https.request
+  const originalHttpsRequest = https.request;
+  https.request = function(input, options, callback) {
+    // Handle different call signatures
+    if (typeof input === 'string') {
+      input = new url.URL(input);
+    } else if (input instanceof url.URL) {
+      input = input;
+    }
+
+    if (typeof options === 'function') {
+      callback = options;
+      options = input;
+    } else if (options) {
+      options = Object.assign({}, input, options);
+    } else {
+      options = input;
+    }
+
+    // Inject proxy agent if not already set and agent is available
+    if (httpsAgent && !options.agent && options.agent !== false) {
+      options.agent = httpsAgent;
+    }
+
+    return originalHttpsRequest.call(this, options, callback);
+  };
+
+  // Monkey-patch https.get
+  const originalHttpsGet = https.get;
+  https.get = function(input, options, callback) {
+    const req = https.request(input, options, callback);
+    req.end();
+    return req;
+  };
+
+  // Set global agents as fallback
+  if (httpAgent) {
+    http.globalAgent = httpAgent;
+  }
+  if (httpsAgent) {
+    https.globalAgent = httpsAgent;
+  }
+
+  // Only log if NODE_DEBUG contains 'proxy'
+  if (process.env.NODE_DEBUG && process.env.NODE_DEBUG.includes('proxy')) {
+    console.error('[go_proxy] Proxy injection active:', proxyUrl);
+    if (!httpAgent && !httpsAgent) {
+      console.error('[go_proxy] Warning: http-proxy-agent not found, proxy may not work with all libraries');
+      console.error('[go_proxy] Install with: npm install http-proxy-agent');
+    }
+  }
+})();
