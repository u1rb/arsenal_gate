+#pragma once
+
+#include <array>
+#include <concepts>
+#include <cstdint>
+#include <span>
+#include <string>
+#include <string_view>
+#include <vector>
+
+// --- Interface Definition ---
+template <typename T>
+concept Encoder = requires(T e, std::span<const uint8_t> data) {
+  { e(data) } -> std::same_as<std::string>;
+};
+
+template <typename T>
+concept Decoder = requires(T d, std::string_view encoded) {
+  { d(encoded) } -> std::same_as<std::vector<uint8_t>>;
+};
+
+template <Encoder TEncoder, Decoder TDecoder> struct EncodingStrategy {
+  std::string name;
+  TEncoder encode;
+  TDecoder decode;
+};
+
+// --- Base64 Functions ---
+auto base64_encode(std::span<const uint8_t> data) -> std::string;
+auto base64_decode(std::string_view encoded) -> std::vector<uint8_t>;
+
+// --- Hex Functions ---
+auto hex_encode(std::span<const uint8_t> data) -> std::string;
+auto hex_decode(std::string_view encoded) -> std::vector<uint8_t>;
+
+// --- No-op Functions ---
+auto noop_encode(std::span<const uint8_t> data) -> std::string;
+auto noop_decode(std::string_view encoded) -> std::vector<uint8_t>;
+
+// Helper function to create an EncodingStrategy
+template <Encoder TEncoder, Decoder TDecoder>
+auto make_strategy(std::string name, TEncoder &&encoder, TDecoder &&decoder) {
+  return EncodingStrategy<TEncoder, TDecoder>{std::move(name),
+                                              std::forward<TEncoder>(encoder),
+                                              std::forward<TDecoder>(decoder)};
+}
