+// --- Helper Function to Demonstrate Encoding/Decoding ---
+template<Encoder TEncoder, Decoder TDecoder>
+void demonstrate_encoding(std::span<const uint8_t> original_buffer, 
+                        const EncodingStrategy<TEncoder, TDecoder>& strategy) {
+    std::cout << "\n--- Testing Strategy: " << strategy.name << " ---\n";
+
+    // --- Encoding ---
+    std::string encoded_str;
+    try {
+        encoded_str = strategy.encode(original_buffer);
+        std::cout << "Encoded (" << strategy.name << "): ";
+        // Avoid printing potentially huge/binary strings directly for "None"
+        if (strategy.name == "None") {
+            std::cout << "<" << encoded_str.length() << " bytes of raw data>" << std::endl;
+        } else {
+             std::cout << encoded_str << std::endl;
+        }
+    } catch (const std::exception& e) {
+        std::cerr << "Encoding failed: " << e.what() << std::endl;
+        return; // Cannot proceed without encoded data
+    }
+
+    // --- Decoding ---
+    std::vector<uint8_t> decoded_buffer;
+    try {
+        decoded_buffer = strategy.decode(encoded_str);
+        std::cout << "Decoded size: " << decoded_buffer.size() << " bytes\n";
+
+        // Basic check: Does decoded size match original?
+        if (decoded_buffer.size() != original_buffer.size()) {
+             std::cerr << "Error: Decoded size (" << decoded_buffer.size()
+                       << ") does not match original size (" << original_buffer.size() << ")!\n";
+        }
+    } catch (const std::exception& e) {
+        std::cerr << "Decoding failed: " << e.what() << std::endl;
+        return; // Cannot proceed without decoded data
+    }
+
+    // --- Deserialization & Verification ---
+    if (decoded_buffer.empty()) {
+      std::cerr << "Decoded data is empty, cannot verify!\n";
+      return;
+    }
+
+    std::cout << "Verifying FlatBuffer data...\n";
+    flatbuffers::Verifier verifier(decoded_buffer.data(), decoded_buffer.size());
+    if (!ExampleData::VerifyMessageBuffer(verifier)) {
+        std::cerr << "Verification failed for " << strategy.name << "!\n";
+        // If "None" failed, print a warning about the encoding method
+        if (strategy.name == "None") {
+             std::cerr << "[Warning: The 'None' encoding is unsafe and might have corrupted the data.]\n";
+        }
+        return;
+    }
+    std::cout << "Verification successful.\n";
+
+    // --- Access Data ---
+    auto message = ExampleData::GetMessage(decoded_buffer.data());
+    std::cout << "Content: " << message->content()->string_view() << "\n"
+              << "Timestamp: " << message->timestamp() << "\n"
+              << "Urgent: " << (message->is_urgent() ? "Yes" : "No") << "\n";
+    if (message->values()) {
+        std::cout << "Values: [";
+        bool first = true;
+        for (int32_t val : *message->values()) {
+            if (!first) std::cout << ", ";
+            std::cout << val;
+            first = false;
+        }
+        std::cout << "]\n";
+    } else {
+        std::cout << "Values: (Not present)\n";
+    }
+}
