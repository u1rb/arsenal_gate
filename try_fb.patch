+  auto timestamp = std::chrono::duration_cast<std::chrono::milliseconds>(
+                       std::chrono::system_clock::now().time_since_epoch())
+                       .count();
+  bool urgent = true;
+  std::vector<int32_t> int_values = {1, 1, 2, 3, 5, 8, -13}; // Fibonacci-ish
+  auto values_vector = builder.CreateVector(int_values);
+
+  ExampleData::MessageBuilder message_builder(builder);
+  message_builder.add_content(message_content);
+  message_builder.add_timestamp(timestamp);
+  message_builder.add_is_urgent(urgent);
+  message_builder.add_values(values_vector);
+  builder.Finish(message_builder.Finish());
+
+  auto original_buffer = builder.GetBufferSpan();
+  std::cout << "Serialized size: " << original_buffer.size() << " bytes\n";
+
+  // --- Define Strategies ---
+  auto base64_strategy = make_strategy("Base64", base64_encode, base64_decode);
+  auto hex_strategy = make_strategy("Hex", hex_encode, hex_decode);
