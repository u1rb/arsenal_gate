+cmake_minimum_required(VERSION 3.20) # C++23 and modern FetchContent features
+project(FlatbufferFetchExample LANGUAGES CXX)
+
+set(CMAKE_CXX_STANDARD 23)
+set(CMAKE_CXX_STANDARD_REQUIRED ON)
+
+include(FetchContent)
+
+#############################################################################
+# --- Fetch and configure FlatBuffers ---
+#############################################################################
+FetchContent_Declare(
+  flatbuffers
+  GIT_REPOSITORY https://github.com/google/flatbuffers.git
+  GIT_TAG        v25.2.10 # Update as needed for newer versions
+  GIT_SHALLOW    TRUE
+)
+
+# Make flatbuffers available
+FetchContent_GetProperties(flatbuffers)
+if(NOT flatbuffers_POPULATED)
+  FetchContent_Populate(flatbuffers)
+  # Add the flatbuffers project. This will define targets like 'flatbuffers' (library) and 'flatc' (executable).
+  option(FLATBUFFERS_BUILD_TESTS "Build FlatBuffers tests" OFF)
+  add_subdirectory(${flatbuffers_SOURCE_DIR} ${flatbuffers_BINARY_DIR})
+endif()
+
+# Ensure the flatc target exists (optional, but good practice)
+if(NOT TARGET flatc)
+    message(FATAL_ERROR "The 'flatc' executable target was not found after adding FlatBuffers. Check the FlatBuffers CMake configuration.")
+endif()
+set(FLATC_TARGET flatc) # Use the target name
+
+#############################################################################
+# --- Fetch and configure Catch2 ---
+#############################################################################
+FetchContent_Declare(
+  Catch2
+  GIT_REPOSITORY https://github.com/catchorg/Catch2.git
+  GIT_TAG        v3.6.0 # Use a recent v3 tag
+  GIT_SHALLOW    TRUE
+)
+
+FetchContent_MakeAvailable(Catch2)
+# Catch2 v3 provides the Catch2WithMain target which includes the main function
+
+#############################################################################
+# --- Schema Compilation Configuration ---
+#############################################################################
+
+# CONFIGURABLE: Set the output directory for generated headers
+set(FLATBUFFERS_GEN_DIR "${CMAKE_CURRENT_BINARY_DIR}/generated-flatbuffers" CACHE PATH "Directory for generated FlatBuffers headers")
+
+# Create the output directory if it doesn't exist
+file(MAKE_DIRECTORY ${FLATBUFFERS_GEN_DIR})
+
+# List to store all generated header files
+set(GENERATED_HEADERS)
+
+#############################################################################
+# --- Function: Add FlatBuffer Schema ---
+#############################################################################
+# This function adds a schema file to be compiled with flatc
+# Usage:
+#   add_flatbuffer_schema(
+#     SCHEMA "path/to/schema.fbs"           # Required: Path to the schema file (absolute or relative to CMAKE_CURRENT_SOURCE_DIR recommended)
+#     OUTPUT_NAME "my_schema_generated.h"   # Optional: Custom output file name (defaults to <schema_name>_generated.h)
+#   )
+function(add_flatbuffer_schema)
+  # Parse arguments
+  set(options)
+  set(oneValueArgs SCHEMA OUTPUT_NAME)
+  set(multiValueArgs)
+  cmake_parse_arguments(FB "${options}" "${oneValueArgs}" "${multiValueArgs}" ${ARGN})
+
+  # Validate required arguments
+  if(NOT FB_SCHEMA)
+    message(FATAL_ERROR "add_flatbuffer_schema: SCHEMA argument is required")
+  endif()
+
+  # Ensure the schema file exists
+  if(NOT EXISTS "${FB_SCHEMA}")
+     message(FATAL_ERROR "add_flatbuffer_schema: Schema file does not exist: ${FB_SCHEMA}")
+  endif()
+
+  # Get schema file name without extension
+  get_filename_component(SCHEMA_NAME ${FB_SCHEMA} NAME_WE)
+  get_filename_component(SCHEMA_FILENAME ${FB_SCHEMA} NAME) # Full filename
+
+  # Set output file name (use custom name if provided, otherwise default)
+  if(FB_OUTPUT_NAME)
+    set(OUTPUT_FILE "${FLATBUFFERS_GEN_DIR}/${FB_OUTPUT_NAME}")
+  else()
+    set(OUTPUT_FILE "${FLATBUFFERS_GEN_DIR}/${SCHEMA_NAME}_generated.h")
+  endif()
+
+  # Add custom command to generate header from schema
+  add_custom_command(
+    OUTPUT ${OUTPUT_FILE}
+    # Use the flatc target via generator expression
+    COMMAND $<TARGET_FILE:${FLATC_TARGET}>
+    # Arguments for flatc
+    ARGS --cpp -o ${FLATBUFFERS_GEN_DIR} ${FB_SCHEMA}
+    # Dependencies: The command re-runs if the schema or flatc changes
+    DEPENDS ${FB_SCHEMA} ${FLATC_TARGET}
+    COMMENT "Generating C++ from FlatBuffers schema: ${SCHEMA_FILENAME} -> ${OUTPUT_FILE}"
+    VERBATIM
+    USES_TERMINAL # Might provide better output formatting/coloring
+  )
+
+  # Add the generated file to the global list
+  set(GENERATED_HEADERS ${GENERATED_HEADERS} ${OUTPUT_FILE} PARENT_SCOPE)
+
+  # Group generated file in IDEs (optional, but helpful)
+  source_group("Generated Files\\FlatBuffers" FILES ${OUTPUT_FILE})
+
+endfunction()
+
+#############################################################################
+# --- Add your schema files here ---
+#############################################################################
+
+# Add the default schema file (using absolute path is robust)
+add_flatbuffer_schema(SCHEMA "${CMAKE_CURRENT_SOURCE_DIR}/schema.fbs")
+
+# Example of how to add additional schema files:
+# set(MY_SCHEMAS_DIR "${CMAKE_CURRENT_SOURCE_DIR}/schemas")
+# add_flatbuffer_schema(SCHEMA "${MY_SCHEMAS_DIR}/another_schema.fbs")
+# add_flatbuffer_schema(
+#   SCHEMA "${MY_SCHEMAS_DIR}/custom_schema.fbs"
+#   OUTPUT_NAME "my_custom_generated.h" # Specify a custom output name
+# )
+
+# Create a target that depends on all generated headers.
+# This ensures all custom commands run when this target is built.
+add_custom_target(
+  generate_flatbuffer_headers ALL # Add 'ALL' to make it run by default
+  DEPENDS ${GENERATED_HEADERS}
+  COMMENT "Ensuring all FlatBuffers headers are generated"
+)
+
+#############################################################################
+# --- Encoding Library ---
+#############################################################################
+
+# Add the encoding library
+add_library(encoding STATIC
+  encoding.cpp
+  encoding.hpp
+)
+
+# Set modern C++ standard for the library
+target_compile_features(encoding PRIVATE cxx_std_23)
+
+#############################################################################
+# --- Main Application ---
+#############################################################################
+
+# Add the main executable
+add_executable(MyFlatbufferApp main.cpp)
+
+# Make the executable depend on the header generation target
+add_dependencies(MyFlatbufferApp generate_flatbuffer_headers)
+
+# Add include paths
+target_include_directories(MyFlatbufferApp PRIVATE
+  ${FLATBUFFERS_GEN_DIR}  # Include the generated headers directory
+  ${CMAKE_CURRENT_SOURCE_DIR}  # For encoding.hpp
+)
+
+# Link against the flatbuffers runtime library and encoding library
+target_link_libraries(MyFlatbufferApp PRIVATE 
+  flatbuffers
+  encoding
+)
+
+#############################################################################
+# --- Benchmark Application ---
+#############################################################################
+
+# Add the benchmark executable
+add_executable(MyFlatbufferBenchmarks benchmarks.cpp)
+
+# Make the benchmark executable depend on the header generation target
+add_dependencies(MyFlatbufferBenchmarks generate_flatbuffer_headers)
+
+# Add include paths for benchmarks (same as main app)
+target_include_directories(MyFlatbufferBenchmarks PRIVATE
+  ${FLATBUFFERS_GEN_DIR}
+  ${CMAKE_CURRENT_SOURCE_DIR}  # For encoding.hpp
+)
+
+# Link benchmarks against Catch2, Flatbuffers and encoding library
+target_link_libraries(MyFlatbufferBenchmarks PRIVATE
+  Catch2::Catch2WithMain # Provides Catch2 framework + main()
+  flatbuffers            # For FlatBuffers runtime
+  encoding              # Our encoding library
+)
+
+#############################################################################
+# --- Debug Information / Optional ---
+#############################################################################
+
+# Uncomment to print debug information during CMake configuration
+# message(STATUS "FlatBuffers source dir: ${flatbuffers_SOURCE_DIR}")
+# message(STATUS "FlatBuffers binary dir: ${flatbuffers_BINARY_DIR}")
+# message(STATUS "FlatBuffers generated headers dir: ${FLATBUFFERS_GEN_DIR}")
+# message(STATUS "FlatBuffers generated headers list: ${GENERATED_HEADERS}")
+# message(STATUS "Using flatc executable from target: ${FLATC_TARGET}")
+# message(STATUS "Catch2 source dir: ${Catch2_SOURCE_DIR}")
