+#include "encoding.hpp"
+#include <algorithm>
+#include <iomanip>
+#include <sstream>
+#include <stdexcept>
+
+namespace {
+constexpr std::string_view base64_chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
+                                         "abcdefghijklmnopqrstuvwxyz"
+                                         "0123456789+/";
+}
+
+auto base64_encode(std::span<const uint8_t> data) -> std::string {
+    std::string result;
+    result.reserve(((data.size() + 2) / 3) * 4);
+
+    std::size_t i = 0;
+    std::array<uint8_t, 3> bytes{};
+    while (i < data.size()) {
+        bytes[0] = data[i++];
+        bytes[1] = (i < data.size()) ? data[i++] : 0;
+        bytes[2] = (i < data.size()) ? data[i++] : 0;
+
+        result += base64_chars[bytes[0] >> 2];
+        result += base64_chars[((bytes[0] & 0x03) << 4) | (bytes[1] >> 4)];
+        result += (i < data.size() + 1) ? base64_chars[((bytes[1] & 0x0f) << 2) | (bytes[2] >> 6)] : '=';
+        result += (i < data.size() + 0) ? base64_chars[bytes[2] & 0x3f] : '=';
+    }
+
+    size_t padding_count = (3 - (data.size() % 3)) % 3;
+    if (padding_count > 0 && result.size() >= 1) result[result.size() - 1] = '=';
+    if (padding_count > 1 && result.size() >= 2) result[result.size() - 2] = '=';
+
+    return result;
+}
+
+auto base64_decode(std::string_view encoded) -> std::vector<uint8_t> {
+    std::vector<uint8_t> result;
+    result.reserve(encoded.size() * 3 / 4);
+    std::string current_chunk;
+    current_chunk.reserve(4);
+    size_t padding_chars = 0;
+
+    for(char c : encoded) {
+        if (std::isspace(static_cast<unsigned char>(c))) continue;
+
+        if (c == '=') {
+            current_chunk += c;
+            padding_chars++;
+            if (padding_chars > 2) {
+                throw std::runtime_error("Invalid Base64: More than two padding characters.");
+            }
+        } else {
+            if (padding_chars > 0) {
+                throw std::runtime_error("Invalid Base64: Character found after padding.");
+            }
+            size_t pos = base64_chars.find(c);
+            if (pos == std::string_view::npos) {
+                throw std::runtime_error(std::string("Invalid Base64 character: ") + c);
+            }
+            current_chunk += c;
+        }
+
+        if (current_chunk.length() == 4) {
+            std::array<uint8_t, 4> chunk_indices{};
+            for(size_t i = 0; i < 4; ++i) {
+                if (current_chunk[i] == '=') {
+                    chunk_indices[i] = 0;
+                } else {
+                    size_t pos_val = base64_chars.find(current_chunk[i]);
+                    if(pos_val == std::string_view::npos) {
+                        throw std::runtime_error("Internal error during base64 decode indexing.");
+                    }
+                    chunk_indices[i] = static_cast<uint8_t>(pos_val);
+                }
+            }
+
+            result.push_back((chunk_indices[0] << 2) | (chunk_indices[1] >> 4));
+
+            if (current_chunk[2] != '=') {
+                result.push_back((chunk_indices[1] << 4) | (chunk_indices[2] >> 2));
+                if (current_chunk[3] != '=') {
+                    result.push_back((chunk_indices[2] << 6) | chunk_indices[3]);
+                }
+            }
+
+            if (current_chunk[2] == '=' && current_chunk[3] != '=') {
+                throw std::runtime_error("Invalid Base64 Padding: '=' found in 3rd position but not 4th.");
+            }
+
+            current_chunk.clear();
+        }
+    }
+
+    if (!current_chunk.empty()) {
+        bool only_padding_or_ws = true;
+        for(char c : current_chunk) {
+            if (c != '=' && !std::isspace(static_cast<unsigned char>(c))) {
+                only_padding_or_ws = false;
+                break;
+            }
+        }
+        if (!only_padding_or_ws) {
+            throw std::runtime_error("Invalid Base64: Trailing characters or incomplete chunk.");
+        }
+    }
+
+    return result;
+}
+
+auto hex_encode(std::span<const uint8_t> data) -> std::string {
+    std::stringstream ss;
+    ss << std::hex << std::setfill('0');
+    for (uint8_t byte : data) {
+        ss << std::setw(2) << static_cast<int>(byte);
+    }
+    return ss.str();
+}
+
+auto hex_decode(std::string_view encoded) -> std::vector<uint8_t> {
+    std::string clean_encoded;
+    for(char c : encoded) {
+        if (!std::isspace(static_cast<unsigned char>(c))) {
+            clean_encoded += c;
+        }
+    }
+
+    if (clean_encoded.length() % 2 != 0) {
+        throw std::runtime_error("Invalid Hex string: Odd length after removing whitespace.");
+    }
+    std::vector<uint8_t> result;
+    result.reserve(clean_encoded.length() / 2);
+
+    for (size_t i = 0; i < clean_encoded.length(); i += 2) {
+        std::string byte_str = clean_encoded.substr(i, 2);
+        try {
+            if (byte_str.find_first_not_of("0123456789abcdefABCDEF") != std::string::npos) {
+                throw std::invalid_argument("Invalid Hex character found");
+            }
+            unsigned long byte_val = std::stoul(byte_str, nullptr, 16);
+            if (byte_val > 255) {
+                throw std::out_of_range("Hex value exceeds 255");
+            }
+            result.push_back(static_cast<uint8_t>(byte_val));
+        } catch (const std::invalid_argument& e) {
+            throw std::runtime_error("Invalid Hex character in string: '" + byte_str + "'");
+        } catch (const std::out_of_range& e) {
+            throw std::runtime_error("Hex value out of range for conversion: '" + byte_str + "'");
+        }
+    }
+    return result;
+}
+
+auto noop_encode(std::span<const uint8_t> data) -> std::string {
+    return std::string(reinterpret_cast<const char*>(data.data()), data.size());
+}
+
+auto noop_decode(std::string_view encoded) -> std::vector<uint8_t> {
+    const uint8_t* begin_ptr = reinterpret_cast<const uint8_t*>(encoded.data());
+    return std::vector<uint8_t>(begin_ptr, begin_ptr + encoded.size());
+} 
