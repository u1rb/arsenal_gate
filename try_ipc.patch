+TEST_CASE("SharedRingBuffer latency benchmark",
+          "[shared_ringbuffer][benchmark][latency]") {
+  const std::string test_name = "test_latency";
+  // Randomize buffer size between 256KB and 4MB
+  std::random_device rd;
+  std::mt19937 gen(rd());
+  std::uniform_int_distribution<> buffer_size_dist(256 * 1024, 4 * 1024 * 1024);
+  const size_t buffer_size = buffer_size_dist(gen);
+  std::cout << "\nUsing random buffer size for latency test: " << (buffer_size / 1024) << " KB" << std::endl;
+
+  SharedRingBuffer producer(test_name, buffer_size);
+  auto consumer = SharedRingBuffer::open(test_name);
+
+  // Prepare test data with different sizes - now include some irregular sizes
+  std::vector<size_t> message_sizes = {8, 64, 256, 1024, 4096, 16384};
+  
+  // Add some random odd-sized messages to test boundary conditions
+  std::uniform_int_distribution<> odd_size_dist(1, 32 * 1024);
+  for (int i = 0; i < 3; i++) {
+    message_sizes.push_back(odd_size_dist(gen));
+  }
+  
+  // Randomize number of iterations between 500-1500
+  std::uniform_int_distribution<> iter_dist(500, 1500);
+  const int iterations = iter_dist(gen);
+  std::cout << "Running " << iterations << " iterations per message size" << std::endl;
+
+  std::cout << "\nLatency Benchmark Results:" << std::endl;
+  std::cout << "------------------------" << std::endl;
+  std::cout << "Message Size | Write Latency (μs) | Read Latency (μs) | "
+               "Round-trip Latency (μs)"
+            << std::endl;
+  std::cout << "------------|-------------------|------------------|-----------"
+               "-------------"
+            << std::endl;
+
+  // Random pattern generation strategy
+  std::uniform_int_distribution<> pattern_dist(0, 3);
+
+  for (size_t msg_size : message_sizes) {
+    std::vector<uint8_t> data(msg_size);
+    
+    // Choose a random data pattern
+    int pattern = pattern_dist(gen);
+    switch (pattern) {
+      case 0: // Sequential values
+        std::iota(data.begin(), data.end(), 0);
+        break;
+      case 1: // All same value
+        std::fill(data.begin(), data.end(), 42);
+        break;
+      case 2: // Random values
+        std::generate(data.begin(), data.end(), [&]() { return static_cast<uint8_t>(gen() & 0xFF); });
+        break;
+      case 3: // Alternating values
+        for (size_t i = 0; i < data.size(); i++) {
+          data[i] = (i % 2) ? 0xAA : 0x55;
+        }
+        break;
+    }
+    std::cout << "Testing " << msg_size << " bytes with pattern type " << pattern << std::endl;
+
+    // Write latency measurements
+    std::vector<double> write_latencies;
+    std::vector<double> read_latencies;
+    std::vector<double> round_trip_latencies;
+
+    for (int i = 0; i < iterations; i++) {
+      // Occasionally inject a small delay to simulate system load
+      if (i % 50 == 0) {
+        std::uniform_int_distribution<> load_delay_dist(1, 10);
+        std::this_thread::sleep_for(std::chrono::milliseconds(load_delay_dist(gen)));
+      }
+
+      // Measure write latency
+      auto write_start = std::chrono::high_resolution_clock::now();
+      producer.write(data);
+      auto write_end = std::chrono::high_resolution_clock::now();
+      auto write_duration =
+          std::chrono::duration_cast<std::chrono::nanoseconds>(write_end -
+                                                               write_start)
+              .count() /
+          1000.0; // μs
+      write_latencies.push_back(write_duration);
+
+      // Measure read latency
+      auto read_start = std::chrono::high_resolution_clock::now();
+      auto received = consumer.read(msg_size);
+      auto read_end = std::chrono::high_resolution_clock::now();
+      auto read_duration = std::chrono::duration_cast<std::chrono::nanoseconds>(
+                               read_end - read_start)
+                               .count() /
+                           1000.0; // μs
+      read_latencies.push_back(read_duration);
+
+      // Round-trip latency
+      round_trip_latencies.push_back(write_duration + read_duration);
+
+      // Verify data integrity
+      REQUIRE(received.size() == data.size());
+      if (!received.empty()) {
+        REQUIRE(received == data);
+      }
+    }
+
+    // Calculate average latencies
+    auto calc_avg = [](const std::vector<double> &values) -> double {
+      return std::accumulate(values.begin(), values.end(), 0.0) / values.size();
+    };
+
+    double avg_write_latency = calc_avg(write_latencies);
+    double avg_read_latency = calc_avg(read_latencies);
+    double avg_round_trip = calc_avg(round_trip_latencies);
+
+    // Calculate minimum latencies
+    auto min_write_latency =
+        *std::min_element(write_latencies.begin(), write_latencies.end());
+    auto min_read_latency =
+        *std::min_element(read_latencies.begin(), read_latencies.end());
+    auto min_round_trip = *std::min_element(round_trip_latencies.begin(),
+                                           round_trip_latencies.end());
+
+    // Print results
+    std::cout << std::setw(12) << msg_size << " | " << std::setw(19)
+              << std::fixed << std::setprecision(3) << avg_write_latency
+              << " | " << std::setw(18) << avg_read_latency << " | "
+              << std::setw(24) << avg_round_trip << std::endl;
+    
+    // Also print minimum latencies (often more relevant for benchmarks)
+    std::cout << "            | " << std::setw(19) << std::fixed 
+              << std::setprecision(3) << min_write_latency << " (min)"
+              << " | " << std::setw(18) << min_read_latency << " (min)"
+              << " | " << std::setw(24) << min_round_trip << " (min)" << std::endl;
+  }
+
+  // Verify the benchmark is meaningful
+  REQUIRE(consumer.available() == 0);
+}
