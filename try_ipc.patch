+#include <condition_variable>
+#include <random>
+
+using namespace shm_ipc;
+using namespace std::chrono_literals;
+
+// Mutex for synchronized console output
+std::mutex cout_mutex;
+#define SAFE_COUT(msg) { std::lock_guard<std::mutex> lock(cout_mutex); std::cout << msg << std::endl; }
+
+TEST_CASE("Multiple consumers", "[multi_consumer]") {
+    const std::string test_name = "test_multi_consumer";
+    // Randomize buffer size between 512KB and 2MB
+    std::random_device rd;
+    std::mt19937 gen(rd());
+    std::uniform_int_distribution<> buffer_size_dist(512 * 1024, 2 * 1024 * 1024);
+    const size_t buffer_size = buffer_size_dist(gen);
+    std::cout << "Multi-consumer test with buffer size: " << (buffer_size / 1024) << " KB" << std::endl;
+    
+    // Create a producer
+    SharedRingBuffer producer(test_name, buffer_size);
+    
+    SECTION("Open multiple consumers") {
+        // Randomize number of consumers between 2 and 8 (maximum supported)
+        std::uniform_int_distribution<> consumer_count_dist(2, 8);
+        int num_consumers = consumer_count_dist(gen);
+        
+        // Create consumers using vector
+        std::vector<SharedRingBuffer> consumers;
+        
+        for (int i = 0; i < num_consumers; i++) {
+            consumers.push_back(SharedRingBuffer::open_consumer(test_name, i));
+            REQUIRE(consumers[i].consumer_id() == i);
+        }
+        
+        // Check consumer count
+        REQUIRE(producer.consumer_count() == num_consumers);
+        
+        // Generate random data
+        std::uniform_int_distribution<> data_size_dist(10, 1000);
+        size_t data_size = data_size_dist(gen);
+        std::vector<uint8_t> data(data_size);
+        std::generate(data.begin(), data.end(), [&gen]() { 
+            return static_cast<uint8_t>(gen() & 0xFF); 
+        });
+        
+        REQUIRE(producer.write(data) == data.size());
+        
+        // Each consumer should see the data
+        for (int i = 0; i < num_consumers; i++) {
+            REQUIRE(consumers[i].available() == data.size());
+            auto read_data = consumers[i].read(data.size());
+            REQUIRE(read_data == data);
+        }
+    }
+    
+    SECTION("Reset consumer") {
+        // Create 3 consumers
+        auto consumer1 = SharedRingBuffer::open_consumer(test_name, 0);
+        auto consumer2 = SharedRingBuffer::open_consumer(test_name, 1);
+        auto consumer3 = SharedRingBuffer::open_consumer(test_name, 2);
+        
+        // Generate random data sets
+        std::uniform_int_distribution<> data_size_dist(10, 1000);
+        std::vector<uint8_t> data1(data_size_dist(gen));
+        std::vector<uint8_t> data2(data_size_dist(gen));
+        
+        std::generate(data1.begin(), data1.end(), [&gen]() { 
+            return static_cast<uint8_t>(gen() & 0xFF); 
+        });
+        std::generate(data2.begin(), data2.end(), [&gen]() { 
+            return static_cast<uint8_t>(gen() & 0xFF); 
+        });
+        
+        REQUIRE(producer.write(data1) == data1.size());
+        
+        // Reset consumer2 (skips data1)
+        REQUIRE(consumer2.reset_consumer());
+        
+        // Write more data
+        REQUIRE(producer.write(data2) == data2.size());
+        
+        // Consumer1 should see both data sets
+        REQUIRE(consumer1.available() == data1.size() + data2.size());
+        auto read1_1 = consumer1.read(data1.size());
+        REQUIRE(read1_1 == data1);
+        auto read1_2 = consumer1.read(data2.size());
+        REQUIRE(read1_2 == data2);
+        
+        // Consumer2 should only see data2
+        REQUIRE(consumer2.available() == data2.size());
+        auto read2 = consumer2.read(data2.size());
+        REQUIRE(read2 == data2);
+        
+        // Consumer3 should see both data sets
+        REQUIRE(consumer3.available() == data1.size() + data2.size());
+        auto read3_1 = consumer3.read(data1.size());
+        REQUIRE(read3_1 == data1);
+        auto read3_2 = consumer3.read(data2.size());
+        REQUIRE(read3_2 == data2);
+    }
+    
+    SECTION("Concurrent readers") {
+        // Randomize number of consumers between 2 and 6
+        std::uniform_int_distribution<> consumer_count_dist(2, 6);
+        const int NUM_CONSUMERS = consumer_count_dist(gen);
+        
+        // Randomize number of messages between 10 and 30
+        std::uniform_int_distribution<> msg_count_dist(10, 30);
+        const int NUM_MESSAGES = msg_count_dist(gen);
+        
+        SAFE_COUT("Starting concurrent reader test with " << NUM_CONSUMERS << " consumers and " << NUM_MESSAGES << " messages");
+        
+        // Track total messages received by all consumers
+        std::atomic<int> total_received{0};
+        
+        // Flag to signal consumers to exit even if they haven't received all messages
+        std::atomic<bool> should_exit{false};
+        
+        // Track the exit status of each consumer
+        std::vector<std::atomic<bool>> consumer_finished(NUM_CONSUMERS);
+        for (auto& flag : consumer_finished) {
+            flag.store(false);
+        }
+        
+        // Create consumer threads
+        std::vector<std::thread> consumer_threads;
+        
+        // Setup random delays for consumers
+        std::uniform_int_distribution<> consumer_delay_dist(1, 30);
+        
+        // Start a watchdog thread to detect deadlocks
+        std::atomic<bool> watchdog_triggered{false};
+        std::thread watchdog([&]() {
+            // Wait for 60 seconds max (increased for randomized tests)
+            for (int i = 0; i < 60; i++) {
+                std::this_thread::sleep_for(1s);
+                
+                // Log progress every 5 seconds
+                if (i % 5 == 0) {
+                    SAFE_COUT("Watchdog: " << i << "s elapsed, " << total_received.load() 
+                             << " messages received out of " << (NUM_CONSUMERS * NUM_MESSAGES) << " expected");
+                }
+                
+                // Check if test is complete
+                if (total_received.load() >= NUM_CONSUMERS * NUM_MESSAGES) {
+                    SAFE_COUT("Watchdog: All messages received, exiting watchdog");
+                    return;
+                }
+                
+                // Check if all consumers are stuck
+                bool all_stuck = true;
+                for (int j = 0; j < NUM_CONSUMERS; j++) {
+                    if (!consumer_finished[j].load()) {
+                        all_stuck = false;
+                        break;
+                    }
+                }
+                
+                if (all_stuck) {
+                    SAFE_COUT("Watchdog: All consumers are stuck, but not all messages received");
+                    should_exit.store(true);
+                    watchdog_triggered.store(true);
+                    return;
+                }
+            }
+            
+            // If we got here, we timed out
+            SAFE_COUT("Watchdog triggered - timeout after 60 seconds!");
+            should_exit.store(true);
+            watchdog_triggered.store(true);
+        });
+        
+        for (int i = 0; i < NUM_CONSUMERS; i++) {
+            consumer_threads.emplace_back([&, i]() {
+                try {
+                    // Introduce random startup delay to test staggered consumer startup
+                    std::this_thread::sleep_for(std::chrono::milliseconds(consumer_delay_dist(gen)));
+                    
+                    // Open as consumer
+                    auto consumer = SharedRingBuffer::open_consumer(test_name, i);
+                    SAFE_COUT("Consumer " << i << " started");
+                    
+                    int messages_received = 0;
+                    auto start_time = std::chrono::steady_clock::now();
+                    
+                    // Create variable read size for more real-world behavior
+                    std::uniform_int_distribution<> read_size_dist(50, 500);
+                    
+                    while (messages_received < NUM_MESSAGES && !should_exit.load()) {
+                        // Randomize read size to test partial reads
+                        size_t read_size = read_size_dist(gen);
+                        auto data = consumer.read(read_size);
+                        
+                        if (!data.empty()) {
+                            messages_received++;
+                            total_received.fetch_add(1);
+                            
+                            // Log each message to debug deadlocks
+                            SAFE_COUT("Consumer " << i << " received message " << messages_received 
+                                     << " (size: " << data.size() << ", value: " << (int)data[0] << ")");
+                        } else {
+                            // Sleep briefly if no data with random backoff
+                            std::uniform_int_distribution<> sleep_dist(1, 20);
+                            std::this_thread::sleep_for(std::chrono::milliseconds(sleep_dist(gen)));
+                        }
+                        
+                        // Check for timeout (20 seconds without progress - increased for random tests)
+                        auto now = std::chrono::steady_clock::now();
+                        if (now - start_time > 20s && messages_received == 0) {
+                            SAFE_COUT("Consumer " << i << " timed out waiting for first message");
+                            break;
+                        }
+                    }
+                    
+                    SAFE_COUT("Consumer " << i << " finished with " << messages_received << " messages");
+                    consumer_finished[i].store(true);
+                } catch (const std::exception& e) {
+                    SAFE_COUT("Consumer " << i << " exception: " << e.what());
+                    consumer_finished[i].store(true);
+                }
+            });
+        }
+        
+        // Give consumers time to start up with random delay
+        std::uniform_int_distribution<> startup_delay_dist(50, 200);
+        std::this_thread::sleep_for(std::chrono::milliseconds(startup_delay_dist(gen)));
+        
+        // Generate random message sizes
+        std::uniform_int_distribution<> msg_size_dist(20, 400);
+        
+        // Producer sends messages with progress reporting
+        for (int i = 0; i < NUM_MESSAGES && !should_exit.load(); i++) {
+            // Create random-sized messages
+            size_t msg_size = msg_size_dist(gen);
+            std::vector<uint8_t> data(msg_size);
+            
+            // Fill with a combination of message number and random data
+            for (size_t j = 0; j < data.size(); j++) {
+                if (j < 4) {
+                    // First 4 bytes encode the message number
+                    data[j] = static_cast<uint8_t>((i >> (j * 8)) & 0xFF);
+                } else {
+                    // Rest is random
+                    data[j] = static_cast<uint8_t>(gen() & 0xFF);
+                }
+            }
+            
+            // Try to write with retry logic
+            bool write_success = false;
+            for (int retry = 0; retry < 5 && !write_success && !should_exit.load(); retry++) {
+                size_t written = producer.write(data);
+                write_success = (written == data.size());
+                
+                if (!write_success) {
+                    SAFE_COUT("Producer write retry " << retry << " for message " << i << " (free space: " << producer.free_space() << ")");
+                    std::this_thread::sleep_for(std::chrono::milliseconds(10 * (retry + 1)));
+                }
+            }
+            
+            if (!write_success) {
+                SAFE_COUT("Producer failed to write message " << i << " after retries (free space: " << producer.free_space() << ")");
+                should_exit.store(true);
+                break;
+            }
+            
+            // Log each message
+            SAFE_COUT("Producer wrote message " << i << " (size: " << data.size() << ")");
+            
+            // Wait between messages with random delay to test varied timing patterns
+            std::uniform_int_distribution<> producer_delay_dist(10, 100);
+            std::this_thread::sleep_for(std::chrono::milliseconds(producer_delay_dist(gen)));
+        }
+        
+        SAFE_COUT("Producer finished writing all messages");
+        
+        // Wait for all consumers to finish or watchdog to trigger
+        for (auto& thread : consumer_threads) {
+            thread.join();
+        }
+        
+        // Wait for watchdog
+        watchdog.join();
+        
+        // Each consumer should have received all messages
+        SAFE_COUT("Total messages received: " << total_received.load() << " out of " << (NUM_CONSUMERS * NUM_MESSAGES) << " expected");
+        
+        if (!watchdog_triggered.load()) {
+            REQUIRE(total_received.load() == NUM_CONSUMERS * NUM_MESSAGES);
+        } else {
+            // If watchdog triggered, test will fail, but at least it won't hang
+            REQUIRE_FALSE(watchdog_triggered.load());
+        }
+    }
+    
+    SECTION("Consumer drop out") {
+        // Create 3 consumers
+        auto consumer1 = SharedRingBuffer::open_consumer(test_name, 0);
+        
+        {
+            // consumer2 in a scope that will automatically destroy it
+            auto consumer2 = SharedRingBuffer::open_consumer(test_name, 1);
+            
+            // Check consumer count
+            REQUIRE(producer.consumer_count() == 2);
+            
+            // Write random sized data
+            std::uniform_int_distribution<> data_size_dist(10, 1000);
+            std::vector<uint8_t> data1(data_size_dist(gen));
+            std::generate(data1.begin(), data1.end(), [&gen]() {
+                return static_cast<uint8_t>(gen() & 0xFF);
+            });
+            
+            REQUIRE(producer.write(data1) == data1.size());
+            
+            // Both consumers read it
+            auto read1 = consumer1.read(data1.size());
+            REQUIRE(read1 == data1);
+            
+            auto read2 = consumer2.read(data1.size());
+            REQUIRE(read2 == data1);
+            
+            // consumer2 goes out of scope and should be destroyed
+        }
+        
+        // Check that consumer count decreased
+        std::this_thread::sleep_for(std::chrono::milliseconds(10)); // Give time for cleanup
+        REQUIRE(producer.consumer_count() == 1);
+        
+        // Write more random data
+        std::uniform_int_distribution<> data_size_dist(10, 1000);
+        std::vector<uint8_t> data2(data_size_dist(gen));
+        std::generate(data2.begin(), data2.end(), [&gen]() {
+            return static_cast<uint8_t>(gen() & 0xFF);
+        });
+        
+        REQUIRE(producer.write(data2) == data2.size());
+        
+        // Only consumer1 is left to read it
+        auto read3 = consumer1.read(data2.size());
+        REQUIRE(read3 == data2);
+    }
