diff --git a/src/shm_ipc.c b/src/shm_ipc.c
new file mode 100644
index 0000000..619602c
--- /dev/null
+++ b/src/shm_ipc.c
@@ -0,0 +1,764 @@
+#include "shm_ipc.h"
+#include <fcntl.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/stat.h>
+#include <unistd.h>
+#include <errno.h>
+#include <stdatomic.h>
+
+#define DEFAULT_BUFFER_SIZE (1024 * 1024) // 1MB
+#define MESSAGE_HEADER_SIZE sizeof(uint32_t) // Size of message length prefix
+
+/**
+ * Ring buffer structure for IPC communication
+ */
+struct RingBuffer {
+    size_t buffer_size;                              // Size of the data buffer
+    atomic_size_t* write_index;                      // Index where next write will occur
+    atomic_size_t* read_indices[SHM_IPC_MAX_CONSUMERS]; // Indices where next read will occur (one per consumer)
+    atomic_size_t* consumer_active;                  // Bitmap of active consumers
+    uint8_t* data;                                   // Pointer to the mapped data
+    void* mmap_addr;                                 // Base address of the mapped region
+    size_t mmap_size;                                // Total size of the mapped region
+    int fd;                                          // File descriptor for the shared memory
+    char* shm_name;                                  // Name of the shared memory segment
+    int consumer_id;                                 // ID of this consumer (-1 for producer)
+};
+
+/**
+ * Creates a new shared memory ring buffer
+ */
+RingBuffer* shm_ipc_create(const char* shm_name, size_t size) {
+    if (!shm_name) {
+        return NULL;
+    }
+
+    size_t actual_size = (size == 0) ? DEFAULT_BUFFER_SIZE : size;
+    
+    // Allocate ring buffer structure
+    RingBuffer* rb = (RingBuffer*)malloc(sizeof(RingBuffer));
+    if (!rb) {
+        return NULL;
+    }
+    
+    // Initialize the structure
+    memset(rb, 0, sizeof(RingBuffer));
+    rb->consumer_id = -1; // This is a producer
+    
+    // Store the shared memory name
+    rb->shm_name = strdup(shm_name);
+    if (!rb->shm_name) {
+        free(rb);
+        return NULL;
+    }
+
+    // Calculate total memory needs: 
+    // buffer size + 1 atomic size_t for write index + SHM_IPC_MAX_CONSUMERS for read indices
+    // + 1 for the active consumers bitmap
+    size_t header_size = sizeof(atomic_size_t) * (1 + SHM_IPC_MAX_CONSUMERS + 1);
+    rb->mmap_size = header_size + actual_size;
+    rb->buffer_size = actual_size;
+    
+    // Create and open shared memory object
+    char shm_path[256];
+    snprintf(shm_path, sizeof(shm_path), "/dev/shm/%s", shm_name);
+    
+    // Open or create shared memory file
+    rb->fd = open(shm_path, O_RDWR | O_CREAT, 0666);
+    if (rb->fd == -1) {
+        perror("open");
+        free(rb->shm_name);
+        free(rb);
+        return NULL;
+    }
+    
+    // Set the file size
+    if (ftruncate(rb->fd, rb->mmap_size) == -1) {
+        perror("ftruncate");
+        close(rb->fd);
+        free(rb->shm_name);
+        free(rb);
+        return NULL;
+    }
+    
+    // Memory map the shared object
+    rb->mmap_addr = mmap(NULL, rb->mmap_size, PROT_READ | PROT_WRITE, MAP_SHARED, rb->fd, 0);
+    if (rb->mmap_addr == MAP_FAILED) {
+        perror("mmap");
+        close(rb->fd);
+        free(rb->shm_name);
+        free(rb);
+        return NULL;
+    }
+    
+    // Setup memory layout:
+    // - First atomic_size_t: write index
+    // - Next SHM_IPC_MAX_CONSUMERS atomic_size_t: read indices
+    // - Next atomic_size_t: active consumer bitmap
+    // - Remaining: data buffer
+    rb->write_index = (atomic_size_t*)rb->mmap_addr;
+    for (int i = 0; i < SHM_IPC_MAX_CONSUMERS; i++) {
+        rb->read_indices[i] = (atomic_size_t*)((uint8_t*)rb->mmap_addr + sizeof(atomic_size_t) * (i + 1));
+    }
+    rb->consumer_active = (atomic_size_t*)((uint8_t*)rb->mmap_addr + sizeof(atomic_size_t) * (1 + SHM_IPC_MAX_CONSUMERS));
+    rb->data = (uint8_t*)rb->mmap_addr + header_size;
+    
+    // Initialize atomic counters
+    atomic_store(rb->write_index, 0);
+    
+    // Set all read indices to 0
+    for (int i = 0; i < SHM_IPC_MAX_CONSUMERS; i++) {
+        atomic_store(rb->read_indices[i], 0);
+    }
+    
+    // No consumers active yet
+    atomic_store(rb->consumer_active, 0);
+    
+    return rb;
+}
+
+/**
+ * Opens an existing shared memory ring buffer as a consumer
+ */
+RingBuffer* shm_ipc_open_consumer(const char* shm_name, int consumer_id) {
+    if (!shm_name || consumer_id < 0 || consumer_id >= SHM_IPC_MAX_CONSUMERS) {
+        return NULL;
+    }
+    
+    // Allocate ring buffer structure
+    RingBuffer* rb = (RingBuffer*)malloc(sizeof(RingBuffer));
+    if (!rb) {
+        return NULL;
+    }
+    
+    // Initialize the structure
+    memset(rb, 0, sizeof(RingBuffer));
+    rb->consumer_id = consumer_id;
+    
+    // Store the shared memory name
+    rb->shm_name = strdup(shm_name);
+    if (!rb->shm_name) {
+        free(rb);
+        return NULL;
+    }
+    
+    // Create shared memory path
+    char shm_path[256];
+    snprintf(shm_path, sizeof(shm_path), "/dev/shm/%s", shm_name);
+    
+    // Open existing shared memory object
+    rb->fd = open(shm_path, O_RDWR, 0666);
+    if (rb->fd == -1) {
+        free(rb->shm_name);
+        free(rb);
+        return NULL;
+    }
+    
+    // Get the file size to determine buffer size
+    struct stat sb;
+    if (fstat(rb->fd, &sb) == -1) {
+        close(rb->fd);
+        free(rb->shm_name);
+        free(rb);
+        return NULL;
+    }
+    
+    rb->mmap_size = sb.st_size;
+    size_t header_size = sizeof(atomic_size_t) * (1 + SHM_IPC_MAX_CONSUMERS + 1);
+    rb->buffer_size = rb->mmap_size - header_size;
+    
+    // Memory map the shared object
+    rb->mmap_addr = mmap(NULL, rb->mmap_size, PROT_READ | PROT_WRITE, MAP_SHARED, rb->fd, 0);
+    if (rb->mmap_addr == MAP_FAILED) {
+        close(rb->fd);
+        free(rb->shm_name);
+        free(rb);
+        return NULL;
+    }
+    
+    // Setup pointers to the mapped memory
+    rb->write_index = (atomic_size_t*)rb->mmap_addr;
+    for (int i = 0; i < SHM_IPC_MAX_CONSUMERS; i++) {
+        rb->read_indices[i] = (atomic_size_t*)((uint8_t*)rb->mmap_addr + sizeof(atomic_size_t) * (i + 1));
+    }
+    rb->consumer_active = (atomic_size_t*)((uint8_t*)rb->mmap_addr + sizeof(atomic_size_t) * (1 + SHM_IPC_MAX_CONSUMERS));
+    rb->data = (uint8_t*)rb->mmap_addr + header_size;
+    
+    // Mark this consumer as active
+    atomic_fetch_or(rb->consumer_active, 1 << consumer_id);
+    
+    return rb;
+}
+
+/**
+ * Opens an existing shared memory ring buffer (consumer 0)
+ */
+RingBuffer* shm_ipc_open(const char* shm_name) {
+    return shm_ipc_open_consumer(shm_name, 0);
+}
+
+/**
+ * Resets a consumer's read index to the current write position
+ */
+bool shm_ipc_reset_consumer(RingBuffer* rb, int consumer_id) {
+    if (!rb || consumer_id < 0 || consumer_id >= SHM_IPC_MAX_CONSUMERS) {
+        return false;
+    }
+    
+    size_t write_idx = atomic_load(rb->write_index);
+    atomic_store(rb->read_indices[consumer_id], write_idx);
+    
+    return true;
+}
+
+/**
+ * Finds the minimum read index among active consumers
+ * Returns write_idx if no consumers are active
+ */
+static size_t find_min_read_index(const RingBuffer* rb) {
+    size_t write_idx = atomic_load(rb->write_index);
+    size_t active_mask = atomic_load(rb->consumer_active);
+    
+    if (active_mask == 0) {
+        return write_idx; // No active consumers
+    }
+    
+    // We need to be careful about comparing indices in a ring buffer,
+    // especially when determining the minimum.
+    
+    // First, count active consumers and collect their read indices
+    size_t indices[SHM_IPC_MAX_CONSUMERS];
+    int count = 0;
+    
+    for (int i = 0; i < SHM_IPC_MAX_CONSUMERS; i++) {
+        if (active_mask & (1 << i)) {
+            indices[count++] = atomic_load(rb->read_indices[i]);
+        }
+    }
+    
+    if (count == 0) {
+        return write_idx; // No active consumers
+    }
+    
+    // For a ring buffer, the "minimum" depends on the position of the write pointer.
+    // We need to find the index that would be encountered first when moving
+    // backward from the write pointer.
+    
+    // First, find the minimum index among those that are <= write_idx
+    size_t min_le = write_idx;
+    bool found_le = false;
+    
+    for (int i = 0; i < count; i++) {
+        size_t idx = indices[i];
+        if (idx <= write_idx && (!found_le || idx < min_le)) {
+            min_le = idx;
+            found_le = true;
+        }
+    }
+    
+    // Now find the maximum index among those that are > write_idx
+    size_t max_gt = 0;
+    bool found_gt = false;
+    
+    for (int i = 0; i < count; i++) {
+        size_t idx = indices[i];
+        if (idx > write_idx && (!found_gt || idx > max_gt)) {
+            max_gt = idx;
+            found_gt = true;
+        }
+    }
+    
+    // If we found indices <= write_idx, the minimum is the smallest of these
+    if (found_le) {
+        return min_le;
+    }
+    
+    // Otherwise, it's the largest of the indices > write_idx
+    if (found_gt) {
+        return max_gt;
+    }
+    
+    // This should never happen if count > 0
+    return write_idx;
+}
+
+/**
+ * Calculates available space considering buffer wrapping correctly
+ */
+static size_t calculate_available_space(const RingBuffer* rb, size_t write_idx, size_t min_read_idx) {
+    // In a ring buffer, available space depends on the relative positions of 
+    // write_idx and min_read_idx.
+    
+    if (min_read_idx == write_idx) {
+        // Either buffer is completely empty or completely full.
+        // Since this is called from write operations, we assume empty.
+        return rb->buffer_size - 1; // Keep one byte free
+    }
+    
+    if (min_read_idx > write_idx) {
+        // Read index is ahead of write index - we have a clear run
+        // [===W-----R===]
+        return min_read_idx - write_idx - 1;
+    } else {
+        // Write index is ahead of read index - we have to wrap around
+        // [---R=====W---]
+        return rb->buffer_size - (write_idx - min_read_idx) - 1;
+    }
+}
+
+/**
+ * Writes data to the ring buffer
+ */
+bool shm_ipc_write(RingBuffer* rb, const uint8_t* data, size_t len) {
+    if (!rb || !data || len == 0) {
+        return false;
+    }
+    
+    // Only the producer can write
+    if (rb->consumer_id != -1) {
+        return false;
+    }
+    
+    // Check if buffer is big enough for this message
+    if (len >= rb->buffer_size) {
+        return false; // Message too large for buffer
+    }
+    
+    size_t write_idx = atomic_load(rb->write_index);
+    size_t min_read_idx = find_min_read_index(rb);
+    
+    // Calculate available space
+    size_t available_space = calculate_available_space(rb, write_idx, min_read_idx);
+    
+    if (available_space < len) {
+        return false; // Not enough space
+    }
+    
+    // Handle wrap-around case
+    if (write_idx + len > rb->buffer_size) {
+        size_t first_chunk_size = rb->buffer_size - write_idx;
+        size_t second_chunk_size = len - first_chunk_size;
+        
+        // Write first chunk up to end of buffer
+        memcpy(rb->data + write_idx, data, first_chunk_size);
+        
+        // Write second chunk from start of buffer
+        if (second_chunk_size > 0) {
+            memcpy(rb->data, data + first_chunk_size, second_chunk_size);
+        }
+        
+        // Update write index - atomic store ensures visibility to consumers
+        atomic_store(rb->write_index, second_chunk_size);
+    } else {
+        // No wrap-around needed
+        memcpy(rb->data + write_idx, data, len);
+        
+        // Update write index
+        size_t new_write_idx = write_idx + len;
+        if (new_write_idx == rb->buffer_size) {
+            new_write_idx = 0; // Wrap exactly at buffer end
+        }
+        atomic_store(rb->write_index, new_write_idx);
+    }
+    
+    return true;
+}
+
+/**
+ * Reads data from the ring buffer
+ */
+int shm_ipc_read(RingBuffer* rb, uint8_t* buffer, size_t max_len) {
+    if (!rb || !buffer || max_len == 0) {
+        return -1;
+    }
+    
+    // Make sure this is a consumer
+    if (rb->consumer_id < 0 || rb->consumer_id >= SHM_IPC_MAX_CONSUMERS) {
+        return -1;
+    }
+    
+    size_t write_idx = atomic_load(rb->write_index);
+    size_t read_idx = atomic_load(rb->read_indices[rb->consumer_id]);
+    
+    if (read_idx == write_idx) {
+        return 0; // Buffer empty for this consumer
+    }
+    
+    // Calculate available data (need to handle wrap-around)
+    size_t available_data;
+    if (write_idx > read_idx) {
+        available_data = write_idx - read_idx;
+    } else {
+        available_data = rb->buffer_size - read_idx + write_idx;
+    }
+    
+    size_t bytes_to_read = (max_len < available_data) ? max_len : available_data;
+    
+    // Handle wrap-around case
+    if (read_idx + bytes_to_read > rb->buffer_size) {
+        size_t first_chunk_size = rb->buffer_size - read_idx;
+        size_t second_chunk_size = bytes_to_read - first_chunk_size;
+        
+        // Read first chunk from end of buffer
+        memcpy(buffer, rb->data + read_idx, first_chunk_size);
+        
+        // Read second chunk from start of buffer
+        if (second_chunk_size > 0) {
+            memcpy(buffer + first_chunk_size, rb->data, second_chunk_size);
+        }
+        
+        // Update read index
+        atomic_store(rb->read_indices[rb->consumer_id], second_chunk_size);
+    } else {
+        // No wrap-around needed
+        memcpy(buffer, rb->data + read_idx, bytes_to_read);
+        
+        // Update read index
+        size_t new_read_idx = read_idx + bytes_to_read;
+        if (new_read_idx == rb->buffer_size) {
+            new_read_idx = 0; // Wrap exactly at buffer end
+        }
+        atomic_store(rb->read_indices[rb->consumer_id], new_read_idx);
+    }
+    
+    return bytes_to_read;
+}
+
+/**
+ * Returns the number of bytes available to read
+ */
+size_t shm_ipc_available(const RingBuffer* rb) {
+    if (!rb) {
+        return 0;
+    }
+    
+    // Make sure this is a consumer
+    if (rb->consumer_id < 0 || rb->consumer_id >= SHM_IPC_MAX_CONSUMERS) {
+        return 0;
+    }
+    
+    size_t write_idx = atomic_load(rb->write_index);
+    size_t read_idx = atomic_load(rb->read_indices[rb->consumer_id]);
+    
+    if (write_idx >= read_idx) {
+        return write_idx - read_idx;
+    } else {
+        return rb->buffer_size - read_idx + write_idx;
+    }
+}
+
+/**
+ * Returns the free space available for writing
+ */
+size_t shm_ipc_free_space(const RingBuffer* rb) {
+    if (!rb) {
+        return 0;
+    }
+    
+    // Only the producer can check free space
+    if (rb->consumer_id != -1) {
+        return 0;
+    }
+    
+    size_t write_idx = atomic_load(rb->write_index);
+    size_t min_read_idx = find_min_read_index(rb);
+    
+    return calculate_available_space(rb, write_idx, min_read_idx);
+}
+
+/**
+ * Returns the total size of the buffer
+ */
+size_t shm_ipc_buffer_size(const RingBuffer* rb) {
+    if (!rb) {
+        return 0;
+    }
+    
+    return rb->buffer_size;
+}
+
+/**
+ * Returns the consumer ID
+ */
+int shm_ipc_get_consumer_id(const RingBuffer* rb) {
+    if (!rb) {
+        return -1;
+    }
+    
+    return rb->consumer_id;
+}
+
+/**
+ * Returns the number of active consumers
+ */
+int shm_ipc_get_consumer_count(const RingBuffer* rb) {
+    if (!rb) {
+        return 0;
+    }
+    
+    size_t active_mask = atomic_load(rb->consumer_active);
+    int count = 0;
+    
+    for (int i = 0; i < SHM_IPC_MAX_CONSUMERS; i++) {
+        if (active_mask & (1 << i)) {
+            count++;
+        }
+    }
+    
+    return count;
+}
+
+/**
+ * Destroys the ring buffer
+ */
+void shm_ipc_destroy(RingBuffer* rb) {
+    if (!rb) {
+        return;
+    }
+    
+    // If this is a consumer, mark it as inactive
+    if (rb->consumer_id >= 0 && rb->consumer_id < SHM_IPC_MAX_CONSUMERS) {
+        atomic_fetch_and(rb->consumer_active, ~(1 << rb->consumer_id));
+    }
+    
+    if (rb->mmap_addr != MAP_FAILED && rb->mmap_addr != NULL) {
+        munmap(rb->mmap_addr, rb->mmap_size);
+    }
+    
+    if (rb->fd != -1) {
+        close(rb->fd);
+    }
+    
+    free(rb->shm_name);
+    free(rb);
+}
+
+/**
+ * Writes a complete message to the ring buffer with message framing
+ * Format: [message_length (4 bytes)][message_data (n bytes)]
+ */
+bool shm_ipc_write_message(RingBuffer* rb, const uint8_t* data, size_t len) {
+    if (!rb || !data || len == 0 || len > SHM_IPC_MAX_MESSAGE_SIZE) {
+        return false;
+    }
+    
+    // Only the producer can write
+    if (rb->consumer_id != -1) {
+        return false;
+    }
+    
+    // Calculate total size needed for the message with header
+    size_t total_size = MESSAGE_HEADER_SIZE + len;
+    
+    // Check if buffer is big enough for this message
+    if (total_size >= rb->buffer_size) {
+        return false; // Message too large for buffer
+    }
+    
+    // Get current write position and calculate available space
+    size_t write_idx = atomic_load(rb->write_index);
+    size_t min_read_idx = find_min_read_index(rb);
+    size_t available_space = calculate_available_space(rb, write_idx, min_read_idx);
+    
+    if (available_space < total_size) {
+        return false; // Not enough space
+    }
+    
+    // First write the message length (4 bytes)
+    uint32_t msg_len = (uint32_t)len;
+    
+    // Handle wrap-around for the header
+    if (write_idx + MESSAGE_HEADER_SIZE > rb->buffer_size) {
+        // Header wraps around
+        size_t first_chunk = rb->buffer_size - write_idx;
+        size_t second_chunk = MESSAGE_HEADER_SIZE - first_chunk;
+        
+        memcpy(rb->data + write_idx, &msg_len, first_chunk);
+        memcpy(rb->data, ((uint8_t*)&msg_len) + first_chunk, second_chunk);
+        
+        write_idx = second_chunk;
+    } else {
+        // Header fits without wrapping
+        memcpy(rb->data + write_idx, &msg_len, MESSAGE_HEADER_SIZE);
+        write_idx = (write_idx + MESSAGE_HEADER_SIZE) % rb->buffer_size;
+    }
+    
+    // Now write the message data
+    if (write_idx + len > rb->buffer_size) {
+        // Message data wraps around
+        size_t first_chunk = rb->buffer_size - write_idx;
+        size_t second_chunk = len - first_chunk;
+        
+        memcpy(rb->data + write_idx, data, first_chunk);
+        memcpy(rb->data, data + first_chunk, second_chunk);
+        
+        // Update write index
+        atomic_store(rb->write_index, second_chunk);
+    } else {
+        // Message data fits without wrapping
+        memcpy(rb->data + write_idx, data, len);
+        
+        // Update write index
+        size_t new_write_idx = write_idx + len;
+        if (new_write_idx == rb->buffer_size) {
+            new_write_idx = 0;
+        }
+        atomic_store(rb->write_index, new_write_idx);
+    }
+    
+    return true;
+}
+
+/**
+ * Helper function to peek at bytes from the ring buffer without advancing the read index
+ */
+static bool peek_bytes(const RingBuffer* rb, size_t read_idx, void* buffer, size_t len) {
+    if (!rb || !buffer || len == 0) {
+        return false;
+    }
+    
+    // Check if there's enough data to peek
+    size_t write_idx = atomic_load(rb->write_index);
+    size_t available;
+    
+    if (write_idx >= read_idx) {
+        available = write_idx - read_idx;
+    } else {
+        available = rb->buffer_size - read_idx + write_idx;
+    }
+    
+    if (available < len) {
+        return false;
+    }
+    
+    // Copy the data without advancing the read index
+    if (read_idx + len > rb->buffer_size) {
+        // Data wraps around
+        size_t first_chunk = rb->buffer_size - read_idx;
+        size_t second_chunk = len - first_chunk;
+        
+        memcpy(buffer, rb->data + read_idx, first_chunk);
+        memcpy((uint8_t*)buffer + first_chunk, rb->data, second_chunk);
+    } else {
+        // Data fits without wrapping
+        memcpy(buffer, rb->data + read_idx, len);
+    }
+    
+    return true;
+}
+
+/**
+ * Checks if a complete message is available for reading
+ */
+bool shm_ipc_message_available(const RingBuffer* rb, size_t* message_size) {
+    if (!rb) {
+        return false;
+    }
+    
+    // Make sure this is a consumer
+    if (rb->consumer_id < 0 || rb->consumer_id >= SHM_IPC_MAX_CONSUMERS) {
+        return false;
+    }
+    
+    // Get current read position
+    size_t read_idx = atomic_load(rb->read_indices[rb->consumer_id]);
+    
+    // Try to read message length
+    uint32_t msg_len;
+    if (!peek_bytes(rb, read_idx, &msg_len, MESSAGE_HEADER_SIZE)) {
+        return false; // Not enough data for message header
+    }
+    
+    // Calculate total message size (header + data)
+    size_t total_size = MESSAGE_HEADER_SIZE + msg_len;
+    
+    // Check if we have the complete message
+    size_t write_idx = atomic_load(rb->write_index);
+    size_t available;
+    
+    if (write_idx >= read_idx) {
+        available = write_idx - read_idx;
+    } else {
+        available = rb->buffer_size - read_idx + write_idx;
+    }
+    
+    if (available < total_size) {
+        return false; // Don't have the complete message yet
+    }
+    
+    // If message_size pointer is provided, return the message data size
+    if (message_size != NULL) {
+        *message_size = msg_len;
+    }
+    
+    return true;
+}
+
+/**
+ * Reads a complete message from the ring buffer
+ */
+bool shm_ipc_read_message(RingBuffer* rb, uint8_t* buffer, size_t buffer_size, size_t* message_size) {
+    if (!rb || !buffer || buffer_size == 0) {
+        return false;
+    }
+    
+    // Make sure this is a consumer
+    if (rb->consumer_id < 0 || rb->consumer_id >= SHM_IPC_MAX_CONSUMERS) {
+        return false;
+    }
+    
+    // Check if a message is available and get its size
+    size_t msg_len;
+    if (!shm_ipc_message_available(rb, &msg_len)) {
+        return false; // No complete message available
+    }
+    
+    // Check if our buffer is large enough
+    if (buffer_size < msg_len) {
+        return false; // Buffer too small
+    }
+    
+    // Get current read position
+    size_t read_idx = atomic_load(rb->read_indices[rb->consumer_id]);
+    
+    // Skip over the message length header
+    if (read_idx + MESSAGE_HEADER_SIZE > rb->buffer_size) {
+        // Header wraps around
+        read_idx = (read_idx + MESSAGE_HEADER_SIZE) - rb->buffer_size;
+    } else {
+        read_idx = (read_idx + MESSAGE_HEADER_SIZE);
+    }
+    
+    // Read the message data
+    if (read_idx + msg_len > rb->buffer_size) {
+        // Message data wraps around
+        size_t first_chunk = rb->buffer_size - read_idx;
+        size_t second_chunk = msg_len - first_chunk;
+        
+        memcpy(buffer, rb->data + read_idx, first_chunk);
+        memcpy(buffer + first_chunk, rb->data, second_chunk);
+        
+        // Update read index
+        atomic_store(rb->read_indices[rb->consumer_id], second_chunk);
+    } else {
+        // Message data fits without wrapping
+        memcpy(buffer, rb->data + read_idx, msg_len);
+        
+        // Update read index
+        size_t new_read_idx = read_idx + msg_len;
+        if (new_read_idx == rb->buffer_size) {
+            new_read_idx = 0;
+        }
+        atomic_store(rb->read_indices[rb->consumer_id], new_read_idx);
+    }
+    
+    // If message_size pointer is provided, return the message data size
+    if (message_size != NULL) {
+        *message_size = msg_len;
+    }
+    
+    return true;
+} 
