+TEST_CASE("SharedRingBuffer message framing", "[shared_ringbuffer][messaging]") {
+  const std::string test_name = "test_messaging";
+  
+  // Randomize buffer size between 1KB and 32KB
+  std::random_device rd;
+  std::mt19937 gen(rd());
+  std::uniform_int_distribution<> buffer_size_dist(1024, 32 * 1024);
+  const size_t buffer_size = buffer_size_dist(gen);
+  
+  std::cout << "Message framing test with buffer size: " << buffer_size << " bytes" << std::endl;
+  
+  // Create producer and consumer
+  SharedRingBuffer producer(test_name, buffer_size);
+  auto consumer = SharedRingBuffer::open_consumer(test_name, 0);
+  
+  SECTION("Basic message framing") {
+    // Test basic write/read message
+    std::vector<uint8_t> test_message = {1, 2, 3, 4, 5};
+    
+    REQUIRE(producer.write_message(test_message));
+    
+    // Check if message is available
+    auto msg_size_opt = consumer.message_available();
+    REQUIRE(msg_size_opt.has_value());
+    REQUIRE(msg_size_opt.value() == test_message.size());
+    
+    // Read the message
+    auto received = consumer.read_message();
+    REQUIRE(received == test_message);
+    
+    // No more messages available
+    REQUIRE_FALSE(consumer.message_available().has_value());
+  }
+  
+  SECTION("Multiple messages") {
+    // Write multiple messages of different sizes
+    std::vector<std::vector<uint8_t>> messages;
+    
+    // Generate 5 messages with random sizes (smaller max size to ensure it fits in buffer)
+    std::uniform_int_distribution<> msg_size_dist(10, 500);
+    for (int i = 0; i < 5; i++) {
+      size_t size = msg_size_dist(gen);
+      std::vector<uint8_t> msg(size);
+      
+      // Fill with pattern where first byte is the message number
+      msg[0] = static_cast<uint8_t>(i);
+      for (size_t j = 1; j < size; j++) {
+        msg[j] = static_cast<uint8_t>(gen() & 0xFF);
+      }
+      
+      messages.push_back(msg);
+      
+      // Write message
+      REQUIRE(producer.write_message(msg));
+      
+      std::cout << "Wrote message " << i << " with size " << size << std::endl;
+    }
+    
+    // Read all messages and verify
+    for (int i = 0; i < 5; i++) {
+      // Check if message is available
+      auto msg_size_opt = consumer.message_available();
+      REQUIRE(msg_size_opt.has_value());
+      REQUIRE(msg_size_opt.value() == messages[i].size());
+      
+      // Read message
+      auto received = consumer.read_message();
+      REQUIRE(received.size() == messages[i].size());
+      REQUIRE(received[0] == static_cast<uint8_t>(i)); // Check message identifier
+      REQUIRE(received == messages[i]);
+      
+      std::cout << "Read message " << i << " with size " << received.size() << std::endl;
+    }
+    
+    // No more messages
+    REQUIRE_FALSE(consumer.message_available().has_value());
+  }
+  
+  SECTION("Message wrapping") {
+    // Write a message that will wrap around the buffer
+    
+    // First fill most of the buffer (80%) with a regular write to advance the write pointer
+    size_t filler_size = buffer_size * 0.8;
+    std::vector<uint8_t> filler(filler_size);
+    std::generate(filler.begin(), filler.end(), [&gen]() { 
+      return static_cast<uint8_t>(gen() & 0xFF); 
+    });
+    
+    producer.write(filler);
+    
+    // Now read the filler to free up space
+    consumer.read(filler.size());
+    
+    // Generate a message that's 50% of buffer size
+    size_t message_size = buffer_size * 0.5;
+    std::vector<uint8_t> wrapped_message(message_size);
+    std::generate(wrapped_message.begin(), wrapped_message.end(), [&gen]() { 
+      return static_cast<uint8_t>(gen() & 0xFF); 
+    });
+    
+    // Write the message - this should wrap around the buffer
+    REQUIRE(producer.write_message(wrapped_message));
+    
+    // Read the message
+    auto received = consumer.read_message();
+    REQUIRE(received.size() == wrapped_message.size());
+    REQUIRE(received == wrapped_message);
+  }
+  
+  SECTION("Maximum sized message") {
+    // Create a message that's reasonably large but smaller than buffer size
+    // The header is 4 bytes, and we need to leave space to avoid buffer issues
+    size_t max_message_size = std::min(buffer_size / 2, static_cast<size_t>(4096));
+    std::vector<uint8_t> large_message(max_message_size);
+    
+    // Fill with pattern
+    for (size_t i = 0; i < max_message_size; i++) {
+      large_message[i] = static_cast<uint8_t>(i & 0xFF);
+    }
+    
+    // Write the message
+    REQUIRE(producer.write_message(large_message));
+    
+    // Read the message
+    auto received = consumer.read_message();
+    REQUIRE(received.size() == large_message.size());
+    
+    // Verify pattern
+    for (size_t i = 0; i < max_message_size; i++) {
+      REQUIRE(received[i] == static_cast<uint8_t>(i & 0xFF));
+    }
+  }
+  
+  SECTION("Interleaved raw and message reads/writes") {
+    // Test mixing regular reads/writes with message reads/writes
+    
+    // Write a raw chunk of data
+    std::vector<uint8_t> raw_data = {10, 20, 30, 40, 50};
+    producer.write(raw_data);
+    
+    // Write a message
+    std::vector<uint8_t> message = {60, 70, 80, 90, 100};
+    REQUIRE(producer.write_message(message));
+    
+    // Read raw data
+    auto received_raw = consumer.read(raw_data.size());
+    REQUIRE(received_raw == raw_data);
+    
+    // Read message
+    auto received_msg = consumer.read_message();
+    REQUIRE(received_msg == message);
+    
+    // Do it again in reverse order
+    std::vector<uint8_t> message2 = {1, 3, 5, 7, 9};
+    REQUIRE(producer.write_message(message2));
+    
+    std::vector<uint8_t> raw_data2 = {2, 4, 6, 8, 10};
+    producer.write(raw_data2);
+    
+    // Read message first
+    auto received_msg2 = consumer.read_message();
+    REQUIRE(received_msg2 == message2);
+    
+    // Read raw data
+    auto received_raw2 = consumer.read(raw_data2.size());
+    REQUIRE(received_raw2 == raw_data2);
+  }
+  
+  SECTION("Random-sized messages") {
+    // Generate and write random-sized messages
+    std::uniform_int_distribution<> count_dist(5, 10);
+    int message_count = count_dist(gen);
+    
+    std::vector<std::vector<uint8_t>> messages;
+    
+    for (int i = 0; i < message_count; i++) {
+      // Random message size from 1 byte to 5% of buffer (to ensure it fits)
+      std::uniform_int_distribution<> size_dist(1, std::min(static_cast<size_t>(buffer_size / 20), static_cast<size_t>(500)));
+      size_t size = size_dist(gen);
+      
+      std::vector<uint8_t> msg(size);
+      std::generate(msg.begin(), msg.end(), [&gen]() { 
+        return static_cast<uint8_t>(gen() & 0xFF); 
+      });
+      
+      // Mark first byte with message number so we can verify order
+      if (!msg.empty()) {
+        msg[0] = static_cast<uint8_t>(i & 0xFF);
+      }
+      
+      messages.push_back(msg);
+      
+      // Write message
+      REQUIRE(producer.write_message(msg));
+    }
+    
+    std::cout << "Wrote " << message_count << " random-sized messages" << std::endl;
+    
+    // Read all messages back
+    for (int i = 0; i < message_count; i++) {
+      auto msg_size_opt = consumer.message_available();
+      REQUIRE(msg_size_opt.has_value());
+      REQUIRE(msg_size_opt.value() == messages[i].size());
+      
+      auto received = consumer.read_message();
+      REQUIRE(received.size() == messages[i].size());
+      if (!received.empty()) {
+        REQUIRE(received[0] == static_cast<uint8_t>(i & 0xFF));
+      }
+      REQUIRE(received == messages[i]);
+    }
+    
+    // No more messages
+    REQUIRE_FALSE(consumer.message_available().has_value());
+  }
+}
