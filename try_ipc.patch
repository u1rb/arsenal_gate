+TEST_CASE("SharedRingBuffer basic operations", "[shared_ringbuffer]") {
+  const std::string test_name = "test_basic_ops";
+  
+  // Randomize buffer size between 512 and 8192 bytes
+  std::random_device rd;
+  std::mt19937 gen(rd());
+  std::uniform_int_distribution<> buffer_size_dist(512, 8192);
+  const size_t buffer_size = buffer_size_dist(gen);
+  std::cout << "Basic ops test with buffer size: " << buffer_size << " bytes" << std::endl;
+
+  // Create a new shared memory buffer (producer)
+  SharedRingBuffer producer(test_name, buffer_size);
+  
+  // Also open a consumer to read data
+  auto consumer = SharedRingBuffer::open_consumer(test_name, 0);
+
+  SECTION("Buffer properties") {
+    REQUIRE(producer.name() == test_name);
+    REQUIRE(producer.buffer_size() >= buffer_size);
+    REQUIRE(producer.is_producer() == true);
+    REQUIRE(consumer.is_producer() == false);
+    REQUIRE(consumer.available() == 0);
+    REQUIRE(producer.free_space() > 0);
+  }
+
+  SECTION("Write and read data") {
+    // Generate random test data size between 1-100 bytes
+    std::uniform_int_distribution<> size_dist(1, 100);
+    size_t test_data_size = size_dist(gen);
+    
+    std::vector<uint8_t> test_data(test_data_size);
+    std::generate(test_data.begin(), test_data.end(), [&gen]() { 
+      return static_cast<uint8_t>(gen() & 0xFF); 
+    });
+
+    size_t written = producer.write(test_data);
+    REQUIRE(written == test_data.size());
+    REQUIRE(consumer.available() == test_data.size());
+
+    auto read_data = consumer.read(test_data_size + 10); // Try to read more than available
+    REQUIRE(read_data.size() == test_data.size());
+    REQUIRE(read_data == test_data);
+    REQUIRE(consumer.available() == 0);
+  }
+
+  SECTION("Multiple write and read operations") {
+    // Generate different sized random data chunks
+    std::uniform_int_distribution<> size_dist(10, 100);
+    std::vector<uint8_t> data1(size_dist(gen));
+    std::vector<uint8_t> data2(size_dist(gen));
+    
+    std::generate(data1.begin(), data1.end(), [&gen]() { 
+      return static_cast<uint8_t>(gen() & 0xFF); 
+    });
+    std::generate(data2.begin(), data2.end(), [&gen]() { 
+      return static_cast<uint8_t>(gen() & 0xFF); 
+    });
+
+    producer.write(data1);
+    producer.write(data2);
+
+    REQUIRE(consumer.available() == data1.size() + data2.size());
+
+    auto read1 = consumer.read(data1.size());
+    REQUIRE(read1 == data1);
+
+    auto read2 = consumer.read(data2.size());
+    REQUIRE(read2 == data2);
+
+    REQUIRE(consumer.available() == 0);
+  }
+
+  SECTION("Buffer wrapping") {
+    // Fill most of the buffer with random percentage
+    std::uniform_int_distribution<> fill_pct_dist(40, 70);
+    int fill_percentage = fill_pct_dist(gen);
+    size_t first_chunk_size = buffer_size * fill_percentage / 100;
+    
+    std::vector<uint8_t> large_data(first_chunk_size);
+    std::generate(large_data.begin(), large_data.end(), [&gen]() {
+      return static_cast<uint8_t>(gen() & 0xFF);
+    });
+
+    producer.write(large_data);
+    auto read_large = consumer.read(large_data.size());
+    REQUIRE(read_large == large_data);
+
+    // Write more data to force wrapping with a random size
+    std::uniform_int_distribution<> wrap_size_dist(
+        buffer_size/8, buffer_size/3);  // Between 1/8 and 1/3 of buffer size
+    size_t wrap_data_size = wrap_size_dist(gen);
+    
+    std::vector<uint8_t> wrap_data(wrap_data_size);
+    std::generate(wrap_data.begin(), wrap_data.end(), [&gen]() {
+      return static_cast<uint8_t>(gen() & 0xFF);
+    });
+
+    // Do multiple writes that will eventually force a wrap
+    for (int i = 0; i < 3; i++) {
+      producer.write(wrap_data);
+      auto read_wrap = consumer.read(wrap_data.size());
+      REQUIRE(read_wrap == wrap_data);
+    }
+    
+    // Test near-exact buffer size to check boundary conditions
+    std::uniform_int_distribution<> boundary_dist(
+        buffer_size - 20, buffer_size + 20);
+    size_t boundary_size = std::min(static_cast<size_t>(boundary_dist(gen)), buffer_size - 1);
+    
+    std::vector<uint8_t> boundary_data(boundary_size);
+    std::generate(boundary_data.begin(), boundary_data.end(), [&gen]() {
+      return static_cast<uint8_t>(gen() & 0xFF);
+    });
+    
+    // This should either succeed if space is available or fail gracefully
+    size_t written = producer.write(boundary_data);
+    if (written > 0) {
+      auto read_boundary = consumer.read(written);
+      REQUIRE(read_boundary.size() == written);
+      for (size_t i = 0; i < written; i++) {
+        REQUIRE(read_boundary[i] == boundary_data[i]);
+      }
+    }
+  }
+}
+
+TEST_CASE("SharedRingBuffer IPC between processes",
+          "[shared_ringbuffer][ipc]") {
+  const std::string test_name = "test_ipc";
+  const size_t buffer_size = 4096;
+
+  SECTION("Consumer opens existing buffer") {
+    // Create the buffer first
+    {
+      SharedRingBuffer producer(test_name, buffer_size);
+      std::vector<uint8_t> data = {1, 2, 3, 4, 5};
+      producer.write(data);
+    }
+
+    // Now open it as a consumer
+    SharedRingBuffer consumer = SharedRingBuffer::open(test_name);
+    REQUIRE(consumer.available() == 5);
+    auto data = consumer.read(5);
+    REQUIRE(data == std::vector<uint8_t>{1, 2, 3, 4, 5});
+  }
+}
+
+TEST_CASE("SharedRingBuffer performance", "[shared_ringbuffer][performance]") {
+  const std::string test_name = "test_perf";
+  // Randomize buffer size between 512KB and 2MB
+  std::random_device rd;
+  std::mt19937 gen(rd());
+  std::uniform_int_distribution<> buffer_size_dist(512 * 1024, 2 * 1024 * 1024);
+  const size_t buffer_size = buffer_size_dist(gen); // Random buffer size
+  std::cout << "Using random buffer size: " << (buffer_size / 1024) << " KB" << std::endl;
+
+  SharedRingBuffer producer(test_name, buffer_size);
+  auto consumer = SharedRingBuffer::open(test_name);
+
+  SECTION("Large data transfer") {
+    const size_t total_data = 10 * 1024 * 1024; // 10MB
+    // Random chunk sizes between 16KB and 128KB
+    std::uniform_int_distribution<> chunk_dist(16 * 1024, 128 * 1024);
+
+    // Random delay between operations (0-5ms)
+    std::uniform_int_distribution<> delay_dist(0, 5);
+    
+    // Random data distribution
+    std::uniform_int_distribution<> distrib(0, 255);
+
+    auto start = std::chrono::high_resolution_clock::now();
+
+    // Write data in chunks
+    size_t total_written = 0;
+    while (total_written < total_data) {
+      // Randomize chunk size for each write
+      size_t chunk_size = chunk_dist(gen);
+      std::vector<uint8_t> chunk(chunk_size);
+      
+      // Fill with random data
+      std::generate(chunk.begin(), chunk.end(),
+                  [&]() { return static_cast<uint8_t>(distrib(gen)); });
+
+      size_t written = producer.write(chunk);
+      total_written += written;
+
+      // Random delay to simulate real-world conditions
+      if (delay_dist(gen) == 0) { // 20% chance of delay
+        std::this_thread::sleep_for(std::chrono::milliseconds(delay_dist(gen)));
+      }
+
+      // Read the data back immediately
+      auto read_data = consumer.read(written);
+      REQUIRE(read_data.size() == written);
+      
+      // Random delay for reader too
+      if (delay_dist(gen) == 0) {
+        std::this_thread::sleep_for(std::chrono::milliseconds(delay_dist(gen)));
+      }
+    }
+
+    auto end = std::chrono::high_resolution_clock::now();
+    auto duration =
+        std::chrono::duration_cast<std::chrono::milliseconds>(end - start)
+            .count();
+
+    // Calculate throughput in MB/s
+    double throughput =
+        (static_cast<double>(total_written) / (1024.0 * 1024.0)) /
+        (duration / 1000.0);
+
+    std::cout << "Throughput: " << throughput << " MB/s" << std::endl;
+    REQUIRE(throughput > 0);
+  }
+}
