+#ifndef SHM_IPC_H
+#define SHM_IPC_H
+
+#include <stddef.h>
+#include <stdbool.h>
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+/**
+ * Maximum number of supported consumers
+ */
+#define SHM_IPC_MAX_CONSUMERS 8
+
+/**
+ * Maximum message size
+ */
+#define SHM_IPC_MAX_MESSAGE_SIZE (1024 * 1024) // 1MB
+
+/**
+ * Ring buffer structure for IPC communication
+ */
+typedef struct RingBuffer RingBuffer;
+
+/**
+ * Creates a new shared memory ring buffer
+ * @param shm_name Name of the shared memory segment
+ * @param size Size of the buffer in bytes, 0 means use default (1MB)
+ * @return Pointer to the ring buffer, or NULL on error
+ */
+RingBuffer* shm_ipc_create(const char* shm_name, size_t size);
+
+/**
+ * Opens an existing shared memory ring buffer as a consumer
+ * @param shm_name Name of the shared memory segment
+ * @param consumer_id ID of the consumer (0 to SHM_IPC_MAX_CONSUMERS-1)
+ * @return Pointer to the ring buffer, or NULL on error
+ */
+RingBuffer* shm_ipc_open_consumer(const char* shm_name, int consumer_id);
+
+/**
+ * Opens an existing shared memory ring buffer (equivalent to consumer_id 0)
+ * @param shm_name Name of the shared memory segment
+ * @return Pointer to the ring buffer, or NULL on error
+ */
+RingBuffer* shm_ipc_open(const char* shm_name);
+
+/**
+ * Resets a consumer's read index to the current write position
+ * @param rb Pointer to the ring buffer
+ * @param consumer_id ID of the consumer (0 to SHM_IPC_MAX_CONSUMERS-1)
+ * @return true if successful, false otherwise
+ */
+bool shm_ipc_reset_consumer(RingBuffer* rb, int consumer_id);
+
+/**
+ * Writes data to the ring buffer
+ * @param rb Pointer to the ring buffer
+ * @param data Data to write
+ * @param len Length of the data
+ * @return true if write was successful, false otherwise
+ */
+bool shm_ipc_write(RingBuffer* rb, const uint8_t* data, size_t len);
+
+/**
+ * Writes a complete message to the ring buffer with message framing
+ * @param rb Pointer to the ring buffer
+ * @param data Message data to write
+ * @param len Length of the message
+ * @return true if write was successful, false otherwise
+ */
+bool shm_ipc_write_message(RingBuffer* rb, const uint8_t* data, size_t len);
+
+/**
+ * Reads data from the ring buffer
+ * @param rb Pointer to the ring buffer
+ * @param buffer Buffer to read into
+ * @param max_len Maximum number of bytes to read
+ * @return Number of bytes read, or -1 on error
+ */
+int shm_ipc_read(RingBuffer* rb, uint8_t* buffer, size_t max_len);
+
+/**
+ * Reads a complete message from the ring buffer
+ * This function reads a message that was written using shm_ipc_write_message
+ * @param rb Pointer to the ring buffer
+ * @param buffer Buffer to read the message into
+ * @param buffer_size Size of the provided buffer
+ * @param message_size Optional pointer to receive the actual message size
+ * @return true if a message was read successfully, false if no message available or error
+ */
+bool shm_ipc_read_message(RingBuffer* rb, uint8_t* buffer, size_t buffer_size, size_t* message_size);
+
+/**
+ * Checks if a complete message is available for reading
+ * @param rb Pointer to the ring buffer
+ * @param message_size Optional pointer to receive the size of the next message
+ * @return true if a complete message is available, false otherwise
+ */
+bool shm_ipc_message_available(const RingBuffer* rb, size_t* message_size);
+
+/**
+ * Returns the number of bytes available to read
+ * @param rb Pointer to the ring buffer
+ * @return Number of bytes available
+ */
+size_t shm_ipc_available(const RingBuffer* rb);
+
+/**
+ * Returns the free space available for writing
+ * @param rb Pointer to the ring buffer
+ * @return Number of bytes free
+ */
+size_t shm_ipc_free_space(const RingBuffer* rb);
+
+/**
+ * Returns the total size of the buffer
+ * @param rb Pointer to the ring buffer
+ * @return Total buffer size in bytes
+ */
+size_t shm_ipc_buffer_size(const RingBuffer* rb);
+
+/**
+ * Returns the consumer ID associated with this ring buffer
+ * @param rb Pointer to the ring buffer
+ * @return Consumer ID, or -1 if this is a producer
+ */
+int shm_ipc_get_consumer_id(const RingBuffer* rb);
+
+/**
+ * Returns the number of active consumers
+ * @param rb Pointer to the ring buffer
+ * @return Number of active consumers
+ */
+int shm_ipc_get_consumer_count(const RingBuffer* rb);
+
+/**
+ * Destroys the ring buffer
+ * @param rb Pointer to the ring buffer
+ */
+void shm_ipc_destroy(RingBuffer* rb);
+
+#ifdef __cplusplus
+}
+#endif
+
+#endif /* SHM_IPC_H */ 
