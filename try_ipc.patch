+#pragma once
+
+#include <string>
+#include <vector>
+#include <memory>
+#include <stdexcept>
+#include <cstdint>
+#include <optional>
+
+// Forward declaration of the C RingBuffer struct
+struct RingBuffer;
+
+namespace shm_ipc {
+
+/**
+ * Exception thrown when shared memory operations fail
+ */
+class ShmException : public std::runtime_error {
+public:
+    explicit ShmException(const std::string& message)
+        : std::runtime_error(message) {}
+};
+
+/**
+ * C++ wrapper for the C shared memory IPC ring buffer.
+ * Implements a producer-consumer pattern with shared memory.
+ */
+class SharedRingBuffer {
+public:
+    /**
+     * Creates a new shared memory ring buffer (producer)
+     * @param name Name of the shared memory segment
+     * @param size Size of the buffer in bytes, 0 means use default (1MB)
+     * @throws ShmException if creation fails
+     */
+    SharedRingBuffer(const std::string& name, size_t size = 0);
+    
+    /**
+     * Opens an existing shared memory ring buffer as a specific consumer
+     * @param name Name of the shared memory segment
+     * @param consumer_id ID of the consumer (0 to 7)
+     * @param create_if_not_exists If true, creates the buffer if it doesn't exist
+     * @param size Size of the buffer if creating, ignored otherwise
+     * @throws ShmException if open fails
+     */
+    static SharedRingBuffer open_consumer(const std::string& name, int consumer_id, 
+                                         bool create_if_not_exists = false, 
+                                         size_t size = 0);
+    
+    /**
+     * Opens an existing shared memory ring buffer (as consumer 0)
+     * @param name Name of the shared memory segment
+     * @param create_if_not_exists If true, creates the buffer if it doesn't exist
+     * @param size Size of the buffer if creating, ignored otherwise
+     * @throws ShmException if open fails
+     */
+    static SharedRingBuffer open(const std::string& name, 
+                                bool create_if_not_exists = false, 
+                                size_t size = 0);
+    
+    /**
+     * Resets a consumer's read position to the current write position,
+     * effectively skipping all pending data.
+     * @param consumer_id ID of the consumer to reset, or -1 to reset this consumer
+     * @return true if successful, false otherwise
+     */
+    bool reset_consumer(int consumer_id = -1);
+    
+    /**
+     * Destructor - releases resources
+     */
+    ~SharedRingBuffer();
+    
+    // No copy
+    SharedRingBuffer(const SharedRingBuffer&) = delete;
+    SharedRingBuffer& operator=(const SharedRingBuffer&) = delete;
+    
+    // Move is allowed
+    SharedRingBuffer(SharedRingBuffer&& other) noexcept;
+    SharedRingBuffer& operator=(SharedRingBuffer&& other) noexcept;
+    
+    /**
+     * Writes data to the ring buffer
+     * @param data Data to write
+     * @return Number of bytes written
+     * @throws ShmException if write fails
+     */
+    size_t write(const std::vector<uint8_t>& data);
+    
+    /**
+     * Writes data to the ring buffer
+     * @param data Pointer to data
+     * @param size Size of data
+     * @return Number of bytes written
+     * @throws ShmException if write fails
+     */
+    size_t write(const uint8_t* data, size_t size);
+    
+    /**
+     * Writes a complete message to the ring buffer with message framing
+     * @param data Message data to write
+     * @return true if write was successful, false otherwise
+     * @throws ShmException if write fails
+     */
+    bool write_message(const std::vector<uint8_t>& data);
+    
+    /**
+     * Writes a complete message to the ring buffer with message framing
+     * @param data Pointer to message data
+     * @param size Size of message data
+     * @return true if write was successful, false otherwise
+     * @throws ShmException if write fails
+     */
+    bool write_message(const uint8_t* data, size_t size);
+    
+    /**
+     * Reads data from the ring buffer
+     * @param max_size Maximum number of bytes to read
+     * @return Vector containing the read data
+     * @throws ShmException if read fails
+     */
+    std::vector<uint8_t> read(size_t max_size);
+    
+    /**
+     * Reads data from the ring buffer into a buffer
+     * @param buffer Buffer to read into
+     * @param max_size Maximum number of bytes to read
+     * @return Number of bytes read
+     * @throws ShmException if read fails
+     */
+    size_t read(uint8_t* buffer, size_t max_size);
+    
+    /**
+     * Reads a complete message from the ring buffer
+     * This function reads a message that was written using write_message
+     * @return Vector containing the message data, or empty vector if no message available
+     * @throws ShmException if read fails
+     */
+    std::vector<uint8_t> read_message();
+    
+    /**
+     * Checks if a complete message is available for reading
+     * @return Optional containing the message size, or std::nullopt if no message available
+     */
+    std::optional<size_t> message_available() const;
+    
+    /**
+     * Returns the number of bytes available to read
+     * @return Number of bytes available
+     */
+    size_t available() const;
+    
+    /**
+     * Returns the free space available for writing
+     * @return Number of bytes free
+     */
+    size_t free_space() const;
+    
+    /**
+     * Returns the total buffer size
+     * @return Buffer size in bytes
+     */
+    size_t buffer_size() const;
+    
+    /**
+     * Returns the name of the shared memory segment
+     * @return Name of the shared memory segment
+     */
+    const std::string& name() const { return name_; }
+    
+    /**
+     * Returns the consumer ID or -1 if this is a producer
+     * @return Consumer ID or -1
+     */
+    int consumer_id() const;
+    
+    /**
+     * Returns the number of active consumers
+     * @return Number of active consumers
+     */
+    int consumer_count() const;
+    
+    /**
+     * Returns whether this instance is a producer
+     * @return true if this is a producer, false if this is a consumer
+     */
+    bool is_producer() const { return consumer_id() == -1; }
+
+private:
+    explicit SharedRingBuffer(RingBuffer* rb, const std::string& name);
+    
+    RingBuffer* rb_;
+    std::string name_;
+};
+
+} // namespace shm_ipc 
