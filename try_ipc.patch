index 0000000..97be00a
--- /dev/null
+++ b/src/shm_ipc_wrapper.cpp
@@ -0,0 +1,274 @@
+#include "shm_ipc_wrapper.h"
+#include "shm_ipc.h"
+#include <cstring>
+#include <utility>
+
+namespace shm_ipc {
+
+SharedRingBuffer::SharedRingBuffer(const std::string& name, size_t size)
+    : name_(name) {
+    rb_ = shm_ipc_create(name.c_str(), size);
+    if (!rb_) {
+        throw ShmException("Failed to create shared memory ring buffer");
+    }
+}
+
+SharedRingBuffer SharedRingBuffer::open_consumer(const std::string& name, int consumer_id,
+                                               bool create_if_not_exists, size_t size) {
+    RingBuffer* rb = shm_ipc_open_consumer(name.c_str(), consumer_id);
+    
+    if (!rb && create_if_not_exists) {
+        rb = shm_ipc_create(name.c_str(), size);
+        if (rb) {
+            // The created buffer is a producer, we need to destroy it and open as consumer
+            shm_ipc_destroy(rb);
+            rb = shm_ipc_open_consumer(name.c_str(), consumer_id);
+        }
+    }
+    
+    if (!rb) {
+        throw ShmException("Failed to open shared memory ring buffer as consumer " + std::to_string(consumer_id));
+    }
+    
+    return SharedRingBuffer(rb, name);
+}
+
+SharedRingBuffer SharedRingBuffer::open(const std::string& name, bool create_if_not_exists, size_t size) {
+    return open_consumer(name, 0, create_if_not_exists, size);
+}
+
+bool SharedRingBuffer::reset_consumer(int consumer_id) {
+    if (!rb_) {
+        throw ShmException("Ring buffer is not initialized");
+    }
+    
+    // If consumer_id is -1, use the ID of this consumer
+    if (consumer_id == -1) {
+        consumer_id = shm_ipc_get_consumer_id(rb_);
+        if (consumer_id == -1) {
+            throw ShmException("Cannot reset a producer");
+        }
+    }
+    
+    return shm_ipc_reset_consumer(rb_, consumer_id);
+}
+
+SharedRingBuffer::SharedRingBuffer(RingBuffer* rb, const std::string& name)
+    : rb_(rb), name_(name) {
+}
+
+SharedRingBuffer::~SharedRingBuffer() {
+    if (rb_) {
+        shm_ipc_destroy(rb_);
+        rb_ = nullptr;
+    }
+}
+
+SharedRingBuffer::SharedRingBuffer(SharedRingBuffer&& other) noexcept
+    : rb_(other.rb_), name_(std::move(other.name_)) {
+    other.rb_ = nullptr;
+}
+
+SharedRingBuffer& SharedRingBuffer::operator=(SharedRingBuffer&& other) noexcept {
+    if (this != &other) {
+        if (rb_) {
+            shm_ipc_destroy(rb_);
+        }
+        
+        rb_ = other.rb_;
+        name_ = std::move(other.name_);
+        
+        other.rb_ = nullptr;
+    }
+    return *this;
+}
+
+size_t SharedRingBuffer::write(const std::vector<uint8_t>& data) {
+    return write(data.data(), data.size());
+}
+
+size_t SharedRingBuffer::write(const uint8_t* data, size_t size) {
+    if (!rb_) {
+        throw ShmException("Ring buffer is not initialized");
+    }
+    
+    if (size == 0) {
+        return 0;
+    }
+    
+    if (!is_producer()) {
+        throw ShmException("Only producers can write to the buffer");
+    }
+    
+    bool success = shm_ipc_write(rb_, data, size);
+    if (!success) {
+        // This might be a buffer full condition, which isn't necessarily an error
+        if (shm_ipc_free_space(rb_) < size) {
+            return 0; // Buffer full
+        }
+        throw ShmException("Failed to write to ring buffer");
+    }
+    
+    return size;
+}
+
+std::vector<uint8_t> SharedRingBuffer::read(size_t max_size) {
+    if (!rb_) {
+        throw ShmException("Ring buffer is not initialized");
+    }
+    
+    if (max_size == 0) {
+        return {};
+    }
+    
+    if (is_producer()) {
+        throw ShmException("Only consumers can read from the buffer");
+    }
+    
+    std::vector<uint8_t> buffer(max_size);
+    size_t bytes_read = read(buffer.data(), max_size);
+    buffer.resize(bytes_read);
+    return buffer;
+}
+
+size_t SharedRingBuffer::read(uint8_t* buffer, size_t max_size) {
+    if (!rb_) {
+        throw ShmException("Ring buffer is not initialized");
+    }
+    
+    if (max_size == 0 || !buffer) {
+        return 0;
+    }
+    
+    if (is_producer()) {
+        throw ShmException("Only consumers can read from the buffer");
+    }
+    
+    int result = shm_ipc_read(rb_, buffer, max_size);
+    if (result < 0) {
+        throw ShmException("Failed to read from ring buffer");
+    }
+    
+    return static_cast<size_t>(result);
+}
+
+size_t SharedRingBuffer::available() const {
+    if (!rb_) {
+        return 0;
+    }
+    
+    if (is_producer()) {
+        return 0; // Producers can't check available data
+    }
+    
+    return shm_ipc_available(rb_);
+}
+
+size_t SharedRingBuffer::free_space() const {
+    if (!rb_) {
+        return 0;
+    }
+    
+    if (!is_producer()) {
+        return 0; // Consumers can't check free space
+    }
+    
+    return shm_ipc_free_space(rb_);
+}
+
+size_t SharedRingBuffer::buffer_size() const {
+    if (!rb_) {
+        return 0;
+    }
+    
+    return shm_ipc_buffer_size(rb_);
+}
+
+int SharedRingBuffer::consumer_id() const {
+    if (!rb_) {
+        return -1;
+    }
+    
+    return shm_ipc_get_consumer_id(rb_);
+}
+
+int SharedRingBuffer::consumer_count() const {
+    if (!rb_) {
+        return 0;
+    }
+    
+    return shm_ipc_get_consumer_count(rb_);
+}
+
+bool SharedRingBuffer::write_message(const std::vector<uint8_t>& data) {
+    return write_message(data.data(), data.size());
+}
+
+bool SharedRingBuffer::write_message(const uint8_t* data, size_t size) {
+    if (!rb_) {
+        throw ShmException("Ring buffer is not initialized");
+    }
+    
+    if (size == 0) {
+        return true; // Empty message is always successful
+    }
+    
+    if (!is_producer()) {
+        throw ShmException("Only producers can write messages to the buffer");
+    }
+    
+    return shm_ipc_write_message(rb_, data, size);
+}
+
+std::vector<uint8_t> SharedRingBuffer::read_message() {
+    if (!rb_) {
+        throw ShmException("Ring buffer is not initialized");
+    }
+    
+    if (is_producer()) {
+        throw ShmException("Only consumers can read messages from the buffer");
+    }
+    
+    // Check if a message is available and get its size
+    auto msg_size_opt = message_available();
+    if (!msg_size_opt) {
+        return {}; // No message available
+    }
+    
+    size_t msg_size = *msg_size_opt;
+    std::vector<uint8_t> buffer(msg_size);
+    
+    // Read the message
+    size_t actual_size;
+    bool success = shm_ipc_read_message(rb_, buffer.data(), buffer.size(), &actual_size);
+    
+    if (!success) {
+        throw ShmException("Failed to read message from ring buffer");
+    }
+    
+    // Resize the buffer to the actual message size
+    if (actual_size != msg_size) {
+        buffer.resize(actual_size);
+    }
+    
+    return buffer;
+}
+
+std::optional<size_t> SharedRingBuffer::message_available() const {
+    if (!rb_) {
+        return std::nullopt;
+    }
+    
+    if (is_producer()) {
+        return std::nullopt; // Producers can't check available messages
+    }
+    
+    size_t msg_size;
+    if (shm_ipc_message_available(rb_, &msg_size)) {
+        return msg_size;
+    }
+    
+    return std::nullopt;
+}
+
+} // namespace shm_ipc 
