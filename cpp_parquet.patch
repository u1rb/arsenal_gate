+TEST_CASE("CSBTree Random Operations Performance", "[csbtree][performance][random]") {
+    CSBTree* tree = csb_create_tree(compare_asc_perf);
+    REQUIRE(tree != NULL);
+    
+    // Parameters for random performance testing
+    const size_t WARMUP_OPS = 5000;        // Initial operations to build the tree
+    const size_t RANDOM_OPS = 50000;       // Operations to benchmark
+    const uint64_t MIN_PRICE = 9000;
+    const uint64_t MAX_PRICE = 11000;
+    const uint64_t START_ORDER_ID = 10000;
+    
+    // Seed for random generator
+    std::mt19937_64 rng(std::chrono::high_resolution_clock::now().time_since_epoch().count());
+    std::uniform_int_distribution<uint64_t> price_dist(MIN_PRICE, MAX_PRICE);
+    std::uniform_int_distribution<uint32_t> size_dist(1, 100);
+    
+    // For tracking existing orders
+    std::vector<Order> active_orders;
+    
+    // Warm up the tree with some initial data
+    std::cout << "\n--- Random Operations: Warming up with " << WARMUP_OPS << " orders ---\n";
+    for (size_t i = 0; i < WARMUP_OPS; ++i) {
+        Order order = {
+            .order_id = START_ORDER_ID + i,
+            .price = price_dist(rng),
+            .size = size_dist(rng),
+            .timestamp = static_cast<uint64_t>(std::chrono::high_resolution_clock::now().time_since_epoch().count())
+        };
+        int result = csb_add_order(tree, order);
+        REQUIRE(result == 0);
+        active_orders.push_back(order);
+    }
+    
+    std::cout << "Tree warmed up with " << active_orders.size() << " orders and " 
+              << tree->total_price_levels << " price levels\n\n";
+    
+    SECTION("Random Mixed Insert/Delete Performance") {
+        // Vectors to store latency measurements
+        std::vector<double> insert_latencies;
+        std::vector<double> delete_latencies;
+        insert_latencies.reserve(RANDOM_OPS/2);
+        delete_latencies.reserve(RANDOM_OPS/2);
+        
+        std::cout << "--- Random Insert/Delete Benchmark: " << RANDOM_OPS << " operations ---\n";
+        
+        // Perform random inserts and deletes
+        for (size_t i = 0; i < RANDOM_OPS; ++i) {
+            // Randomly choose between insert (60%) and delete (40%) if we have orders
+            bool do_insert = (active_orders.empty() || 
+                             (std::uniform_int_distribution<int>(1, 100)(rng) <= 60));
+            
+            if (do_insert) {
+                // INSERT operation
+                Order order = {
+                    .order_id = START_ORDER_ID + WARMUP_OPS + i,
+                    .price = price_dist(rng),
+                    .size = size_dist(rng),
+                    .timestamp = static_cast<uint64_t>(std::chrono::high_resolution_clock::now().time_since_epoch().count())
+                };
+                
+                auto start = std::chrono::high_resolution_clock::now();
+                int result = csb_add_order(tree, order);
+                auto end = std::chrono::high_resolution_clock::now();
+                
+                REQUIRE(result == 0);
+                active_orders.push_back(order);
+                
+                std::chrono::duration<double, std::nano> elapsed = end - start;
+                insert_latencies.push_back(elapsed.count());
+            } else {
+                // DELETE operation - pick a random order to delete
+                std::uniform_int_distribution<size_t> order_idx_dist(0, active_orders.size() - 1);
+                size_t idx = order_idx_dist(rng);
+                Order order_to_delete = active_orders[idx];
+                
+                auto start = std::chrono::high_resolution_clock::now();
+                int result = csb_delete_order(tree, order_to_delete.price, order_to_delete.order_id);
+                auto end = std::chrono::high_resolution_clock::now();
+                
+                REQUIRE(result == 0);
+                
+                // Remove from active orders (swap with last element and pop for O(1) removal)
+                std::swap(active_orders[idx], active_orders.back());
+                active_orders.pop_back();
+                
+                std::chrono::duration<double, std::nano> elapsed = end - start;
+                delete_latencies.push_back(elapsed.count());
+            }
+        }
+        
+        // Print statistics
+        std::cout << "Final tree state: " << active_orders.size() << " orders and " 
+                  << tree->total_price_levels << " price levels\n";
+        
+        print_latency_stats("Random Insert", insert_latencies);
+        print_latency_stats("Random Delete", delete_latencies);
+    }
+    
+    SECTION("Bursts of Inserts and Deletes Performance") {
+        // Vectors to store latency measurements
+        std::vector<double> burst_insert_latencies;
+        std::vector<double> burst_delete_latencies;
+        burst_insert_latencies.reserve(RANDOM_OPS/2);
+        burst_delete_latencies.reserve(RANDOM_OPS/2);
+        
+        const size_t BURST_SIZE = 100; // Size of each insert/delete burst
+        const size_t NUM_BURSTS = RANDOM_OPS / BURST_SIZE;
+        
+        std::cout << "--- Burst Insert/Delete Benchmark: " 
+                  << NUM_BURSTS << " bursts of " << BURST_SIZE << " operations each ---\n";
+        
+        for (size_t burst = 0; burst < NUM_BURSTS; ++burst) {
+            // Alternate between insert and delete bursts
+            bool is_insert_burst = (burst % 2 == 0);
+            
+            if (is_insert_burst) {
+                // INSERT BURST
+                for (size_t i = 0; i < BURST_SIZE; ++i) {
+                    Order order = {
+                        .order_id = START_ORDER_ID + WARMUP_OPS + (burst * BURST_SIZE) + i,
+                        .price = price_dist(rng),
+                        .size = size_dist(rng),
+                        .timestamp = static_cast<uint64_t>(std::chrono::high_resolution_clock::now().time_since_epoch().count())
+                    };
+                    
+                    auto start = std::chrono::high_resolution_clock::now();
+                    int result = csb_add_order(tree, order);
+                    auto end = std::chrono::high_resolution_clock::now();
+                    
+                    REQUIRE(result == 0);
+                    active_orders.push_back(order);
+                    
+                    std::chrono::duration<double, std::nano> elapsed = end - start;
+                    burst_insert_latencies.push_back(elapsed.count());
+                }
+            } else {
+                // DELETE BURST - delete orders if we have enough
+                if (active_orders.size() > BURST_SIZE) {
+                    for (size_t i = 0; i < BURST_SIZE; ++i) {
+                        // Pick a random order to delete
+                        std::uniform_int_distribution<size_t> order_idx_dist(0, active_orders.size() - 1);
+                        size_t idx = order_idx_dist(rng);
+                        Order order_to_delete = active_orders[idx];
+                        
+                        auto start = std::chrono::high_resolution_clock::now();
+                        int result = csb_delete_order(tree, order_to_delete.price, order_to_delete.order_id);
+                        auto end = std::chrono::high_resolution_clock::now();
+                        
+                        REQUIRE(result == 0);
+                        
+                        // Remove from active orders
+                        std::swap(active_orders[idx], active_orders.back());
+                        active_orders.pop_back();
+                        
+                        std::chrono::duration<double, std::nano> elapsed = end - start;
+                        burst_delete_latencies.push_back(elapsed.count());
+                    }
+                }
+            }
+        }
+        
+        // Print statistics
+        std::cout << "Final tree state: " << active_orders.size() << " orders and " 
+                  << tree->total_price_levels << " price levels\n";
+        
+        print_latency_stats("Burst Insert", burst_insert_latencies);
+        print_latency_stats("Burst Delete", burst_delete_latencies);
+    }
+    
+    csb_destroy_tree(tree);
+}
