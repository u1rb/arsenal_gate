+// Add this new test case for multi-ticker performance
+TEST_CASE("CSBTree Multi-Ticker Performance (300 Tickers instead of 3000)", "[csbtree][performance][multi_ticker]") {
+    // Constants for the multi-ticker test - reduced from 3000 to 300 due to memory constraints
+    const size_t NUM_TICKERS = 2000;
+    const size_t ORDERS_PER_TICKER = 10;          // Initial orders per ticker during warmup
+    const size_t TOTAL_WARMUP_ORDERS = NUM_TICKERS * ORDERS_PER_TICKER;
