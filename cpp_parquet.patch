+std::vector<Order> generate_random_orders(size_t count, uint64_t min_price, uint64_t max_price, uint64_t start_order_id) {
+    std::vector<Order> orders;
+    orders.reserve(count);
+    std::mt19937_64 rng(std::chrono::high_resolution_clock::now().time_since_epoch().count());
+    std::uniform_int_distribution<uint64_t> price_dist(min_price, max_price);
+    std::uniform_int_distribution<uint32_t> size_dist(1, 100); // Random sizes
+
+    for (size_t i = 0; i < count; ++i) {
+        orders.push_back({
+            .order_id = start_order_id + i,
+            .price = price_dist(rng),
+            .size = size_dist(rng),
+            .timestamp = (uint64_t)std::chrono::high_resolution_clock::now().time_since_epoch().count() // Use high-res timestamp
+        });
+    }
+    return orders;
+}
