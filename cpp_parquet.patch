+#ifndef POOL_ALLOCATOR_H
+#define POOL_ALLOCATOR_H
+
+#include <stddef.h> // For size_t
+
+// Opaque structure declaration (implementation hidden)
+typedef struct PoolAllocator PoolAllocator;
+
+/**
+ * @brief Creates a new pool allocator.
+ * 
+ * Allocates a large block of memory and divides it into fixed-size items.
+ * Provides fast allocation and deallocation of these items.
+ *
+ * @param item_size The size of each individual item to be allocated from the pool.
+ * @param pool_capacity The maximum number of items the pool can hold.
+ * @param alignment The required memory alignment for each item (must be a power of two, or 0 for default alignment).
+ * @return Pointer to the created PoolAllocator, or NULL on failure.
+ */
+PoolAllocator* pool_create(size_t item_size, size_t pool_capacity, size_t alignment);
+
+/**
+ * @brief Destroys a pool allocator and frees all associated memory.
+ *
+ * @param pool Pointer to the PoolAllocator to destroy.
+ */
+void pool_destroy(PoolAllocator* pool);
+
+/**
+ * @brief Allocates a single item from the pool.
+ *
+ * Retrieves an item from the free list. This operation is typically O(1).
+ * The allocated memory is NOT guaranteed to be zeroed.
+ *
+ * @param pool Pointer to the PoolAllocator.
+ * @return Pointer to the allocated item, or NULL if the pool is full or invalid.
+ */
+void* pool_alloc(PoolAllocator* pool);
+
+/**
+ * @brief Frees a previously allocated item, returning it to the pool.
+ *
+ * Adds the item back to the free list. This operation is typically O(1).
+ *
+ * @param pool Pointer to the PoolAllocator.
+ * @param item Pointer to the item to free. Must have been allocated from this pool.
+ */
+void pool_free(PoolAllocator* pool, void* item);
+
+/**
+ * @brief Gets the number of currently allocated items in the pool.
+ *
+ * @param pool Pointer to the PoolAllocator.
+ * @return The number of allocated items.
+ */
+size_t pool_get_allocated_count(const PoolAllocator* pool);
+
+/**
+ * @brief Gets the total capacity (maximum number of items) of the pool.
+ *
+ * @param pool Pointer to the PoolAllocator.
+ * @return The total capacity of the pool.
+ */
+size_t pool_get_capacity(const PoolAllocator* pool);
+
+#endif // POOL_ALLOCATOR_H 
