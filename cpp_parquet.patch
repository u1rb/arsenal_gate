+#include <catch2/catch_test_macros.hpp>
+#include <vector>
+#include <algorithm>
+#include <limits>
+#include <set>
+#include <random>
+#include <map>
+#include <chrono>
+#include <iostream>
+
+
+// Make C headers compatible with C++
+extern "C" {
+#include "csb_tree.h" 
+}
+
+// --- Comparison Functions ---
+
+// Ascending order (for asks)
+int compare_asc(uint64_t a, uint64_t b) {
+    if (a < b) return -1;
+    if (a > b) return 1;
+    return 0;
+}
+
+// Descending order (for bids)
+int compare_desc(uint64_t a, uint64_t b) {
+    if (a < b) return 1;  // Note the swap for descending
+    if (a > b) return -1;
+    return 0;
+}
+
+// --- Test Cases ---
+
+TEST_CASE("CSBTree Basic Operations (Ascending - Asks)", "[csbtree]") {
+    CSBTree* tree = csb_create_tree(compare_asc);
+    REQUIRE(tree != NULL);
+    REQUIRE(tree->root == NULL);
+    REQUIRE(tree->total_price_levels == 0);
+
+    Order o1 = { .order_id = 101, .price = 100, .size = 10, .timestamp = 1 };
+    Order o2 = { .order_id = 102, .price = 110, .size = 5,  .timestamp = 2 };
+    Order o3 = { .order_id = 103, .price = 100, .size = 7,  .timestamp = 3 }; // Same price as o1
+    Order o4 = { .order_id = 104, .price = 90,  .size = 20, .timestamp = 4 };
+    Order o5 = { .order_id = 105, .price = 100, .size = 3,  .timestamp = 0 }; // Same price, earlier timestamp
+
+    SECTION("Add and Lookup Single Order") {
+        REQUIRE(csb_add_order(tree, o1) == 0);
+        REQUIRE(tree->total_price_levels == 1); // One price level added
+        
+        OrderList* list = csb_lookup_orders_by_price(tree, 100);
+        REQUIRE(list != NULL);
+        REQUIRE(list->count == 1);
+        REQUIRE(list->total_volume == 10);
+        REQUIRE(list->head != NULL);
+        REQUIRE(list->head->order.order_id == 101);
+        REQUIRE(list->head->next == NULL);
+
+        REQUIRE(csb_lookup_orders_by_price(tree, 110) == NULL);
+    }
+
+    SECTION("Add Multiple Orders and Lookup") {
+        csb_add_order(tree, o1); // 100
+        csb_add_order(tree, o2); // 110
+        csb_add_order(tree, o3); // 100 (existing)
+        csb_add_order(tree, o4); // 90
+        REQUIRE(tree->total_price_levels == 3); // Three unique price levels
+
+        OrderList* list100 = csb_lookup_orders_by_price(tree, 100);
+        REQUIRE(list100 != NULL);
+        REQUIRE(list100->count == 2);
+        REQUIRE(list100->total_volume == 17);
+        REQUIRE(list100->head != NULL);
+        REQUIRE(list100->head->order.order_id == 101); // o1 (ts=1) before o3 (ts=3)
+        REQUIRE(list100->head->next != NULL);
+        REQUIRE(list100->head->next->order.order_id == 103);
+        REQUIRE(list100->head->next->next == NULL);
+
+        OrderList* list110 = csb_lookup_orders_by_price(tree, 110);
+        REQUIRE(list110 != NULL);
+        REQUIRE(list110->count == 1);
+        REQUIRE(list110->total_volume == 5);
+        REQUIRE(list110->head->order.order_id == 102);
+
+        OrderList* list90 = csb_lookup_orders_by_price(tree, 90);
+        REQUIRE(list90 != NULL);
+        REQUIRE(list90->count == 1);
+        REQUIRE(list90->total_volume == 20);
+        REQUIRE(list90->head->order.order_id == 104);
+    }
+
+    SECTION("Add Order with Earlier Timestamp") {
+        csb_add_order(tree, o1); // ts=1
+        csb_add_order(tree, o3); // ts=3
+        csb_add_order(tree, o5); // ts=0
+        REQUIRE(tree->total_price_levels == 1); // Still just one price level
+
+        OrderList* list100 = csb_lookup_orders_by_price(tree, 100);
