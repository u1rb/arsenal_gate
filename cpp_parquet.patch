+    // Seed for random generator
+    std::mt19937_64 rng(std::chrono::high_resolution_clock::now().time_since_epoch().count());
+    std::uniform_int_distribution<uint64_t> price_dist(MIN_PRICE, MAX_PRICE);
+    std::uniform_int_distribution<uint32_t> size_dist(1, 100);
+    std::uniform_int_distribution<size_t> ticker_dist(0, NUM_TICKERS - 1);
+    
+    // Create 3000 order books (one for each ticker)
+    std::cout << "\n--- Multi-Ticker Test: Creating " << NUM_TICKERS << " order books ---\n";
+    std::vector<CSBTree*> order_books(NUM_TICKERS);
+    for (size_t i = 0; i < NUM_TICKERS; ++i) {
