+// --- Underflow Handling Helper Functions ---
+
+// Main entry point for handling potential underflow after deletion.
+// Processes the stack upwards, fixing underflow at each level.
+static void handle_node_underflow(CSBTree* tree, DeleteStack* stack) {
+    while (!is_delete_stack_empty(stack)) {
+        PathElement current_path = pop_delete_stack(stack);
+        CSBTreeNode* node = current_path.node;
+        
+        // Get parent information if available
+        CSBTreeNode* parent = NULL;
+        uint8_t parent_index = 0; // Index of 'node' within 'parent'
+        if (!is_delete_stack_empty(stack)) {
+            parent = stack->elements[stack->size - 1].node; // Peek at parent
+            parent_index = stack->elements[stack->size - 1].index;
+            assert(!parent->is_leaf); // Parent must be internal
+        } else {
+             // If the stack is empty, 'node' is the root.
+             // Check if the root needs special handling (e.g., becoming empty or having only one child).
+             if (node == tree->root) {
+                if (!node->is_leaf && node->num_keys == 0) {
+                    // Root became empty, promote its only child
+                    CSBTreeNode* old_root = tree->root;
+                    tree->root = old_root->data.internal.children[0];
+                    pool_free(tree->node_pool, old_root);
+                    // The new root (if it exists) doesn't underflow by definition
+                } else if (node->is_leaf && node->num_keys == 0) {
+                     // Root was a leaf and is now empty
+                     pool_free(tree->node_pool, tree->root);
+                     tree->root = NULL;
+                     tree->total_price_levels = 0; // Ensure count is zero
+                 }
+                 // Root doesn't underflow if it has keys or is a non-empty leaf
+                 break; // No parent to check, done with underflow handling
+             } else {
+                 // Should not happen: non-root node with no parent on stack
+                 fprintf(stderr, "Error: Orphaned node encountered during underflow handling.\n");
+                 break;
+             }
+        }
+
+        // Check for underflow
+        bool underflow = (node->is_leaf) 
+                         ? (node->num_keys < CSB_MIN_LEAF_KEYS)
+                         : (node->num_keys < CSB_MIN_INTERNAL_KEYS);
+
+        if (underflow) {
+            if (node->is_leaf) {
+                handle_leaf_underflow(tree, node, parent, parent_index);
+            } else {
+                handle_internal_underflow(tree, node, parent, parent_index);
+            }
+             // Underflow was handled (merged or redistributed). 
+             // The parent's key count might have changed due to merge,
+             // so continue the loop to check the parent.
+        } else {
+            // Node is not underflowing, no structural change needed at this level.
+            // We still need to continue up the stack in case a merge happened below
+            // which *did* affect the parent's key count, causing it to underflow.
+            // However, if no merge occurred *at this level*, we can stop if the path
+            // didn't involve a merge lower down that removed a key from this node's parent.
+            // For simplicity and correctness, we often just continue up the stack.
+            // Optimization: Could track if a merge occurred to potentially break early.
+        }
+    }
+}
+
+
+// Handles underflow in a leaf node. Tries to redistribute, otherwise merges.
+static void handle_leaf_underflow(CSBTree* tree, CSBTreeNode* leaf, CSBTreeNode* parent, uint8_t parent_index) {
+    assert(leaf->is_leaf);
+    assert(parent != NULL);
+    assert(parent_index <= parent->num_keys); // parent_index is the index of the *pointer* to leaf
+
+    // Try to borrow from the right sibling
+    if (parent_index < parent->num_keys) {
+        CSBTreeNode* right_sibling = parent->data.internal.children[parent_index + 1];
+        assert(right_sibling->is_leaf);
+        if (right_sibling->num_keys > CSB_MIN_LEAF_KEYS) {
+            redistribute_leaf_nodes(tree, leaf, right_sibling, parent, parent_index);
+            return; // Redistribution successful
+        }
+    }
+
+    // Try to borrow from the left sibling
+    if (parent_index > 0) {
+        CSBTreeNode* left_sibling = parent->data.internal.children[parent_index - 1];
+        assert(left_sibling->is_leaf);
+        if (left_sibling->num_keys > CSB_MIN_LEAF_KEYS) {
+            // Note: redistribute function expects left, right order
+            redistribute_leaf_nodes(tree, left_sibling, leaf, parent, parent_index - 1);
+            return; // Redistribution successful
+        }
+    }
+
+    // Cannot redistribute, must merge
+    if (parent_index < parent->num_keys) {
+        // Merge with right sibling
+        CSBTreeNode* right_sibling = parent->data.internal.children[parent_index + 1];
+        merge_leaf_nodes(tree, leaf, right_sibling, parent, parent_index);
+    } else {
+        // Merge with left sibling (we must have a left sibling if we couldn't merge right)
+        assert(parent_index > 0);
+        CSBTreeNode* left_sibling = parent->data.internal.children[parent_index - 1];
+        // Note: merge function expects left, right order
+        merge_leaf_nodes(tree, left_sibling, leaf, parent, parent_index - 1);
+    }
+}
+
+
+/*
+ * ASCII Art: redistribute_leaf_nodes (Borrow from Right)
+ * Goal: Left leaf L is underflowing, borrow first element from Right sibling R.
+ *
+ * BEFORE:
+ *       Parent P: [... | K_sep | ...] -> separator_index
+ *                  /       \
+ *   Leaf L (num < min): [K1|V1] ... | -> R
+ *   Leaf R (num > min): [K3|V3] [K4|V4] ... | -> Next
+ *
+ * AFTER:
+ *       Parent P: [... | K4    | ...] -> K_sep updated to R's new first key
+ *                  /       \
+ *   Leaf L (num = min): [K1|V1] ... [K3|V3] | -> R (Added R's first element)
+ *   Leaf R (num >= min): [K4|V4] ... | -> Next (Lost first element)
+ *
+ * Invariants Maintained:
+ * - Both L and R now have >= min keys.
+ * - Keys remain sorted across L, P, R.
+ * - Leaf link L -> R -> Next remains correct.
+ * - Parent separator key is updated.
+ * - Parent subtree counts for L and R are updated.
+ */
+/*
+ * ASCII Art: redistribute_leaf_nodes (Borrow from Left)
+ * Goal: Right leaf R is underflowing, borrow last element from Left sibling L.
+ *
+ * BEFORE:
+ *       Parent P: [... | K_sep | ...] -> separator_index
+ *                  /       \
+ *   Leaf L (num > min): [K1|V1] [K2|V2] | -> R
+ *   Leaf R (num < min): [K3|V3] ... | -> Next
+ *
+ * AFTER:
+ *       Parent P: [... | K2    | ...] -> K_sep updated to L's moved key
+ *                  /       \
+ *   Leaf L (num >= min): [K1|V1] | -> R (Lost last element)
+ *   Leaf R (num = min): [K2|V2] [K3|V3] ... | -> Next (Added L's last element)
+ *
+ * Invariants Maintained:
+ * - Both L and R now have >= min keys.
+ * - Keys remain sorted across L, P, R.
+ * - Leaf link L -> R -> Next remains correct.
+ * - Parent separator key is updated.
+ * - Parent subtree counts for L and R are updated.
+ */
+static void redistribute_leaf_nodes(CSBTree* tree, CSBTreeNode* left, CSBTreeNode* right, CSBTreeNode* parent, uint8_t separator_index) {
+    assert(left->is_leaf && right->is_leaf);
+    assert(separator_index < parent->num_keys);
+
+    if (left->num_keys < CSB_MIN_LEAF_KEYS) {
+        // Borrow from right sibling: move right's first element to left's end
+        uint64_t key_to_move = right->data.leaf.keys[0];
+        OrderList* value_to_move = right->data.leaf.values[0];
+
+        // Add to left
+        left->data.leaf.keys[left->num_keys] = key_to_move;
+        left->data.leaf.values[left->num_keys] = value_to_move;
+        left->num_keys++;
+
+        // Remove from right (shift left)
+        memmove(right->data.leaf.keys, right->data.leaf.keys + 1, (right->num_keys - 1) * sizeof(uint64_t));
+        memmove(right->data.leaf.values, right->data.leaf.values + 1, (right->num_keys - 1) * sizeof(OrderList*));
+        right->num_keys--;
+        right->data.leaf.keys[right->num_keys] = 0; // Zero out
+        right->data.leaf.values[right->num_keys] = NULL;
+
+
+        // Update parent separator key to the new smallest key in the right node
+        parent->data.internal.keys[separator_index] = right->data.leaf.keys[0];
+
+    } else { // right->num_keys < CSB_MIN_LEAF_KEYS
+        // Borrow from left sibling: move left's last element to right's beginning
+        uint64_t key_to_move = left->data.leaf.keys[left->num_keys - 1];
+        OrderList* value_to_move = left->data.leaf.values[left->num_keys - 1];
+
+        // Make space in right (shift right)
+        memmove(right->data.leaf.keys + 1, right->data.leaf.keys, right->num_keys * sizeof(uint64_t));
+        memmove(right->data.leaf.values + 1, right->data.leaf.values, right->num_keys * sizeof(OrderList*));
+        
+        // Add to right's beginning
+        right->data.leaf.keys[0] = key_to_move;
+        right->data.leaf.values[0] = value_to_move;
+        right->num_keys++;
+
+        // Remove from left's end
+        left->num_keys--;
+        left->data.leaf.keys[left->num_keys] = 0; // Zero out
+        left->data.leaf.values[left->num_keys] = NULL;
+
+        // Update parent separator key to the new smallest key in the right node (which is key_to_move)
+        parent->data.internal.keys[separator_index] = key_to_move; // or right->data.leaf.keys[0]
+    }
+    
+    // Update subtree counts in parent for both children involved
+    parent->data.internal.subtree_price_level_counts[separator_index] = get_subtree_price_level_count_recursive(left);
+    parent->data.internal.subtree_price_level_counts[separator_index + 1] = get_subtree_price_level_count_recursive(right);
+}
+
+
+/*
+ * ASCII Art: merge_leaf_nodes
+ * Goal: Merge Right leaf R into Left leaf L (assume L+R fits).
+ *
+ * BEFORE:
+ *       Parent P: [... | K_sep | ...] -> separator_index
+ *                  /       \
+ *   Leaf L: [K1|V1] ... | -> R
+ *   Leaf R: [K3|V3] ... | -> Next
+ *
+ * AFTER:
+ *       Parent P: [...] -> K_sep and pointer to R removed, subsequent elements shifted left.
+ *                 /
+ *   Leaf L: [K1|V1] ... [K3|V3] ... | -> Next (Contains merged content, points to R's old next)
+ *   (Node R is freed)
+ *
+ * Invariants Maintained:
+ * - L contains all elements from L and R, sorted.
+ * - L has <= max keys.
+ * - Parent P has key K_sep and pointer to R removed. Parent might underflow (handled later).
+ * - Leaf link L -> Next is maintained.
+ * - Parent subtree count for L is updated.
+ */
+static void merge_leaf_nodes(CSBTree* tree, CSBTreeNode* left, CSBTreeNode* right, CSBTreeNode* parent, uint8_t separator_index) {
+    assert(left->is_leaf && right->is_leaf);
+    assert(left->num_keys + right->num_keys <= CSB_LEAF_ORDER); // Ensure merge fits
+    assert(separator_index < parent->num_keys);
+
+    // Copy keys and values from right node to the end of the left node
+    memcpy(left->data.leaf.keys + left->num_keys, right->data.leaf.keys, right->num_keys * sizeof(uint64_t));
+    memcpy(left->data.leaf.values + left->num_keys, right->data.leaf.values, right->num_keys * sizeof(OrderList*));
+    left->num_keys += right->num_keys;
+
+    // Update linked list pointer (left now points to whatever right pointed to)
+    left->data.leaf.next_leaf = right->data.leaf.next_leaf;
+
+    // Remove separator key and pointer to right child from parent
+    uint64_t key_removed_from_parent = parent->data.internal.keys[separator_index]; // For potential use if debugging
+    
+    // Shift keys in parent left
+    memmove(parent->data.internal.keys + separator_index, parent->data.internal.keys + separator_index + 1, (parent->num_keys - 1 - separator_index) * sizeof(uint64_t));
+    // Shift children pointers in parent left
+    memmove(parent->data.internal.children + separator_index + 1, parent->data.internal.children + separator_index + 2, (parent->num_keys - (separator_index + 1)) * sizeof(CSBTreeNode*));
+    // Shift subtree counts in parent left
+    memmove(parent->data.internal.subtree_price_level_counts + separator_index + 1, parent->data.internal.subtree_price_level_counts + separator_index + 2, (parent->num_keys - (separator_index + 1)) * sizeof(uint64_t));
+
+    parent->num_keys--;
+    // Zero out unused entries in parent (optional)
+    parent->data.internal.keys[parent->num_keys] = 0;
+    parent->data.internal.children[parent->num_keys + 1] = NULL;
+    parent->data.internal.subtree_price_level_counts[parent->num_keys + 1] = 0;
+
+    // Update count for the merged child (left) in the parent
+     parent->data.internal.subtree_price_level_counts[separator_index] = get_subtree_price_level_count_recursive(left);
+    
+    // Free the now-empty right node
+    // Important: Do not destroy OrderLists within 'right', they were moved to 'left'
+    pool_free(tree->node_pool, right);
+    
+    // The parent might now underflow, handle_node_underflow will check it.
+}
+
+
+// Handles underflow in an internal node. Tries to redistribute, otherwise merges.
+static void handle_internal_underflow(CSBTree* tree, CSBTreeNode* node, CSBTreeNode* parent, uint8_t parent_index) {
+    assert(!node->is_leaf);
+    assert(parent != NULL);
+    assert(parent_index <= parent->num_keys);
+
+    // Try to borrow from the right sibling
+    if (parent_index < parent->num_keys) {
+        CSBTreeNode* right_sibling = parent->data.internal.children[parent_index + 1];
+        assert(!right_sibling->is_leaf);
+        if (right_sibling->num_keys > CSB_MIN_INTERNAL_KEYS) {
+            redistribute_internal_nodes(tree, node, right_sibling, parent, parent_index);
+            return; // Redistribution successful
+        }
+    }
+
+    // Try to borrow from the left sibling
+    if (parent_index > 0) {
+        CSBTreeNode* left_sibling = parent->data.internal.children[parent_index - 1];
+        assert(!left_sibling->is_leaf);
+        if (left_sibling->num_keys > CSB_MIN_INTERNAL_KEYS) {
+            // Note: redistribute function expects left, right order
+            redistribute_internal_nodes(tree, left_sibling, node, parent, parent_index - 1);
+            return; // Redistribution successful
+        }
+    }
+
+    // Cannot redistribute, must merge
+    if (parent_index < parent->num_keys) {
+        // Merge with right sibling
+        CSBTreeNode* right_sibling = parent->data.internal.children[parent_index + 1];
+        merge_internal_nodes(tree, node, right_sibling, parent, parent_index);
+    } else {
+        // Merge with left sibling
+        assert(parent_index > 0);
+        CSBTreeNode* left_sibling = parent->data.internal.children[parent_index - 1];
+        merge_internal_nodes(tree, left_sibling, node, parent, parent_index - 1);
+    }
+}
+
+
+/*
+ * ASCII Art: redistribute_internal_nodes (Borrow from Right)
+ * Goal: Left internal L is underflowing, borrow from Right sibling R.
+ *
+ * BEFORE:
+ *         Parent P: [... | K_sep | ...] -> separator_index
+ *                    /       \
+ *   Internal L (num < min): [KL1]... | Children CL0, CL1...
+ *   Internal R (num > min): [KR1] [KR2]... | Children CR0, CR1, CR2...
+ *
+ * AFTER:
+ *         Parent P: [... | KR1   | ...] -> K_sep replaced by R's first key
+ *                    /       \
+ *   Internal L (num = min): [KL1]... [K_sep] | Children CL0, CL1..., CR0 (Gained key from P, child from R)
+ *   Internal R (num >= min): [KR2]... | Children CR1, CR2... (Lost first key and child)
+ *
+ * Invariants Maintained:
+ * - Both L and R now have >= min keys.
+ * - Keys remain sorted across L, P, R.
+ * - Children pointers correctly reassigned.
+ * - Parent separator key updated.
+ * - Subtree counts updated in L, R, and P (for children L and R).
+ */
+/*
+ * ASCII Art: redistribute_internal_nodes (Borrow from Left)
+ * Goal: Right internal R is underflowing, borrow from Left sibling L.
+ *
+ * BEFORE:
+ *         Parent P: [... | K_sep | ...] -> separator_index
+ *                    /       \
+ *   Internal L (num > min): [KL1] [KL2]... | Children CL0, CL1, CL2... CL_last
+ *   Internal R (num < min): [KR1]... | Children CR0, CR1...
+ *
+ * AFTER:
+ *         Parent P: [... | KL_last | ...] -> K_sep replaced by L's last key
+ *                    /       \
+ *   Internal L (num >= min): [KL1]... | Children CL0, CL1, CL2... (Lost last key and child)
+ *   Internal R (num = min): [K_sep] [KR1]... | Children CL_last, CR0, CR1... (Gained key from P, child from L)
+ *
+ * Invariants Maintained:
+ * - Both L and R now have >= min keys.
+ * - Keys remain sorted across L, P, R.
+ * - Children pointers correctly reassigned.
+ * - Parent separator key updated.
+ * - Subtree counts updated in L, R, and P (for children L and R).
+ */
+static void redistribute_internal_nodes(CSBTree* tree, CSBTreeNode* left, CSBTreeNode* right, CSBTreeNode* parent, uint8_t separator_index) {
+    assert(!left->is_leaf && !right->is_leaf);
+    assert(separator_index < parent->num_keys);
+
+    uint64_t parent_separator_key = parent->data.internal.keys[separator_index];
+
+    if (left->num_keys < CSB_MIN_INTERNAL_KEYS) {
+        // Borrow from right: move parent separator down to left, move right's first key up to parent, move right's first child to left
+        
+        // Move parent separator key down to end of left node
+        left->data.internal.keys[left->num_keys] = parent_separator_key;
+
+        // Move right sibling's first child pointer to end of left node's children
+        left->data.internal.children[left->num_keys + 1] = right->data.internal.children[0];
+        left->data.internal.subtree_price_level_counts[left->num_keys + 1] = right->data.internal.subtree_price_level_counts[0];
+        left->num_keys++;
+
+        // Move right sibling's first key up to parent separator position
+        parent->data.internal.keys[separator_index] = right->data.internal.keys[0];
+
+        // Shift keys/children/counts left in right sibling
+        memmove(right->data.internal.keys, right->data.internal.keys + 1, (right->num_keys - 1) * sizeof(uint64_t));
+        memmove(right->data.internal.children, right->data.internal.children + 1, right->num_keys * sizeof(CSBTreeNode*));
+        memmove(right->data.internal.subtree_price_level_counts, right->data.internal.subtree_price_level_counts + 1, right->num_keys * sizeof(uint64_t));
+        right->num_keys--;
+        // Zero out unused entries (optional)
+        right->data.internal.keys[right->num_keys] = 0;
+        right->data.internal.children[right->num_keys + 1] = NULL;
+        right->data.internal.subtree_price_level_counts[right->num_keys + 1] = 0;
+
+    } else { // right->num_keys < CSB_MIN_INTERNAL_KEYS
+        // Borrow from left: move parent separator down to right, move left's last key up to parent, move left's last child to right
+        
+        // Shift keys/children/counts right in right sibling to make space at the beginning
+        memmove(right->data.internal.keys + 1, right->data.internal.keys, right->num_keys * sizeof(uint64_t));
+        memmove(right->data.internal.children + 1, right->data.internal.children, (right->num_keys + 1) * sizeof(CSBTreeNode*));
+        memmove(right->data.internal.subtree_price_level_counts + 1, right->data.internal.subtree_price_level_counts, (right->num_keys + 1) * sizeof(uint64_t));
+
+        // Move parent separator key down to beginning of right node
+        right->data.internal.keys[0] = parent_separator_key;
+
+        // Move left sibling's last child pointer to beginning of right node's children
+        right->data.internal.children[0] = left->data.internal.children[left->num_keys];
+        right->data.internal.subtree_price_level_counts[0] = left->data.internal.subtree_price_level_counts[left->num_keys];
+        right->num_keys++;
+        
+        // Move left sibling's last key up to parent separator position
+        parent->data.internal.keys[separator_index] = left->data.internal.keys[left->num_keys - 1];
+
+        // Remove last key/child/count from left sibling
+        left->num_keys--;
+        // Zero out unused entries (optional)
+        left->data.internal.keys[left->num_keys] = 0;
+        left->data.internal.children[left->num_keys + 1] = NULL;
+        left->data.internal.subtree_price_level_counts[left->num_keys + 1] = 0;
+    }
+    
+    // Update subtree counts in parent for both children involved
+    // Using recursive count for safety after structural change
+    parent->data.internal.subtree_price_level_counts[separator_index] = get_subtree_price_level_count_recursive(left);
+    parent->data.internal.subtree_price_level_counts[separator_index + 1] = get_subtree_price_level_count_recursive(right);
+}
+
+/*
+ * ASCII Art: merge_internal_nodes
+ * Goal: Merge Right internal R into Left internal L.
+ *
+ * BEFORE:
+ *         Parent P: [... | K_sep | ...] -> separator_index
+ *                    /       \
+ *   Internal L: [KL1]... | Children CL0, CL1...
+ *   Internal R: [KR1]... | Children CR0, CR1...
+ *
+ * AFTER:
+ *         Parent P: [...] -> K_sep and pointer to R removed, subsequent elements shifted left.
+ *                   /
+ *   Internal L: [KL1]... [K_sep] [KR1]... | Children CL0, CL1..., CR0, CR1...
+ *              (Contains merged content including K_sep from parent)
+ *   (Node R is freed)
+ *
+ * Invariants Maintained:
+ * - L contains all elements from L, R, and the parent separator K_sep, sorted.
+ * - L has <= max keys.
+ * - Children pointers correctly reassigned.
+ * - Parent P has key K_sep and pointer to R removed. Parent might underflow.
+ * - Parent subtree count for L is updated.
+ */
+static void merge_internal_nodes(CSBTree* tree, CSBTreeNode* left, CSBTreeNode* right, CSBTreeNode* parent, uint8_t separator_index) {
+    assert(!left->is_leaf && !right->is_leaf);
+    assert(separator_index < parent->num_keys);
+    // Ensure merge fits: left keys + right keys + 1 (from parent) <= max keys
+    assert(left->num_keys + right->num_keys + 1 <= CSB_INTERNAL_ORDER - 1); 
+
+    uint64_t key_from_parent = parent->data.internal.keys[separator_index];
+
+    // Copy separator key from parent down into the end of the left node's keys
+    left->data.internal.keys[left->num_keys] = key_from_parent;
+    left->num_keys++;
+
+    // Copy keys from the right node into the left node
+    memcpy(left->data.internal.keys + left->num_keys, right->data.internal.keys, right->num_keys * sizeof(uint64_t));
+    // Copy children pointers from the right node into the left node
+    memcpy(left->data.internal.children + left->num_keys, right->data.internal.children, (right->num_keys + 1) * sizeof(CSBTreeNode*));
+    // Copy subtree counts from the right node into the left node
+    memcpy(left->data.internal.subtree_price_level_counts + left->num_keys, right->data.internal.subtree_price_level_counts, (right->num_keys + 1) * sizeof(uint64_t));
+    left->num_keys += right->num_keys;
+
+    // Remove separator key and pointer to right child from parent
+    // Shift keys left
+    memmove(parent->data.internal.keys + separator_index, parent->data.internal.keys + separator_index + 1, (parent->num_keys - 1 - separator_index) * sizeof(uint64_t));
+    // Shift children pointers left
+    memmove(parent->data.internal.children + separator_index + 1, parent->data.internal.children + separator_index + 2, (parent->num_keys - (separator_index + 1)) * sizeof(CSBTreeNode*));
+    // Shift subtree counts left
+    memmove(parent->data.internal.subtree_price_level_counts + separator_index + 1, parent->data.internal.subtree_price_level_counts + separator_index + 2, (parent->num_keys - (separator_index + 1)) * sizeof(uint64_t));
+    
+    parent->num_keys--;
+     // Zero out unused entries in parent (optional)
+    parent->data.internal.keys[parent->num_keys] = 0;
+    parent->data.internal.children[parent->num_keys + 1] = NULL;
+    parent->data.internal.subtree_price_level_counts[parent->num_keys + 1] = 0;
+
+    // Update count for the merged child (left) in the parent
+    parent->data.internal.subtree_price_level_counts[separator_index] = get_subtree_price_level_count_recursive(left);
+
+    // Free the now-empty right node
+    pool_free(tree->node_pool, right);
+
+    // Parent might now underflow, handle_node_underflow will check it.
+}
+
+// Modifies the size of an existing order
+int csb_modify_order(CSBTree* tree, uint64_t price, uint64_t order_id, uint32_t new_size) {
+    if (!tree || !tree->root) {
+        return -1; // Tree is empty
+    }
+    
+    // Use fast path to locate the leaf node containing the price
+    CSBTreeNode* leaf = find_leaf_for_key(tree, price);
+    if (!leaf) {
+        return -1; // Leaf not found (shouldn't happen in a well-formed tree)
+    }
+    
+    // Find the price level in the leaf
+    uint8_t index = find_index_in_node(leaf, price, tree->compare_keys);
+    if (index >= leaf->num_keys || tree->compare_keys(price, leaf->data.leaf.keys[index]) != 0) {
+        return -1; // Price level not found
+    }
+    
+    // Get the order list at the price level
+    OrderList* list = leaf->data.leaf.values[index];
+    if (!list || list->count == 0) {
+        return -1; // Empty or non-existent order list (shouldn't happen in a well-formed tree)
+    }
+    
+    // Search for the order with the specified ID
+    OrderNode* current = list->head;
+    while (current) {
+        if (current->order.order_id == order_id) {
+            // Found the order to modify
+            // Calculate the change in size
+            int64_t size_diff = (int64_t)new_size - (int64_t)current->order.size;
+            
+            // Update the order size
+            current->order.size = new_size;
+            
+            // Update the list's total volume
+            list->total_volume += size_diff;
+            
+            return 0; // Success
+        }
+        current = current->next;
+    }
+    
+    // Order ID not found at the price level
+    return -1;
+}
