@@ -0,0 +1,83 @@
+use std::{
+    env,
+    error::Error,
+    process::{Command, Stdio},
+    thread,
+    time::Duration,
+};
+
+use sysinfo::{Pid, System};
+
+fn main() -> Result<(), Box<dyn Error>> {
+    let args: Vec<String> = env::args().collect();
+    if args.len() < 2 {
+        eprintln!("Usage: {} <command> [args...]", args[0]);
+        std::process::exit(1);
+    }
+
+    let command = &args[1];
+    let command_args = &args[2..];
+
+    println!("Spawning command: {} {}", command, command_args.join(" "));
+
+    let mut child = Command::new(command)
+        .args(command_args)
+        .stdout(Stdio::null()) // Optional: Redirect child stdout/stderr
+        .stderr(Stdio::null())
+        .spawn()?;
+
+    let child_pid = Pid::from_u32(child.id());
+    println!("Spawned child process with PID: {}", child_pid);
+
+    let mut max_rss = 0;
+    let mut sys = System::new_all();
+
+    while let Ok(None) = child.try_wait() {
+        sys.refresh_process(child_pid); // Refresh data for the specific process
+
+        if let Some(process) = sys.process(child_pid) {
+            let current_rss = process.memory(); // memory() returns resident memory in bytes in v0.30.x
+            if current_rss > max_rss {
+                max_rss = current_rss;
+            }
+            // Optional: print current RSS
+            // println!("Current RSS: {} KB", current_rss / 1024);
+        } else {
+            // Process might have exited between try_wait and refresh_process
+            break;
+        }
+
+        thread::sleep(Duration::from_millis(100)); // Check interval
+    }
+
+    // Final check after process exit
+    sys.refresh_process(child_pid);
+    if let Some(process) = sys.process(child_pid) {
+        let current_rss = process.memory();
+        if current_rss > max_rss {
+            max_rss = current_rss;
+        }
+    }
+
+    let status = child.wait()?;
+    println!("Child process exited with status: {}", status);
+
+    // Pretty print the memory usage in appropriate units
+    if max_rss >= 1_073_741_824 {
+        // 1 GB in bytes
+        println!(
+            "Maximum RSS observed: {:.2} GB",
+            max_rss as f64 / 1_073_741_824.0
+        );
+    } else if max_rss >= 1_048_576 {
+        // 1 MB in bytes
+        println!(
+            "Maximum RSS observed: {:.2} MB",
+            max_rss as f64 / 1_048_576.0
+        );
+    } else {
+        println!("Maximum RSS observed: {:.2} KB", max_rss as f64 / 1024.0);
+    }
+
+    Ok(())
+}
diff --git a/try_cpp_parquet/rust_parquet_writer/src/main.rs b/try_cpp_parquet/rust_parquet_writer/src/main.rs
