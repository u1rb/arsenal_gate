+// Outputs duration in nanoseconds
+void print_latency_stats(const std::string& operation, const std::vector<double>& durations_ns) {
+    // Calculate statistics
+    double avg = 0.0;
+    double min = std::numeric_limits<double>::max();
+    double max = 0.0;
+    double p50 = 0.0;
+    double p90 = 0.0;
+    double p99 = 0.0;
+    
+    // Sort for percentiles
+    std::vector<double> sorted_durations = durations_ns;
+    std::sort(sorted_durations.begin(), sorted_durations.end());
+    
+    // Calculate stats
+    for (const auto& d : durations_ns) {
+        avg += d;
+        min = std::min(min, d);
+        max = std::max(max, d);
+    }
+    avg /= durations_ns.size();
+    
+    // Percentiles
+    p50 = sorted_durations[sorted_durations.size() * 0.5];
+    p90 = sorted_durations[sorted_durations.size() * 0.9];
+    p99 = sorted_durations[sorted_durations.size() * 0.99];
+    
+    // Output
+    std::cout << std::fixed << std::setprecision(2);
+    std::cout << "--- " << operation << " Latency (ns) ---" << std::endl;
+    std::cout << "Min: " << min << " ns" << std::endl;
+    std::cout << "Avg: " << avg << " ns" << std::endl;
+    std::cout << "Max: " << max << " ns" << std::endl;
+    std::cout << "P50: " << p50 << " ns" << std::endl;
+    std::cout << "P90: " << p90 << " ns" << std::endl;
+    std::cout << "P99: " << p99 << " ns" << std::endl;
+    std::cout << std::endl;
