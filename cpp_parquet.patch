+        // Measure lazy delete performance
+        std::vector<double> lazy_delete_latencies;
+        lazy_delete_latencies.reserve(TEST_DELETES);
+        
+        for (size_t i = 0; i < TEST_DELETES; ++i) {
+            const auto& order = orders_to_delete[i];
+            auto start = std::chrono::high_resolution_clock::now();
+            int result = csb_delete_order(tree, order.price, order.order_id);
+            auto end = std::chrono::high_resolution_clock::now();
+            
+            if (result == 0) {
+                std::chrono::duration<double, std::nano> elapsed = end - start;
+                lazy_delete_latencies.push_back(elapsed.count());
+            }
+        }
+        
+        // Process the lazy deletions and measure time
+        auto process_start = std::chrono::high_resolution_clock::now();
+        int processed = csb_process_lazy_deletions(tree);
+        auto process_end = std::chrono::high_resolution_clock::now();
+        
+        std::chrono::duration<double, std::nano> process_time = process_end - process_start;
+        double avg_process_time = process_time.count() / processed;
+        
+        // Calculate statistics
+        double avg_regular = std::accumulate(regular_delete_latencies.begin(), regular_delete_latencies.end(), 0.0) / regular_delete_latencies.size();
+        double avg_lazy = std::accumulate(lazy_delete_latencies.begin(), lazy_delete_latencies.end(), 0.0) / lazy_delete_latencies.size();
+        
+        std::sort(regular_delete_latencies.begin(), regular_delete_latencies.end());
+        std::sort(lazy_delete_latencies.begin(), lazy_delete_latencies.end());
+        
+        double p50_regular = regular_delete_latencies[static_cast<size_t>(regular_delete_latencies.size() * 0.5)];
+        double p50_lazy = lazy_delete_latencies[static_cast<size_t>(lazy_delete_latencies.size() * 0.5)];
+        
+        double p99_regular = regular_delete_latencies[static_cast<size_t>(regular_delete_latencies.size() * 0.99)];
+        double p99_lazy = lazy_delete_latencies[static_cast<size_t>(lazy_delete_latencies.size() * 0.99)];
+        
+        // Output results
+        std::cout << "\n--- Delete Performance Comparison ---" << std::endl;
+        std::cout << "Regular Delete Avg Latency: " << avg_regular << " ns" << std::endl;
+        std::cout << "Regular Delete P50 Latency: " << p50_regular << " ns" << std::endl;
+        std::cout << "Regular Delete P99 Latency: " << p99_regular << " ns" << std::endl;
+        std::cout << "\nLazy Delete Avg Latency: " << avg_lazy << " ns" << std::endl;
+        std::cout << "Lazy Delete P50 Latency: " << p50_lazy << " ns" << std::endl;
+        std::cout << "Lazy Delete P99 Latency: " << p99_lazy << " ns" << std::endl;
+        std::cout << "\nBatch Processing:" << std::endl;
+        std::cout << "Processed " << processed << " lazy deletions" << std::endl;
+        std::cout << "Total Batch Processing Time: " << process_time.count() << " ns" << std::endl;
+        std::cout << "Average Per Delete Processing: " << avg_process_time << " ns" << std::endl;
+        std::cout << "----------------------------------" << std::endl;
+    }
+    
+    csb_destroy_tree(tree);
+}
