+// Helper function to create a CSB-Tree with custom pool sizes
+CSBTree* create_tree_with_custom_pools(csb_key_compare_func compare_func, 
+                                      size_t node_pool_size,
+                                      size_t list_pool_size, 
+                                      size_t order_node_pool_size) {
+    // Allocate the tree structure itself using standard malloc (similar to csb_create_tree)
+    CSBTree* tree = (CSBTree*)malloc(sizeof(CSBTree));
+    if (!tree) {
+        perror("Failed to allocate CSBTree structure");
+        return NULL;
+    }
+    tree->root = NULL; 
+    tree->compare_keys = compare_func;
+    tree->total_price_levels = 0;
+
+    // Initialize Memory Pools with custom sizes
+    tree->node_pool = pool_create(sizeof(CSBTreeNode), node_pool_size, CACHE_ALIGNMENT);
+    tree->list_pool = pool_create(sizeof(OrderList), list_pool_size, 0); 
+    tree->order_node_pool = pool_create(sizeof(OrderNode), order_node_pool_size, 0);
+
+    if (!tree->node_pool || !tree->list_pool || !tree->order_node_pool) {
+        fprintf(stderr, "FATAL: Failed to create memory pools for CSBTree.\n");
+        // Cleanup partially created pools before exiting
+        pool_destroy(tree->node_pool);
+        pool_destroy(tree->list_pool);
+        pool_destroy(tree->order_node_pool);
+        free(tree); // Free the tree struct itself
+        return NULL;
+    }
+    
+    // Initialize lazy deletion support
+    memset(tree->lazy_deletes, 0, sizeof(LazyDeleteEntry) * CSB_MAX_LAZY_DELETES);
+    tree->lazy_delete_count = 0;
+    tree->lazy_delete_enabled = false;
+
+    return tree;
+}
