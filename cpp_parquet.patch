diff --git a/csbtree_c2/csb_tree.c b/csbtree_c2/csb_tree.c
new file mode 100644
index 0000000..01c8a6e
--- /dev/null
+++ b/csbtree_c2/csb_tree.c
@@ -0,0 +1,1713 @@
+#include "csb_tree.h"
+#include "pool_allocator.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+#include <assert.h>
+
+// --- Private Helper Functions --- 
+
+// Default pool sizes (can be tuned)
+#define DEFAULT_NODE_POOL_SIZE 10000
+#define DEFAULT_LIST_POOL_SIZE 5000
+#define DEFAULT_ORDER_NODE_POOL_SIZE 20000
+
+// Cache alignment (common cache line size)
+#define CACHE_ALIGNMENT 128 // Let's try aligning nodes to 128 bytes
+
+// Allocates a node using the tree's node pool
+static CSBTreeNode* allocate_node(CSBTree* tree, bool is_leaf) {
+    CSBTreeNode* node = (CSBTreeNode*)pool_alloc(tree->node_pool);
+    if (!node) {
+        fprintf(stderr, "FATAL: Failed to allocate CSBTreeNode from pool (pool full?).\n");
+        // In HFT, running out of pre-allocated memory is often fatal
+        exit(EXIT_FAILURE); 
+    }
+    // Explicitly zero the memory (pool_alloc doesn't guarantee zeroing)
+    memset(node, 0, sizeof(CSBTreeNode)); 
+    node->is_leaf = is_leaf;
+    node->num_keys = 0;
+    return node;
+}
+
+// Frees an OrderList and all its OrderNodes using the respective pools
+static void destroy_order_list(CSBTree* tree, OrderList* list) {
+    if (!list) return;
+    OrderNode* current = list->head;
+    while (current) {
+        OrderNode* next = current->next;
+        pool_free(tree->order_node_pool, current);
+        current = next;
+    }
+    pool_free(tree->list_pool, list);
+}
+
+// Recursively frees nodes (post-order traversal) using the node pool
+static void free_node_recursive(CSBTree* tree, CSBTreeNode* node) {
+    if (!node) return;
+
+    if (node->is_leaf) {
+        // Free the OrderLists associated with this leaf
+        for (uint8_t i = 0; i < node->num_keys; ++i) {
+            // Pass the tree pointer to destroy_order_list now
+            destroy_order_list(tree, node->data.leaf.values[i]);
+        }
+        // No need to free next_leaf pointer itself, just the node
+    } else {
+        // Recursively free child nodes
+        for (uint8_t i = 0; i <= node->num_keys; ++i) { // Note: num_keys + 1 children
+            free_node_recursive(tree, node->data.internal.children[i]);
+        }
+    }
+    pool_free(tree->node_pool, node);
+}
+
+// Creates and initializes an OrderList using the tree's list pool
+static OrderList* create_order_list(CSBTree* tree) {
+    OrderList* list = (OrderList*)pool_alloc(tree->list_pool);
+     if (!list) {
+        fprintf(stderr, "FATAL: Failed to allocate OrderList from pool (pool full?).\n");
+        exit(EXIT_FAILURE); 
+    }
+    // Explicitly zero the memory
+    memset(list, 0, sizeof(OrderList));
+    return list;
+}
+
+// Creates a new OrderNode using the tree's order_node pool
+static OrderNode* create_order_node(CSBTree* tree, Order order) {
+    OrderNode* node = (OrderNode*)pool_alloc(tree->order_node_pool);
+    if (!node) {
+        fprintf(stderr, "FATAL: Failed to allocate OrderNode from pool (pool full?).\n");
+        exit(EXIT_FAILURE);
+    }
+    // No need to memset, fields are assigned directly
+    node->order = order;
+    node->next = NULL;
+    return node;
+}
+
+// --- Helper: Search within a node ---
+
+// Finds the index `i` for traversal or insertion.
+// Internal Nodes: Returns index `i` of the child pointer to follow.
+//                 Keys in children[i] < keys[i]. Keys >= keys[i] are in children[i+1].
+// Leaf Nodes:   Returns index `i` where key *should* be if it exists, or where it would be inserted.
+static uint8_t find_index_in_node(const CSBTreeNode* node, uint64_t key, csb_key_compare_func compare)
+{
+    uint8_t i = 0;
+    if (node->is_leaf) {
+        // --- Leaf Node Logic --- 
+        // Find the first key >= target key, or position after last key.
+        uint64_t* keys = node->data.leaf.keys;
+        while (i < node->num_keys && compare(key, keys[i]) > 0) {
+            i++;
+        }
+        // 'i' is now the index where key should be, or num_keys if > all keys.
+        return i; 
+    } else {
+        // --- Internal Node Logic --- 
+        // Find the first key[i] such that key < keys[i].
+        // If key >= keys[i], we need to check the next key or go to the rightmost child.
+        uint64_t* keys = node->data.internal.keys;
+        while (i < node->num_keys && compare(key, keys[i]) >= 0) {
+            // If key is >= the current separator key, 
+            // it belongs in the subtree to the right of this key.
+            i++;
+        }
+        // 'i' is now the index of the child pointer to follow.
+        return i;
+    }
+}
+
+// --- OrderList Helper Functions ---
+
+/*
+ * ASCII Art: add_order_to_list
+ * Goal: Insert 'NewOrder' into sorted list (by time/id).
+ *
+ * BEFORE:
+ *   list->head -> [OrderA (t=10)] -> [OrderB (t=15)] -> NULL
+ *   NewOrder (t=12)
+ *
+ * AFTER:
+ *   list->head -> [OrderA (t=10)] -> [NewNode (t=12)] -> [OrderB (t=15)] -> NULL
+ *
+ * Invariants Maintained:
+ * - Sorted order (timestamp ASC, order_id ASC)
+ * - list->count incremented
+ * - list->total_volume updated
+ */
+static void add_order_to_list(CSBTree* tree, OrderList* list, Order order) {
+    OrderNode* new_node = create_order_node(tree, order);
+    list->total_volume += order.size;
+    list->count++;
+
+    // Insert into sorted list (primary: timestamp ASC, secondary: order_id ASC)
+    OrderNode** current_ptr = &list->head;
+    while (*current_ptr != NULL && 
+           (order.timestamp > (*current_ptr)->order.timestamp ||
+            (order.timestamp == (*current_ptr)->order.timestamp && order.order_id > (*current_ptr)->order.order_id))) 
+    {
+        current_ptr = &(*current_ptr)->next;
+    }
+    new_node->next = *current_ptr;
+    *current_ptr = new_node;
+}
+
+// --- Helper Functions for Insertion ---
+
+// Finds the leaf node where the key should reside.
+// Returns the leaf node.
+static CSBTreeNode* find_leaf_for_key(CSBTree* tree, uint64_t key) {
+    if (!tree->root) {
+        return NULL; // Should be handled by caller creating root if needed
+    }
+    CSBTreeNode* current = tree->root;
+    while (!current->is_leaf) {
+        uint8_t index = find_index_in_node(current, key, tree->compare_keys);
+        current = current->data.internal.children[index];
+         if (!current) { // Should not happen in a well-formed tree
+            fprintf(stderr, "Error: Null child found during leaf search.\n");
+            return NULL; 
+        }
+    }
+    return current;
+}
+
+// --- Subtree Price Level Count Helper ---
+
+// Recursively calculates the actual number of *price levels* (keys) in the subtree rooted at `node`.
+// This traverses down to leaves and sums keys, ignoring stored intermediate counts.
+// Used to ensure correctness after splits/merges.
+static size_t get_subtree_price_level_count_recursive(const CSBTreeNode* node) {
+    if (!node) return 0;
+    if (node->is_leaf) {
+        // Leaf count is simply the number of keys it holds
+        return node->num_keys;
+    } else {
+        size_t count = 0;
+        for (uint8_t i = 0; i <= node->num_keys; ++i) {
+            // Recursively call for children
+            count += get_subtree_price_level_count_recursive(node->data.internal.children[i]);
+        }
+        return count;
+    }
+}
+
+// --- Insertion Data Structure ---
+
+// Structure to hold the result of an insertion that might cause a split
+typedef struct InsertResult {
+    bool split_occurred;
+    uint64_t median_key;      // Key to insert into parent (if split_occurred)
+    CSBTreeNode* new_node;    // The newly created node after split (if split_occurred)
+    int price_level_count_change; // How many new price levels were added (+1 or 0)
+} InsertResult;
+
+// Creates an empty InsertResult (no split, no price level count change yet)
+static InsertResult no_split_or_change() {
+    InsertResult result = { .split_occurred = false, .median_key = 0, .new_node = NULL, .price_level_count_change = 0 };
+    return result;
+}
+
+// --- Insertion Helpers (Modified for Price Level Counts) ---
+
+/*
+ * ASCII Art: insert_into_leaf_non_full
+ * Goal: Insert key K, value V into a leaf L that has space.
+ *
+ * BEFORE (e.g., LEAF_ORDER=4, num_keys=2):
+ *   L: [K1|V1] [K3|V3] ___ ___
+ *   Insert (K=K2, V=V2)
+ *
+ * AFTER (num_keys=3):
+ *   L: [K1|V1] [K2|V2] [K3|V3] ___  (Elements shifted right)
+ *
+ * Invariants Maintained:
+ * - Keys remain sorted.
+ * - num_keys incremented.
+ * - Leaf node remains valid (<= LEAF_ORDER keys).
+ */
+static int insert_into_leaf_non_full(CSBTreeNode* leaf, uint64_t key, OrderList* value, csb_key_compare_func compare) {
+    assert(leaf->is_leaf);
+    assert(leaf->num_keys < CSB_LEAF_ORDER);
+    assert(value != NULL && value->count > 0); // Should be inserting a non-empty list
+
+    uint8_t index = find_index_in_node(leaf, key, compare);
+
+    // Shift existing keys/values to make space
+    memmove(&leaf->data.leaf.keys[index + 1], &leaf->data.leaf.keys[index], (leaf->num_keys - index) * sizeof(uint64_t));
+    memmove(&leaf->data.leaf.values[index + 1], &leaf->data.leaf.values[index], (leaf->num_keys - index) * sizeof(OrderList*));
+
+    // Insert the new key/value
+    leaf->data.leaf.keys[index] = key;
+    leaf->data.leaf.values[index] = value;
+    leaf->num_keys++;
+
+    return 1; // Return +1 because a new price level was added
+}
+
+/*
+ * ASCII Art: split_leaf_node
+ * Goal: Split a full leaf L when inserting (K, V).
+ *
+ * BEFORE (e.g., LEAF_ORDER=3, num_keys=3):
+ *   L: [K1|V1] [K2|V2] [K3|V3]  -> NextLeaf
+ *   Insert (K=K2.5, V=V2.5) -> Temporary: [K1|V1] [K2|V2] [K2.5|V2.5] [K3|V3]
+ *
+ * AFTER (Split point = (3+1)/2 = 2):
+ *   L (num_keys=2): [K1|V1] [K2|V2] ___  -> NewL
+ *   NewL (num_keys=2): [K2.5|V2.5] [K3|V3] ___ -> NextLeaf
+ *   Result: { split=true, median_key=K2.5, new_node=NewL, count_change=+1 }
+ *
+ * Invariants Maintained:
+ * - Both L and NewL satisfy min/max key constraints (>= MIN_LEAF_KEYS).
+ * - Keys are partitioned correctly (keys in L < median_key <= keys in NewL).
+ * - Leaf nodes remain linked (L -> NewL -> NextLeaf).
+ * - A new price level was added overall (+1 count change).
+ */
+static InsertResult split_leaf_node(CSBTree* tree, CSBTreeNode* leaf, uint64_t key, OrderList* value, csb_key_compare_func compare) {
+    assert(leaf->is_leaf);
+    assert(leaf->num_keys == CSB_LEAF_ORDER);
+    assert(value != NULL && value->count > 0);
+
+    uint64_t temp_keys[CSB_LEAF_ORDER + 1];
+    OrderList* temp_values[CSB_LEAF_ORDER + 1];
+    uint8_t insert_pos = find_index_in_node(leaf, key, compare); // Find where new key goes
+
+    // Copy elements before insertion point
+    memcpy(temp_keys, leaf->data.leaf.keys, insert_pos * sizeof(uint64_t));
+    memcpy(temp_values, leaf->data.leaf.values, insert_pos * sizeof(OrderList*));
+    // Insert new element
+    temp_keys[insert_pos] = key;
+    temp_values[insert_pos] = value;
+    // Copy elements after insertion point
+    memcpy(temp_keys + insert_pos + 1, leaf->data.leaf.keys + insert_pos, (CSB_LEAF_ORDER - insert_pos) * sizeof(uint64_t));
+    memcpy(temp_values + insert_pos + 1, leaf->data.leaf.values + insert_pos, (CSB_LEAF_ORDER - insert_pos) * sizeof(OrderList*));
+
+    CSBTreeNode* new_leaf = allocate_node(tree, true);
+    new_leaf->data.leaf.next_leaf = leaf->data.leaf.next_leaf;
+    leaf->data.leaf.next_leaf = new_leaf;
+
+    uint8_t split_point = (CSB_LEAF_ORDER + 1) / 2;
+
+    // Update the original (left) leaf node
+    leaf->num_keys = split_point;
+    memcpy(leaf->data.leaf.keys, temp_keys, split_point * sizeof(uint64_t));
+    memcpy(leaf->data.leaf.values, temp_values, split_point * sizeof(OrderList*));
+    memset(leaf->data.leaf.keys + split_point, 0, (CSB_LEAF_ORDER - split_point) * sizeof(uint64_t));
+    memset(leaf->data.leaf.values + split_point, 0, (CSB_LEAF_ORDER - split_point) * sizeof(OrderList*));
+
+    // Update the new (right) leaf node
+    new_leaf->num_keys = CSB_LEAF_ORDER + 1 - split_point;
+    memcpy(new_leaf->data.leaf.keys, temp_keys + split_point, new_leaf->num_keys * sizeof(uint64_t));
+    memcpy(new_leaf->data.leaf.values, temp_values + split_point, new_leaf->num_keys * sizeof(OrderList*));
+
+    InsertResult result;
+    result.split_occurred = true;
+    result.median_key = new_leaf->data.leaf.keys[0];
+    result.new_node = new_leaf;
+    result.price_level_count_change = 1; // A new price level was added in this operation
+
+    return result;
+}
+
+/*
+ * ASCII Art: insert_into_internal_non_full
+ * Goal: Insert key K and right child pointer C' into internal node N at index `idx`.
+ *
+ * BEFORE (e.g., INTERNAL_ORDER=5 (4 keys max), num_keys=2, idx=1):
+ *   N: [K1] [K3] ___ ___   (Keys)
+ *      /   |   \           (Children)
+ *     C0  C1   C3
+ *      c0  c1   c3          (Counts)
+ *   Insert Key=K2, Right Child=C2
+ *
+ * AFTER (num_keys=3):
+ *   N: [K1] [K2] [K3] ___
+ *      /   |   |   \
+ *     C0  C1  C2   C3
+ *      c0' c1' c2'  c3       (c0', c1' recalculated recursively)
+ *
+ * Invariants Maintained:
+ * - Keys remain sorted.
+ * - num_keys incremented.
+ * - Children pointers correctly correspond to key ranges.
+ * - Node remains valid (<= INTERNAL_ORDER-1 keys).
+ * - Subtree counts for affected children (at idx and idx+1) are updated.
+ */
+static void insert_into_internal_non_full(CSBTreeNode* node, uint8_t index, uint64_t key, CSBTreeNode* right_child) {
+    assert(!node->is_leaf);
+    assert(node->num_keys < CSB_INTERNAL_ORDER - 1);
+    assert(index <= node->num_keys);
+
+    // Shift keys
+    memmove(&node->data.internal.keys[index + 1], &node->data.internal.keys[index], (node->num_keys - index) * sizeof(uint64_t));
+    // Shift children pointers
+    memmove(&node->data.internal.children[index + 2], &node->data.internal.children[index + 1], (node->num_keys - index) * sizeof(CSBTreeNode*));
+    // Shift subtree counts - note these will be overwritten below
+    memmove(&node->data.internal.subtree_price_level_counts[index + 2], &node->data.internal.subtree_price_level_counts[index + 1], (node->num_keys - index) * sizeof(uint64_t));
+
+    // Insert the new key and child
+    node->data.internal.keys[index] = key;
+    node->data.internal.children[index + 1] = right_child;
+
+    // Recalculate and store the count for the *new* child subtree.
+    node->data.internal.subtree_price_level_counts[index + 1] = get_subtree_price_level_count_recursive(right_child);
+    
+    // ALSO Recalculate and store the count for the *original* child subtree at index,
+    // as its count might have changed due to the split below it.
+    node->data.internal.subtree_price_level_counts[index] = get_subtree_price_level_count_recursive(node->data.internal.children[index]);
+
+    node->num_keys++;
+}
+
+/*
+ * ASCII Art: split_internal_node
+ * Goal: Split a full internal node N when inserting key K and child C'.
+ *
+ * BEFORE (e.g., INTERNAL_ORDER=5 (4 keys max), num_keys=4):
+ *   N: [K1] [K2] [K3] [K4]
+ *      /  |   |   |   \
+ *     C0 C1  C2  C3  C4
+ *     c0 c1  c2  c3  c4
+ *   Insert Key=K2.5, Child=C2.5 at index=2
+ *   Temporary: Keys=[K1,K2,K2.5,K3,K4], Children=[C0,C1,C2,C2.5,C3,C4]
+ *
+ * AFTER (Median index = 5/2 = 2. Median key = K2.5):
+ *   N (num_keys=2): [K1] [K2] ___ ___
+ *     /   |   \
+ *    C0  C1   C2
+ *    c0' c1'  c2'        (Counts recalculated)
+ *
+ *   NewN (num_keys=2): [K3] [K4] ___ ___
+ *     /   |   \
+ *    C2.5 C3  C4
+ *    c2.5' c3' c4'       (Counts recalculated)
+ *
+ *   Result: { split=true, median_key=K2.5, new_node=NewN, count_change=0 }
+ *           (Median K2.5 is passed up to parent)
+ *
+ * Invariants Maintained:
+ * - Both N and NewN satisfy min/max key constraints.
+ * - Keys and children are partitioned correctly around the promoted median key.
+ * - Subtree counts are recalculated for all children in both N and NewN.
+ * - Split itself doesn't change total price level count (count_change=0).
+ */
+static InsertResult split_internal_node(CSBTree* tree, CSBTreeNode* node, uint8_t index, uint64_t key, CSBTreeNode* right_child, csb_key_compare_func compare) {
+    assert(!node->is_leaf);
+    assert(node->num_keys == CSB_INTERNAL_ORDER - 1);
+
+    uint64_t temp_keys[CSB_INTERNAL_ORDER];
+    CSBTreeNode* temp_children[CSB_INTERNAL_ORDER + 1];
+
+    // Copy existing keys/children data before insertion point into temp arrays
+    memcpy(temp_keys, node->data.internal.keys, index * sizeof(uint64_t));
+    memcpy(temp_children, node->data.internal.children, (index + 1) * sizeof(CSBTreeNode*));
+
+    // Insert the new key and child into temp arrays
+    temp_keys[index] = key;
+    temp_children[index + 1] = right_child;
+
+    // Copy existing keys/children data after insertion point into temp arrays
+    memcpy(temp_keys + index + 1, node->data.internal.keys + index, (CSB_INTERNAL_ORDER - 1 - index) * sizeof(uint64_t));
+    memcpy(temp_children + index + 2, node->data.internal.children + index + 1, (CSB_INTERNAL_ORDER - (index + 1)) * sizeof(CSBTreeNode*));
+
+    CSBTreeNode* new_node = allocate_node(tree, false); // is_leaf = false
+    uint8_t median_index = (CSB_INTERNAL_ORDER) / 2;
+    uint64_t median_key = temp_keys[median_index];
+
+    // Update the original (left) node
+    node->num_keys = median_index;
+    memcpy(node->data.internal.keys, temp_keys, median_index * sizeof(uint64_t));
+    memcpy(node->data.internal.children, temp_children, (median_index + 1) * sizeof(CSBTreeNode*));
+    // Recalculate counts for the left node's children recursively
+    for (uint8_t i = 0; i <= node->num_keys; ++i) {
+        node->data.internal.subtree_price_level_counts[i] = get_subtree_price_level_count_recursive(node->data.internal.children[i]);
+    }
+    // Zero out the rest (optional but good practice)
+    memset(node->data.internal.keys + median_index, 0, (CSB_INTERNAL_ORDER - 1 - median_index) * sizeof(uint64_t));
+    memset(node->data.internal.children + median_index + 1, 0, (CSB_INTERNAL_ORDER - (median_index + 1)) * sizeof(CSBTreeNode*));
+    memset(node->data.internal.subtree_price_level_counts + median_index + 1, 0, (CSB_INTERNAL_ORDER - (median_index + 1)) * sizeof(uint64_t));
+
+    // Update the new (right) node
+    new_node->num_keys = CSB_INTERNAL_ORDER - 1 - median_index;
+    memcpy(new_node->data.internal.keys, temp_keys + median_index + 1, new_node->num_keys * sizeof(uint64_t));
+    memcpy(new_node->data.internal.children, temp_children + median_index + 1, (new_node->num_keys + 1) * sizeof(CSBTreeNode*));
+    // Recalculate counts for the right node's children recursively
+    for (uint8_t i = 0; i <= new_node->num_keys; ++i) {
+        new_node->data.internal.subtree_price_level_counts[i] = get_subtree_price_level_count_recursive(new_node->data.internal.children[i]);
+    }
+
+    InsertResult result;
+    result.split_occurred = true;
+    result.median_key = median_key;
+    result.new_node = new_node;
+    // This split itself doesn't change the total price level count directly
+    result.price_level_count_change = 0;
+
+    return result;
+}
+
+// --- Recursive Insertion Helper (Handles Price Level Counts) ---
+
+// Inserts an order into the subtree rooted at `node`.
+// Handles existing price levels, new price levels, and splits.
+// Updates subtree price level counts along the path.
+// Returns InsertResult indicating if a split occurred and the price level count change (+1 or 0).
+static InsertResult insert_recursive(CSBTree* tree, CSBTreeNode* node, Order order) {
+    
+    uint64_t key = order.price;
+
+    if (node->is_leaf) {
+        // --- Base Case: Leaf Node ---
+        uint8_t index = find_index_in_node(node, key, tree->compare_keys);
+        
+        if (index < node->num_keys && tree->compare_keys(key, node->data.leaf.keys[index]) == 0) {
+            // Price level exists, add order to the list
+            add_order_to_list(tree, node->data.leaf.values[index], order);
+            // Return no split, no price level change
+            return no_split_or_change();
+        } else {
+            // Price level does not exist, need to insert a new key/value pair
+            OrderList* new_list = create_order_list(tree);
+            add_order_to_list(tree, new_list, order);
+
+            if (node->num_keys < CSB_LEAF_ORDER) {
+                // Leaf has space
+                insert_into_leaf_non_full(node, key, new_list, tree->compare_keys);
+                // Return no split, price level count changed by +1
+                InsertResult result = no_split_or_change();
+                result.price_level_count_change = 1;
+                return result;
+            } else {
+                // Leaf is full, split it
+                InsertResult split_res = split_leaf_node(tree, node, key, new_list, tree->compare_keys);
+                // split_leaf_node already set price_level_count_change to +1
+                return split_res;
+            }
+        }
+    } else {
+        // --- Recursive Step: Internal Node ---
+        uint8_t index = find_index_in_node(node, key, tree->compare_keys);
+        CSBTreeNode* child_to_descend = node->data.internal.children[index];
+        
+        InsertResult result_from_child = insert_recursive(tree, child_to_descend, order);
+
+        // Update current node's subtree price level count for the child we descended into,
+        // but only if the count actually changed below (i.e., a new price level was added).
+        if (result_from_child.price_level_count_change > 0) {
+           node->data.internal.subtree_price_level_counts[index] += result_from_child.price_level_count_change;
+           // It might be safer to *always* recalculate here, but let's try incremental first:
+           // node->data.internal.subtree_price_level_counts[index] = get_subtree_price_level_count_recursive(child_to_descend);
+        }
+
+        if (result_from_child.split_occurred) {
+            // Child split, need to insert median key/new node into current node
+            uint64_t median_key = result_from_child.median_key;
+            CSBTreeNode* new_child_node = result_from_child.new_node;
+
+            if (node->num_keys < CSB_INTERNAL_ORDER - 1) {
+                // Current internal node has space
+                insert_into_internal_non_full(node, index, median_key, new_child_node);
+                // insert_into_internal_non_full recalculated counts for index and index+1.
+                // Split was absorbed. Return no split, pass original price level change up.
+                InsertResult result = no_split_or_change();
+                result.price_level_count_change = result_from_child.price_level_count_change; // Propagate original change
+                return result;
+            } else {
+                // Current internal node is also full, split it
+                InsertResult current_split_res = split_internal_node(tree, node, index, median_key, new_child_node, tree->compare_keys);
+                // split_internal_node recalculated counts for the new nodes.
+                // Propagate the split upwards. Pass original price level change up.
+                current_split_res.price_level_count_change = result_from_child.price_level_count_change; // Propagate original change
+                return current_split_res;
+            }
+        } else {
+            // Child did not split. Pass the result (esp. price_level_count_change) upwards.
+            return result_from_child; // Propagate original change
+        }
+    }
+}
+
+// --- Public API Implementation ---
+
+// Creates a new CSB-Tree
+CSBTree* csb_create_tree(csb_key_compare_func compare_func) {
+    // Allocate the tree structure itself using standard malloc (it's small)
+    CSBTree* tree = (CSBTree*)malloc(sizeof(CSBTree));
+    if (!tree) {
+        perror("Failed to allocate CSBTree structure");
+        return NULL;
+    }
+    tree->root = NULL; 
+    tree->compare_keys = compare_func;
+    assert(compare_func != NULL); 
+    tree->total_price_levels = 0;
+
+    // Initialize Memory Pools
+    // Align nodes to 128 bytes, lists/order_nodes to default (pointer size)
+    tree->node_pool = pool_create(sizeof(CSBTreeNode), DEFAULT_NODE_POOL_SIZE, CACHE_ALIGNMENT);
+    tree->list_pool = pool_create(sizeof(OrderList), DEFAULT_LIST_POOL_SIZE, 0); 
+    tree->order_node_pool = pool_create(sizeof(OrderNode), DEFAULT_ORDER_NODE_POOL_SIZE, 0);
+
+    if (!tree->node_pool || !tree->list_pool || !tree->order_node_pool) {
+        fprintf(stderr, "FATAL: Failed to create memory pools for CSBTree.\n");
+        // Cleanup partially created pools before exiting
+        pool_destroy(tree->node_pool);
+        pool_destroy(tree->list_pool);
+        pool_destroy(tree->order_node_pool);
+        free(tree); // Free the tree struct itself
+        exit(EXIT_FAILURE);
+    }
+    
+    // Initialize lazy deletion support
+    memset(tree->lazy_deletes, 0, sizeof(LazyDeleteEntry) * CSB_MAX_LAZY_DELETES);
+    tree->lazy_delete_count = 0;
+    tree->lazy_delete_enabled = false;
+
+    return tree;
+}
+
+// Destroys the CSB-Tree and frees all associated memory
+void csb_destroy_tree(CSBTree* tree) {
+    if (!tree) return;
+    // Free all nodes using the recursive helper (which now uses the pools)
+    free_node_recursive(tree, tree->root);
+    
+    // Destroy the memory pools
+    pool_destroy(tree->node_pool);
+    pool_destroy(tree->list_pool);
+    pool_destroy(tree->order_node_pool);
+
+    // Free the tree structure itself
+    free(tree);
+}
+
+// Adds an order to the tree.
+int csb_add_order(CSBTree* tree, Order order) {
+    if (!tree) return -1;
+
+    // --- Handle Empty Tree --- Special Case
+    if (!tree->root) {
+        tree->root = allocate_node(tree, true);
+        OrderList* new_list = create_order_list(tree);
+        add_order_to_list(tree, new_list, order);
+        tree->root->data.leaf.keys[0] = order.price;
+        tree->root->data.leaf.values[0] = new_list;
+        tree->root->num_keys = 1;
+        tree->root->data.leaf.next_leaf = NULL;
+        tree->total_price_levels = 1; // First price level
+        return 0;
+    }
+
+    // --- Use Recursive Insertion --- 
+    InsertResult result = insert_recursive(tree, tree->root, order);
+
+    // Update total price level count
+    if (result.price_level_count_change > 0) {
+        tree->total_price_levels += result.price_level_count_change;
+    }
+
+    // Handle root split if it occurred
+    if (result.split_occurred) {
+        CSBTreeNode* old_root = tree->root;
+        CSBTreeNode* new_root = allocate_node(tree, false);
+        new_root->num_keys = 1;
+        new_root->data.internal.keys[0] = result.median_key;
+        new_root->data.internal.children[0] = old_root;
+        new_root->data.internal.children[1] = result.new_node;
+        // Set initial price level counts for the new root using recursive calculation
+        new_root->data.internal.subtree_price_level_counts[0] = get_subtree_price_level_count_recursive(old_root);
+        new_root->data.internal.subtree_price_level_counts[1] = get_subtree_price_level_count_recursive(result.new_node);
+        tree->root = new_root;
+    }
+
+    return 0; // Success
+}
+
+// --- OrderList Helper for Deletion ---
+
+// Removes an order by ID from an OrderList.
+// Returns true if found and removed, false otherwise.
+// Updates the list's count and total_volume.
+static bool remove_order_from_list(CSBTree* tree, OrderList* list, uint64_t order_id) {
+    if (!list || !list->head) return false;
+
+    OrderNode** current_ptr = &list->head;
+    while (*current_ptr != NULL) {
+        OrderNode* entry = *current_ptr;
+        if (entry->order.order_id == order_id) {
+            // Found the order
+            *current_ptr = entry->next; // Unlink the node
+            list->count--;
+            list->total_volume -= entry->order.size;
+            pool_free(tree->order_node_pool, entry);
+            return true;
+        }
+        current_ptr = &entry->next;
+    }
+    return false; // Order ID not found in this list
+}
+
+// --- Deletion Helper Functions ---
+
+/*
+ * ASCII Art: remove_from_leaf
+ * Goal: Remove key/value pair at index `idx` from leaf L.
+ *
+ * BEFORE (e.g., idx=1):
+ *   L: [K1|V1] [K2|V2] [K3|V3] ___
+ *
+ * AFTER:
+ *   L: [K1|V1] [K3|V3] ___ ___  (Elements shifted left, V2 destroyed)
+ *   Return: -1 (price level count change)
+ *
+ * Invariants Maintained:
+ * - Keys remain sorted.
+ * - num_keys decremented.
+ * - OrderList at `idx` is destroyed.
+ * - Node might underflow (handled by caller).
+ */
+static int remove_from_leaf(CSBTree* tree, CSBTreeNode* leaf, uint8_t index) {
+    assert(leaf->is_leaf);
+    assert(index < leaf->num_keys);
+
+    // Destroy the associated OrderList (it must be empty by this point)
+    destroy_order_list(tree, leaf->data.leaf.values[index]);
+
+    // Shift keys and values left
+    memmove(&leaf->data.leaf.keys[index], &leaf->data.leaf.keys[index + 1], (leaf->num_keys - 1 - index) * sizeof(uint64_t));
+    memmove(&leaf->data.leaf.values[index], &leaf->data.leaf.values[index + 1], (leaf->num_keys - 1 - index) * sizeof(OrderList*));
+
+    leaf->num_keys--;
+    // Zero out the last (now unused) elements (optional)
+    leaf->data.leaf.keys[leaf->num_keys] = 0;
+    leaf->data.leaf.values[leaf->num_keys] = NULL;
+
+    return -1; // A price level was removed
+}
+
+// After the remove_from_leaf function, add a simple DeleteResult struct:
+
+// Simple structure for delete operation results
+typedef struct DeleteResult {
+    bool success;              // Whether deletion was successful
+    int price_level_count_change; // How price level count changed (0 or -1)
+} DeleteResult;
+
+// After the DeleteResult struct, add the needed structures for the iterative implementation
+typedef struct PathElement {
+    CSBTreeNode* node;
+    uint8_t index;
+} PathElement;
+
+typedef struct DeleteStack {
+    PathElement elements[32]; // Supports trees up to depth 32
+    int size;
+} DeleteStack;
+
+// Forward declarations of helper functions
+static bool is_lazy_deleted(CSBTree* tree, uint64_t price, uint64_t order_id);
+static bool add_to_lazy_deletes(CSBTree* tree, uint64_t price, uint64_t order_id);
+static bool delete_fast_path(CSBTree* tree, uint64_t price, uint64_t order_id, int* price_level_change);
+
+// Forward declarations for underflow handling
+static void handle_node_underflow(CSBTree* tree, DeleteStack* stack);
+static void handle_leaf_underflow(CSBTree* tree, CSBTreeNode* leaf, CSBTreeNode* parent, uint8_t parent_index);
+static void handle_internal_underflow(CSBTree* tree, CSBTreeNode* node, CSBTreeNode* parent, uint8_t parent_index);
+static void redistribute_leaf_nodes(CSBTree* tree, CSBTreeNode* left, CSBTreeNode* right, CSBTreeNode* parent, uint8_t separator_index);
+static void merge_leaf_nodes(CSBTree* tree, CSBTreeNode* left, CSBTreeNode* right, CSBTreeNode* parent, uint8_t separator_index);
+static void redistribute_internal_nodes(CSBTree* tree, CSBTreeNode* left, CSBTreeNode* right, CSBTreeNode* parent, uint8_t separator_index);
+static void merge_internal_nodes(CSBTree* tree, CSBTreeNode* left, CSBTreeNode* right, CSBTreeNode* parent, uint8_t separator_index);
+
+// Initialize an empty delete stack
+static void init_delete_stack(DeleteStack* stack) {
+    stack->size = 0;
+}
+
+// Push a node and index onto the stack
+static void push_delete_stack(DeleteStack* stack, CSBTreeNode* node, uint8_t index) {
+    if (stack->size < 32) {
+        stack->elements[stack->size].node = node;
+        stack->elements[stack->size].index = index;
+        stack->size++;
+    } else {
+        fprintf(stderr, "Error: Delete stack overflow\n");
+    }
+}
+
+// Pop an element from the stack
+static PathElement pop_delete_stack(DeleteStack* stack) {
+    if (stack->size > 0) {
+        stack->size--;
+        return stack->elements[stack->size];
+    } else {
+        PathElement empty = {NULL, 0};
+        return empty;
+    }
+}
+
+// Check if the stack is empty
+static bool is_delete_stack_empty(DeleteStack* stack) {
+    return stack->size == 0;
+}
+
+// --- Fast path: Direct leaf lookup for delete ---
+static bool delete_fast_path(CSBTree* tree, uint64_t price, uint64_t order_id, int* price_level_change) {
+    *price_level_change = 0;
+    
+    // Use direct leaf lookup for the price
+    CSBTreeNode* leaf = find_leaf_for_key(tree, price);
+    if (!leaf) return false;
+    
+    // Search for price in this leaf
+    uint8_t index = find_index_in_node(leaf, price, tree->compare_keys);
+    if (index >= leaf->num_keys || tree->compare_keys(price, leaf->data.leaf.keys[index]) != 0) {
+        return false; // Price not found
+    }
+    
+    // Try to remove order from the order list
+    OrderList* list = leaf->data.leaf.values[index];
+    if (!remove_order_from_list(tree, list, order_id)) {
+        return false; // Order ID not found
+    }
+    
+    // If order list is now empty, remove the price level
+    if (list->count == 0) {
+        remove_from_leaf(tree, leaf, index);
+        *price_level_change = -1;
+    }
+    
+    return true; // Deletion successful
+}
+
+// Now replace the original csb_delete_order function with this improved version:
+
+int csb_delete_order(CSBTree* tree, uint64_t price, uint64_t order_id) {
+    if (!tree || !tree->root) {
+        return -1; // Tree is empty
+    }
+    
+    // Check if lazy deletion is enabled
+    if (tree->lazy_delete_enabled) {
+        // Check if this order is already in the lazy delete list
+        if (is_lazy_deleted(tree, price, order_id)) {
+            return 0; // Already scheduled for deletion
+        }
+        
+        // Try to add to lazy delete list
+        if (add_to_lazy_deletes(tree, price, order_id)) {
+            return 0; // Successfully added to lazy delete list
+        }
+        // If adding to lazy delete list failed, fall through to normal deletion
+    }
+    
+    // Optimization: Check if the order actually exists. 
+    // This adds overhead but prevents unnecessary tree modification attempts.
+    // If performance is paramount and deletions of non-existent orders are rare,
+    // this check could potentially be removed, relying on the traversal to fail.
+    OrderList* list_check = csb_lookup_orders_by_price(tree, price);
+    bool order_existed_in_list = false;
+    if (list_check) {
+        OrderNode* current_check = list_check->head;
+        while (current_check) {
+            if (current_check->order.order_id == order_id) {
+                order_existed_in_list = true;
+                break;
+            }
+            current_check = current_check->next;
+        }
+    }
+    if (!order_existed_in_list) {
+        return -1; // Order didn't exist in the first place
+    }
+    
+    // Try fast path delete first (might modify price_level_change)
+    int price_level_change = 0;
+    CSBTreeNode* leaf_node_for_fast_path = find_leaf_for_key(tree, price);
+    bool fast_path_possible = false;
+    if (leaf_node_for_fast_path) {
+        uint8_t index = find_index_in_node(leaf_node_for_fast_path, price, tree->compare_keys);
+        if (index < leaf_node_for_fast_path->num_keys && tree->compare_keys(price, leaf_node_for_fast_path->data.leaf.keys[index]) == 0) {
+             OrderList* list = leaf_node_for_fast_path->data.leaf.values[index];
+             // Fast path only applicable if removing the order doesn't empty the list OR
+             // if it empties the list but the leaf node won't underflow after removal.
+             if (list->count > 1 || leaf_node_for_fast_path->num_keys > CSB_MIN_LEAF_KEYS) {
+                fast_path_possible = true;
+             }
+        }
+    }
+
+    if (fast_path_possible && delete_fast_path(tree, price, order_id, &price_level_change)) {
+        // Update tree stats if a price level was removed
+        if (price_level_change < 0) {
+            tree->total_price_levels += price_level_change;
+            // IMPORTANT: Fast path *doesn't* update ancestor counts. 
+            // This is only safe because we checked that no underflow occurred.
+            // If counts need to be perfectly accurate *always*, even after fast path,
+            // we'd need to add a path update here too.
+        }
+        
+        // Fast path handles tree becoming empty already (if root was the leaf)
+        // We don't need the root handling here after fast path succeed
+        
+        return 0; // Successful delete via fast path
+    }
+    
+    // --- Iterative Deletion Path (if fast path failed or wasn't applicable) ---
+    DeleteStack stack;
+    init_delete_stack(&stack);
+    
+    CSBTreeNode* current = tree->root;
+    bool order_removed_from_list = false;
+    // price_level_change is reset here for the iterative path
+    price_level_change = 0; 
+    CSBTreeNode* target_leaf_node = NULL; 
+    uint8_t leaf_index = 0; // Index within the leaf where price level was found/removed
+
+    // Phase 1: Traverse down to leaf, storing path
+    while (current != NULL) {
+        uint8_t index = find_index_in_node(current, price, tree->compare_keys);
+        push_delete_stack(&stack, current, index);
+        if (current->is_leaf) {
+            target_leaf_node = current;
+            leaf_index = index;
+            break; // Found the potential leaf
+        }
+        current = current->data.internal.children[index];
+    }
+    
+    // Phase 2: Handle leaf node operations
+    if (target_leaf_node != NULL && 
+        leaf_index < target_leaf_node->num_keys && 
+        tree->compare_keys(price, target_leaf_node->data.leaf.keys[leaf_index]) == 0) {
+        
+        // Found the price level in the leaf
+        OrderList* list = target_leaf_node->data.leaf.values[leaf_index];
+        if (remove_order_from_list(tree, list, order_id)) {
+            order_removed_from_list = true; 
+
+            // If list became empty, remove the price level itself
+            if (list->count == 0) {
+                price_level_change = remove_from_leaf(tree, target_leaf_node, leaf_index);
+                assert(price_level_change == -1); // remove_from_leaf should return -1
+            }
+        }
+    }
+
+    // If the order wasn't found in the list (or price level wasn't found), pop stack and return error
+    if (!order_removed_from_list) {
+        // Need to pop the stack to avoid leaving stale pointers if we exit early
+        while(!is_delete_stack_empty(&stack)) pop_delete_stack(&stack);
+        return -1; // Order not found or couldn't be removed
+    }
+    
+    // Phase 3: Update subtree counts and handle underflow on the path back up
+    
+    // Adjust total count first
+    if (price_level_change != 0) {
+         tree->total_price_levels += price_level_change;
+    }
+
+    // Remove the leaf node entry itself from the stack as its state is handled directly.
+    // We will check it for underflow inside handle_node_underflow using the peeked parent.
+    PathElement leaf_path_element = pop_delete_stack(&stack); 
+    assert(leaf_path_element.node == target_leaf_node);
+
+    // Update counts ONLY if a price level was actually removed.
+    // If only an order was removed from a list, counts don't change.
+    if (price_level_change != 0) {
+        DeleteStack count_update_stack = stack; // Use a copy for count updates
+        while (!is_delete_stack_empty(&count_update_stack)) {
+            PathElement element = pop_delete_stack(&count_update_stack);
+            CSBTreeNode* node = element.node;
+            uint8_t index = element.index;
+            
+            // Internal nodes have counts to update
+            if (!node->is_leaf) { 
+                node->data.internal.subtree_price_level_counts[index] += price_level_change;
+            }
+            // else: leaf nodes don't store subtree counts
+        }
+    }
+    
+    // Phase 4: Handle potential underflow propagation upwards
+    // Push the affected leaf node back onto the stack (if a price level was removed)
+    // so that handle_node_underflow starts checking from the leaf level.
+    if (price_level_change != 0) {
+       push_delete_stack(&stack, target_leaf_node, leaf_index); // Push leaf back
+       handle_node_underflow(tree, &stack);
+    }
+    // Note: If price_level_change is 0, no structural change happened, so no underflow check needed.
+
+    // The handle_node_underflow function now handles root changes (emptying, promotion).
+    // We no longer need the specific root handling checks that were here previously.
+
+    return 0; // Deletion successful
+}
+
+// Finds the order list for a specific price level.
+OrderList* csb_lookup_orders_by_price(const CSBTree* tree, uint64_t price) {
+    if (!tree || !tree->root) {
+        // printf("Lookup price %lu: Tree or root is NULL\n", price);
+        return NULL;
+    }
+
+    // printf("Lookup price %lu: Starting at root (is_leaf=%d, keys=%u)\n", price, tree->root->is_leaf, tree->root->num_keys);
+    CSBTreeNode* current = tree->root;
+    csb_key_compare_func compare = tree->compare_keys;
+
+    // 1. Traverse down the tree
+    while (!current->is_leaf) {
+        uint8_t index = find_index_in_node(current, price, compare);
+        // printf("Lookup price %lu: Internal node, index=%u\n", price, index);
+        if (index > current->num_keys) { // Should not happen
+             fprintf(stderr, "Lookup Error: index %u > num_keys %u\n", index, current->num_keys);
+             return NULL;
+        }
+        current = current->data.internal.children[index];
+        if (!current) {
+            // printf("Lookup price %lu: Traversed to NULL child at index %u\n", price, index);
+            return NULL;
+        }
+         // printf("Lookup price %lu: Descended to node (is_leaf=%d, keys=%u)\n", price, current->is_leaf, current->num_keys);
+    }
+
+    // 2. Search within the leaf node
+    CSBTreeNode* leaf = current;
+    // printf("Lookup price %lu: At leaf node. Searching...\n", price);
+    uint8_t index = find_index_in_node(leaf, price, compare);
+    // printf("Lookup price %lu: Leaf node, found index=%u\n", price, index);
+
+    // Check if the key at the found index actually matches
+    if (index < leaf->num_keys && compare(price, leaf->data.leaf.keys[index]) == 0) {
+        // printf("Lookup price %lu: Match found at index %u. Returning list.\n", price, index);
+        return leaf->data.leaf.values[index];
+    } else {
+        // printf("Lookup price %lu: No match found (index=%u, num_keys=%u)\n", price, index, leaf->num_keys);
+        return NULL; // Price level not found
+    }
+}
+
+// Gets the best price level (highest bid or lowest ask depending on compare_func).
+// The "best" is always the first element according to the tree's sort order.
+// Returns the price key, or a sentinel value (e.g., 0 or UINT64_MAX) if the tree is empty.
+uint64_t csb_get_best_price(const CSBTree* tree) {
+    if (!tree || !tree->root) return 0; // Or UINT64_MAX if 0 is a valid price
+
+    CSBTreeNode* current = tree->root;
+
+    // Traverse to the leftmost leaf to find the minimum element according to the comparator
+    while (!current->is_leaf) {
+        current = current->data.internal.children[0]; // Always go to the leftmost child
+        if (!current) { // Should not happen
+             fprintf(stderr, "Error: Null node during best price traversal.\n");
+             return 0;
+         }
+    }
+
+    // At the leftmost leaf node
+    if (current->num_keys == 0) {
+        return 0; // Empty leaf
+    }
+
+    return current->data.leaf.keys[0]; // First key in the leftmost leaf is always the "best"
+}
+
+// Gets the OrderList associated with the best price level.
+// Returns NULL if the tree is empty.
+OrderList* csb_get_best_price_orders(const CSBTree* tree) {
+     if (!tree || !tree->root) return NULL;
+
+    CSBTreeNode* current = tree->root;
+
+    // Traverse to the leftmost leaf
+    while (!current->is_leaf) {
+        current = current->data.internal.children[0];
+        if (!current) {
+             fprintf(stderr, "Error: Null node during best price orders traversal.\n");
+             return NULL;
+         }
+    }
+
+    // At the leftmost leaf node
+    if (current->num_keys == 0) {
+        return NULL;
+    }
+
+    return current->data.leaf.values[0]; // First value in the leftmost leaf
+}
+
+// Retrieves the price key of the Nth price level in sorted order (0-based index).
+// The sorting order depends on the tree's comparison function.
+// Returns 0 on success, -1 if n is out of bounds (n >= total_price_levels).
+int csb_get_nth_price_level(const CSBTree* tree, size_t n, uint64_t* result_price) {
+    if (!tree || !tree->root || !result_price || n >= tree->total_price_levels) {
+        return -1; // Invalid input or index out of bounds
+    }
+
+    CSBTreeNode* current = tree->root;
+    size_t rank = n; // Remaining rank to find
+
+    // 1. Traverse down using subtree price level counts
+    while (!current->is_leaf) {
+        bool found_child = false;
+        for (uint8_t i = 0; i <= current->num_keys; ++i) {
+            size_t count_in_child = current->data.internal.subtree_price_level_counts[i];
+            if (rank < count_in_child) {
+                // The Nth price level is in this child's subtree
+                current = current->data.internal.children[i];
+                if (!current) { // Should not happen
+                     fprintf(stderr, "Error: Null node during Nth price level traversal.\n");
+                    return -1;
+                }
+                found_child = true;
+                break; // Descend into this child
+            } else {
+                // The Nth price level is further to the right, subtract this child's count
+                rank -= count_in_child;
+            }
+        }
+        if (!found_child) {
+            // This should not happen if total_price_levels and subtree counts are correct
+            fprintf(stderr, "Error: Nth price level rank inconsistency during traversal (rank %zu).\n", rank);
+            // Dump node state for debugging?
+            return -1;
+        }
+    }
+
+    // 2. We are now at the correct leaf node
+    CSBTreeNode* leaf = current;
+
+    // 3. Find the Nth key within this leaf node
+    if (rank < leaf->num_keys) {
+        *result_price = leaf->data.leaf.keys[rank];
+        return 0; // Success
+    } else {
+        // This should not happen if counts were correct
+        fprintf(stderr, "Error: Nth price level rank inconsistency within leaf node (rank %zu, num_keys %u).\n", rank, leaf->num_keys);
+        return -1;
+    }
+}
+
+// Enable or disable lazy deletion mode
+void csb_set_lazy_deletion(CSBTree* tree, bool enable) {
+    if (!tree) return;
+    
+    // If disabling lazy deletion, process any pending deletions
+    if (tree->lazy_delete_enabled && !enable) {
+        csb_process_lazy_deletions(tree);
+    }
+    
+    tree->lazy_delete_enabled = enable;
+}
+
+// Process all pending lazy deletions
+int csb_process_lazy_deletions(CSBTree* tree) {
+    if (!tree || tree->lazy_delete_count == 0) {
+        return 0;
+    }
+    
+    int processed = 0;
+    
+    // Process all valid lazy delete entries
+    for (size_t i = 0; i < CSB_MAX_LAZY_DELETES; i++) {
+        if (tree->lazy_deletes[i].is_valid) {
+            // Get the price and order_id from the lazy delete entry
+            uint64_t price = tree->lazy_deletes[i].price;
+            uint64_t order_id = tree->lazy_deletes[i].order_id;
+            
+            // Temporarily disable lazy deletion to avoid recursion
+            bool original_lazy_setting = tree->lazy_delete_enabled;
+            tree->lazy_delete_enabled = false;
+            
+            // Call delete directly (will use our iterative implementation)
+            csb_delete_order(tree, price, order_id);
+            
+            // Restore lazy deletion setting
+            tree->lazy_delete_enabled = original_lazy_setting;
+            
+            // Mark this entry as processed
+            tree->lazy_deletes[i].is_valid = false;
+            processed++;
+        }
+    }
+    
+    // Reset lazy delete count
+    tree->lazy_delete_count = 0;
+    
+    return processed;
+}
+
+// Check if an order is in the lazy delete list
+static bool is_lazy_deleted(CSBTree* tree, uint64_t price, uint64_t order_id) {
+    for (size_t i = 0; i < CSB_MAX_LAZY_DELETES; i++) {
+        if (tree->lazy_deletes[i].is_valid && 
+            tree->lazy_deletes[i].price == price && 
+            tree->lazy_deletes[i].order_id == order_id) {
+            return true;
+        }
+    }
+    return false;
+}
+
+// Add an order to the lazy delete list
+static bool add_to_lazy_deletes(CSBTree* tree, uint64_t price, uint64_t order_id) {
+    // If the list is full, process all pending deletions first
+    if (tree->lazy_delete_count >= CSB_MAX_LAZY_DELETES) {
+        csb_process_lazy_deletions(tree);
+    }
+    
+    // Find an empty slot
+    for (size_t i = 0; i < CSB_MAX_LAZY_DELETES; i++) {
+        if (!tree->lazy_deletes[i].is_valid) {
+            tree->lazy_deletes[i].price = price;
+            tree->lazy_deletes[i].order_id = order_id;
+            tree->lazy_deletes[i].is_valid = true;
+            tree->lazy_delete_count++;
+            return true;
+        }
+    }
+    
+    // If we get here, something went wrong - the list should have had space
+    return false;
+}
