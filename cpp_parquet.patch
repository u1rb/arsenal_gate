+#include "pool_allocator.h"
+#include <stdlib.h>
+#include <stdio.h>
+#include <stdint.h>
+#include <string.h> // For memset
+
+// Structure for the free list node (intrusive)
+typedef struct FreeNode {
+    struct FreeNode* next_free;
+} FreeNode;
+
+// Pool Allocator structure definition
+struct PoolAllocator {
+    void* memory_block;       // Pointer to the entire allocated memory block
+    FreeNode* free_list_head; // Head of the intrusive linked list of free items
+    size_t item_size;         // Size of each item in bytes
+    size_t aligned_item_size; // Item size adjusted for alignment and FreeNode pointer
+    size_t capacity;          // Maximum number of items
+    size_t allocated_count;   // Current number of allocated items
+    size_t alignment;         // Alignment requirement
+};
+
+// Helper to calculate aligned size
+static size_t calculate_aligned_item_size(size_t item_size, size_t alignment) {
+    // Ensure enough space for the FreeNode pointer
+    size_t required_size = (item_size > sizeof(FreeNode)) ? item_size : sizeof(FreeNode);
+    
+    // Calculate aligned size
+    if (alignment > 0) {
+        return (required_size + alignment - 1) & ~(alignment - 1);
+    } else {
+        // Default alignment (usually sufficient for pointers)
+        return (required_size + sizeof(void*) - 1) & ~(sizeof(void*) - 1);
+    }
+}
+
+PoolAllocator* pool_create(size_t item_size, size_t pool_capacity, size_t alignment) {
+    if (item_size == 0 || pool_capacity == 0) {
+        fprintf(stderr, "PoolAllocator Error: Item size and capacity must be positive.\n");
+        return NULL;
+    }
+    // Ensure alignment is a power of two and also meets minimum requirement for posix_memalign
+    if (alignment == 0) {
+        alignment = sizeof(void*); // Default alignment
+    } else if ((alignment & (alignment - 1)) != 0 || alignment < sizeof(void*)) {
+         fprintf(stderr, "PoolAllocator Error: Alignment must be a power of two and >= sizeof(void*).\n");
+         return NULL;
+    }
+    // effective_alignment is just alignment now
+
+    PoolAllocator* pool = (PoolAllocator*)malloc(sizeof(PoolAllocator));
+    if (!pool) {
+        perror("PoolAllocator Error: Failed to allocate PoolAllocator struct");
+        return NULL;
+    }
+
+    pool->item_size = item_size;
+    pool->capacity = pool_capacity;
+    pool->allocated_count = 0;
+    pool->alignment = alignment; // Store the guaranteed alignment
+    pool->aligned_item_size = calculate_aligned_item_size(item_size, alignment);
+    pool->free_list_head = NULL;
+    pool->memory_block = NULL; // Initialize before allocation attempt
+
+    // Allocate the main memory block using posix_memalign for guaranteed alignment
+    size_t total_size = pool->aligned_item_size * pool->capacity;
+    int ret = posix_memalign(&pool->memory_block, pool->alignment, total_size);
+
+    if (ret != 0 || !pool->memory_block) {
+        fprintf(stderr, "PoolAllocator Error: posix_memalign failed (error code: %d)\n", ret);
+        // Ensure memory_block is NULL if allocation failed before freeing pool struct
+        pool->memory_block = NULL; 
+        free(pool);
+        return NULL;
+    }
+
+    // Initialize the free list by linking all items
+    char* current_item_ptr = (char*)pool->memory_block;
+    for (size_t i = 0; i < pool->capacity; ++i) {
+        // Verify alignment of each item start (for debugging)
+        // if (((uintptr_t)current_item_ptr % pool->alignment) != 0) {
+        //     fprintf(stderr, "Alignment Error during free list init at index %zu!\n", i);
+        // }
+        FreeNode* free_node = (FreeNode*)current_item_ptr;
+        free_node->next_free = pool->free_list_head;
+        pool->free_list_head = free_node;
+        current_item_ptr += pool->aligned_item_size;
+    }
+
+    return pool;
+}
+
+void pool_destroy(PoolAllocator* pool) {
+    if (!pool) return;
+    // Free the main memory block (allocated with posix_memalign, freed with free)
+    free(pool->memory_block); 
+    // Free the pool structure itself
+    free(pool);
+}
+
+void* pool_alloc(PoolAllocator* pool) {
+    if (!pool || !pool->free_list_head) {
+        // Pool is full or invalid
+        fprintf(stderr, "PoolAllocator Warning: Allocation failed (pool full or invalid).\n");
+        return NULL; 
+    }
+
+    // Get the first free node
+    FreeNode* free_node = pool->free_list_head;
+
+    // Update the free list head
+    pool->free_list_head = free_node->next_free;
+
+    pool->allocated_count++;
+
+    // Optional: Zero the memory before returning (can impact performance)
+    // memset(free_node, 0, pool->item_size); // Only zero the actual item size requested
+
+    return (void*)free_node; // Return the pointer to the allocated item
+}
+
+void pool_free(PoolAllocator* pool, void* item) {
+    if (!pool || !item) return;
+
+     // Basic sanity check: Ensure the item is within the pool's memory block
+     char* item_ptr = (char*)item;
+     char* block_start = (char*)pool->memory_block;
+     // Calculate end based on initial allocation, handle potential NULL block
+     char* block_end = block_start ? (block_start + (pool->capacity * pool->aligned_item_size)) : NULL;
+     if (!block_start || item_ptr < block_start || item_ptr >= block_end) {
+         fprintf(stderr, "PoolAllocator Error: Attempting to free memory not belonging to this pool (%p).\n", item);
+         // Maybe exit or assert in debug mode?
+         return; 
+     }
+     // Check alignment check (should pass now if posix_memalign worked)
+     if (((uintptr_t)item_ptr % pool->alignment) != 0) {
+         // This should ideally not happen anymore
+         fprintf(stderr, "PoolAllocator Error: Freeing misaligned pointer (%p), expected alignment %zu.\n", item, pool->alignment);
+         // Consider asserting or exiting in debug
+         return; 
+     }
+
+
+    // Cast the item pointer back to a FreeNode
+    FreeNode* free_node = (FreeNode*)item;
+
+    // Add it to the front of the free list
+    free_node->next_free = pool->free_list_head;
+    pool->free_list_head = free_node;
+
+    pool->allocated_count--;
+}
+
+size_t pool_get_allocated_count(const PoolAllocator* pool) {
+    return pool ? pool->allocated_count : 0;
+}
+
+size_t pool_get_capacity(const PoolAllocator* pool) {
+    return pool ? pool->capacity : 0;
+} 
