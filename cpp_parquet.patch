+        std::cout << "\n--- Multi-Ticker Random Operations Benchmark: " << TEST_OPS << " operations ---\n";
+        
+        for (size_t i = 0; i < TEST_OPS; ++i) {
+            // Randomly select a ticker for this operation
+            size_t ticker_id = ticker_dist(rng);
+            CSBTree* tree = order_books[ticker_id];
+            
+            // Randomly choose operation: insert (40%), delete (30%), lookup (30%)
+            int operation = std::uniform_int_distribution<int>(1, 10)(rng);
+            
+            if (operation <= 4) {
+                // INSERT operation
+                Order order = {
+                    .order_id = next_order_id++,
+                    .price = price_dist(rng),
