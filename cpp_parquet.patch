+        for (size_t j = 0; j < ORDERS_PER_TICKER; ++j) {
+            Order order = {
+                .order_id = next_order_id++,
+                .price = price_dist(rng),
+                .size = size_dist(rng),
+                .timestamp = static_cast<uint64_t>(std::chrono::high_resolution_clock::now().time_since_epoch().count())
+            };
+            
+            int result = csb_add_order(order_books[ticker_id], order);
