+TEST_CASE("CSBTree Random Insert and Delete Operations", "[csbtree][random]") {
+    CSBTree* tree = csb_create_tree(compare_asc);
+    REQUIRE(tree != NULL);
+    
+    // Parameters for random testing
+    const size_t NUM_ORDERS = 1000;
+    const uint64_t MIN_PRICE = 1000;
+    const uint64_t MAX_PRICE = 2000;
+    const uint64_t START_ORDER_ID = 10000;
+    
+    // Generate random orders
+    std::vector<Order> orders;
+    orders.reserve(NUM_ORDERS);
+    
+    std::mt19937_64 rng(42); // Fixed seed for reproducibility
+    std::uniform_int_distribution<uint64_t> price_dist(MIN_PRICE, MAX_PRICE);
+    std::uniform_int_distribution<uint32_t> size_dist(1, 100);
+    
+    // Create orders with random prices
+    for (size_t i = 0; i < NUM_ORDERS; ++i) {
+        orders.push_back({
+            .order_id = START_ORDER_ID + i,
+            .price = price_dist(rng),
+            .size = size_dist(rng),
+            .timestamp = i // Use index as timestamp for deterministic ordering
+        });
+    }
+    
+    // Insert all orders
+    std::vector<Order> inserted_orders;
+    inserted_orders.reserve(NUM_ORDERS);
+    
+    size_t expected_price_levels = 0;
+    std::set<uint64_t> unique_prices;
+    
+    SECTION("Insert and Delete Random Orders") {
+        INFO("Inserting " << NUM_ORDERS << " random orders");
+        
+        // Insert all orders and track unique price levels
+        for (const auto& order : orders) {
+            REQUIRE(csb_add_order(tree, order) == 0);
+            inserted_orders.push_back(order);
+            
+            // Track unique prices to verify price level count
+            if (unique_prices.insert(order.price).second) {
+                expected_price_levels++;
+            }
+        }
+        
+        REQUIRE(tree->total_price_levels == expected_price_levels);
+        INFO("Tree has " << tree->total_price_levels << " price levels after insertion");
+        
+        // Shuffle the inserted orders for random deletion order
+        std::shuffle(inserted_orders.begin(), inserted_orders.end(), rng);
+        
+        // Delete orders one by one and verify tree consistency
+        for (size_t i = 0; i < inserted_orders.size(); ++i) {
+            const auto& order = inserted_orders[i];
+            
+            // Count how many orders remain at this price level
+            OrderList* list = csb_lookup_orders_by_price(tree, order.price);
+            REQUIRE(list != NULL);
+            
+            size_t orders_at_price_before = list->count;
+            
+            // Delete the order
+            REQUIRE(csb_delete_order(tree, order.price, order.order_id) == 0);
+            
+            // If this was the last order at this price level, the level should be removed
+            if (orders_at_price_before == 1) {
+                REQUIRE(csb_lookup_orders_by_price(tree, order.price) == NULL);
+                expected_price_levels--;
+            } else {
+                // Otherwise, the price level should still exist with one fewer order
+                list = csb_lookup_orders_by_price(tree, order.price);
+                REQUIRE(list != NULL);
+                REQUIRE(list->count == orders_at_price_before - 1);
+            }
+            
+            // Verify total price levels is correct
+            REQUIRE(tree->total_price_levels == expected_price_levels);
+        }
+        
+        // At the end, tree should be empty (logically)
+        REQUIRE(tree->total_price_levels == 0);
+        // The actual root node might still exist with internal implementation details
+        // so we only check the logical emptiness via total_price_levels
+    }
+    
+    SECTION("Randomized Edge Case Testing") {
+        INFO("Testing edge cases with randomized data");
+        
+        // Insert all orders
+        for (const auto& order : orders) {
+            REQUIRE(csb_add_order(tree, order) == 0);
+            inserted_orders.push_back(order);
+            if (unique_prices.insert(order.price).second) {
+                expected_price_levels++;
+            }
+        }
+        
+        REQUIRE(tree->total_price_levels == expected_price_levels);
+        
+        // Map to track orders by price for targeted deletions
+        std::map<uint64_t, std::vector<uint64_t>> orders_by_price;
+        for (const auto& order : inserted_orders) {
+            orders_by_price[order.price].push_back(order.order_id);
+        }
+        
+        // 1. Test deleting all orders at single price level
+        if (!orders_by_price.empty()) {
+            auto price_it = orders_by_price.begin();
+            uint64_t target_price = price_it->first;
+            INFO("Testing deletion of all orders at price level " << target_price);
+            
+            size_t orders_to_delete = price_it->second.size();
+            for (uint64_t order_id : price_it->second) {
+                REQUIRE(csb_delete_order(tree, target_price, order_id) == 0);
+            }
+            
+            // Price level should be gone
+            REQUIRE(csb_lookup_orders_by_price(tree, target_price) == NULL);
+            expected_price_levels--;
+            REQUIRE(tree->total_price_levels == expected_price_levels);
+            
+            // Remove this price from the map
+            orders_by_price.erase(price_it);
+        }
+        
+        // 2. Test deleting best price level (should update best price)
+        if (!orders_by_price.empty()) {
+            uint64_t old_best_price = csb_get_best_price(tree);
+            INFO("Testing deletion of best price level " << old_best_price);
+            
+            // Get all orders at the best price
+            auto& best_price_orders = orders_by_price[old_best_price];
+            for (uint64_t order_id : best_price_orders) {
+                REQUIRE(csb_delete_order(tree, old_best_price, order_id) == 0);
+            }
+            
+            // Price level should be gone
+            REQUIRE(csb_lookup_orders_by_price(tree, old_best_price) == NULL);
+            expected_price_levels--;
+            REQUIRE(tree->total_price_levels == expected_price_levels);
+            
+            // Best price should have changed
+            if (tree->total_price_levels > 0) {
+                uint64_t new_best_price = csb_get_best_price(tree);
+                REQUIRE(new_best_price != old_best_price);
+            }
+            
+            // Remove this price from the map
+            orders_by_price.erase(old_best_price);
+        }
+        
+        // 3. Remove remaining orders in random order
+        std::vector<std::pair<uint64_t, uint64_t>> remaining_orders; // (price, order_id)
+        for (const auto& [price, order_ids] : orders_by_price) {
+            for (uint64_t order_id : order_ids) {
+                remaining_orders.push_back({price, order_id});
+            }
+        }
+        
+        std::shuffle(remaining_orders.begin(), remaining_orders.end(), rng);
+        
+        for (const auto& [price, order_id] : remaining_orders) {
+            OrderList* list = csb_lookup_orders_by_price(tree, price);
+            REQUIRE(list != NULL);
+            
+            size_t orders_at_price_before = list->count;
+            REQUIRE(csb_delete_order(tree, price, order_id) == 0);
+            
+            if (orders_at_price_before == 1) {
+                REQUIRE(csb_lookup_orders_by_price(tree, price) == NULL);
+                expected_price_levels--;
+            }
+            
+            REQUIRE(tree->total_price_levels == expected_price_levels);
+        }
+        
+        // Tree should be empty at the end
+        REQUIRE(tree->total_price_levels == 0);
+    }
+    
+    csb_destroy_tree(tree);
+}
