@@ -0,0 +1,123 @@
+use std::fs::File;
+use std::io::BufWriter;
+use std::sync::Arc;
+use std::time::Instant;
+
+use arrow::array::{ArrayRef, Float64Array, Int64Array, StringArray};
+use arrow::datatypes::{DataType, Field, Schema};
+use arrow::record_batch::RecordBatch;
+use parquet::arrow::ArrowWriter;
+use parquet::basic::Compression;
+use parquet::file::properties::WriterProperties;
+use rand::distributions::Alphanumeric;
+use rand::{thread_rng, Rng};
+
+const COL5_LEN: usize = 100;
+const POOL_SIZE: usize = 1024 * 10; // 10KB pool for random string slices
+
+fn main() -> Result<(), Box<dyn std::error::Error>> {
+    // 2. Define the total number of records to generate
+    let total_records = 20_000_000;
+    let chunk_size = 8192; // Number of records per RecordBatch
+
+    // 3. Define the Arrow Schema corresponding to the struct
+    let schema = Arc::new(Schema::new(vec![
+        Field::new("col1", DataType::Int64, false),
+        Field::new("col2", DataType::Int64, false),
+        Field::new("col3", DataType::Float64, true), // Nullable double
+        Field::new("col4", DataType::Utf8, false),
+        Field::new("col5", DataType::Utf8, false),
+    ]));
+
+    // 4. Set up the output file writer with buffering
+    let file = File::create("output.parquet")?;
+    let buffered_writer = BufWriter::new(file);
+
+    // 5. Configure Parquet WriterProperties (e.g., compression)
+    let props = WriterProperties::builder()
+        .set_compression(Compression::LZ4_RAW)
+        .set_write_batch_size(1024) // Internal buffer size for writing pages
+        .set_data_page_size_limit(1024 * 1024) // Limit for data page size
+        .set_max_row_group_size(1024 * 1024) // Set max rows per row group (e.g., ~1 million)
+        .build();
+
+    // 6. Initialize the ArrowWriter
+    let mut writer = ArrowWriter::try_new(buffered_writer, schema.clone(), Some(props))?;
+
+    // Generate a pool of random characters for efficient string generation
+    let mut rng = thread_rng();
+    let pool: String = (&mut rng)
+        .sample_iter(&Alphanumeric)
+        .take(POOL_SIZE)
+        .map(char::from)
+        .collect();
+
+    println!("Starting Parquet file generation...");
+    let start_time = Instant::now(); // Start timer
+
+    // 7. Process data in chunks directly without storing the entire dataset in memory
+    let num_chunks = (total_records + chunk_size - 1) / chunk_size; // Ceiling division
+
+    for chunk_idx in 0..num_chunks {
+        // Calculate the start and end indices for this chunk
+        let start_idx = chunk_idx * chunk_size;
+        let end_idx = std::cmp::min(start_idx + chunk_size, total_records);
+        let current_chunk_size = end_idx - start_idx;
+
+        // Pre-allocate vectors for this chunk only
+        let mut col1_vec = Vec::with_capacity(current_chunk_size);
+        let mut col2_vec = Vec::with_capacity(current_chunk_size);
+        let mut col3_vec = Vec::with_capacity(current_chunk_size);
+        let mut col4_vec = Vec::with_capacity(current_chunk_size);
+        let mut col5_vec = Vec::with_capacity(current_chunk_size);
+
+        // Pre-generate random start indices for col5 for this chunk
+        let max_start_index = pool.len() - COL5_LEN;
+        let col5_start_indices: Vec<usize> = (0..current_chunk_size)
+            .map(|_| rng.gen_range(0..max_start_index))
+            .collect();
+
+        // Generate only the records for this chunk
+        for (j, i) in (start_idx..end_idx).enumerate() {
+            col1_vec.push(i as i64);
+            col2_vec.push((i * 2) as i64);
+            col3_vec.push(if i % 10 == 0 {
+                None
+            } else {
+                Some(i as f64 * 1.1)
+            });
+            col4_vec.push(format!("StringA_{}", i));
+            // Generate col5 string from the pool using pre-generated index
+            let start = col5_start_indices[j];
+            col5_vec.push(pool[start..start + COL5_LEN].to_string());
+        }
+
+        // Convert to Arrow arrays
+        let col1_array = Arc::new(Int64Array::from(col1_vec)) as ArrayRef;
+        let col2_array = Arc::new(Int64Array::from(col2_vec)) as ArrayRef;
+        let col3_array = Arc::new(Float64Array::from(col3_vec)) as ArrayRef;
+        let col4_array = Arc::new(StringArray::from(col4_vec)) as ArrayRef;
+        let col5_array = Arc::new(StringArray::from(col5_vec)) as ArrayRef;
+
+        // Create a RecordBatch from the arrays and schema
+        let batch = RecordBatch::try_new(
+            schema.clone(),
+            vec![col1_array, col2_array, col3_array, col4_array, col5_array],
+        )?;
+
+        // Write the RecordBatch to the Parquet file
+        writer.write(&batch)?;
+    }
+
+    // 8. CRUCIAL: Close the writer to finalize the Parquet file
+    writer.close()?;
+
+    let duration = start_time.elapsed(); // Stop timer
+
+    println!(
+        "Parquet file 'output.parquet' written successfully in {:.2?}.",
+        duration
+    );
+
+    Ok(())
+}
