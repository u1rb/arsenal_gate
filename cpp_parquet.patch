+#ifndef CSB_TREE_H
+#define CSB_TREE_H
+
+#include <stdint.h>
+#include <stddef.h>
+#include <stdbool.h>
+#include "pool_allocator.h"
+
+// --- Configuration Constants ---
+
+// Target node size (adjust based on cache line size, e.g., 64, 128, 256)
+#define CSB_NODE_SIZE 128
+
+// Maximum number of pending lazy deletions before a real deletion
+#define CSB_MAX_LAZY_DELETES 4
+
+// Forward Declarations
+struct CSBTreeNode;
+struct OrderList;
+
+// --- Order Data Structures ---
+
+typedef struct Order {
+    uint64_t order_id;    // Unique identifier for the order
+    uint64_t price;       // Price level (used as the key in the tree)
+    uint32_t size;        // Order quantity
+    uint64_t timestamp;   // Timestamp or sequence number for time priority
+    // Add other relevant fields: side (bid/ask), user ID, etc.
+} Order;
+
+typedef struct OrderNode {
+    Order order;
+    struct OrderNode* next; // Pointer to the next order at the same price level
+} OrderNode;
+
+typedef struct OrderList {
+    OrderNode* head;       // Head of the linked list of orders
+    uint64_t total_volume; // Sum of sizes of all orders in the list
+    size_t count;          // Number of orders in the list
+} OrderList;
+
+// Lazy deletion structure to track deleted orders
+typedef struct LazyDeleteEntry {
+    uint64_t price;
+    uint64_t order_id;
+    bool is_valid;       // Whether this entry is valid/active
+} LazyDeleteEntry;
+
+// --- Tree Configuration ---
+
+// Maximum number of keys/values in a leaf node.
+// Should be chosen such that sizeof(CSBTreeNode) <= desired cache line size.
+// Example: For 128 bytes, with ~16 bytes overhead, leaves ~112 bytes.
+// If keys (uint64_t) and values (OrderList*) are 8 bytes each (16 bytes/pair),
+// LEAF_ORDER ~ floor(112 / 16) = 7. Let's test with 7.
+#define CSB_LEAF_ORDER 7
+
+// Maximum number of children in an internal node (implies INTERNAL_ORDER - 1 keys).
+// Should be chosen such that sizeof(CSBTreeNode) <= desired cache line size.
+// Example: For 128 bytes, with ~16 bytes overhead, leaves ~112 bytes.
+// Keys (uint64_t), children (CSBTreeNode*), counts (uint64_t) are 8 bytes each.
+// Needs space for N keys, N+1 children, N+1 counts = N*8 + (N+1)*8 + (N+1)*8 = 24N + 16
+// If 24N + 16 <= 112 => 24N <= 96 => N <= 4. Max keys = 4.
+// So, max children (INTERNAL_ORDER) = 5. Let's test with 5.
+#define CSB_INTERNAL_ORDER 5
+
+// Minimum number of keys in a leaf node (must be <= LEAF_ORDER/2)
+// ceil(CSB_LEAF_ORDER / 2) = ceil(7/2) = 4
+#define CSB_MIN_LEAF_KEYS ((CSB_LEAF_ORDER + 1) / 2)
+
+// Minimum number of keys in an internal node (must be <= (INTERNAL_ORDER-1)/2)
+// ceil(CSB_INTERNAL_ORDER / 2) - 1 = ceil(5/2) - 1 = 3 - 1 = 2
+#define CSB_MIN_INTERNAL_KEYS (((CSB_INTERNAL_ORDER + 1) / 2) - 1)
+
+// --- Tree Node Structure ---
+
+typedef struct CSBTreeNode {
+    bool is_leaf;
+    uint8_t num_keys; // Number of keys currently stored
+
+    union {
+        // Internal node data
+        struct {
+            uint64_t keys[CSB_INTERNAL_ORDER - 1];             // Separator keys
+            struct CSBTreeNode* children[CSB_INTERNAL_ORDER]; // Child node pointers
+            uint64_t subtree_price_level_counts[CSB_INTERNAL_ORDER]; // Count of *price levels* in each child subtree
+        } internal;
+
+        // Leaf node data
+        struct {
+            uint64_t keys[CSB_LEAF_ORDER];         // Price keys
+            OrderList* values[CSB_LEAF_ORDER];   // Pointers to order lists for each price
+            struct CSBTreeNode* next_leaf;       // Pointer to the next leaf node
+        } leaf;
+    } data;
+
+    // Padding to reach CSB_NODE_SIZE (compiler might add some automatically)
+    // char padding[CSB_NODE_SIZE - sizeof(bool) - sizeof(uint8_t) - sizeof(union data)];
+    // Note: Calculating exact padding is complex due to union and potential compiler alignment.
+    // Rely on the definition ensuring the components fit.
+
+} CSBTreeNode;
+
+// --- Key Comparison Function ---
+
+// Function pointer type for comparing keys (prices).
+// Returns: < 0 if key1 < key2, 0 if key1 == key2, > 0 if key1 > key2
+// (Adjust comparison logic for descending order needed for bids)
+typedef int (*csb_key_compare_func)(uint64_t key1, uint64_t key2);
+
+// --- Tree Structure ---
+
+typedef struct CSBTree {
+    CSBTreeNode* root;
+    csb_key_compare_func compare_keys;
+    size_t total_price_levels; // Total number of unique price levels in the tree
+
+    // Memory Pools for nodes, lists, and order nodes
+    PoolAllocator* node_pool;
+    PoolAllocator* list_pool;
+    PoolAllocator* order_node_pool;
+    
+    // Lazy deletion support
+    LazyDeleteEntry lazy_deletes[CSB_MAX_LAZY_DELETES];
+    size_t lazy_delete_count;
+    bool lazy_delete_enabled;
+} CSBTree;
+
+// --- Public API ---
+
+/**
+ * @brief Creates a new, empty CSB-Tree.
+ * @param compare_func Function pointer for comparing keys (prices).
+ *                     Use a function returning ascending order for asks, descending for bids.
+ * @return Pointer to the newly created tree, or NULL on failure.
+ */
+CSBTree* csb_create_tree(csb_key_compare_func compare_func);
+
+/**
+ * @brief Destroys the CSB-Tree and frees all associated memory.
+ * @param tree Pointer to the tree to destroy.
+ */
+void csb_destroy_tree(CSBTree* tree);
+
+/**
+ * @brief Adds an order to the tree.
+ *        Handles adding to existing price levels or creating new ones.
+ * @param tree Pointer to the CSB-Tree.
+ * @param order The order data to add.
+ * @return 0 on success, -1 on failure (e.g., allocation error).
+ */
+int csb_add_order(CSBTree* tree, Order order);
+
+/**
+ * @brief Deletes an order specified by its price and unique ID.
+ *        If this is the last order at a price level, the level itself is removed.
+ * @param tree Pointer to the CSB-Tree.
+ * @param price The price level of the order to delete.
+ * @param order_id The unique ID of the order to delete.
+ * @return 0 if the order was found and deleted, -1 otherwise.
+ */
+int csb_delete_order(CSBTree* tree, uint64_t price, uint64_t order_id);
+
+/**
+ * @brief Modifies the size of an existing order.
+ *        The size change is also reflected in the price level's total volume.
+ * @param tree Pointer to the CSB-Tree.
+ * @param price The price level of the order to modify.
+ * @param order_id The unique ID of the order to modify.
+ * @param new_size The new size for the order.
+ * @return 0 if the order was found and modified, -1 otherwise.
+ */
+int csb_modify_order(CSBTree* tree, uint64_t price, uint64_t order_id, uint32_t new_size);
+
+/**
+ * @brief Enables or disables lazy deletion mode.
+ * @param tree Pointer to the CSB-Tree.
+ * @param enable True to enable lazy deletion, false to disable it.
+ */
+void csb_set_lazy_deletion(CSBTree* tree, bool enable);
+
+/**
+ * @brief Forces processing of all pending lazy deletions.
+ * @param tree Pointer to the CSB-Tree.
+ * @return The number of deletions processed.
+ */
+int csb_process_lazy_deletions(CSBTree* tree);
+
+/**
+ * @brief Looks up the list of orders for a specific price level.
+ * @param tree Pointer to the CSB-Tree.
+ * @param price The price level to look up.
+ * @return Pointer to the OrderList for the given price, or NULL if the price level does not exist.
+ */
+OrderList* csb_lookup_orders_by_price(const CSBTree* tree, uint64_t price);
+
+/**
+ * @brief Gets the best price level in the tree according to the tree's comparator.
+ *        (e.g., lowest price for asks, highest price for bids).
+ * @param tree Pointer to the CSB-Tree.
+ * @return The best price key. Returns 0 (or potentially UINT64_MAX depending on valid price range)
+ *         if the tree is empty.
+ */
+uint64_t csb_get_best_price(const CSBTree* tree);
+
+/**
+ * @brief Gets the OrderList associated with the best price level in the tree.
+ * @param tree Pointer to the CSB-Tree.
+ * @return Pointer to the OrderList for the best price, or NULL if the tree is empty.
+ */
+OrderList* csb_get_best_price_orders(const CSBTree* tree);
+
+/**
+ * @brief Retrieves the price key of the Nth price level in sorted order (0-based index).
+ *        The sorting order depends on the tree's comparison function.
+ * @param tree Pointer to the CSB-Tree.
+ * @param n The 0-based rank of the price level to retrieve.
+ * @param result_price Pointer to a uint64_t where the resulting price key will be stored.
+ * @return 0 on success, -1 if n is out of bounds (n >= total_price_levels).
+ */
+int csb_get_nth_price_level(const CSBTree* tree, size_t n, uint64_t* result_price);
+
+#endif // CSB_TREE_H 
